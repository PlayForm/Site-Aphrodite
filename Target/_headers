# Cloudflare Pages custom headers for the Aphrodite site.

# Content-hashed build assets: cache forever.
/_astro/*
	Cache-Control: public, max-age=31536000, immutable

# The brand assets are versioned by their content in practice; cache them
# like the build assets.
/Brand/*
	Cache-Control: public, max-age=31536000, immutable

# Security and correctness basics for every route.
/*
	X-Content-Type-Options: nosniff
	Referrer-Policy: strict-origin-when-cross-origin
