    "astro": "7.3.8",
    "astro-capo": "0.0.1",
    "astrojs-service-worker": "2.0.3",
    "autoprefixer": "10.6.1",
    "cssnano": "9.5.0",
    "cssnano-preset-advanced": "9.4.0",
    "dotenv": "18.0.7",
