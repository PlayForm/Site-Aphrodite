---
import Base from "@Layout/Base.astro";

import Breadcrumbs from "@Component/Breadcrumbs.astro";
import CodeFence from "@Component/CodeFence.astro";
import Related from "@Component/Related.astro";
import { Stamps, Versions } from "@Library/Versions";

const BothCrates =
	Versions.Binary === Versions.Hermes
		? `both v${Versions.Binary}`
		: `v${Versions.Binary} and v${Versions.Hermes}`;
---

<Base
	Title="CRATES // APHRODITE"
	Description={`The Aphrodite workspace: the aphrodite Chat Completions proxy crate and the aphrodite-hermes integration crate, ${BothCrates}, plus the vendored Headroom fork.`}
>
	<main
		class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-24 px-5 py-32 sm:px-8 lg:gap-40 lg:px-14 lg:py-56"
	>
		<Breadcrumbs />
		<header class="relative flex w-full flex-col items-start">
			<div
				class="mb-5 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				CRATES // WORKSPACE MANIFEST
			</div>
			<h1
				class="font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-5xl"
			>
				Crates
			</h1>
			<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Two workspace crates plus the vendored Headroom fork that carries the content
				transforms.
				<span class="mt-1 block text-base">It is the reason the fork stays separate:
				Aphrodite adds the preview pipeline, CCR storage, Hermes integration, and
				dual-proxy architecture on top of Headroom, instead of rewriting the
				transforms.</span>
				<span class="mt-1 block text-base text-zinc-dust">SRC: README.md:515-519</span>
			</p>
		</header>

		<!-- CASE #01: APHRODITE -->
		<section class="relative w-full lg:w-9/12 lg:self-start">
			<div
				class="zine-box-crimson relative -rotate-[2.2deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-8"
			>
				<div
					class="absolute -top-3.5 left-6 border border-black bg-raw-blood px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
				>
					#01 // PROXY CRATE
				</div>
				<div class="mb-4 mt-2 flex flex-wrap items-center justify-between gap-2">
					<h2 class="font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
						aphrodite
					</h2>
					<span
						class="-rotate-2 border-2 border-black bg-raw-blood px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[4px_4px_0px_#000]"
					>
						{Stamps.Binary()}
					</span>
				</div>
				<p class="mb-4 font-body text-base leading-relaxed text-bone-newsprint">
					Chat Completions proxy with CCR, tool relay, and programmatic CCR for Hermes agent
					integration. Ships the
					<code class="font-mono text-base text-weathered-teal">aphrodite</code> binary and a
					cdylib/rlib library; built on axum and tokio.
				</p>
				<div class="border-2 border-oxblood-dark bg-asphalt-panel p-3.5">
					<div class="mb-1 text-base font-black uppercase tracking-widest text-stamped-canary">
						INSTALL // CARGO:
					</div>
					<CodeFence Class="border border-oxblood-dark" Code="$ cargo install aphrodite" />
					<div class="ccr-marker mt-2 font-mono text-base font-bold text-weathered-teal">
						{`<<<CCR:crate.aphrodite|${Versions.Binary}|axum-0.8.9+tokio-1.53.1>>>`}
					</div>
				</div>
				<p class="mt-4 text-base text-zinc-dust">SRC: crates/aphrodite/Cargo.toml</p>
			</div>
		</section>

		<!-- CASE #02: APHRODITE-HERMES -->
		<section class="relative w-full lg:w-7/12 lg:self-end lg:-mt-12">
			<div
				class="zine-box-crimson relative rotate-[2.2deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-8"
			>
				<div
					class="absolute -top-3.5 right-6 border border-black bg-stamped-canary px-3 py-0.5 text-base font-black uppercase tracking-widest text-soot-black shadow-[2px_2px_0px_#000]"
				>
					#02 // INTEGRATION CRATE
				</div>
				<div class="mb-4 mt-2 flex flex-wrap items-center justify-between gap-2">
					<h2 class="font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
						aphrodite-hermes
					</h2>
					<span
						class="rotate-1 border-2 border-black bg-stamped-canary px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-soot-black shadow-[4px_4px_0px_#000]"
					>
						{`v${Versions.Hermes}`}
					</span>
				</div>
				<p class="mb-4 font-body text-base leading-relaxed text-bone-newsprint">
					Hermes Agent-specific integration for the Aphrodite compression engine - tool
					schemas, hook dispatch, skill registration. Ships the
					<code class="font-mono text-base text-weathered-teal">aphrodite-hermes-setup</code>
					helper binary and the dylib; watches config with notify.
				</p>
				<div class="border-2 border-oxblood-dark bg-asphalt-panel p-3.5">
					<div class="mb-1 text-base font-black uppercase tracking-widest text-stamped-canary">
						INSTALL // CARGO:
					</div>
					<CodeFence Class="border border-oxblood-dark" Code="$ cargo install aphrodite-hermes" />
				</div>
				<p class="mt-4 text-base text-zinc-dust">SRC: crates/aphrodite-hermes/Cargo.toml</p>
			</div>
		</section>

		<!-- CONFIG SURFACE -->
		<section class="relative w-full">
			<div
				class="mb-5 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				CONFIGURATION SURFACE // APHRODITE.TOML.EXAMPLE
			</div>
			<div
				class="zine-box-crimson relative w-full rotate-[0.6deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-10"
			>
				<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
					<div class="border border-oxblood-dark bg-soot-black p-4 font-mono text-base text-bone-newsprint">
						<div class="text-weathered-teal">[[proxies]]</div>
						<div>cache <span class="text-zinc-dust">→</span> <span class="text-stamped-canary">127.0.0.1:9797</span> timeout <span class="text-stamped-canary">120</span></div>
						<div>token <span class="text-zinc-dust">→</span> <span class="text-stamped-canary">127.0.0.1:9798</span> timeout <span class="text-stamped-canary">300</span></div>
						<div>tool_relay = <span class="text-stamped-canary">true</span> <span class="text-zinc-dust">(both)</span></div>
						<div class="pt-3 text-weathered-teal">[defaults]</div>
						<div>api_url = <span class="text-stamped-canary">"https://api.openai.com"</span></div>
						<div>ccr_ttl_seconds = <span class="text-stamped-canary">3600</span></div>
						<div class="pt-3 text-weathered-teal">[flow]</div>
						<div>budget_chars = <span class="text-stamped-canary">2600</span></div>
					</div>
					<div class="border border-oxblood-dark bg-soot-black p-4 font-mono text-base text-bone-newsprint">
						<div class="text-weathered-teal">[compression]</div>
						<div>engine_threshold_pct = <span class="text-stamped-canary">45</span></div>
						<div>tool_threshold_token = <span class="text-stamped-canary">512</span></div>
						<div>tool_threshold_cache = <span class="text-stamped-canary">4096</span></div>
						<div>terminal_threshold = <span class="text-stamped-canary">1024</span></div>
						<div>inline_threshold = <span class="text-stamped-canary">2048</span></div>
						<div>code_multiplier = <span class="text-stamped-canary">3.0</span></div>
						<div>auto_reload = <span class="text-stamped-canary">false</span> <span class="text-zinc-dust"># opt-in</span></div>
						<div class="pt-3 text-weathered-teal">[previews]</div>
						<div>preview_max_chars = <span class="text-stamped-canary">120</span></div>
					</div>
				</div>
				<p class="mt-6 border-t border-oxblood-dark pt-4 font-body text-base leading-relaxed text-zinc-dust">
					Keys not yet wired into the runtime are annotated DOCUMENTED BUT UNWIRED in the
					example; the dead <code class="font-mono text-base">[templates.*]</code> subtree was
					removed in v1.6.6. Marker grammar:
					<code class="ccr-marker font-mono text-base text-weathered-teal">&lt;&lt;&lt;CCR:hash|type|size&gt;&gt;&gt;</code>
				</p>
				<p class="mt-2 text-base text-zinc-dust">SRC: aphrodite.toml.example; CHANGELOG.md v{Versions.ChangelogVersion}</p>
			</div>
		</section>

		<!-- RELATED: the natural neighbors -->
		<Related
			Links={[
				{ Href: "/versions/", Label: "VERSIONS" },
				{ Href: "/benchmarks/", Label: "BENCHMARKS" },
				{ Href: "/setup/", Label: "SETUP" },
			]}
		/>
	</main>
</Base>
