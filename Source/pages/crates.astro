---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineSource from "@Component/ZineSource.astro";
import CodeFence from "@Component/CodeFence.astro";
import { Versions } from "@Library/Versions";
import { Assert, CrateNames, Crates as Roster } from "@Library/Roster";
import { CrateNote } from "@Library/Prose/Crates";
import ZineSurface from "@Component/ZineSurface.astro";

// THE WORKSPACE - never typed here. `Cargo.toml` decides which crates exist;
// each crate's own manifest supplies its name, version and description. A
// crate added to the workspace appears on this page with no edit to it, and
// `Assert` fails the build if the page's prose names one the workspace does
// not declare.
Assert("Source/Library/Prose/Crates.ts", CrateNote, CrateNames);

/** A manifest description already ends in a period; a card's role adds one. */
const Sentence = (Text: string): string => Text.replace(/\.$/, "");

const Crates = Roster.map((Crate, Index) => {
	const Note = CrateNote[Crate.Name] ?? {};

	return {
		...Crate,
		// The case number is the roster's own order, zero-padded - the ordinal
		// a card is filed under, computed rather than typed.
		N: String(Index + 1).padStart(2, "0"),
		Role: Note.Role ?? Crate.Description,
		Ships: Note.Ships ?? (Crate.Vendored ? "a library only" : "its own crate"),
		Body: Note.Body ?? [],
		Marker: Note.Marker,
		// COLOUR IS IDENTITY, NOT DECORATION. Canary is a workspace crate - one a
		// reader installs. Teal is the vendored fork - one that arrives as a
		// dependency. Both are the published `.telemetry-tag` modifiers, so each
		// carries its own legible ink: canary is a solid fill with soot type, and
		// teal is an OUTLINE because teal reads at 4.5:1 as text on the dark
		// fills while crimson does not (which is why crimson would be solid).
		Chip: Crate.Vendored ? "telemetry-tag--teal" : "telemetry-tag--canary",
		// What an install does with it, in the ribbon's telemetry voice.
		Kind: Crate.Vendored ? "VENDORED // DEPENDENCY" : "WORKSPACE // INSTALLABLE",
		// A LIBRARY HAS NO BINARY, so `cargo install` has nothing to place on
		// disk and a card that printed the command would print a command that
		// fails. The vendored card renders the line that pulls it in instead:
		// the same declaration its consumer's manifest carries.
		Installs: !Crate.Vendored,
		Version: `v${Crate.Version}`,
	};
});

const BothCrates =
	Versions.Binary === Versions.Hermes
		? `both v${Versions.Binary}`
		: `v${Versions.Binary} and v${Versions.Hermes}`;

// THE CHAIN, in the direction the manifests declare it: `aphrodite-hermes`
// declares `aphrodite` as a path dependency, and `aphrodite` declares the
// vendored fork's core library. Written here rather than only in prose so the
// dependency card cannot drift from the roster above it. `Pull` marks the
// identifiers it renders in the mono voice with backticks, and the template
// splits on them.
const Chain = [
	{
		Name: "aphrodite-hermes",
		Version: `v${Versions.Hermes}`,
		Pull: "Installed directly. Its manifest declares `aphrodite` as a path dependency at the same version, so building this crate builds the proxy crate with it.",
	},
	{
		Name: "aphrodite",
		Version: `v${Versions.Binary}`,
		Pull: "Installed directly. Its manifest declares the vendored fork's core library as a dependency under its published name, so the transforms are compiled into the binary rather than reimplemented beside it.",
	},
	{
		Name: "aphrodite-headroom-core",
		Version: `v${Versions.Headroom}`,
		Pull: "Never installed directly: it arrives as `aphrodite`'s dependency, as a library only. Upstream's proxy surface does not ship in Aphrodite.",
	},
];
---

<Base
	Title="CRATES // APHRODITE"
	Description={`The Aphrodite workspace: the aphrodite Chat Completions proxy crate and the aphrodite-hermes integration crate, ${BothCrates}, plus the vendored Headroom fork.`}
>
	<PageShell Rhythm="wide">
		<PageHeader
			Tape="CRATES // WORKSPACE MANIFEST"
			Title="Crates"
			Lead={[
				"A tool call's output becomes part of the model's context, and one crate in this workspace is the code that transforms it before the model reads it.",
				"Two workspace crates plus the vendored Headroom fork that carries the content transforms.",
				`It is the reason the fork stays separate: Aphrodite adds the preview pipeline, CCR storage, Hermes integration, and dual-proxy architecture on top of Headroom, instead of rewriting the transforms.`,
				`The binary links the fork's <code class="font-mono text-base text-weathered-teal">headroom-core</code> library only, published as <code class="font-mono text-base text-weathered-teal">aphrodite-headroom-core v${Versions.Headroom}</code>: upstream's proxy surface does not ship in Aphrodite.`,
				"Every crate is installable on its own; which one an install actually needs follows from the dependency chain.",
			]}
		/>

		<!-- 01 // WORKSPACE - the decision matrix: one row per published name -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">01 // WORKSPACE // {Crates.length} PUBLISHED NAMES</p>
			<h2 id="manifest" class="mt-3 scroll-mt-24 type-section text-bone-white">
				What the workspace publishes
			</h2>
			<p class="mt-6 max-w-[46rem] font-body text-body leading-relaxed text-bone-newsprint">
				{Crates.length} names leave this workspace, and none of them is typed by hand: the
				workspace <code class="font-mono text-base text-weathered-teal">Cargo.toml</code>{" "}
				decides which crates exist, and every entry is read from that crate's own manifest -
				its name, its version, its description. A crate added to the workspace appears in
				the roster with no edit anywhere, and a crate removed from it leaves the same way.
			</p>

			<ZineSurface Class="mt-8" Mode="edge">
				<div class="overflow-x-auto">
					<table class="w-full border-collapse text-left">
						<thead>
							<tr class="border-b border-[color:var(--tier-well-edge)]">
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									CRATE
								</th>
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									ROLE
								</th>
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									SHIPS
								</th>
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									VERSION
								</th>
							</tr>
						</thead>
						<tbody>
							{Crates.map(({ Name, Role, Ships, Version, Chip }) => (
								<tr class="border-b border-[color:var(--tier-shell-edge)] align-top last:border-b-0">
									<th
										scope="row"
										class="whitespace-nowrap px-4 py-4 text-left sm:px-5"
									>
										<a
											class="font-mono text-code font-bold text-weathered-teal underline decoration-transparent decoration-2 underline-offset-4 transition-colors hover:decoration-stamped-canary"
											href={`#${Name}`}
										>
											{Name}
										</a>
									</th>
									<td class="max-w-[26rem] px-4 py-4 font-body text-body leading-relaxed text-zinc-dust sm:px-5">
										{Role}
									</td>
									<td class="max-w-[20rem] px-4 py-4 font-body text-body leading-relaxed text-bone-newsprint sm:px-5">
										{Ships}
									</td>
									<td class="px-4 py-4 sm:px-5">
										<span class:list={["telemetry-tag", Chip]}>{Version}</span>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</ZineSurface>

			<ZineSource
				Lines={[
					"SRC: README.md:515-519",
					"SRC: crates/aphrodite/Cargo.toml; crates/aphrodite-hermes/Cargo.toml",
				]}
			/>
		</section>

		<!-- 02 // CASES - one shell card per crate, ribbon first -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">02 // CASES // THE MANIFEST, CRATE BY CRATE</p>
			<h2 id="cases" class="mt-3 scroll-mt-24 type-section text-bone-white">
				Each crate in full
			</h2>
			<p class="mt-6 max-w-[46rem] font-body text-body leading-relaxed text-bone-newsprint">
				Each name declares itself once, in its own manifest: the version is that file's
				version and the role is that file's description, so the roster cannot drift from the
				crates it describes. What each one puts on disk is the difference that matters
				before an install - a
				<code class="font-mono text-base text-weathered-teal">cargo install</code> for the
				two workspace crates, and for the vendored fork the dependency line that pulls it
				in, because a library has no binary to place. Colour is the crate's kind and not its
				rank: canary is a workspace crate a reader installs, teal is the vendored fork that
				arrives as a dependency.
			</p>

			<div class="mt-10 grid grid-cols-1 items-start gap-8 lg:grid-cols-3">
				{Crates.map((Crate) => (
					<article
						id={Crate.Name}
						class="grunge shell-card flex scroll-mt-24 flex-col"
						data-grunge
						data-grunge-mode="edge"
					>
						<header class="border-b border-[color:var(--tier-shell-edge)] px-5 py-4">
							<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
								<span class="type-meta uppercase text-zinc-dust">{`CASE #${Crate.N}`}</span>
								<h3 class="font-mono text-code font-bold text-bone-white">
									{Crate.Name}
								</h3>
								<span class:list={["telemetry-tag ml-auto", Crate.Chip]}>
									{Crate.Version}
								</span>
							</div>
							<p class="mt-3 font-body text-body leading-relaxed text-bone-newsprint">
								{Sentence(Crate.Role)}.
							</p>
							<p class="type-meta mt-2 uppercase text-zinc-dust">{Crate.Kind}</p>
						</header>

						<div class="prose-flow flex-1 px-5 py-5">
							<p>
								<span class="type-meta block uppercase text-zinc-dust">SHIPS</span>
								<span class="mt-1 block font-body text-body leading-relaxed text-bone-newsprint">
									{Crate.Ships}
								</span>
							</p>
							{Crate.Body.map((Line) => (
								<p class="font-body text-body leading-relaxed text-bone-newsprint">
									{Line}
								</p>
							))}

							{Crate.Installs ? (
								<div>
									<p class="type-meta uppercase text-stamped-canary">
										INSTALL // CARGO:
									</p>
									<CodeFence
										Class="mt-2"
										Code={`$ cargo install ${Crate.Name}`}
										CopyPayload={`cargo install ${Crate.Name}`}
									/>
									{Crate.Marker ? (
										<div class="ccr-marker mt-3 font-mono text-code font-bold text-weathered-teal">
											{`<<<CCR:${Crate.Marker}|${Crate.Version.replace(/^v/, "")}|axum-0.8.9+tokio-1.53.1>>>`}
										</div>
									) : null}
								</div>
							) : (
								<div>
									<p class="type-meta uppercase text-zinc-dust">
										ARRIVES AS // A DEPENDENCY, NOT A COMMAND:
									</p>
									<div class="well mt-2 px-4 py-3 font-mono text-code leading-relaxed">
										<span class="text-weathered-teal">aphrodite</span>
										<span class="text-zinc-dust"> → </span>
										<span class="text-stamped-canary">{Crate.Name}</span>
									</div>
									<p class="mt-2 font-body text-body leading-relaxed text-zinc-dust">
										A library only, so{" "}
										<code class="font-mono text-base">cargo install</code>
										has no binary to place on disk: the proxy crate declares it,
										and the transforms compile into the binary.
									</p>
								</div>
							)}
						</div>

						<p class="border-t border-[color:var(--tier-shell-edge)] px-5 py-3 font-mono text-meta text-zinc-dust">
							SRC: {Crate.Path}
						</p>
					</article>
				))}
			</div>
		</section>

		<!-- 03 // DEPENDENCY - the whole story in one wide card -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">03 // DEPENDENCY // ONE CHAIN, {Chain.length} LINKS</p>
			<h2 id="dependency" class="mt-3 scroll-mt-24 type-section text-bone-white">
				Who pulls whom
			</h2>
			<p class="mt-6 max-w-[46rem] font-body text-body leading-relaxed text-bone-newsprint">
				The three names are one chain and not three islands. Each link is a path dependency
				in the manifest one step up, so the direction never reverses: the vendored core
				knows nothing about the proxy, the proxy knows nothing about Hermes, and Hermes is
				the only crate that speaks to the agent. That is why an install names two crates and
				receives three.
			</p>

			<ZineBox
				Emphasis="featured"
				Size="lg"
				Surface="shell"
				Grunge={true}
				Tape="DEPENDENCY"
				Class="mt-10"
			>
				<p class="type-meta uppercase text-zinc-dust">
					WHAT A CARGO INSTALL PULLS // DECLARED IN EACH MANIFEST
				</p>

				<dl class="well mt-6 grid grid-cols-1 gap-x-6 gap-y-5 p-4 font-body sm:p-5 lg:grid-cols-[minmax(0,19rem)_1fr]">
					{Chain.map((Link) => (
						<>
							<dt class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
								<span class="font-mono text-code font-bold text-bone-white">
									{Link.Name}
								</span>
								<span class="telemetry-tag">{Link.Version}</span>
							</dt>
							<dd class="text-body leading-relaxed text-bone-newsprint">
								{Link.Pull.split("`").map((Part, At) =>
									At % 2 === 1 ? (
										<code class="font-mono text-base text-weathered-teal">
											{Part}
										</code>
									) : (
										Part
									),
								)}
							</dd>
						</>
					))}
				</dl>

				<p class="mt-8 border-t border-[color:var(--tier-shell-edge)] pt-6 font-body text-body leading-relaxed text-bone-newsprint">
					The first two are the ones a user installs; the third arrives as their
					dependency.
				</p>
				<p class="mt-3 font-body text-body leading-relaxed text-zinc-dust">
					The chain is also why the fork stays separate rather than being absorbed: the
					vendored core carries the content transforms and nothing else, the proxy adds
					the preview pipeline, the CCR store, the tool relay and the dual-proxy
					architecture around it, and Hermes adds the tool schemas, the hook dispatch and
					the skill registration on top of the proxy. Each layer stays installable,
					testable and replaceable on its own, and the boundary between them is a
					manifest line rather than a convention.
				</p>
			</ZineBox>
		</section>

		<!-- 04 // CONFIGURATION - what both halves read at runtime -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">04 // CONFIGURATION SURFACE // APHRODITE.TOML.EXAMPLE</p>
			<h2 id="config" class="mt-3 scroll-mt-24 type-section text-bone-white">
				What the crates read at runtime
			</h2>
			<p class="mt-6 max-w-[46rem] font-body text-body leading-relaxed text-bone-newsprint">
				One TOML file is read by both halves of the pair: the proxy takes its listeners and
				its flow budget from it, the dylib takes the compression thresholds and the
				previews. The shipped example carries the keys grouped the way the file groups
				them, and every value is the example's own default rather than a recommendation.
			</p>

			<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
				<div class="well p-4 sm:p-5">
					<p class="type-meta mb-4 uppercase text-zinc-dust">
						PROXY // PROXIES, DEFAULTS, FLOW
					</p>
					<div class="font-mono text-code leading-relaxed text-bone-newsprint">
						<div class="text-weathered-teal">[[proxies]]</div>
						<div>
							cache <span class="text-zinc-dust">→</span>{" "}
							<span class="text-stamped-canary">127.0.0.1:9797</span> timeout{" "}
							<span class="text-stamped-canary">120</span>
						</div>
						<div>
							token <span class="text-zinc-dust">→</span>{" "}
							<span class="text-stamped-canary">127.0.0.1:9798</span> timeout{" "}
							<span class="text-stamped-canary">300</span>
						</div>
						<div>
							tool_relay = <span class="text-stamped-canary">true</span>{" "}
							<span class="text-zinc-dust">(both)</span>
						</div>
						<div class="pt-3 text-weathered-teal">[defaults]</div>
						<div>
							api_url ={" "}
							<span class="text-stamped-canary">"https://api.openai.com"</span>
						</div>
						<div>
							ccr_ttl_seconds = <span class="text-stamped-canary">3600</span>
						</div>
						<div class="pt-3 text-weathered-teal">[flow]</div>
						<div>
							budget_chars = <span class="text-stamped-canary">2600</span>
						</div>
					</div>
				</div>

				<div class="well p-4 sm:p-5">
					<p class="type-meta mb-4 uppercase text-zinc-dust">
						ENGINE // COMPRESSION, PREVIEWS
					</p>
					<div class="font-mono text-code leading-relaxed text-bone-newsprint">
						<div class="text-weathered-teal">[compression]</div>
						<div>
							engine_threshold_pct = <span class="text-stamped-canary">30</span>
						</div>
						<div>
							tool_threshold_token = <span class="text-stamped-canary">256</span>
						</div>
						<div>
							tool_threshold_cache = <span class="text-stamped-canary">2048</span>
						</div>
						<div>
							terminal_threshold = <span class="text-stamped-canary">256</span>
						</div>
						<div>
							inline_threshold = <span class="text-stamped-canary">1024</span>
						</div>
						<div>
							code_multiplier = <span class="text-stamped-canary">1.0</span>
						</div>
						<div>
							auto_reload = <span class="text-stamped-canary">true</span>{" "}
							<span class="text-zinc-dust"># shipped default</span>
						</div>
						<div class="pt-3 text-weathered-teal">[previews]</div>
						<div>
							preview_max_chars = <span class="text-stamped-canary">0</span>
						</div>
					</div>
				</div>
			</div>

			<p class="mt-8 max-w-[46rem] border-t border-oxblood-dark pt-6 font-body text-body leading-relaxed text-zinc-dust">
				Keys without a live consumer are annotated DOCUMENTED BUT UNWIRED in the example;
				the
				<code class="font-mono text-base">[templates.*]</code> section is live configuration
				- preview families, the marker block, prompt templates and the reverse key map
				render from these format strings (hardcoded builders apply when a block is absent).
			</p>
			<p class="mt-3 max-w-[46rem] font-body text-body leading-relaxed text-zinc-dust">
				Marker grammar:
				<code class="ccr-marker font-mono text-base text-weathered-teal">
					&lt;&lt;&lt;CCR:hash|type|size&gt;&gt;&gt;
				</code>
			</p>

			<ZineSource
				Lines={[`SRC: aphrodite.toml.example; CHANGELOG.md v${Versions.ChangelogVersion}`]}
			/>
		</section>

		<!-- SLOT 4: exactly one onward link -->
		<Related
			Links={[
				{ Href: "/versions/", Label: "VERSIONS" },
				{ Href: "/setup/", Label: "SETUP" },
				{ Href: "/benchmarks/", Label: "BENCHMARKS" },
			]}
		/>
	</PageShell>
</Base>
