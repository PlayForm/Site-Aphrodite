---
import Base from "@Layout/Base.astro";

import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import Related from "@Component/Related.astro";
import SectionNav from "@Component/SectionNav.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineButton from "@Component/ZineButton.astro";
import ZineDossier from "@Component/ZineDossier.astro";
import ZineKicker from "@Component/ZineKicker.astro";
import ZineLesson from "@Component/ZineLesson.astro";
import ZinePullQuote from "@Component/ZinePullQuote.astro";
import ZineSource from "@Component/ZineSource.astro";
import ZineStamp from "@Component/ZineStamp.astro";
import ZineStatBar from "@Component/ZineStatBar.astro";
import ZineTape from "@Component/ZineTape.astro";
import { ReleaseNote, Stamps, Versions } from "@Library/Versions";

/**
 * VERSIONS - the release ledger, drawn as a telemetry sheet.
 *
 * THE SHAPE OF THE PAGE. Six chapters, each opened by the blueprint grammar's
 * own section rule and numbered tag (`.blueprint-section` + `.section-index`,
 * Global.css), and each chapter's content carried by one of three surfaces:
 *
 *   shell-card / well   The register, the stamp ledger and the changelog groups
 *                       are HAIRLINE ROWS: a 1px `--tier-shell-edge` rule per
 *                       row, mono for every identifier and every version, and
 *                       the telemetry chip (`.telemetry-tag`) for a status. A
 *                       ledger is read by scanning a column, so the columns are
 *                       what the design protects - not a border around them.
 *   tier-inverted       The current release is printed on the sand sheet: bone
 *                       ground, carbon type, oxblood ink behind it. It is the
 *                       one row in the register that is not the same as its
 *                       neighbours, and the same sheet opens the page.
 *   tier-shell          The tape's stamps and the changelog groups. Quiet
 *                       plates; the tape's two shape-changing stamps keep the
 *                       canary boundary and the heavier plane.
 *
 * WHAT DID NOT MOVE. Every sentence, figure, table row, example and key this
 * page carried, it still carries: the release register is the same thirteen
 * records, the changelog is the same eight groups with their entries verbatim,
 * the stamp ledger is the same five artifacts, and the tape is the same
 * thirteen stamps with their `Why` lines. Re-layout is not a licence to trim.
 *
 * THE EVIDENCE ACCENTS ARE IDENTITY. A changelog group's chip is its `Tone`
 * fill (canary / teal / crimson) and a stamp's fill is its `Color` (raw /
 * canary / teal / bone) - the same palette the rest of the site uses, and it
 * never moves to quieten a block. On the sand sheet the teal and canary INKS
 * are unusable (both sit within a few points of the bone ground), so the pod's
 * own labels take `--oxblood-dark` and its link takes `--raw-blood`: the
 * identity is the fill, and only the ink moves where legibility requires it.
 *
 * THE GRUNGE STAYS. Every framed surface this route draws carries
 * `data-grunge` (the ink is painted per load by Script/Grunge), and the sand
 * pod takes `grunge--oxblood` because a bone splat on a bone sheet is no splat
 * at all.
 *
 * RE-VOICING, AND WHAT IT CARRIED (the sanctioned exception: a sentence whose
 * subject is the website is restated as a statement about the software; every
 * fact survives):
 *
 *   "the review groups appear further down the page"  ->  "the review groups follow"
 *   "the register renders whatever those files say on the day the site is built"
 *                                                     ->  "the pairing published here is
 *                                                          whatever those files say on the
 *                                                          day of the build"
 *   "The tape runs top to bottom in release order"    ->  "The tape runs in release order,
 *                                                          oldest first"
 *   "The table finds a version; the tape explains why the project looks the way it does"
 *                                                     ->  "One finds a version; the other
 *                                                          explains why the project looks
 *                                                          the way it does"
 *   "Both bars share one scale"                       ->  "Both figures share one scale"
 */

/** The release-note URL for a row stamp ("v1.6.6" -> the Aphrodite/v1.6.6 tag). */
const NoteFor = (Ver: string): string =>
	ReleaseNote(Ver.startsWith("v") ? Ver.slice(1) : Ver);

// THE RELEASE REGISTER - one row per release, from the first public
// architecture (v0.7.0) to the current pairing (read from the monorepo
// primaries at build time by Library/Versions.ts). Every "what landed" line
// traces to CHANGELOG.md's release header; every release link is the GitHub
// release note. `Why` is the second line of the record: not what changed but
// what it changed for, because a version number on its own never explains why
// anyone should care. The 1.2.2 (first crates.io publish) and 1.4.6
// (chain-split CCR + the first plugin-first release) rows carry the canary
// tag, because those two changed the project's shape.
interface Release {
	Ver: string;
	Date: string;
	Pair: string;
	Landed: string;
	Why: string;
	Tag: string;
	Emphasis: boolean;
	/** The release-note tag when the row's Ver is a range (the note links at one tag). */
	Note?: string;
}
const Releases: Release[] = [
	{
		Ver: "v0.7.0",
		Date: "2026-06-17",
		Pair: "PLUGIN: PYTHON ERA (PRE-2.0)",
		Landed: "Atomization + live containers: the Python plugin split into 29 nested modules; terminal output streams instead of blocking.",
		Why: "It is the release that gave the project a shape: once the plugin is 29 modules and terminal output streams, every later port has somewhere to land, and a long command stops being a page of silence.",
		Tag: "THE FIRST ARCHITECTURE",
		Emphasis: false,
	},
	{
		Ver: "v1.2.2",
		Date: "2026-07-13",
		Pair: "PLUGIN v2.0.5",
		Landed: "First crates.io publish: aphrodite-headroom-core 0.1.1 -> aphrodite 1.2.2 -> aphrodite-hermes 1.2.2; classification re-measured at 40-123 ns.",
		Why: "Publishing is what turned a private tool into an install: the three crates resolve from crates.io in dependency order, and 40-123 ns is the first classification figure the project could point at instead of assert.",
		Tag: "FIRST CRATES.IO",
		Emphasis: true,
	},
	{
		Ver: "v1.3.2 -> v1.3.4",
		Note: "v1.3.4",
		Date: "2026-07-14",
		Pair: "PLUGIN v2.0.x",
		Landed: "Rust maturity: the losslessness sweep (hash the ORIGINAL, never the wrapper) and the lossy-arguments fix; then high-intelligibility previews at 132× overall.",
		Why: "Hashing the ORIGINAL is the property the marker scheme rests on: hash the wrapper and the same bytes compress into two different markers, so a retrieval returns a copy that never matches the next turn.",
		Tag: "RUST MATURITY",
		Emphasis: false,
	},
	{
		Ver: "v1.4.6",
		Date: "2026-09-19",
		Pair: "PLUGIN v2.1.4",
		Landed: "Chain-split CCR + the first plugin-first release: the plugin tagged before the parent, so BINARY_VERSION 1.4.6 points at assets that already exist.",
		Why: "Two changes in one tag. Chain-split gives each segment of a chained command its own marker, so one 40 KB output becomes several small retrievals; plugin-first ordering means the pin never points at an asset the release has not uploaded yet.",
		Tag: "CHAIN-SPLIT + PLUGIN-FIRST",
		Emphasis: true,
	},
	{
		Ver: "v1.5.0",
		Date: "2026-09-20",
		Pair: "PLUGIN v2.2.0",
		Landed: "Edition-2024 + atomization: the flat src/*.rs promoted into per-item module trees; the aphrodite_debug tool lands.",
		Why: "Edition 2024 and per-item module trees are the layout the rest of the port grows into, and aphrodite_debug arrives as the tool that reads a stored entry back when a marker and its content disagree.",
		Tag: "EDITION-2024",
		Emphasis: false,
	},
	{
		Ver: "v1.5.1",
		Date: "2026-09-21",
		Pair: "PLUGIN v2.1.5",
		Landed: "Headroom fork publication 0.1.3: the fork's accumulated changes finally reach crates.io, replacing the stale July 0.1.2.",
		Why: "The fork is where the transforms live, so a stale fork on crates.io is a stale classifier in every install; 0.1.3 is the release that closed the gap between the tree and what the registry served.",
		Tag: "FORK PUBLISHED",
		Emphasis: false,
	},
	{
		Ver: "v1.6.0",
		Date: "2026-09-24",
		Pair: "PLUGIN v2.2.0",
		Landed: "Config diagnostics + opt-in auto-reload (issue #38): a broken aphrodite.toml can no longer fail silently to defaults.",
		Why: "Falling back to defaults in silence is the worst thing a config layer can do - a typo reads as a deliberate setting. Diagnostics make the file answer for itself, and auto-reload stays opt-in because a running session should not change under the operator.",
		Tag: "DIAGNOSTICS",
		Emphasis: false,
	},
	{
		Ver: "v1.6.3",
		Date: "2026-09-25",
		Pair: "PLUGIN v2.2.3",
		Landed: "One runtime home (issue #40): the shim and the Rust half resolve one shared home instead of $HERMES_HOME vs $HOME.",
		Why: "Two halves resolving two different homes is a bug that only shows on someone else's machine; one shared home retires the whole class instead of documenting a workaround for it.",
		Tag: "ONE HOME",
		Emphasis: false,
	},
	{
		Ver: "v1.6.5",
		Date: "2026-10-05",
		Pair: "PLUGIN v2.2.5",
		Landed: "Checksum law: the in-tree SHA256SUMS.txt is the only checksum source of truth; a missing file, version mismatch, or missing asset entry is a hard refusal.",
		Why: "A checksum that can be skipped is not a checksum. Making a missing file, a version mismatch and a missing asset entry each a hard refusal is what lets a download be verified rather than hoped for.",
		Tag: "CHECKSUM LAW",
		Emphasis: false,
	},
	{
		Ver: "v1.6.6",
		Date: "2026-10-07",
		Pair: "PLUGIN v2.2.6",
		Landed: "Catalog review: aphrodite_prefetch refuses .env, auth.json, ~/.ssh, the Hermes home and non-file paths; setup treats the Hermes plugin dir as report-only; the dylib arm refuses an install without in-tree checksums.",
		Why: "This is the release whose review groups follow: a prefetch that cannot read a secret, a setup that cannot write where it does not own, and a context engine described as opt-in because it is.",
		Tag: "CATALOG REVIEW",
		Emphasis: false,
	},
	{
		Ver: "v1.7.0",
		Date: "2026-10-13",
		Pair: "PLUGIN v2.3.0",
		Landed: "Feature port: TOML templates, auto-expand, the context engine, live containers, the Rhai micro-script engine, and recursion/body-size caps - plus a per-session state registry so multi-session gateways stop contending on one global lock.",
		Why: "The Python era's behaviour arrives in Rust in one tag, and the shared-gateway lock wedge goes with it: a parent and its subagents no longer serialise on one state lock, and a debug build can log the path it took.",
		Tag: "FEATURE PORT",
		Emphasis: false,
	},
	{
		Ver: "v1.8.0",
		Date: "2026-11-08",
		Pair: "PLUGIN v2.3.1",
		Landed:
			"Bounded CCR store: store_max_entries / store_max_bytes evict the least-recently-accessed rows past either cap, the expiry sweep turns debounced and index-driven (a missing-hash retrieve went 37.40 ms -> 0.22 ms on a 300k-row store), and fill_pct is relabelled as compression headroom; aphrodite-headroom-core 0.2.0 carries the fork-side store limits.",
		Why: "Retention is the difference between a store that grows until the disk complains and one an operator can budget: two caps, one eviction rule, and a sweep that no longer runs on every single retrieve.",
		Tag: "BOUNDED STORE",
		Emphasis: false,
	},
	{
		Ver: `v${Versions.Binary}`,
		Date: Versions.ChangelogDate,
		Pair: `PLUGIN v${Versions.Plugin}`,
		Landed:
			"Docs catch up to the engine: the docs tree stops pinning a version it does not own, preview and directive truncation markers go ASCII, and aphrodite_debug is gated at compile time instead of stripped by hand at staging.",
		Why: "A release can be small and still change behaviour: the truncation marker now costs one byte instead of three, and the release profile registers exactly the 13 production tools because the compiler says so - not because a staging script remembered to delete one.",
		Tag: "CURRENT PAIRING",
		Emphasis: false,
	},
];

/** THE REGISTER'S ROWS, with the status each one prints.
 *
 *  `Releases` is ordered oldest-first and its FINAL entry is the one built from
 *  the monorepo's manifests (Library/Versions), so the last row is the current
 *  pairing by construction - not by a typed version that could drift. That row
 *  is the one printed on the sand sheet, the same identity the page's opening
 *  pod carries, so a reader scanning the register can see which line the page
 *  is about.
 *
 *  The status is derived from the flag the canary tag already encodes: the two
 *  releases that changed the project's shape are `Emphasis`, everything else is
 *  an ordinary release, and the last one is current. Nothing here is a new
 *  claim - it is the sentence under the table ("THE CANARY TAGS MARK THE TWO
 *  RELEASES THAT CHANGED THE PROJECT'S SHAPE") given a column to live in. */
const CurrentIndex = Releases.length - 1;
const Register = Releases.map((Entry, Index) => ({
	...Entry,
	Current: Index === CurrentIndex,
	Status: Entry.Emphasis
		? "SHAPE CHANGE"
		: Index === CurrentIndex
			? "CURRENT"
			: "RELEASE",
}));

// THE CHANGELOG - the current release's own entries, one block per group, with
// the group labels the CHANGELOG.md subsections carry. `Why` is the line the
// changelog itself implies but never states: what the group was for.
interface Change {
	Label: string;
	Tone: "canary" | "teal" | "dust";
	Intro?: string;
	Lines: string[];
	Why?: string;
}
const CurrentChanges: Change[] = [
	{
		Label: "FIX // DEPENDENCY SECURITY",
		Tone: "canary",
		Why: "The vendored fork is where SQLite actually lives, so the advisory has to close there and not in the parent crate that never sees it.",
		Lines: [
			"- rusqlite 0.40.2 -> 0.41 in the owned headroom fork; bundled SQLite 3.54.1; closes RUSTSEC-2026-0459",
			"- no API reaches the parent: CcrStore, SqliteCcrStore and the retention surface are unchanged",
			"- rustls 0.23.46 / rustls-webpki 0.103.17 / webpki-roots 1.0.12 resolve without constraint changes",
		],
	},
	{
		Label: "FIX // TOOL CATALOG",
		Tone: "teal",
		Why: "A staging step that removes a tool by hand is a step that can be forgotten; a cfg gate is enforced by the compiler on every build, in every profile.",
		Lines: [
			"- aphrodite_debug sits behind #[cfg(debug_assertions)] in schemas.rs, tools.rs and debug.rs",
			"- cargo build --release registers exactly the 13 declared production tools; a debug build registers 14",
			"- hermes plugins validate rule 6 holds for a release dylib without touching the tree",
		],
	},
	{
		Label: "CHORE // TRUNCATION",
		Tone: "dust",
		Why: "ASCII is one byte where U+2026 is three, and the cap arithmetic has to agree with what it emits or the marker overruns the budget it was sized for.",
		Lines: [
			"- U+2026 -> ... in the preview builders, the directive builders and loader, and the default marker hint",
			"- apply_preview_cap takes max_chars - 4 and appends ...] so the closing bracket still fits",
			"- the directive cap keeps MAX_DIRECTIVE_CHARS + 3 and MAX_COMBINED_CHARS + 4",
		],
	},
	{
		Label: "DOCS // README + TREE",
		Tone: "teal",
		Why: "A docs tree that pins a version it does not own drifts on the next release; pointing at the manifests makes it self-correcting instead of re-edited.",
		Lines: [
			"- README gains LLM provider configuration, Verify it's running, See It Work, session lifecycle, directives",
			"- docs/README.md and docs/architecture/README.md stop pinning a binary/plugin version",
			"- retention documented in sqlite, prometheus, lifecycle and aphrodite.toml.example",
		],
	},
	{
		Label: "CHORE // PLUGIN TRACK",
		Tone: "dust",
		Why: "Three commits landed past v2.3.1 with no tag, so the plugin version advances to match the binary it ships beside.",
		Lines: [
			"- plugin.yaml 2.3.1 -> 2.3.2 with its install_message header and the plugin README badge",
			"- BINARY_VERSION 1.8.1, and the in-tree SHA256SUMS.txt regenerated to match",
		],
	},
];

// THE PRIOR CHANGELOG - the catalog review's groups, kept because they are the
// release this page's register first documented. The label is pinned to its own
// version: a changelog group belongs to the release that shipped it, never to
// whatever the head happens to be today.
const PriorChanges: Change[] = [
	{
		Label: "CATALOG REVIEW",
		Tone: "canary",
		Intro: "Catalog review: prefetch path guard, setup hardening, opt-in context engine.",
		Lines: [
			"- fix: aphrodite_prefetch refuses .env, auth.json, ~/.ssh, Hermes home, non-file paths",
			"- fix: aphrodite setup treats Hermes-home plugin dir as report-only",
			"- fix: dylib arm refuses install when in-tree SHA256SUMS.txt is missing",
		],
	},
	{
		Label: "FEATURES",
		Tone: "teal",
		Lines: [
			"+ context engine opt-in at registration: APHRODITE_CONTEXT_ENGINE=1 (TOML default true)",
			"+ non-destructive: should_compress always False; transcript unchanged",
			"+ pre_tool_call behavior disclosed: auto-backgrounds long terminal commands",
			"+ requires_hermes: >=0.20.2",
		],
	},
	{
		Label: "CHORE + DOCS",
		Tone: "dust",
		Lines: [
			"- config 1:1 audit: dead [templates.*] subtree and compression.prefetch removed",
			"- chain_split_min/max_segments and defaults.api_url/model added; unwired keys annotated",
			"- 21 doc files fixed; version stamps 1.6.5 → 1.6.6",
		],
	},
];

const ToneText = {
	canary: "text-stamped-canary",
	teal: "text-weathered-teal",
	dust: "text-zinc-dust",
};

/** The group label chip's fill, one per changelog tone. Teal takes DARK ink -
 *  bone-white on weathered-teal is 3.06:1 at 16px, soot-black is 5.36:1 (the
 *  measurement ZineStamp records). The fill is the identity; only the ink moves.
 *
 *  This stays the measured 16px stamp chip: a changelog group is a heading, not
 *  a micro-label, and its fill is what says which tone of change the group
 *  carries. The register's status chips use the 11.5px telemetry voice instead,
 *  because a status is a micro-label. */
const ToneStamp = {
	canary: "bg-stamped-canary text-soot-black",
	teal: "bg-weathered-teal text-soot-black",
	dust: "bg-raw-blood text-bone-white",
};

// THE FIVE STAMPS - one row per artifact, with the file that owns it and the
// value that file currently carries. Nothing is typed by hand: the register
// carries whatever the manifests say on the day of the build, which is why a
// release that forgets to bump one of them surfaces as a disagreement rather
// than as a stale figure.
const Artifacts = [
	{ Artifact: "binary", Source: "crates/aphrodite/Cargo.toml", Stamp: `v${Versions.Binary}` },
	{
		Artifact: "integration crate",
		Source: "crates/aphrodite-hermes/Cargo.toml",
		Stamp: `v${Versions.Hermes}`,
	},
	{ Artifact: "plugin spec", Source: "plugins/aphrodite/plugin.yaml", Stamp: `v${Versions.Plugin}` },
	{
		Artifact: "download pin",
		Source: "plugins/aphrodite/BINARY_VERSION",
		Stamp: `v${Versions.BinaryVersionFile}`,
	},
	{
		Artifact: "headroom fork",
		Source: "vendor/headroom/crates/headroom-core",
		Stamp: `v${Versions.Headroom}`,
	},
];

// The page's own sections, in document order - SectionNav renders exactly these,
// so an entry can never name a section this page does not have.
const Sections = [
	{ Id: "current", Label: "CURRENT" },
	{ Id: "contract", Label: "CONTRACT" },
	{ Id: "changelog", Label: "CHANGELOG" },
	{ Id: "register", Label: "REGISTER" },
	{ Id: "tape", Label: "TAPE" },
	{ Id: "numbers", Label: "NUMBERS" },
];

/** The perforation spine: six holes, sized by whether the stamp is enlarged. */
const Holes = [0, 1, 2, 3, 4, 5];
---

<Base
	Title="VERSIONS // APHRODITE"
	Description={`Aphrodite v${Versions.Binary}, plugin v${Versions.Plugin} (${Versions.ChangelogDate}). The shipped pairing, how a pairing is cut, the current changelog, the full release register, and pointers to the benchmarks.`}
>
	<PageShell Rhythm="wide">
		<PageHeader
			Tape="VERSIONS // RELEASE LOG"
			Title="Versions"
			Lead={[
				`A tool call's output becomes part of the model's context, and every release in this log changes what of it Aphrodite keeps.`,
				`Current release: binary <strong>${Stamps.Binary()}</strong>, plugin <strong>${Stamps.Plugin()}</strong> (v${Versions.Binary}, ${Versions.ChangelogDate}).`,
				`Requires Rust 1.88+.`,
				`Licensed CC0-1.0.`,
				"Every stamp is read from the monorepo's own manifests at build time, so the register cannot claim a version the tree does not carry.",
			]}
		/>

		<SectionNav Sections={Sections} />

		<!-- ============ 01 // CURRENT - the shipped pairing, printed ============ -->
		<section id="current" class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">01 // MONUMENT // THE SHIPPED PAIRING</p>
			<h2 class="mt-3 type-section text-bone-white">The pairing that ships today</h2>

			{/* THE SAND POD. The current release is the one record that is not a row
			    among rows, so it is printed rather than framed: the inverted tier is a
			    bone sheet with carbon type, and the ink behind it is oxblood
			    (`grunge--oxblood`) because a bone splat on a bone sheet is no splat at
			    all. The plugin half sits in a `well` - a dark readout recessed into the
			    printed sheet - because the two numbers are two halves of one release,
			    and the sheet is what says they travel together. */}
			<div
				class="grunge grunge--oxblood tier-inverted relative mt-8 border-4 border-blood-crimson p-6 shadow-[8px_8px_0px_#000] sm:p-10"
				data-grunge
				data-grunge-mode="scatter"
			>
				<ZineTape Variant="corner" Label="CURRENT // SHIPPED" Color="canary" Side="right" />
				<div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
					<div class="min-w-0">
						<p class="type-meta font-bold uppercase text-oxblood-dark">BINARY RELEASE</p>
						{/* `.metric` declares the bone ink the giant figure wears on a dark
						    plate; on the sand sheet it takes the sheet's own ink. The value is
						    a token, never a hex: this is the one place where the figure and its
						    ground are both inverted. */}
						<p class="metric mt-2" style="color: var(--tier-inverted-ink)">
							{Stamps.Binary()}
						</p>
					</div>
					<div class="well min-w-0 p-5 sm:p-6">
						<p class="type-meta font-bold uppercase text-zinc-dust">HERMES PLUGIN</p>
						<p
							class="mt-2 font-headline text-3xl font-black tracking-tighter text-bone-white sm:text-5xl"
						>
							{Stamps.Plugin()}
						</p>
						<p class="mt-2 font-mono text-meta font-bold uppercase text-stamped-canary">
							{Versions.ChangelogDate}
						</p>
					</div>
				</div>
			</div>

			<div class="prose-flow mt-10 max-w-[46rem]">
				<p class="type-body text-bone-newsprint">Two numbers, one release:</p>
				<ul class="space-y-2 type-body text-bone-newsprint">
					<li class="border-l-4 border-raw-blood pl-4">
						the binary carries the proxy, the CCR store and the dylib the shim loads
					</li>
					<li class="border-l-4 border-raw-blood pl-4">
						the plugin spec carries the hook names, the tool schemas and the version floor
						the dylib needs from Hermes.
					</li>
				</ul>
				<p class="type-body text-bone-newsprint">
					They are released as a pair on purpose. A plugin that loads a dylib older than its
					own schemas registers tools that do not exist, so the two versions travel together
					and the changelog head declares the pairing in its first lines.
				</p>
			</div>
			<p class="mt-8 border-t border-oxblood-dark pt-4 font-mono text-caption text-zinc-dust">
				{`SRC: CHANGELOG.md v${Versions.ChangelogVersion} head; crates/aphrodite/Cargo.toml; plugins/aphrodite/plugin.yaml`}
			</p>

			{/* THE STAMP LEDGER. A sub-chapter, not a chapter: the quiet eyebrow and a
			    `sub` head, so the section rule above stays the only chapter signal. */}
			<p class="section-kicker mt-16">STAMPS // WHAT EACH NUMBER IS READ FROM</p>
			<h3 id="stamps" class="mt-2 type-sub text-bone-white">Five artifacts, five sources</h3>
			<p class="mt-4 max-w-[46rem] type-body text-bone-newsprint">
				Nothing is typed by hand. Each stamp is read from the file that owns it, and the
				pairing published here is whatever those files say on the day of the build - which
