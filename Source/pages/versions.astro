---
import Base from "@Layout/Base.astro";

import Breadcrumbs from "@Component/Breadcrumbs.astro";
import Related from "@Component/Related.astro";
import { ReleaseNote, Stamps, Versions } from "@Library/Versions";

/** The release-note URL for a tape stamp ("v1.6.6" -> the Aphrodite/v1.6.6 tag). */
const NoteFor = (Ver: string): string =>
	ReleaseNote(Ver.startsWith("v") ? Ver.slice(1) : Ver);

// THE TIMELINE TAPE - one tape strip per release stamp, from the first public
// architecture (v0.7.0) to the current pairing (read from the monorepo
// primaries at build time by Library/Versions.ts). Every
// "what landed" line traces to CHANGELOG.md's release header; every release
// link is the GitHub release note. The 1.2.2 (first crates.io publish) and
// 1.4.6 (chain-split CCR + the first plugin-first release) stamps get the
// enlarged perforation treatment.
interface TapeStamp {
	Ver: string;
	Date: string;
	Pair: string;
	Landed: string;
	Tag: string;
	Enlarged: boolean;
	/** The release-note tag when the stamp's Ver is a range (the note links at one tag). */
	Note?: string;
}
const Tape: TapeStamp[] = [
	{
		Ver: "v0.7.0",
		Date: "2026-06-17",
		Pair: "PLUGIN: PYTHON ERA (PRE-2.0)",
		Landed: "Atomization + live containers: the Python plugin split into 29 nested modules; terminal output streams instead of blocking.",
		Tag: "THE FIRST ARCHITECTURE",
		Enlarged: false,
	},
	{
		Ver: "v1.2.2",
		Date: "2026-07-13",
		Pair: "PLUGIN v2.0.6",
		Landed: "First crates.io publish: aphrodite-headroom-core 0.1.1 -> aphrodite 1.2.2 -> aphrodite-hermes 1.2.2; classification re-measured at 40-123 ns.",
		Tag: "FIRST CRATES.IO",
		Enlarged: true,
	},
	{
		Ver: "v1.3.2 -> v1.3.4",
		Note: "v1.3.4",
		Date: "2026-07-14",
		Pair: "PLUGIN v2.0.x",
		Landed: "Rust maturity: the losslessness sweep (hash the ORIGINAL, never the wrapper) and the lossy-arguments fix; then high-intelligibility previews at 132× overall.",
		Tag: "RUST MATURITY",
		Enlarged: false,
	},
	{
		Ver: "v1.4.6",
		Date: "2026-09-19",
		Pair: "PLUGIN v2.1.4",
		Landed: "Chain-split CCR + the first plugin-first release: the plugin tagged before the parent, so BINARY_VERSION 1.4.6 points at assets that already exist.",
		Tag: "CHAIN-SPLIT + PLUGIN-FIRST",
		Enlarged: true,
	},
	{
		Ver: "v1.5.0",
		Date: "2026-09-20",
		Pair: "PLUGIN v2.2.0",
		Landed: "Edition-2024 + atomization: the flat src/*.rs promoted into per-item module trees; the aphrodite_debug tool lands.",
		Tag: "EDITION-2024",
		Enlarged: false,
	},
	{
		Ver: "v1.5.1",
		Date: "2026-09-21",
		Pair: "PLUGIN v2.1.5",
		Landed: "Headroom fork publication 0.1.3: the fork's accumulated changes finally reach crates.io, replacing the stale July 0.1.2.",
		Tag: "FORK PUBLISHED",
		Enlarged: false,
	},
	{
		Ver: "v1.6.0",
		Date: "2026-09-24",
		Pair: "PLUGIN v2.2.0",
		Landed: "Config diagnostics + opt-in auto-reload (issue #38): a broken aphrodite.toml can no longer fail silently to defaults.",
		Tag: "DIAGNOSTICS",
		Enlarged: false,
	},
	{
		Ver: "v1.6.3",
		Date: "2026-09-25",
		Pair: "PLUGIN v2.2.3",
		Landed: "One runtime home (issue #40): the shim and the Rust half resolve one shared home instead of $HERMES_HOME vs $HOME.",
		Tag: "ONE HOME",
		Enlarged: false,
	},
	{
		Ver: "v1.6.5",
		Date: "2026-10-05",
		Pair: "PLUGIN v2.2.5",
		Landed: "Checksum law: the in-tree SHA256SUMS.txt is the only checksum source of truth; a missing file, version mismatch, or missing asset entry is a hard refusal.",
		Tag: "CHECKSUM LAW",
		Enlarged: false,
	},
	{
		Ver: `v${Versions.Binary}`,
		Date: Versions.ChangelogDate,
		Pair: `PLUGIN v${Versions.Plugin}`,
		Landed: "Path guards: aphrodite_prefetch refuses .env, auth.json, ~/.ssh, the Hermes home, and non-file paths outright; the context engine is re-described as opt-in.",
		Tag: "CURRENT PAIRING",
		Enlarged: false,
	},
];
---

<Base
	Title="VERSIONS // APHRODITE"
	Description={`Aphrodite v${Versions.Binary}, plugin v${Versions.Plugin} (${Versions.ChangelogDate}). The current release, its changelog, and pointers to the full benchmarks.`}
>
	<main
		class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-24 px-5 py-32 sm:px-8 lg:gap-40 lg:px-14 lg:py-56"
	>
		<Breadcrumbs />
		<header class="relative flex w-full flex-col items-start">
			<div
				class="mb-5 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				VERSIONS // RELEASE LOG
			</div>
			<h1
				class="font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-5xl"
			>
				Versions
			</h1>
			<p class="mt-6 max-w-3xl font-body text-sm leading-relaxed text-bone-newsprint">
				Current release: binary <strong>{Stamps.Binary()}</strong>, plugin <strong>{Stamps.Plugin()}</strong>
				({`v${Versions.Binary}`}, {Versions.ChangelogDate}). Requires Rust 1.88+. Licensed CC0-1.0.
				<span class="mt-1 block text-[9px] text-zinc-dust">SRC: README.md:12; CHANGELOG.md v{Versions.ChangelogVersion}</span>
			</p>
		</header>

		<!-- MONUMENT: CURRENT RELEASE -->
		<section class="relative w-full rotate-[0.6deg] transition-transform duration-300 hover:rotate-0">
			<div
				class="absolute -top-4 right-10 z-20 border border-black bg-stamped-canary px-4 py-1 text-[11px] font-black uppercase tracking-widest text-soot-black shadow-[3px_3px_0px_#000]"
			>
				CURRENT // SHIPPED
			</div>
			<div
				class="zine-box-crimson relative overflow-hidden border-4 border-blood-crimson bg-carbon-void p-6 sm:p-10"
			>
				<div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
					<div>
						<div class="text-[11px] font-black uppercase tracking-widest text-raw-blood">
							BINARY RELEASE
						</div>
						<div
							class="font-headline text-5xl font-black tracking-tighter text-bone-white drop-shadow-[3px_3px_0px_#520612] sm:text-7xl"
						>
							{Stamps.Binary()}
						</div>
					</div>
					<div class="zine-box-subtle w-full border-[3px] border-raw-blood bg-soot-black p-5 lg:w-auto">
						<div class="text-[10px] font-black uppercase tracking-widest text-zinc-dust">
							HERMES PLUGIN
						</div>
						<div class="font-headline text-3xl font-black tracking-tighter text-bone-white sm:text-5xl">
							{Stamps.Plugin()}
						</div>
						<div class="mt-1 text-xs font-bold text-stamped-canary">{Versions.ChangelogDate}</div>
					</div>
				</div>
				<div class="mt-8 border-t border-oxblood-dark pt-4 text-[9px] text-zinc-dust">
					SRC: CHANGELOG.md v{Versions.ChangelogVersion} ("{Versions.ChangelogPairing}")
				</div>
			</div>
		</section>

		<!-- CHANGELOG AS TELEMETRY ROWS -->
		<section class="relative w-full">
			<div
				class="mb-5 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				{`CHANGELOG // V${Versions.ChangelogVersion}`}
			</div>
			<div class="flex flex-col gap-6">
				<div
					class="zine-box-subtle relative -rotate-[1.5deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-8"
				>
					<div
						class="absolute -top-3.5 left-6 border border-black bg-raw-blood px-3 py-0.5 text-[10px] font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
					>
						CATALOG REVIEW
					</div>
					<p class="mt-2 font-body text-sm text-bone-newsprint">
						Catalog review: prefetch path guard, setup hardening, opt-in context engine.
					</p>
					<div class="mt-4 space-y-1 border border-oxblood-dark bg-soot-black p-3.5 font-mono text-[12px] text-zinc-dust">
						<div class="text-raw-blood">- fix: aphrodite_prefetch refuses .env, auth.json, ~/.ssh, Hermes home, non-file paths</div>
						<div class="text-raw-blood">- fix: aphrodite setup treats Hermes-home plugin dir as report-only</div>
						<div class="text-raw-blood">- fix: dylib arm refuses install when in-tree SHA256SUMS.txt is missing</div>
					</div>
				</div>
				<div
					class="zine-box-subtle relative rotate-[1.8deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-8 lg:-mt-2"
				>
					<div
						class="absolute -top-3.5 right-6 border border-black bg-stamped-canary px-3 py-0.5 text-[10px] font-black uppercase tracking-widest text-soot-black shadow-[2px_2px_0px_#000]"
					>
						FEATURES
					</div>
					<div class="mt-2 space-y-1 border border-oxblood-dark bg-soot-black p-3.5 font-mono text-[12px] text-zinc-dust">
						<div class="text-weathered-teal">+ context engine opt-in at registration: APHRODITE_CONTEXT_ENGINE=1 (TOML default true)</div>
						<div class="text-weathered-teal">+ non-destructive: should_compress always False; transcript unchanged</div>
						<div class="text-weathered-teal">+ pre_tool_call behavior disclosed: auto-backgrounds long terminal commands</div>
						<div class="text-weathered-teal">+ requires_hermes: &gt;=0.20.2</div>
					</div>
				</div>
				<div
					class="zine-box-subtle relative -rotate-[1.2deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-8"
				>
					<div
						class="absolute -top-3.5 left-6 border border-black bg-weathered-teal px-3 py-0.5 text-[10px] font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
					>
						CHORE + DOCS
					</div>
					<div class="mt-2 space-y-1 border border-oxblood-dark bg-soot-black p-3.5 font-mono text-[12px] text-zinc-dust">
						<div>- config 1:1 audit: dead [templates.*] subtree and compression.prefetch removed</div>
						<div>- chain_split_min/max_segments and defaults.api_url/model added; unwired keys annotated</div>
						<div>- 21 doc files fixed; version stamps 1.6.5 → 1.6.6</div>
					</div>
				</div>
			</div>
			<p class="mt-4 text-[9px] text-zinc-dust">SRC: CHANGELOG.md v{Versions.ChangelogVersion}</p>
		</section>

		<!-- THE TIMELINE TAPE: one strip per release stamp -->
		<section class="relative w-full">
			<div
				class="mb-10 -rotate-1 border border-black bg-stamped-canary px-3 py-1 text-[11px] font-black uppercase tracking-widest text-soot-black shadow-[3px_3px_0px_#000]"
			>
				{`TIMELINE TAPE // v0.7.0 -> v${Versions.Binary}`}
			</div>
			<p class="mb-20 max-w-3xl font-body text-sm leading-relaxed text-bone-newsprint">
				Each strip is one release stamp: the binary and the plugin version it paired,
				the one-line "what landed", and the release note. The tape runs top to bottom
				in release order - the enlarged perforations mark the two stamps that changed
				the project's shape (the first crates.io publish, the chain-split CCR).
			</p>
			<div class="flex flex-col gap-16">
				{
					Tape.map(({ Ver, Date, Pair, Landed, Tag, Enlarged, Note }) => (
						<article
							class={`relative flex items-stretch gap-6 ${
								Enlarged
									? "border-4 border-stamped-canary bg-carbon-void p-8 shadow-[6px_6px_0px_#000]"
									: "border-2 border-oxblood-dark bg-carbon-void p-6 shadow-[4px_4px_0px_#000]"
							} transition-transform duration-300 hover:rotate-0 ${
								Enlarged ? "-rotate-[0.6deg]" : "rotate-[0.3deg]"
							}`}
						>
							{/* Perforation spine */}
							<div
								aria-hidden="true"
								class={`flex w-10 shrink-0 flex-col items-center justify-center gap-3 border-r-2 border-dashed border-oxblood-dark pr-4 ${
									Enlarged ? "text-stamped-canary" : "text-zinc-dust"
								}`}
							>
								<span class={`h-2.5 w-2.5 rounded-full bg-current ${Enlarged ? "" : "opacity-60"}`} />
								<span class={`h-2.5 w-2.5 rounded-full bg-current ${Enlarged ? "" : "opacity-60"}`} />
								<span class={`h-2.5 w-2.5 rounded-full bg-current ${Enlarged ? "" : "opacity-60"}`} />
							</div>
							<div class="flex min-w-0 flex-1 flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-8">
								<div class="shrink-0">
									<div class="text-[10px] font-black uppercase tracking-widest text-zinc-dust">
										{Date}
									</div>
									<div
										class={`font-headline font-black tracking-tighter text-bone-white ${
											Enlarged
												? "text-4xl sm:text-5xl"
												: "text-2xl sm:text-3xl"
										}`}
									>
										{Ver}
									</div>
								</div>
								<div class="min-w-0 flex-1">
									<div class="flex flex-wrap items-center gap-3">
										<span class="border border-black bg-raw-blood px-2 py-0.5 font-mono text-[10px] font-black uppercase tracking-widest text-bone-white">
											{Pair}
										</span>
										<span
											class={`font-mono text-[10px] font-bold uppercase tracking-widest ${
												Enlarged ? "text-stamped-canary" : "text-weathered-teal"
											}`}
										>
											{Tag}
										</span>
									</div>
									<p class="mt-3 max-w-2xl font-body text-sm leading-relaxed text-bone-newsprint">
										{Landed}
									</p>
								</div>
								<a
									class="shrink-0 border border-black bg-soot-black px-3 py-2 font-mono text-[10px] font-black uppercase tracking-widest text-weathered-teal shadow-[3px_3px_0px_#000] transition-colors hover:bg-raw-blood hover:text-bone-white"
									href={NoteFor(Note ?? Ver)}
								>
									RELEASE NOTE ↗
								</a>
							</div>
						</article>
					))
				}
			</div>
			<p class="mt-10 text-[9px] text-zinc-dust">
				SRC: CHANGELOG.md release headers (v0.7.0:1101, v1.2.2:948, v1.3.2:659, v1.3.4:606, v1.5.0:200, v1.5.1:191, v1.6.0:175, v1.6.3:104, v1.6.5:39, v1.6.6:3) + the GitHub release notes (Aphrodite/v*, incl. v1.4.6's chain-split + plugin-first note)
			</p>
		</section>

		<!-- BENCHMARKS POINTER -->
		<section class="relative w-full lg:w-6/12 lg:self-end lg:-mt-4">
			<div
				class="zine-box-crimson relative -rotate-[2.5deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-8"
			>
				<div
					class="absolute -top-3.5 right-6 border border-black bg-raw-blood px-3 py-0.5 text-[10px] font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
				>
					POINTER
				</div>
				<h2 class="mt-2 mb-3 font-headline text-lg font-black uppercase text-bone-white">
					Full numbers
				</h2>
				<p class="font-body text-sm text-bone-newsprint">
					The complete telemetry - 610&times;/132&times;, 8-40 ms, the per-type bars, and the
					200-session study - lives on the benchmarks page.
				</p>
				<a
					class="mt-4 inline-block border border-black bg-raw-blood px-4 py-2 font-mono text-xs font-black uppercase text-bone-white shadow-[3px_3px_0px_#000] transition-colors hover:bg-blood-crimson active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
					href="/benchmarks/"
				>
					OPEN BENCHMARKS
				</a>
			</div>
		</section>

		<!-- RELATED: the natural neighbors -->
		<Related
			Links={[
				{ Href: "/crates/", Label: "CRATES" },
				{ Href: "/benchmarks/", Label: "BENCHMARKS" },
				{ Href: "/setup/", Label: "SETUP" },
			]}
		/>
	</main>
</Base>
