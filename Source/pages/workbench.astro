---
import Base from "@Layout/Base.astro";

import PageShell from "@Component/PageShell.astro";
import Related from "@Component/Related.astro";
import SectionNav from "@Component/SectionNav.astro";
import ZineDiagramNav from "@Component/ZineDiagramNav.astro";
import ZineKicker from "@Component/ZineKicker.astro";
import ZinePipeline from "@Component/ZinePipeline.astro";
import ZineSource from "@Component/ZineSource.astro";
import DualListener from "../Content/Mermaid/dual-listener.svg?raw";
import ConfigResolution from "../Content/Mermaid/config-resolution.svg?raw";

import { DocsRoute, Routes } from "@Library/Links";

// The pipeline's home. The four steps themselves - the classifier, the preview
// shapes, the digest, the decision - live in Script/Pipeline.ts and render
// through Component/ZinePipeline.astro, so this page keeps only its own
// subject: the knobs, the two topology diagrams, the measured arc, and the
// simulation boundary. The SANITIZATION law holds: the samples are synthetic,
// generated for the demo - never real session content, no user-home paths.

// The page's own section list - SectionNav's only input, which is what keeps
// the index truthful: a link can never name a section this page does not render.
//
// BOUNDARY comes first on purpose. The page used to open with "The pipeline,
// live" and put the simulation boundary at the bottom, after hashes, byte
// counts and storage states had already established realism - a reader had
// every reason to believe the numbers before being told what they were. The
// instrument states what it is first, then demonstrates.
const Sections = [
	{ Id: "boundary", Label: "BOUNDARY" },
	{ Id: "pipeline", Label: "PIPELINE" },
	{ Id: "knobs", Label: "KNOBS" },
	{ Id: "states", Label: "STATES" },
	{ Id: "topology", Label: "TOPOLOGY" },
	{ Id: "arc", Label: "THE ARC" },
];

// The four proxy thresholds. The Defaults are the shipped [compression] values
// from crates/aphrodite/templates/aphrodite.toml - a slider that shows anything
// else is drift, because the engine reads the toml. These four are the ones the
// running engine swaps as atomics, which is why they are the ones a reader can
// turn here.
const Knobs = [
	{
		Key: "tool_threshold_token",
		Min: 64,
		Max: 4096,
		Step: 64,
		Default: 256,
		Unit: "B",
		Note: "token proxy threshold (bytes)",
		Line: "The token proxy measured every tool result against this limit: a result over it was compressed into a marker, a result under it stayed in the transcript as it arrived.",
	},
	{
		Key: "tool_threshold_cache",
		Min: 256,
		Max: 16384,
		Step: 256,
		Default: 2048,
		Unit: "B",
		Note: "cache proxy threshold (bytes)",
		Line: "The cache proxy answered on its own port with its own limit, which is what let one binary tune the two lanes independently.",
	},
	{
		Key: "inline_threshold",
		Min: 256,
		Max: 16384,
		Step: 256,
		Default: 1024,
		Unit: "B",
		Note: "inline-vs-durable CCR storage cutoff",
		Line: "This is a storage cutoff, not a compression one: under it a stored blob lived inline in the session, over it the blob went to durable CCR.",
	},
	{
		Key: "code_multiplier",
		Min: 1,
		Max: 8,
		Step: 0.5,
		Default: 1,
		Unit: "x",
		Note: "threshold multiplier for code_* types",
		Line: "Code types multiplied the token limit by this factor, and the effect the config doc names is that code stayed inline while prose of the same size was compressed (docs/config/aphrodite-toml.md:159).",
	},
] as const;

// The engine knob is a COMPACTION control, and compaction is not modelled on
// this page: the simulator holds one blob and no session, so there are no
// middle turns to archive. It is documented here rather than rendered as a
// slider, because a slider that changed nothing would be the same class of
// dishonesty as a fabricated timing - and because wiring it into the
// compression readout is exactly what made the old page contradict itself
// ("compressed" in the verdict, "engine OFF, raw passes through" beside it).
const Compaction = {
	Key: "engine_threshold_pct",
	Default: 30,
	Unit: "%",
	Note: "100+ = engine-off escape hatch",
	Line: "The context engine's fill percentage: middle turns were archived to CCR once the session passed it, 0 meant never, and 100+ switched the engine off (README.md:580).",
	Why: "It is a compaction knob, not a compression one. The four proxy thresholds keep working whatever it is set to, which is why the engine standing down never turned the pipeline off - the two dimensions are separate, and only one of them is measurable without a session.",
} as const;

// The three states the site names, restored from this page's own baseline
// (820fae84) because they are the vocabulary the rest of the site uses. Each
// record carries the label the readout prints, the condition that produced it,
// what the agent ends up holding, and the line that explains it - a label with
// no explanation is a state a reader cannot act on.
//
// The first two are COMPRESSION states and the readout above prints them. The
// third is a COMPACTION state: it describes the context engine standing down,
// which is a different dimension from the proxy thresholds and is not modelled
// by this page's simulator. It stays here because a reader who meets
// engine_threshold_pct anywhere else needs the vocabulary, and its note says
// exactly which dimension it belongs to.
const States = [
	{
		Label: "below threshold, kept inline",
		When: "bytes <= tool_threshold_token (x code_multiplier for code_* types)",
		Holds: "the bytes themselves - nothing to resolve",
		Note: [
			"The sample never crossed the token limit, so the classifier typed it and the preview line was built, but nothing was hashed and no marker was minted.",
			"The bytes stayed in the transcript, which is why this state costs the turn nothing: the agent already reads what it would otherwise have to retrieve.",
		],
	},
	{
		Label: "preview enough, marker stored",
		When: "bytes > tool_threshold_token (x code_multiplier for code_* types)",
		Holds: "the preview line, the address and the marker",
		Note: [
			"The sample crossed the limit, so the digest hashed the original bytes and the marker was stored under that hash.",
			"The preview line answered the question, so the agent reasoned on the preview and left the marker as a receipt rather than a debt.",
		],
	},
	{
		Label: "engine OFF - the 100+ escape hatch, nothing archived mid-session",
		When: "engine_threshold_pct >= 100",
		Holds: "the raw turn, un-archived by the engine - the proxy thresholds still compress tool output",
		Note: [
			"Past 100 the context engine stood down: no middle turn was archived mid-session and nothing was marked by it.",
			"The four proxy thresholds kept working on their own, so tool output was still compressed - the knob switches off one engine, not the pipeline.",
			"This is a compaction state, not a compression one, which is why the readout never prints it: the two dimensions answer different questions, and conflating them is a contradiction.",
		],
	},
] as const;

// The two topology diagrams the page's subject needs: the store's dual
// listener, and the config surface that feeds it. Each carries its own prose
// because a figure without the sentence explaining it is a panel that says
// nothing - the reader gets the shape AND the reading of it.
const Diagrams = [
	{
		Id: "dual-listener",
		Caption: "M5 // DUAL LISTENER",
		Svg: DualListener,
		Note: [
			"One binary serves both lanes: the cache listener answers on :9797 from a 10K-entry DashMap for content over 8 KB, and the token listener answers on :9798 from SQLite for content over 1 KB plus the tool relay.",
			"Both lanes share the BLAKE3 hash and the marker wire format, so a marker minted by one resolves through the other - the address is the contract, not the port.",
			"SSE streams pass through uncompressed, and a healthy running proxy is reused at startup rather than a second being spawned.",
		],
	},
	{
		Id: "config-resolution",
		Caption: "M7 // CONFIG RESOLUTION",
		Svg: ConfigResolution,
		Note: [
			"The file is found by the same three-step search on every start: APHRODITE_CONFIG_PATH first, ./aphrodite.toml in the working directory second, the copy under the Hermes home last.",
			"Inside the file, values resolve env over TOML over default - except mode and listen, which get no blanket env override and keep their ports per-mode through APHRODITE_CACHE_PORT and APHRODITE_TOKEN_PORT.",
			"A Modify event on aphrodite.toml debounces 500 ms and resolves the thresholds into the four atomics; POST /reload does the same thing on demand.",
		],
	},
];

// The measured arc this sim gestures at - one plate per release, each figure
// printed in the CHANGELOG at that release (CHANGELOG.md:962-973, :983). Size
// and Tone fall back to the plate's defaults unless a record overrides them.
//
// A figure is a list of parts, because the numbers in it are the claim and a
// reader should watch them arrive ([data-count]): literal text stays literal,
// a `Count` part renders its own number and climbs to it once on first view.
// The printed string is unchanged either way - "216 KB → 12 markers" is what
// the markup carries before any script runs.
type ArcPart = string | { Count: number };

const Arc: readonly {
	Label: string;
	Parts: readonly ArcPart[];
	Note: string;
	Size?: string;
	Tone?: string;
}[] = [
	{
		Label: "v1.2.2 · REAL-WORLD EXAMPLE",
		Parts: [{ Count: 216 }, " KB → ", { Count: 12 }, " markers"],
		Note: "54K → 240 tokens · the CHANGELOG entry prints the ratio as 225×",
	},
	{
		Label: "v1.2.2 · CLASSIFICATION & CCR STORE (APPLE M2 MAX)",
		Parts: ["classify 40-123 ns · put ", { Count: 453 }, " ns · get 119.4 ns"],
		Size: "text-base",
		Note: "CCR mixed MT, 8 threads: DashMap 229 µs vs Mutex 1.15 ms",
	},
	{
		Label: "WHY THE STORE LOOKS LIKE IT DOES",
		Parts: [{ Count: 5 }, "× at 8 threads"],
		Tone: "text-weathered-teal",
		Note:
			"The DashMap-over-Mutex result is why the in-memory CCR backend is a sharded " +
			"map, not one guarded table.",
	},
	{
		Label: "v1.3.4 · RETRIEVAL INTEGRITY",
		Parts: ["20/20 retrieve OK"],
		Note:
			"Every compressed blob in the standard corpus was retrieved byte-exact; the " +
			"corpus ratios themselves live on the benchmarks page.",
	},
];
---

<Base
	Title="Workbench - Aphrodite"
	Description="A browser simulation of the Aphrodite preview workbench: paste any tool output and watch the preview line, the illustrative marker and the threshold knobs behave - client-side, illustrative, with no engine benchmark and no server-side retrieval."
>
	<PageShell Rhythm="dense" Grow>
		<!-- THE HEAD: the h1 opens the page, not the sample switchboard.
		     The motion attribute always sits on a plain wrapper, never on a
		     .wb-skew plate: an entrance animates `transform`, and a filled Web
		     Animation outranks the author's transform, so a plate that was its
		     own entrance root would lose its skew for good. -->
		<div data-enter>
			<header class="wb-skew motion-wipe-host relative border-l-4 border-blood-crimson bg-carbon-void p-8 shadow-[6px_6px_0px_#7a0a1e]">
				<span class="motion-wipe" data-wipe aria-hidden="true" />
				<ZineKicker Tone="canary">THE UNEXPLAINABLE BECOMES EFFORTLESS</ZineKicker>
				<h1
					class="mt-6 font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-5xl"
				>
					The pipeline, live
				</h1>
				<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					A tool call's output is appended to the model's context, and the model reads every
					line of it. Aphrodite runs four steps over that output before it arrives: the
					enriched preview line the agent would read, the
					marker the store would hold, and the mechanical outcome the pipeline reaches -
					pass-through, or preview plus marker. Any tool output can be put through those
					steps: a build log, a test run, a grep result.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The four live-reloadable compression thresholds are yours to turn. The engine's
					compaction knob is documented further down rather than wired in, because the path
					modelled is the tool-output path and nothing else.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The thresholds the sliders move are the shipped ones, and
					every figure is measured from the bytes of the input and recomputed
					as they turn - so no number can disagree with the payload it describes.
				</p>
			</header>
		</div>

		<SectionNav Sections={Sections} />

		<!-- THE INSTRUMENT LABEL + THE BOUNDARY, before the first interaction.
		     The label is persistent and quiet - it is a caption on an
		     instrument, not a warning - and the full boundary text sits one
		     click away beside the controls it governs. Both used to live at the
		     bottom of the page, under the hashes and the byte counts, which is
		     the one order a reader should never be given. -->
		<div data-reveal>
			<section
				id="boundary"
				aria-label="What this simulates"
				class="border-l-4 border-l-weathered-teal bg-asphalt-panel p-6"
			>
				<ZineKicker Tone="teal">SIMULATION BOUNDARY</ZineKicker>
				<p class="wb-instrument">
					Browser simulation · illustrative digest · no engine benchmark · no
					server-side retrieval
				</p>
				<details class="wb-details mt-6">
					<summary class="wb-details-summary">What this simulates</summary>
					<div class="prose-flow mt-6 max-w-3xl">
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Real:
						</p>
						<ul class="space-y-1 font-body text-base leading-relaxed text-bone-newsprint">
							<li class="border-l-2 border-oxblood-dark pl-3">
								the classifier rules (README.md:153-176)
							</li>
							<li class="border-l-2 border-oxblood-dark pl-3">
								the preview line shapes (README.md:108-133)
							</li>
							<li class="border-l-2 border-oxblood-dark pl-3">
								the threshold semantics and defaults (README.md:395-420).
							</li>
						</ul>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Simulated:
						</p>
						<ul class="space-y-1 font-body text-base leading-relaxed text-bone-newsprint">
							<li class="border-l-2 border-oxblood-dark pl-3">
								the BLAKE3 digest (a deterministic stand-in hash - the real 40-char
								digest needs the Rust store, and no engine can resolve the marker it
								prints)
							</li>
							<li class="border-l-2 border-oxblood-dark pl-3">
								and aphrodite_retrieve (shown as the decision text, never executed).
							</li>
						</ul>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							No timing is simulated at all: the 40-123 ns classify figure is the
							engine's own historical measurement, printed on the rail and arc
							exactly as the README and the CHANGELOG carry it, and /benchmarks/
							prints it with its environment and its reproduce command.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							No network and no runtime: the whole pipeline runs in the browser.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Not depicted: the context engine's auto-compaction pass and the injection
							assembler's directive budget - only the tool-output path is modelled.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							The full registry is larger - the 30-type content catalog lives in
							docs/classification/content-types.md:118-151; only the README
							tier is modelled.
						</p>
					</div>
				</details>
			</section>
		</div>

		<!-- THE FOUR STEPS: the rail, the pair, the readout. The component owns its
		     own <section>, so the anchor the index links to is this wrapper.
		     This page has no [data-stream]: its raw pane is a textarea the reader
		     fills, so there is no fixed set of lines to print one at a time. The
		     stagger belongs on a captured stream - the landing page's build log,
		     the case study's flood, the showcase's twenty outputs - and putting
		     it here would animate an empty box. -->
		<div
			id="pipeline"
			role="region"
			aria-label="Raw stream and enriched preview"
			data-reveal
		>
			<ZinePipeline Mode="full" />
		</div>

		<!-- THE CLASSIFIER, IN PROSE: what the rail above is naming, and why one
		     name is enough for every stage downstream. -->
		<div class="mt-16 border-l-4 border-raw-blood bg-asphalt-panel p-6" data-reveal>
			<ZineKicker Tone="dust" As="div">CLASSIFIER FRAMING</ZineKicker>
			<p class="mt-4 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				The 16 pipeline types the rail renders follow the README catalog
				(README.md:155-176); the full classification registry behind them is 30 types,
				printed in docs/classification/content-types.md:118-151.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				A type is a routing decision, not a description: the first rule that matches wins,
				and every later stage reads that one name.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				A generic bucket is not the end of the road - a conservative semantic detector
				upgrades the git, gitlog, grep, ls and test shapes, and ordinary prose is never
				mis-tagged.
			</p>
		</div>

		<!-- THE KNOBS: aphrodite.toml [compression], live. -->
		<div data-reveal>
			<section
				id="knobs"
				class="wb-skew motion-wipe-host relative border-4 border-blood-crimson bg-carbon-void p-8 shadow-[6px_6px_0px_#7a0a1e]"
				aria-label="Threshold knobs"
			>
				<span class="motion-wipe" data-wipe aria-hidden="true" />
				<div class="flex flex-wrap items-center justify-between gap-6">
					<h2><ZineKicker Tone="white">THRESHOLD KNOBS</ZineKicker></h2>
					<!-- Named for what it does. The old label was "POST /RELOAD",
					     which named an HTTP endpoint this button never calls. -->
					<button type="button" class="wb-pill" data-action="reset-defaults">
						Reset defaults
					</button>
				</div>
				<p class="mt-6 font-mono text-base leading-relaxed text-zinc-dust">
					aphrodite.toml [compression] - the four proxy thresholds are live-reloadable; edit +
					save (or POST /reload) re-applies them immediately (README.md:389).
				</p>
				<p class="mt-4 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Only four values are atomics the running engine swaps: cache, token, inline and
					code_multiplier. Everything else in the file waits for a restart.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The engine knob is an escape hatch rather than a dial - past 100 the context engine
					stands down and the four proxy thresholds keep working alone.
				</p>
				<!-- The reference line the button needs: it restores this page's
				     sliders, and the real reload behaviour lives in the config docs. -->
				<p class="wb-ref mt-4">
					Reset defaults restores the four sliders to the shipped [compression]
					values and changes nothing else. It is not an HTTP reload: the engine's own
					<code class="type-code text-stamped-canary">POST /reload</code> re-applies
					aphrodite.toml to a running binary, and its behaviour is documented in
					<a class="wb-ref-link" href={DocsRoute("config/aphrodite-toml")}>the aphrodite.toml
						configuration reference</a>
					and in <a class="wb-ref-link" href={Routes.Config}>/config/</a>.
				</p>
				<div class="mt-12 grid gap-16 md:grid-cols-2" data-enter="180">
					{
						Knobs.map((Knob) => (
							<div class="border-2 border-blood-crimson/60 bg-soot-black p-6">
								<div class="flex items-baseline justify-between">
									<label
										class="font-mono text-base font-bold text-bone-newsprint"
										for={`wb-knob-${Knob.Key}`}
									>
										{Knob.Key}
									</label>
									<output
										class="font-mono text-base font-black text-stamped-canary"
										data-knob-value={Knob.Key}
										for={`wb-knob-${Knob.Key}`}
									>
										{Knob.Default}
										{Knob.Unit}
									</output>
								</div>
								<input
									id={`wb-knob-${Knob.Key}`}
									data-knob={Knob.Key}
									type="range"
									min={Knob.Min}
									max={Knob.Max}
									step={Knob.Step}
									value={Knob.Default}
									class="wb-slider mt-8 w-full"
								/>
								<p class="mt-4 font-mono text-base uppercase tracking-widest text-zinc-dust">
									{Knob.Note}
								</p>
								<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
									{Knob.Line}
								</p>
							</div>
						))
					}
				</div>
				<!-- THE ENGINE KNOB, DOCUMENTED RATHER THAN RENDERED. It governs the
				     context engine's compaction pass, which this page does not model:
				     one blob, no session, so there are no middle turns to archive. The
				     control is not a slider here because a slider that changed nothing
				     would be the same dishonesty as a fabricated timing - and wiring it
				     into the compression readout is what made the old page say
				     "compressed" and "raw passes through" about the same sample. -->
				<div class="mt-16 border-2 border-oxblood-dark bg-soot-black p-6" data-enter="240">
					<div class="flex flex-wrap items-baseline justify-between gap-4">
						<p class="font-mono text-base font-bold text-bone-newsprint">{Compaction.Key}</p>
						<p class="font-mono text-base font-black text-zinc-dust">
							{Compaction.Default}{Compaction.Unit}
						</p>
					</div>
					<p class="mt-4 font-mono text-base uppercase tracking-widest text-zinc-dust">
						{Compaction.Note} · compaction, not compression · not modelled on this page
					</p>
					<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
						{Compaction.Line}
					</p>
					<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
						{Compaction.Why}
					</p>
					<p class="wb-ref mt-4">
						Compaction is documented with the rest of the configuration surface in
						<a class="wb-ref-link" href={DocsRoute("config/aphrodite-toml")}>the aphrodite.toml
							configuration reference</a>
						and exercised on <a class="wb-ref-link" href={Routes.Config}>/config/</a>.
					</p>
				</div>

				<!-- The verdict strip: what the current knob set would do. -->
				<div class="mt-16 border-2 border-raw-blood bg-soot-black p-4" data-enter="300">
					<ZineKicker Tone="canary">COMPRESSION, CACHE AND STORAGE</ZineKicker>
					<p class="mt-4 font-mono text-base text-bone-newsprint" data-verdict>
						turn the knobs, then RUN PIPELINE
					</p>
					<p class="mt-4 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
						The strip reports what the current knob set does to the sample loaded in the rail
						above: the compression mode, the cache lane's own answer, and whether the store
						routed the blob inline or durably. Three dimensions, printed side by side so one
						can never be read as another.
					</p>
					<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
						Move a slider and the strip changes without a reload, because the four thresholds
						are atomics the running engine swaps - the same sample is inline under a 4 KB
						limit and stored under a 256 B one.
					</p>
					<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
						The byte reduction those decisions produce is printed in the pipeline's own
						readout above, where it is measured against the bytes actually in the pane - not
						here, where nothing is measured and only the routing is reported.
					</p>
				</div>
			</section>
		</div>

		<div data-reveal>
			<section
				id="states"
				class="wb-skew motion-wipe-host relative border-4 border-weathered-teal bg-carbon-void p-8 shadow-[6px_6px_0px_#000]"
				aria-label="Threshold states"
			>
				<span class="motion-wipe" data-wipe aria-hidden="true" />
				<ZineKicker Tone="teal">THRESHOLD STATES</ZineKicker>
				<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Every run ends in one of three states, and a state is the whole contract: the name
					says in one line whether the bytes stayed, whether a marker was minted, and whether
					the engine was in the loop at all.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The first two are compression states, and the readout in the pipeline above names
					them. The third is a compaction state: the token threshold alone decides the first
					two, while the third is the context engine standing down - which is why that knob is
					documented beside the thresholds rather than wired into the readout, and why the
					readout can never print it.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					None of the three is a judgement about the agent's question. Whether a preview
					answers it is the agent's decision, taken with a task in hand; this page has no task
					to give it, so it reports the state and leaves the judgement where it belongs.
				</p>
				<div class="mt-12 grid gap-8 lg:grid-cols-3" data-enter="180">
					{
						States.map((State) => (
							<div class="border-2 border-weathered-teal/60 bg-soot-black p-6">
								<p class="font-mono text-base font-black text-bone-white">{State.Label}</p>
								<p class="mt-4 font-mono text-base uppercase tracking-widest text-zinc-dust">
									WHEN: {State.When}
								</p>
								{State.Note.map((Sentence) => (
									<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
										{Sentence}
									</p>
								))}
								<p class="mt-6 border-t-2 border-weathered-teal/40 pt-4 font-mono text-base text-weathered-teal">
									HOLDS: {State.Holds}
								</p>
							</div>
						))
					}
				</div>
				<p class="mt-12 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The strip in the knobs panel prints the inputs alongside the name - compression
					mode, cache lane and storage - so a run that reads as surprising can be traced back
					to the threshold that produced it.
				</p>
			</section>
		</div>

		<!-- THE TOPOLOGY: the store and the config surface. -->
		<section id="topology" class="grid gap-20 lg:grid-cols-2" aria-label="Diagrams" data-reveal>
			<p class="col-span-full max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Two diagrams carry the parts of the pipeline the rail above cannot show: where the
				store actually lives, and where the thresholds come from.
			</p>
			{
				Diagrams.map((Diagram) => (
					<figure
						class="wb-skew motion-wipe-host relative border-4 border-blood-crimson bg-carbon-void p-4 shadow-[6px_6px_0px_#7a0a1e]"
						data-diagram={Diagram.Id}
					>
						<span class="motion-wipe" data-wipe aria-hidden="true" />
						<div class="overflow-x-auto" set:html={Diagram.Svg} />
						<figcaption class="mt-6">
							<ZineKicker Tone="dust">{Diagram.Caption}</ZineKicker>
						</figcaption>
						{
							Diagram.Note.map((Sentence, Index) => (
								<p
									class:list={[
										Index === 0 ? "mt-6" : "mt-3",
										"max-w-3xl font-body text-base leading-relaxed text-bone-newsprint",
									]}
								>
									{Sentence}
								</p>
							))
						}
					</figure>
				))
			}
		</section>

		<!-- THE ARC: the measured numbers this sim gestures at. -->
		<div data-reveal>
			<section
				id="arc"
				class="wb-skew motion-wipe-host relative border-l-4 border-stamped-canary bg-carbon-void p-8"
				aria-label="Benchmark notes"
			>
				<span class="motion-wipe" data-wipe aria-hidden="true" />
				<ZineKicker Tone="canary">SIM NOTES · THE MEASURED ARC</ZineKicker>
				<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The numbers this sim gestures at are real: each plate prints the figure the CHANGELOG
					carried at that release, and the benchmarks page carries the reproduce commands.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					None of them is measured by this page. They are historical engine measurements,
					printed here as receipts, and the boundary above says so before a reader meets
					them - which is the difference between a citation and a claim.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Read a plate as a receipt - the figure is what the release printed, the note is what
					the number means for the design.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The figures climb to their values once, on the view that brings them in: a receipt
					that counts up is a receipt being read, and the note underneath is what makes it
					mean something.
				</p>
				<div class="mt-12 grid gap-6 md:grid-cols-2" data-enter="180">
					{
						Arc.map((Plate) => (
							<div class="border-2 border-blood-crimson/60 bg-soot-black p-5">
								<ZineKicker Tone="dust" As="div">
									{Plate.Label}
								</ZineKicker>
								<div
									class={`mt-3 font-mono font-black ${Plate.Size ?? "text-2xl"} ${Plate.Tone ?? "text-bone-white"}`}
								>
									{Plate.Parts.map((Part) =>
										typeof Part === "string" ? (
											Part
										) : (
											<span data-count={Part.Count}>
												{Part.Count.toLocaleString("en-US")}
											</span>
										),
									)}
								</div>
								<p class="mt-2 font-mono text-base text-zinc-dust">{Plate.Note}</p>
							</div>
						))
					}
				</div>
				<ZineSource
					Lines={[
						"SRC: CHANGELOG.md:962-973 (the ns/µs table) · CHANGELOG.md:983 (216 KB → 12 markers)",
					]}
				/>
			</section>
		</div>

		<!-- THE BOUNDARY used to close the page here. It now opens it, as a
		     disclosure beside the controls (#boundary, above) - the same text,
		     moved to where a reader meets it before the first figure. -->

		<!-- RELATED: the natural neighbors. -->
		<Related
			Links={[
				{ Href: "/benchmarks/", Label: "BENCHMARKS" },
				{ Href: "/tools/", Label: "TOOLS" },
				{ Href: "/case-study/", Label: "CASE STUDY" },
				{ Href: "/setup/", Label: "SETUP" },
			]}
		/>
	</PageShell>
	<ZineDiagramNav />
</Base>

<style is:global>
	/* The page's own chrome: the skew, the pill and the slider. The pipeline's
	   panes and the samples live in Component/ZinePipeline.astro, which is
	   self-contained because /case-study/ renders it too. */
	.wb-skew {
		transform: skew(-1.2deg);
		transition: transform 0.2s ease;
	}
	.wb-skew:hover {
		transform: rotate(0deg) skew(0deg);
	}
	.wb-pill {
		border: 2px solid #7a0a1e;
