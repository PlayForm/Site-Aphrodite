---
import Base from "@Layout/Base.astro";

import PageShell from "@Component/PageShell.astro";
import Related from "@Component/Related.astro";
import SectionNav from "@Component/SectionNav.astro";
import ZineDiagramNav from "@Component/ZineDiagramNav.astro";
import ZineKicker from "@Component/ZineKicker.astro";
import ZinePipeline from "@Component/ZinePipeline.astro";
import ZineSource from "@Component/ZineSource.astro";
import DualListener from "../Content/Mermaid/dual-listener.svg?raw";
import ConfigResolution from "../Content/Mermaid/config-resolution.svg?raw";

import { DocsRoute, Routes } from "@Library/Links";
import "@Stylesheet/Page/Workbench.css";

// The pipeline's home. The four steps themselves - the classifier, the preview
// shapes, the digest, the decision - live in Script/Pipeline.ts and render
// through Component/ZinePipeline.astro, so this page keeps only its own
// subject: the knobs, the two topology diagrams, the measured arc, and the
// simulation boundary. The SANITIZATION law holds: the samples are synthetic,
// generated for the demo - never real session content, no user-home paths.
//
// THE CONSOLE GRAMMAR (blueprint, Global.css). This page is an instrument, so
// it is laid out as one: every chapter opens on a full-width hairline with a
// numbered index tag above its head (`.blueprint-section` + `.section-index`),
// every panel picks an ELEVATION TIER instead of choosing a background, a
// border and a shadow for itself, and the small labels speak the telemetry
// voice (`.telemetry-tag`, `.metric`). Two rules follow from that and are
// worth stating because they are easy to undo by accident:
//
//   1. A TIER SURFACE AND A TAILWIND BORDER UTILITY DO NOT GO ON THE SAME
//      ELEMENT. `.shell-card` and `.well` set the `border` SHORTHAND, and
//      Global.css loads after the utility layer, so `border-l-4
//      border-weathered-teal` on a `.shell-card` is silently replaced by the
//      tier's own 1px edge. Where a plate needs a custom edge, it takes a FILL
//      (`.tier-shell` / `.tier-well`) and keeps the utilities for the frame.
//   2. ONE EXPRESSIVE ASSEMBLY PER CHAPTER. The hard offset shadow, the skew
//      and the ink sweep belong to the opening plate and to the console; every
//      other plate in a chapter is a quiet tier. Emphasis is a budget, not a
//      habit.
//
// The instrument itself (Component/ZinePipeline.astro, Mode="full") is shared
// with /case-study/, so it is NOT re-skinned here: the page wraps it in the
// console shell and tiers the readout region from outside through the hooks
// the client engine binds (`[data-fact]`), which is the only treatment that
// cannot drift out of the shared component's own stylesheet.

// The page's own section list - SectionNav's only input, which is what keeps
// the index truthful: a link can never name a section this page does not render.
//
// BOUNDARY comes first on purpose. The page used to open with "The pipeline,
// live" and put the simulation boundary at the bottom, after hashes, byte
// counts and storage states had already established realism - a reader had
// every reason to believe the numbers before being told what they were. The
// instrument states what it is first, then demonstrates.
const Sections = [
	{ Id: "boundary", Label: "BOUNDARY" },
	{ Id: "pipeline", Label: "PIPELINE" },
	{ Id: "knobs", Label: "KNOBS" },
	{ Id: "states", Label: "STATES" },
	{ Id: "topology", Label: "TOPOLOGY" },
	{ Id: "arc", Label: "THE ARC" },
];

// The four proxy thresholds. The Defaults are the shipped [compression] values
// from crates/aphrodite/templates/aphrodite.toml - a slider that shows anything
// else is drift, because the engine reads the toml. These four are the ones the
// running engine swaps as atomics, which is why they are the ones a reader can
// turn here.
const Knobs = [
	{
		Key: "tool_threshold_token",
		Min: 64,
		Max: 4096,
		Step: 64,
		Default: 256,
		Unit: "B",
		Note: "token proxy threshold (bytes)",
		Line: "The token proxy measured every tool result against this limit: a result over it was compressed into a marker, a result under it stayed in the transcript as it arrived.",
	},
	{
		Key: "tool_threshold_cache",
		Min: 256,
		Max: 16384,
		Step: 256,
		Default: 2048,
		Unit: "B",
		Note: "cache proxy threshold (bytes)",
		Line: "The cache proxy answered on its own port with its own limit, which is what let one binary tune the two lanes independently.",
	},
	{
		Key: "inline_threshold",
		Min: 256,
		Max: 16384,
		Step: 256,
		Default: 1024,
		Unit: "B",
		Note: "inline-vs-durable CCR storage cutoff",
		Line: "This is a storage cutoff, not a compression one: under it a stored blob lived inline in the session, over it the blob went to durable CCR.",
	},
	{
		Key: "code_multiplier",
		Min: 1,
		Max: 8,
		Step: 0.5,
		Default: 1,
		Unit: "x",
		Note: "threshold multiplier for code_* types",
		Line: "Code types multiplied the token limit by this factor, and the effect the config doc names is that code stayed inline while prose of the same size was compressed (docs/config/aphrodite-toml.md:159).",
	},
] as const;

// The engine knob is a COMPACTION control, and compaction is not modelled on
// this page: the simulator holds one blob and no session, so there are no
// middle turns to archive. It is documented here rather than rendered as a
// slider, because a slider that changed nothing would be the same class of
// dishonesty as a fabricated timing - and because wiring it into the
// compression readout is exactly what made the old page contradict itself
// ("compressed" in the verdict, "engine OFF, raw passes through" beside it).
//
// Its Default is the ONE figure on this page that is a metric rather than a
// sentence: a single shipped value with its own unit, documented and never
// turned, so it can carry `.metric` without contradicting a live control.
const Compaction = {
	Key: "engine_threshold_pct",
	Default: 30,
	Unit: "%",
	Note: "100+ = engine-off escape hatch",
	Line: "The context engine's fill percentage: middle turns were archived to CCR once the session passed it, 0 meant never, and 100+ switched the engine off (README.md:580).",
	Why: "It is a compaction knob, not a compression one. The four proxy thresholds keep working whatever it is set to, which is why the engine standing down never turned the pipeline off - the two dimensions are separate, and only one of them is measurable without a session.",
} as const;

// The three states the site names, restored from this page's own baseline
// (820fae84) because they are the vocabulary the rest of the site uses. Each
// record carries the label the readout prints, the condition that produced it,
// what the agent ends up holding, and the line that explains it - a label with
// no explanation is a state a reader cannot act on.
//
// The first two are COMPRESSION states and the readout above prints them. The
// third is a COMPACTION state: it describes the context engine standing down,
// which is a different dimension from the proxy thresholds and is not modelled
// by this page's simulator. It stays here because a reader who meets
// engine_threshold_pct anywhere else needs the vocabulary, and its note says
// exactly which dimension it belongs to. The `Dimension` field is that
// distinction made scannable - a chip on each card, so the reader does not have
// to read three paragraphs to learn that one of them is a different axis.
const States = [
	{
		Label: "below threshold, kept inline",
		Dimension: "COMPRESSION",
		When: "bytes <= tool_threshold_token (x code_multiplier for code_* types)",
		Holds: "the bytes themselves - nothing to resolve",
		Note: [
			"The sample never crossed the token limit, so the classifier typed it and the preview line was built, but nothing was hashed and no marker was minted.",
			"The bytes stayed in the transcript, which is why this state costs the turn nothing: the agent already reads what it would otherwise have to retrieve.",
		],
	},
	{
		Label: "preview enough, marker stored",
		Dimension: "COMPRESSION",
		When: "bytes > tool_threshold_token (x code_multiplier for code_* types)",
		Holds: "the preview line, the address and the marker",
		Note: [
			"The sample crossed the limit, so the digest hashed the original bytes and the marker was stored under that hash.",
			"The preview line answered the question, so the agent reasoned on the preview and left the marker as a receipt rather than a debt.",
		],
	},
	{
		Label: "engine OFF - the 100+ escape hatch, nothing archived mid-session",
		Dimension: "COMPACTION",
		When: "engine_threshold_pct >= 100",
		Holds: "the raw turn, un-archived by the engine - the proxy thresholds still compress tool output",
		Note: [
			"Past 100 the context engine stood down: no middle turn was archived mid-session and nothing was marked by it.",
			"The four proxy thresholds kept working on their own, so tool output was still compressed - the knob switches off one engine, not the pipeline.",
			"This is a compaction state, not a compression one, which is why the readout never prints it: the two dimensions answer different questions, and conflating them is a contradiction.",
		],
	},
] as const;

// The two topology diagrams the page's subject needs: the store's dual
// listener, and the config surface that feeds it. Each carries its own prose
// because a figure without the sentence explaining it is a panel that says
// nothing - the reader gets the shape AND the reading of it.
const Diagrams = [
	{
		Id: "dual-listener",
		Caption: "M5 // DUAL LISTENER",
		Svg: DualListener,
		Note: [
			"One binary serves both lanes: the cache listener answers on :9797 from a 10K-entry DashMap for content over 8 KB, and the token listener answers on :9798 from SQLite for content over 1 KB plus the tool relay.",
			"Both lanes share the BLAKE3 hash and the marker wire format, so a marker minted by one resolves through the other - the address is the contract, not the port.",
			"SSE streams pass through uncompressed, and a healthy running proxy is reused at startup rather than a second being spawned.",
		],
	},
	{
		Id: "config-resolution",
		Caption: "M7 // CONFIG RESOLUTION",
		Svg: ConfigResolution,
		Note: [
			"The file is found by the same three-step search on every start: APHRODITE_CONFIG_PATH first, ./aphrodite.toml in the working directory second, the copy under the Hermes home last.",
			"Inside the file, values resolve env over TOML over default - except mode and listen, which get no blanket env override and keep their ports per-mode through APHRODITE_CACHE_PORT and APHRODITE_TOKEN_PORT.",
			"A Modify event on aphrodite.toml debounces 500 ms and resolves the thresholds into the four atomics; POST /reload does the same thing on demand.",
		],
	},
];

// The measured arc this sim gestures at - one plate per release, each figure
// printed in the CHANGELOG at that release (CHANGELOG.md:962-973, :983). Size
// and Tone fall back to the plate's defaults unless a record overrides them.
//
// A figure is a list of parts, because the numbers in it are the claim and a
// reader should watch them arrive ([data-count]): literal text stays literal,
// a `Count` part renders its own number and climbs to it once on first view.
// The printed string is unchanged either way - "216 KB → 12 markers" is what
// the markup carries before any script runs.
//
// `Display: "sheet"` promotes a plate to the printed-sheet tier (bone ground,
// carbon ink, the chapter's one hard shadow) and gives its figure the largest
// mono voice on the page. It is set on the real-world example because that is
// the number the whole page exists to point at; the rest are receipts read at
// reading size.
type ArcPart = string | { Count: number };

const Arc: readonly {
	Label: string;
	Parts: readonly ArcPart[];
	Note: string;
	Size?: string;
	Tone?: string;
	Display?: "sheet";
}[] = [
	{
		Label: "v1.2.2 · REAL-WORLD EXAMPLE",
		Parts: [{ Count: 216 }, " KB → ", { Count: 12 }, " markers"],
		Note: "54K → 240 tokens · the CHANGELOG entry prints the ratio as 225×",
		Display: "sheet",
	},
	{
		Label: "v1.2.2 · CLASSIFICATION & CCR STORE (APPLE M2 MAX)",
		Parts: ["classify 40-123 ns · put ", { Count: 453 }, " ns · get 119.4 ns"],
		Size: "text-base",
		Note: "CCR mixed MT, 8 threads: DashMap 229 µs vs Mutex 1.15 ms",
	},
	{
		Label: "WHY THE STORE LOOKS LIKE IT DOES",
		Parts: [{ Count: 5 }, "× at 8 threads"],
		Tone: "text-weathered-teal",
		Note:
			"The DashMap-over-Mutex result is why the in-memory CCR backend is a sharded " +
			"map, not one guarded table.",
	},
	{
		Label: "v1.3.4 · RETRIEVAL INTEGRITY",
		Parts: ["20/20 retrieve OK"],
		Note:
			"Every compressed blob in the standard corpus was retrieved byte-exact; the " +
			"corpus ratios themselves live on the benchmarks page.",
	},
];
---

<Base
	Title="Workbench - Aphrodite"
	Description="A browser simulation of the Aphrodite preview workbench: paste any tool output and the preview line, the illustrative marker and the threshold knobs respond - client-side, illustrative, with no engine benchmark and no server-side retrieval."
>
	<PageShell Rhythm="dense" Grow>
		<!-- THE HEAD: the h1 opens the page, not the sample switchboard.
		     The motion attribute always sits on a plain wrapper, never on a
		     .wb-skew plate: an entrance animates `transform`, and a filled Web
		     Animation outranks the author's transform, so a plate that was its
		     own entrance root would lose its skew for good.

		     This is the chapter's one expressive assembly: the skew, the
		     crimson edge, the pasted shadow and the ink. Everything below it is
		     a quiet tier. -->
		<div data-enter>
			<header
				class="wb-skew motion-wipe-host grunge tier-shell relative border-l-4 border-blood-crimson p-8 shadow-[6px_6px_0px_#7a0a1e]"
				data-grunge
				data-grunge-mode="edge"
			>
				<span class="motion-wipe" data-wipe aria-hidden="true" />
				<p class="section-index">00 // WORKBENCH</p>
				<div class="mt-4">
					<ZineKicker Tone="canary">THE UNEXPLAINABLE BECOMES EFFORTLESS</ZineKicker>
				</div>
				<h1 class="mt-6 font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-5xl">
					The pipeline, live
				</h1>
				<p class="wb-prose mt-6">
					A tool call's output is appended to the model's context, and the model reads
					every line of it. Aphrodite runs four steps over that output before it arrives:
					the enriched preview line the agent would read, the marker the store would hold,
					and the mechanical outcome the pipeline reaches - pass-through, or preview plus
					marker. Any tool output can be put through those steps: a build log, a test run,
					a grep result.
				</p>
				<p class="wb-prose mt-3">
					The four live-reloadable compression thresholds are yours to turn. The engine's
					compaction knob is documented further down rather than wired in, because the
					path modelled is the tool-output path and nothing else.
				</p>
				<p class="wb-prose mt-3">
					The thresholds the sliders move are the shipped ones, and every figure is
					measured from the bytes of the input and recomputed as they turn - so no number
					can disagree with the payload it describes.
				</p>
			</header>
		</div>

		<SectionNav Sections={Sections} />

		<!-- 01 // THE CONTRACT - the simulation boundary, before the first
		     interaction. The label is persistent and quiet - it is a caption on
		     an instrument, not a warning - and the full boundary text sits one
		     click away beside the controls it governs. Both used to live at the
		     bottom of the page, under the hashes and the byte counts, which is
		     the one order a reader should never be given. -->
		<section
			id="boundary"
			aria-label="What this simulates"
			class="blueprint-section"
			style="--blueprint-rule: var(--weathered-teal)"
			data-reveal
		>
			<p class="section-index !text-weathered-teal">01 // THE CONTRACT</p>
			<div class="shell-card mt-4 p-6 sm:p-8">
				{/* The chapter's head, in the sub-head role. It was a kicker at
				    16px - the size of the body copy under it - so the page's
				    heading outline skipped chapter 01 altogether and the card
				    gave no signal that it opened a new subject. Same words. */}
				<h2 class="type-sub text-bone-white">SIMULATION BOUNDARY</h2>
				<p class="wb-instrument">
					Browser simulation · illustrative digest · no engine benchmark · no server-side
					retrieval
				</p>
				<details class="wb-details mt-6">
					<summary class="wb-details-summary">What this simulates</summary>
					<div class="prose-flow mt-6 max-w-3xl">
						<p class="telemetry-tag telemetry-tag--teal">Real</p>
						<ul class="wb-list">
							<li>the classifier rules (README.md:153-176)</li>
							<li>the preview line shapes (README.md:108-133)</li>
							<li>the threshold semantics and defaults (README.md:395-420).</li>
						</ul>
						<p class="telemetry-tag telemetry-tag--canary">Simulated</p>
						<ul class="wb-list">
							<li>
								the BLAKE3 digest (a deterministic stand-in hash - the real 40-char
								digest needs the Rust store, and no engine can resolve the marker it
								prints)
							</li>
							<li>
								and aphrodite_retrieve (shown as the decision text, never executed).
							</li>
						</ul>
						<p class="wb-prose">
							No timing is simulated at all: the 40-123 ns classify figure is the
							engine's own historical measurement, printed on the rail and arc exactly
							as the README and the CHANGELOG carry it, and /benchmarks/ prints it
							with its environment and its reproduce command.
						</p>
						<p class="wb-prose">
							No network and no runtime: the whole pipeline runs in the browser.
						</p>
						<p class="wb-prose">
							Not depicted: the context engine's auto-compaction pass and the
							injection assembler's directive budget - only the tool-output path is
							modelled.
						</p>
						<p class="wb-prose">
							The full registry is larger - the 30-type content catalog lives in
							docs/classification/content-types.md:118-151; only the README tier is
							modelled.
						</p>
					</div>
				</details>
			</div>
		</section>

		<!-- 02 // THE INSTRUMENT. The component owns its own <section>, its rail,
		     its switchboard and its panes; the page owns the console it sits in
		     and the tier the readout region takes (see the page stylesheet).
		     This page has no [data-stream]: its raw pane is a textarea the reader
		     fills, so there is no fixed set of lines to print one at a time. The
		     stagger belongs on a captured stream - the landing page's build log,
		     the case study's flood, the showcase's twenty outputs - and putting
		     it here would animate an empty box. -->
		<section
			id="pipeline"
			aria-label="Raw stream and enriched preview"
			class="blueprint-section wb-rule-raw"
			data-reveal
		>
			<p class="section-index wb-index-raw">02 // THE INSTRUMENT</p>
			<div class="wb-console grunge mt-4" data-grunge data-grunge-mode="edge">
				<ZinePipeline Mode="full" />
			</div>

			<!-- THE CLASSIFIER, IN PROSE: what the rail above is naming, and why
			     one name is enough for every stage downstream. A quiet tier - a
			     hairline and a crimson edge, no fill, no shadow - because it is
			     the chapter's explanation, not its exhibit. -->
			<div class="wb-framing mt-12 pl-6">
				<ZineKicker Tone="dust" As="div">
					CLASSIFIER FRAMING
				</ZineKicker>
				<p class="wb-prose mt-4">
					The 16 pipeline types the rail renders follow the README catalog
					(README.md:155-176); the full classification registry behind them is 30 types,
					printed in docs/classification/content-types.md:118-151.
				</p>
				<p class="wb-prose mt-3">
					A type is a routing decision, not a description: the first rule that matches
					wins, and every later stage reads that one name.
				</p>
				<p class="wb-prose mt-3">
					A generic bucket is not the end of the road - a conservative semantic detector
					upgrades the git, gitlog, grep, ls and test shapes, and ordinary prose is never
					mis-tagged.
				</p>
			</div>
		</section>

		<!-- 03 // THE CONTROLS - aphrodite.toml [compression], live. The chapter
		     opens on the canvas rather than on a plate: the four knob cards are
		     the exhibit, and each one is a WELL (a channel recessed into the
		     page) so the sliders read as instruments rather than as panels. The
		     values they show are telemetry chips, because a number that changes
		     as you drag it is a readout, not prose. -->
		<section
			id="knobs"
			aria-label="Threshold knobs"
			class="blueprint-section"
			style="--blueprint-rule: var(--stamped-canary)"
			data-reveal
		>
			<p class="section-index !text-stamped-canary">03 // THE CONTROLS</p>
			<div class="mt-4 flex flex-wrap items-center justify-between gap-6">
				{/* This chapter's heading used to be a ZineKicker inside a bare
				    <h2>: the kicker's own voice is `text-base` (16px), so the
				    heading measured exactly the size of its body copy and the
				    reader got no signal that the subject changed. `type-sub` is
				    the documented role for a sub-head inside a chapter, and it
				    renders 22-28px over 16px body. The wording is unchanged; only
				    the voice is. */}
				<h2 class="type-sub text-bone-white">THRESHOLD KNOBS</h2>
				<!-- Named for what it does. The old label was "POST /RELOAD",
				     which named an HTTP endpoint this button never calls. It is a
				     control, so it keeps the chip's silhouette and adds the two
				     things a chip does not have: a pointer and a shadow. -->
				<button type="button" class="wb-pill" data-action="reset-defaults">
					Reset defaults
				</button>
			</div>
			<p class="wb-mono mt-6">
				aphrodite.toml [compression] - the four proxy thresholds are live-reloadable; edit +
				save (or POST /reload) re-applies them immediately (README.md:389).
			</p>
			<p class="wb-prose mt-4">
				Only four values are atomics the running engine swaps: cache, token, inline and
				code_multiplier. Everything else in the file waits for a restart.
			</p>
			<p class="wb-prose mt-3">
				The engine knob is an escape hatch rather than a dial - past 100 the context engine
				stands down and the four proxy thresholds keep working alone.
			</p>
			<!-- The reference line the button needs: it restores this page's
			     sliders, and the real reload behaviour lives in the config docs. -->
			<p class="wb-ref mt-4">
				Reset defaults restores the four sliders to the shipped [compression] values and
				changes nothing else. It is not an HTTP reload: the engine's own
				<code class="type-code text-stamped-canary">POST /reload</code> re-applies
				aphrodite.toml to a running binary, and its behaviour is documented in
				<a class="wb-ref-link" href={DocsRoute("config/aphrodite-toml")}>
					the aphrodite.toml configuration reference
				</a>
				and in{" "}
				<a class="wb-ref-link" href={Routes.Config}>
					/config/
				</a>
				.
			</p>
			<div class="mt-12 grid gap-8 md:grid-cols-2" data-enter="180">
				{Knobs.map((Knob) => (
					/* min-w-0 + a wrapping label/value row: the row was nowrap, so its
						   min-content (a 15-character mono key plus its value) set the
						   CARD's min-content and the card measured 282px in a 278px grid
						   track at 390 - it jutted 4px past the column while nothing
						   inside it reported overflow. Letting the pair wrap fixes the
						   cause; min-w-0 stops a longer key from doing it again. */
					<div class="well min-w-0 p-6">
						<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-2">
							<label class="wb-key" for={`wb-knob-${Knob.Key}`}>
								{Knob.Key}
							</label>
							<output
								class="telemetry-tag telemetry-tag--canary"
								data-knob-value={Knob.Key}
								for={`wb-knob-${Knob.Key}`}
							>
								{Knob.Default}
								{Knob.Unit}
							</output>
						</div>
						<input
							id={`wb-knob-${Knob.Key}`}
							data-knob={Knob.Key}
							type="range"
							min={Knob.Min}
							max={Knob.Max}
							step={Knob.Step}
							value={Knob.Default}
							class="wb-slider mt-8 w-full"
						/>
						<p class="wb-label mt-4">{Knob.Note}</p>
						<p class="wb-prose mt-3">{Knob.Line}</p>
					</div>
				))}
			</div>
			<!-- THE ENGINE KNOB, DOCUMENTED RATHER THAN RENDERED. It governs the
			     context engine's compaction pass, which this page does not model:
			     one blob, no session, so there are no middle turns to archive. The
			     control is not a slider here because a slider that changed nothing
			     would be the same dishonesty as a fabricated timing - and wiring it
			     into the compression readout is what made the old page say
			     "compressed" and "raw passes through" about the same sample.

			     Its value is the chapter's one metric: a single shipped figure with
			     its own unit, documented and never turned, so nothing about it can
			     drift from a live control. -->
			<div class="well mt-12 p-6" data-enter="240">
				<div class="flex flex-wrap items-baseline justify-between gap-4">
					<p class="wb-key">{Compaction.Key}</p>
					<p class="metric">
						{Compaction.Default}
						<span class="metric__unit">{Compaction.Unit}</span>
					</p>
				</div>
				<p class="wb-note mt-4">
					{Compaction.Note} · compaction, not compression · a context-engine pass the
					compression readout cannot report
				</p>
				<p class="wb-prose mt-3">{Compaction.Line}</p>
				<p class="wb-prose mt-3">{Compaction.Why}</p>
				<p class="wb-ref mt-4">
					Compaction is documented with the rest of the configuration surface in
					<a class="wb-ref-link" href={DocsRoute("config/aphrodite-toml")}>
						the aphrodite.toml configuration reference
					</a>
					and exercised on{" "}
					<a class="wb-ref-link" href={Routes.Config}>
						/config/
					</a>
					.
				</p>
			</div>

			<!-- The verdict strip: what the current knob set would do. A shell card,
			     not a well: this is the answer the chapter produces, and an answer
			     sits on a surface rather than in a channel. -->
			<div class="shell-card mt-12 p-6" data-enter="300">
				<ZineKicker Tone="canary">COMPRESSION, CACHE AND STORAGE</ZineKicker>
				<p class="wb-verdict mt-4" data-verdict>
					turn the knobs, then RUN PIPELINE
				</p>
				<p class="wb-prose mt-4">
					Three independent decisions follow from the knob set: whether the result is
					compressed, whether the cache lane answers it, and whether the store keeps the
					blob inline or writes it durably. Aphrodite takes the three separately, and
					reporting them side by side is what stops one being read as another.
				</p>
				<p class="wb-prose mt-3">
					The four thresholds are atomics the running engine swaps, so the same result is
					inline under a 4 KB limit and stored under a 256 B one, with no restart between
					the two.
				</p>
				<p class="wb-prose mt-3">
					Byte reduction is measured against the bytes the result actually carries rather
					than against the knob set, so the routing decision and the saving it produces
					stay two figures: the thresholds decide the first, and only the bytes decide the
					second.
				</p>
			</div>
		</section>

		<!-- 04 // THE STATES. Three cards, each carrying the DIMENSION it belongs
		     to as a chip: two are compression states the readout prints, one is a
		     compaction state it cannot. That distinction used to be legible only
		     by reading every paragraph on the card. -->
		<section
			id="states"
			aria-label="Threshold states"
			class="blueprint-section"
			style="--blueprint-rule: var(--weathered-teal)"
			data-reveal
		>
			<p class="section-index !text-weathered-teal">04 // THE STATES</p>
			{/* The chapter head is an <h2> in the sub-head role, not a kicker: a
			    kicker renders at 16px, which is the size of the body copy under
			    it, so the chapter gave the reader no signal that the subject
			    changed. Same words, promoted voice - the fix 03 already carries,
			    and the reason it has to be an element change rather than a
			    colour one. */}
			<h2 class="type-sub mt-3 text-bone-white">THRESHOLD STATES</h2>
			<p class="wb-prose mt-6">
				Every run ends in one of three states, and a state is the whole contract: the name
				says in one line whether the bytes stayed, whether a marker was minted, and whether
				the engine was in the loop at all.
			</p>
			<p class="wb-prose mt-3">
				The first two are compression states, and the readout names them. The third is a
				compaction state: the token threshold alone decides the first two, while the third
				is the context engine standing down - which is why that knob is documented beside
				the thresholds rather than wired into the readout, and why no readout can print it.
			</p>
			<p class="wb-prose mt-3">
				None of the three is a judgement about the agent's question. Whether a preview
				answers it is the agent's decision, taken with a task in hand: the engine reports
				the state, and the judgement stays with the agent that holds the task.
			</p>
			<div class="mt-12 grid gap-8 lg:grid-cols-3" data-enter="180">
				{States.map((State) => (
					/* min-w-0 + `.break-token` on the WHEN line: that line carries the
						   TOML keys (tool_threshold_token, engine_threshold_pct) in mono
						   with tracking-widest, so an unbreakable 21-character token set
						   the card's min-content at 276px and the three cards ran 12px
						   past a 320px viewport. `.break-token` is the utility Global.css
						   documents for exactly this - a container whose min-content is a
						   token - and this was its first caller. */
					<div class="shell-card min-w-0 p-6">
						<p
							class:list={[
								"telemetry-tag",
								State.Dimension === "COMPACTION"
									? "telemetry-tag--canary"
									: "telemetry-tag--teal",
							]}
						>
							{State.Dimension}
						</p>
						<p class="wb-key mt-4">{State.Label}</p>
						<p class="wb-label break-token mt-3">WHEN: {State.When}</p>
						{State.Note.map((Sentence) => (
							<p class="wb-prose mt-3">{Sentence}</p>
						))}
						<p class="wb-holds mt-6 pl-4">HOLDS: {State.Holds}</p>
					</div>
				))}
			</div>
			<p class="wb-prose mt-12">
				The inputs are printed alongside the name - compression mode, cache lane and storage
				- so a run that reads as surprising can be traced back to the threshold that
				produced it.
			</p>
		</section>

		<!-- 05 // THE TOPOLOGY: the store and the config surface. Two figures on
		     the shell tier; the first carries the chapter's hard shadow and ink,
		     the second stays quiet, so the pair reads as one exhibit and one
		     companion rather than as two equal claims. -->
		<section id="topology" aria-label="Diagrams" class="blueprint-section" data-reveal>
			<p class="section-index">05 // THE TOPOLOGY</p>
			<h2 class="type-sub mt-3 text-bone-white">THE STORE AND THE CONFIG SURFACE</h2>
			<p class="wb-prose mt-4">
				Two parts of the pipeline have no place in a readout: where the store actually
				lives, and where the thresholds come from.
			</p>
			<div class="mt-10 grid gap-8 lg:grid-cols-2">
				{Diagrams.map((Diagram, Index) => (
					<figure
						class:list={[
							"shell-card p-4 sm:p-6",
							Index === 0 && "grunge shadow-[6px_6px_0px_#7a0a1e]",
						]}
						data-grunge={Index === 0 ? "" : undefined}
						data-grunge-mode="edge"
						data-diagram={Diagram.Id}
					>
						<div class="overflow-x-auto" set:html={Diagram.Svg} />
						<figcaption class="mt-6">
							<ZineKicker Tone="dust">{Diagram.Caption}</ZineKicker>
						</figcaption>
						{Diagram.Note.map((Sentence, NoteIndex) => (
							<p class:list={[NoteIndex === 0 ? "mt-6" : "mt-3", "wb-prose"]}>
								{Sentence}
							</p>
						))}
					</figure>
				))}
			</div>
		</section>

		<!-- 06 // THE RECEIPTS: the measured numbers this sim gestures at. The
		     real-world example is promoted to the printed-sheet tier (bone
		     ground, carbon ink, the chapter's one hard shadow) because it is the
		     number the page exists to point at; the other three are receipts
		     read at reading size on the shell tier. -->
		<section
			id="arc"
			aria-label="Benchmark notes"
			class="blueprint-section"
			style="--blueprint-rule: var(--stamped-canary)"
			data-reveal
		>
			<p class="section-index !text-stamped-canary">06 // THE RECEIPTS</p>
			<h2 class="type-sub mt-3 text-bone-white">SIM NOTES · THE MEASURED ARC</h2>
			<p class="wb-prose mt-6">
				The numbers the simulation reaches for are real: each plate prints the figure the
				CHANGELOG carried at that release, and the benchmarks page carries the reproduce
				commands.
			</p>
			<p class="wb-prose mt-3">
				None of them was measured for the simulation. They are historical engine
				measurements, printed as receipts and labelled as such wherever they appear - which
				is the difference between a citation and a claim.
			</p>
			<p class="wb-prose mt-3">
				A plate is a receipt: the figure is what the release printed, and the note beside it
				is what the number means for the design.
			</p>
			<p class="wb-prose mt-3">
				The figures count up once when they come into view, and the note underneath each one
				is what makes the number mean something.
			</p>
			<div class="mt-12 grid gap-6 md:grid-cols-2" data-enter="180">
				{Arc.map((Plate) => (
					<div
						class:list={[
							Plate.Display === "sheet"
								? "tier-inverted grunge grunge--oxblood border-l-4 border-stamped-canary p-6 shadow-[6px_6px_0px_#000] sm:p-8 md:col-span-2"
								: "shell-card p-5 sm:p-6",
						]}
						data-grunge={Plate.Display === "sheet" ? "" : undefined}
						data-grunge-mode="edge"
					>
						<ZineKicker Tone={Plate.Display === "sheet" ? "ink" : "dust"} As="div">
							{Plate.Label}
						</ZineKicker>
						<div
							class:list={[
								Plate.Display === "sheet"
									? "wb-sheet-figure mt-4"
									: `mt-3 font-mono font-black ${Plate.Size ?? "text-2xl"} ${Plate.Tone ?? "text-bone-white"}`,
							]}
						>
							{Plate.Parts.map((Part) =>
								typeof Part === "string" ? (
									Part
								) : (
									<span data-count={Part.Count}>
										{Part.Count.toLocaleString("en-US")}
									</span>
								),
							)}
						</div>
						<p
							class:list={[
								"mt-3 font-mono text-base",
								Plate.Display === "sheet" ? "wb-sheet-note" : "text-zinc-dust",
							]}
						>
							{Plate.Note}
						</p>
					</div>
				))}
			</div>
			<ZineSource
				Lines={[
					"SRC: CHANGELOG.md:962-973 (the ns/µs table) · CHANGELOG.md:983 (216 KB → 12 markers)",
				]}
			/>
		</section>

		<!-- THE BOUNDARY used to close the page here. It now opens it, as a
		     disclosure beside the controls (#boundary, above) - the same text,
		     moved to where a reader meets it before the first figure. -->

		<!-- RELATED: the natural neighbors. -->
		<Related
			Links={[
				{ Href: "/benchmarks/", Label: "BENCHMARKS" },
				{ Href: "/tools/", Label: "TOOLS" },
				{ Href: "/case-study/", Label: "CASE STUDY" },
				{ Href: "/setup/", Label: "SETUP" },
			]}
		/>
	</PageShell>
	<ZineDiagramNav />
</Base>

