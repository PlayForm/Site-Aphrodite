										<span class="text-weathered-teal">{Range}</span>
									</div>
									<div class="flex h-4 w-full overflow-hidden border border-oxblood-dark bg-soot-black">
										<div class={`h-full ${Bar}`} style={`width: ${Width};`} />
									</div>
								</div>
							))
						}
						<div class="font-mono text-[10px] leading-relaxed text-zinc-dust">
							SAVINGS SCALE WITH TOOL-OUTPUT VOLUME AND SESSION LENGTH - THE SAME ENGINE,
							FOUR DIFFERENT PAYOFFS, ALL FROM THE SAME KNOBS.
						</div>
					</div>
				</div>
			</div>
		</section>

