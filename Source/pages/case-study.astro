---
import Base from "@Layout/Base.astro";

// Case-study content ledger - the page's single source of truth (the borrowed
// Content.ts pattern, scoped to this page): every dynamic figure the narrative
// renders comes from this block, exactly as printed in README.md, never
// reworded or rounded. Anchors cite the README lines each fact came from.

// The Sep 2026 real-world study (README.md:467-511).
const Study = {
	Sessions: "200",
	Calls: "6,843",
	Window: "SEP 18-20",
	WithMarkers: "424,959,588",
	Expanded: "581,302,405",
	Saved: "156,342,817",
	SavedPct: "26.9%",
	AvgPerCall: "22,921",
	SessionsSaved: "183 / 200",
	MedianRatio: "22.9%",
	TaxCalls: "2,275",
	TaxTokens: "2,011,583",
	Band: "~24-33%",
	BandCenter: "~27%",
	CharsPerTok: "3.0-4.5",
} as const;

// Savings by session shape (README.md:497-499).
const Bands = [
	{ Label: "CHAT-ONLY SESSIONS", Range: "~0%", Width: "4%", Bar: "bg-zinc-dust" },
	{ Label: "LIGHT DEVELOPER SESSION", Range: "~5%", Width: "10%", Bar: "bg-weathered-teal" },
	{ Label: "LONG TOOL-HEAVY SESSIONS", Range: "20-25%", Width: "38%", Bar: "bg-stamped-canary" },
	{ Label: "PURE-TOOL WORKLOADS", Range: "76-82%", Width: "92%", Bar: "bg-raw-blood" },
] as const;

// Real-world per-output compression, orig tokens -> ~33-tok marker (README.md:485-495).
const RealWorld = [
	{ Type: "TERMINAL", Ratio: "74×" },
	{ Type: "TABLE", Ratio: "61×" },
	{ Type: "SOURCE_CODE", Ratio: "45×" },
	{ Type: "LS", Ratio: "37×" },
	{ Type: "DIFF", Ratio: "23×" },
	{ Type: "BUILD", Ratio: "23×" },
	{ Type: "SEARCH", Ratio: "20×" },
] as const;

// Standard-corpus benchmarks (README.md:444-465).
const Bench = {
	Max: "610×",
	Overall: "132×",
	Latency: "8-40 ms",
	Classify: "40-123 ns",
	Median: "23×",
	Corpus: "106 KB → 800 B",
	RoundTrips: "20/20 COMPRESSED · 20/20 RETRIEVE OK",
} as const;

// The per-type benchmark table (README.md:451-457).
const BenchTypes = [
	{ Type: "GIT DIFF (42L)", Without: "~350 tok", With: "~15 tok", Savings: "23×", Width: "18%" },
	{ Type: "BUILD OUTPUT (142L)", Without: "~1,400 tok", With: "~10 tok", Savings: "140×", Width: "80%" },
	{ Type: "TERMINAL OUTPUT", Without: "~200 tok", With: "~10 tok", Savings: "20×", Width: "16%" },
	{ Type: "JSON BLOB (30 KEYS)", Without: "~400 tok", With: "~10 tok", Savings: "40×", Width: "30%" },
	{ Type: "BROWSER SNAPSHOT (342 EL)", Without: "~5,000 tok", With: "~12 tok", Savings: "416×", Width: "98%" },
] as const;

// The threshold tiers - the knobs (README.md:187-198).
const Tiers = [
	{ Tier: "ERROR", Types: "error", Multiplier: "×8", Note: "errors stay visible longest" },
	{ Tier: "CODE", Types: "code_rust · code_python · code_go · code_js · code", Multiplier: "×3.0", Note: "source earns patience" },
	{ Tier: "DIFF / TRACKED", Types: "diff · git · text", Multiplier: "×2", Note: "history, halved" },
	{ Tier: "DEFAULT", Types: "tool_output · json · everything else", Multiplier: "×1", Note: "the baseline" },
	{ Tier: "NOISY (BASE)", Types: "linter · build_output · log", Multiplier: "×1", Note: "never halved, always squeezed" },
] as const;

// The classifier's visible surface: the 16 pipeline types the README's
// catalog renders (README.md:155-176), backed by the full 30-type registry in
// docs/classification/content-types.md:118-151 (the footnote).
const Classifier = { PipelineTypes: 16, RegistryTypes: 30 } as const;

// The four pipeline layers (README.md:133-138).
const Layers = [
	{ N: "01", Name: "CLASSIFY", Figure: "40-123 ns", Note: "the gate: one type per invocation, first match wins" },
	{ N: "02", Name: "PREVIEW", Figure: "~15 tok", Note: "the answer to 'do I care?' without the content" },
	{ N: "03", Name: "STORE", Figure: "BLAKE3", Note: "SQLite / in-memory, the marker is the receipt" },
	{ N: "04", Name: "DECIDE", Figure: "RETRIEVE?", Note: "the agent, not the engine, spends the budget" },
] as const;
---

<Base
	Title="Case Study - Aphrodite"
	Description="Why Aphrodite is shaped this way: the marker is the contract, the classifier is the gate, the thresholds are the knobs - measured at 156,342,817 context tokens saved across 200 real sessions."
>
	<main
		class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-24 px-5 py-16 sm:px-8 lg:gap-32 lg:px-14 lg:py-24"
	>
		<!-- ============ HERO // THE MANIFESTO OPEN ============ -->
		<header class="relative flex w-full flex-col items-start pt-6">
			<div
				class="tape-strip absolute -top-3.5 left-0 z-10 -rotate-1 border-b border-t border-bone-newsprint/30 px-4 py-1 text-[9px] font-black uppercase tracking-widest text-bone-newsprint"
			>
				CASE FILE // APHRODITE-CCR · SEP 2026 · MEASURED
			</div>
			<div
				class="zine-box-crimson relative w-full border-4 border-blood-crimson bg-carbon-void p-6 sm:p-10 lg:p-14"
			>
				<p class="font-mono text-[11px] font-bold uppercase tracking-widest text-raw-blood">
					THE CASE STUDY // WHY, NOT HOW
				</p>
				<h1
					class="mt-3 font-headline text-5xl font-black uppercase leading-[0.9] tracking-tighter text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-7xl lg:text-8xl"
				>
					Why Aphrodite<br />is shaped <span class="text-stamped-canary">this way</span>
				</h1>
				<p class="mt-6 max-w-3xl font-body text-sm leading-relaxed text-bone-newsprint sm:text-base">
					Not a tour of the code - an argument about the shape. An agent's context is a
					budget, and every tool call spends it on raw output before the agent can decide
					whether any of it mattered. Aphrodite's answer is structural: show the shape of
					the output, keep the substance on call, and make the agent - not the engine -
					the one who pays for detail.
				</p>
				<!-- Monument stat -->
				<div
					class="zine-box-subtle mt-10 w-full max-w-2xl border-[3px] border-raw-blood bg-soot-black p-6 sm:p-8"
				>
					<div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-dust">
						CONTEXT TOKENS SAVED · 200 REAL SESSIONS
					</div>
					<div
						class="mt-2 font-headline text-5xl font-black tracking-tighter text-bone-white drop-shadow-[3px_3px_0px_#520612] sm:text-7xl"
					>
						{Study.Saved}
					</div>
					<div class="mt-2 flex flex-wrap items-center gap-3 font-mono text-xs font-bold">
						<span class="text-stamped-canary">{Study.SavedPct} OF THE TOTAL BUDGET</span>
						<span class="text-zinc-dust">·</span>
						<span class="text-weathered-teal">{Study.AvgPerCall} TOK AVG / CALL</span>
						<span class="text-zinc-dust">·</span>
						<span class="text-zinc-dust">{Study.MedianRatio} MEDIAN SESSION</span>
					</div>
				</div>
			</div>
		</header>

		<!-- ============ I. THE PROBLEM // CONTEXT FLOOD ============ -->
		<section class="relative w-full">
			<div
				class="relative z-10 -mb-3.5 ml-6 inline-block -rotate-1 border border-black bg-raw-blood px-4 py-1.5 font-mono text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				I // THE PROBLEM
			</div>
			<div
				class="zine-box-crimson w-full border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:-rotate-[0.6deg] sm:p-10"
			>
				<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
					<div class="flex flex-col gap-4">
						<h2
							class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl"
						>
							The flood is not the data's fault
						</h2>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							Every file read, build, code search, or browser open floods the agent's
							context with raw output - compilation logs, accessibility trees, JSON
							blobs. The agent spends its budget reading noise instead of reasoning.
						</p>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							The structural failure is that raw output arrives <em>before any decision</em>:
							the context pays the full price for content the agent may never use.
							Compression applied after the fact cannot refund a turn that already
							happened. So the intervention point has to be <strong class="text-bone-white"
								>before the LLM sees anything</strong
							>.
						</p>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							That is the first design commitment: intercept at the tool boundary, not
							inside the prompt. Aphrodite replaces the output with a compact, structured
							preview - ~15 tokens of metadata instead of hundreds - and keeps the full
							content retrievable.
						</p>
					</div>
					<!-- Stream pane: what the model used to see -->
					<div class="flex flex-col gap-3">
						<div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-dust">
							EXHIBIT A // THE RAW FLOOD (142-LINE BUILD OUTPUT)
						</div>
						<div class="border border-oxblood-dark bg-soot-black p-4 font-mono text-[12px] leading-relaxed">
							<div class="text-zinc-dust">$ cargo build --release 2&gt;&amp;1</div>
							<div class="text-bone-newsprint opacity-90">   Compiling libc v0.2.168</div>
							<div class="text-bone-newsprint opacity-80">   Compiling tokio v1.47.1</div>
							<div class="text-bone-newsprint opacity-70">   Compiling serde v1.0.219</div>
							<div class="text-bone-newsprint opacity-60">   Compiling axum v0.8.4</div>
							<div class="text-bone-newsprint opacity-50">   Compiling aphrodite v1.6.6</div>
							<div class="text-bone-newsprint opacity-40">
								... 136 more identical lines ...
							</div>
							<div class="text-bone-newsprint opacity-30">
								warning: unused import: `HashMap`
							</div>
							<div class="text-bone-newsprint opacity-20">
								Finished `release` [optimized] in 41.7s
							</div>
							<div
								class="mt-3 border-t border-oxblood-dark pt-3 text-[10px] font-bold text-raw-blood"
							>
								≈ 1,400 TOKENS · MOSTLY NOISE · ONE LINE MATTERED
							</div>
						</div>
						<!-- Paired preview pane -->
						<div class="border border-oxblood-dark bg-asphalt-panel p-4 font-mono text-[12px]">
							<div class="text-[9px] font-bold uppercase tracking-widest text-zinc-dust">
								THE PREVIEW INSTEAD
							</div>
							<div class="mt-2 border border-oxblood-dark bg-soot-black px-3 py-2 text-bone-white">
								[build:1E 1W 142L | warning: unused import: `HashMap`]
							</div>
							<div class="mt-2 text-weathered-teal">
								&lt;&lt;&lt;CCR:0e3a5c9f...a1e|build|1420&gt;&gt;&gt;
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ II. THE GATE // CLASSIFY ============ -->
		<section class="relative w-full">
			<div
				class="relative z-10 -mb-3.5 ml-6 inline-block rotate-1 border border-black bg-stamped-canary px-4 py-1.5 font-mono text-[11px] font-black uppercase tracking-widest text-soot-black shadow-[3px_3px_0px_#000]"
			>
				II // THE GATE
			</div>
			<div
				class="zine-box-canary w-full border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:rotate-[0.5deg] sm:p-10"
			>
				<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
					<div class="flex flex-col gap-4">
						<h2
							class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl"
						>
							The classifier is the gate
						</h2>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							Why classify before compressing? Because "compress everything equally"
							destroyed signal. A compiler error and a verbose build log are both output -
							but one must stay visible and the other should never have been shown in
							full. A single compression policy cannot serve both.
						</p>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							So the type-aware classifier runs first - 40 to 123 nanoseconds, first match
							wins - and each content type carries its own compression threshold tier. The
							README's pipeline renders {Classifier.PipelineTypes} types in its catalog,
							from <code class="font-mono text-xs">build</code> to
							<code class="font-mono text-xs">text</code>; the full classification registry
							backing it is {Classifier.RegistryTypes} types
							(docs/classification/content-types.md). When the classifier only reaches a
							generic bucket, a conservative semantic detector upgrades it to the
							high-signal shapes (git, gitlog, grep, ls, test); ordinary prose is never
							mis-tagged.
						</p>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							This is the "secret sauce" made plain: <strong class="text-bone-white"
								>the classifier is the gate</strong
							>. Nothing is compressed, stored, or marked until the gate has named it -
							and the name is what everything downstream keys on.
						</p>
					</div>
					<!-- Threshold tier table -->
					<div class="flex flex-col gap-2">
						<div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-dust">
							THRESHOLD TIERS // THE KNOBS
						</div>
						{
							Tiers.map(({ Tier, Types, Multiplier, Note }) => (
								<div class="flex items-center justify-between gap-3 border border-oxblood-dark bg-asphalt-panel px-3 py-2">
									<div class="min-w-0">
										<div class="font-mono text-[11px] font-black uppercase tracking-widest text-bone-white">
											{Tier}
											<span class="ml-2 text-stamped-canary">{Multiplier}</span>
										</div>
										<div class="truncate font-mono text-[10px] text-zinc-dust">{Types}</div>
									</div>
									<div
										class="hidden shrink-0 text-right font-mono text-[10px] text-weathered-teal sm:block"
									>
										{Note}
									</div>
								</div>
							))
						}
						<div class="font-mono text-[10px] leading-relaxed text-zinc-dust">
							HIGHER MULTIPLIER = LONGER THE CONTENT STAYS VISIBLE BEFORE COMPRESSION ·
							CODE ×3.0 IS THE CONFIG DEFAULT · FOOTNOTE: THE FULL REGISTRY IS{" "}
							{Classifier.RegistryTypes} TYPES; THE README CATALOG RENDERS{" "}
							{Classifier.PipelineTypes}.
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ III. THE CONTRACT // THE MARKER ============ -->
		<section class="relative w-full">
			<div
				class="relative z-10 -mb-3.5 ml-6 inline-block -rotate-1 border border-black bg-weathered-teal px-4 py-1.5 font-mono text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				III // THE CONTRACT
			</div>
			<div
				class="zine-box-teal w-full border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:-rotate-[0.4deg] sm:p-10"
			>
				<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
					<div class="flex flex-col gap-4">
						<h2
							class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl"
						>
							The marker is the contract
						</h2>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							Replacing output with a summary only works if the missing content stays
							reachable. The bridge between the two is a single string:
						</p>
						<div
							class="border border-oxblood-dark bg-soot-black px-4 py-3 font-mono text-[12px] text-weathered-teal"
						>
							{"<<<CCR:0e3a5c9f2b8d4e6a1c3f5b7d9e0a2c4b6d8f0a1e|build|1420>>>"}
						</div>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							Hash, type, size - in that order, on purpose. The <strong class="text-bone-white"
								>hash</strong
							> is the full 40-char BLAKE3 digest, the address of the stored original. The
							<strong class="text-bone-white">type</strong> tells the agent what kind of
							thing it skipped. The <strong class="text-bone-white">size</strong> tells it
							how much. Three fields are all an agent needs to decide whether retrieval is
							worth it - which is exactly why the marker, not a tool call, is the
							contract: every retrieval entry point (<code class="font-mono text-xs"
								>aphrodite_retrieve</code
							>, <code class="font-mono text-xs">/retrieve</code>,
							<code class="font-mono text-xs">resolve</code>) accepts the marker body
							directly, suffix or no suffix.
						</p>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							The store behind it is deliberately boring: BLAKE3 → SQLite (persistent, the
							<span class="text-weathered-teal">:9798</span> token listener) or in-memory
							DashMap (10K entries, the <span class="text-weathered-teal">:9797</span>
							cache listener). Storage is not the interesting problem; the interesting
							problem is that the agent's decision needs a stable address - and that is
							all the marker has to be.
						</p>
					</div>
					<!-- Paired panes: stream vs preview with marker -->
					<div class="flex flex-col gap-3">
						<div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-dust">
							EXHIBIT B // ONE OUTPUT, TWO FORMS
						</div>
						<div class="border border-oxblood-dark bg-soot-black p-4 font-mono text-[12px]">
							<div class="text-[9px] font-bold uppercase tracking-widest text-zinc-dust">
								WHAT THE AGENT SEES
							</div>
							<div class="mt-2 text-bone-newsprint opacity-90">
								[build:1E 1W 142L | error[E0432]: unresolved import ...]
							</div>
							<div class="mt-1 text-weathered-teal">
								&lt;&lt;&lt;CCR:0e3a5c9f...|build|1420&gt;&gt;&gt;
							</div>
							<div class="mt-3 border-t border-oxblood-dark pt-2 text-[10px] text-zinc-dust">
								≈ 15 TOKENS
							</div>
						</div>
						<div
							class="flex items-center justify-center text-center font-mono text-[11px] font-black uppercase tracking-widest text-stamped-canary"
						>
							↓ APHRODITE_RETRIEVE(HASH) ONLY IF NEEDED ↓
						</div>
						<div class="border border-oxblood-dark bg-asphalt-panel p-4 font-mono text-[12px]">
							<div class="text-[9px] font-bold uppercase tracking-widest text-zinc-dust">
								WHAT RETRIEVAL RETURNS
							</div>
							<div
								class="mt-2 border border-oxblood-dark bg-soot-black px-3 py-2 text-bone-newsprint opacity-90"
							>
								1,420 BYTES OF ORIGINAL OUTPUT · UNCHANGED
							</div>
							<div class="mt-2 text-[10px] text-zinc-dust">
								RECURSIVE RESOLUTION · NESTED MARKERS HANDLED
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ IV. THE LOOP // FOUR LAYERS ============ -->
		<section class="relative w-full">
			<div
				class="relative z-10 -mb-3.5 ml-6 inline-block rotate-1 border border-black bg-raw-blood px-4 py-1.5 font-mono text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				IV // THE LOOP
			</div>
			<div
				class="zine-box-crimson w-full border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:rotate-[0.4deg] sm:p-10"
			>
				<h2
					class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl"
				>
					Four layers, one decision
				</h2>
				<p class="mt-3 max-w-3xl font-body text-sm leading-relaxed text-bone-newsprint">
					The pipeline is short on purpose: classify, preview, store, decide. The whole
					compress step is sub-millisecond - end-to-end latency is {Bench.Latency} including
					the HTTP round-trip - because the design spends its complexity budget on the
					decision, not the transform.
				</p>
				<div class="mt-8 grid grid-cols-1 items-start gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{
						Layers.map(({ N, Name, Figure, Note }, Index) => {
							const Stamp =
								Index % 3 === 0
									? "bg-raw-blood text-bone-white"
									: Index % 3 === 1
										? "bg-stamped-canary text-soot-black"
										: "bg-weathered-teal text-bone-white";
							return (
								<div class="zine-box-subtle relative border-[3px] border-oxblood-dark bg-carbon-void p-5 pt-7 transition-transform duration-200 hover:rotate-0 sm:-rotate-[1.2deg] sm:hover:rotate-0">
									<div
										class={`absolute -top-2.5 left-4 border border-black px-2 py-0.5 text-[9px] font-black uppercase ${Stamp}`}
									>
										{`LAYER // ${N}`}
									</div>
									<div class="font-headline text-2xl font-black tracking-tight text-bone-white">
										{Figure}
									</div>
									<div class="font-mono text-[11px] font-bold uppercase tracking-widest text-stamped-canary">
										{Name}
									</div>
									<div class="mt-4 border-t border-oxblood-dark pt-3 text-[11px] leading-relaxed text-zinc-dust">
										{Note}
									</div>
								</div>
							);
						})
					}
				</div>
				<div class="mt-8 border border-oxblood-dark bg-asphalt-panel p-4 font-body text-sm leading-relaxed text-bone-newsprint">
					And the engine stays polite about it: compression is opt-in and non-destructive -
					everything the agent ever saw stays retrievable unchanged. What the <code
						class="font-mono text-xs">pre_llm_call</code
					> hook adds each turn is an injection assembler, not a rewrite: directives are
					never dropped, nudges are capped at 2, background status and recall are the first
					things to yield, and the whole injection lives inside a 4,000-character budget.
					Two modes cover every entry point -
					<strong class="text-bone-white">plugin hooks</strong> intercept tool results
					directly with no API round-trip, and the <strong class="text-bone-white">reverse
						proxy</strong
					> compresses Chat Completions responses for any OpenAI-compatible client.
				</div>
			</div>
		</section>

		<!-- ============ V. THE KNOBS // THRESHOLDS ============ -->
		<section class="relative w-full">
			<div
				class="relative z-10 -mb-3.5 ml-6 inline-block -rotate-1 border border-black bg-stamped-canary px-4 py-1.5 font-mono text-[11px] font-black uppercase tracking-widest text-soot-black shadow-[3px_3px_0px_#000]"
			>
				V // THE KNOBS
			</div>
			<div
				class="zine-box-canary w-full border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:-rotate-[0.5deg] sm:p-10"
			>
				<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
					<div class="flex flex-col gap-4">
						<h2
							class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl"
						>
							The thresholds are the knobs
						</h2>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							A compression policy that cannot be tuned is a policy that will be fought.
							Aphrodite's tunables are deliberately few and deliberately at the layer
							where they matter: the threshold multipliers per type (from
							<code class="font-mono text-xs">aphrodite.toml</code>'s
							<code class="font-mono text-xs">[compression]</code>), the
							<code class="font-mono text-xs">preview_max_chars</code> preview budget, and
							the context engine's fill threshold
							(<code class="font-mono text-xs">engine_threshold_pct</code>).
						</p>
						<p class="font-body text-sm leading-relaxed text-bone-newsprint">
							Why so few? Because each knob maps to a question the agent actually asks:
							<em>how patient should I be with this kind of output?</em> The adaptive layer
							answers it statistically - <code class="font-mono text-xs">post_llm_call</code>
							captures savings and updates EMA state per type - so the defaults move
							toward what the sessions themselves prove useful, and the config only has to
							set the priors.
						</p>
					</div>
					<!-- Stat bars: savings bands -->
					<div class="flex flex-col gap-3">
						<div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-dust">
							SAVINGS BANDS // SESSION SHAPE DECIDES (MEASURED)
						</div>
						{
							Bands.map(({ Label, Range, Width, Bar }) => (
								<div>
									<div class="mb-1 flex justify-between font-mono text-[11px] font-bold uppercase">
