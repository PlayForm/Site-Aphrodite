---
import Base from "@Layout/Base.astro";

import PageShell from "@Component/PageShell.astro";
import Related from "@Component/Related.astro";
import SectionNav from "@Component/SectionNav.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineDiagramNav from "@Component/ZineDiagramNav.astro";
import ZineKicker from "@Component/ZineKicker.astro";
import ZinePipeline from "@Component/ZinePipeline.astro";
import ZineSource from "@Component/ZineSource.astro";
import ZineSplit from "@Component/ZineSplit.astro";
import ZineStatBar from "@Component/ZineStatBar.astro";
import ZineTape from "@Component/ZineTape.astro";
import PreviewFlow from "../Content/Mermaid/preview-flow.svg?raw";

import {
	Band,
	Benchmark,
	Cite,
	Figure,
	Narrative,
	Registry,
	Release,
	Study as StudyFacts,
	Tier,
} from "@Library/Numbers";

// Case-study content ledger - the page's single source of truth (the borrowed
// Content.ts pattern, scoped to this page): every dynamic figure the narrative
// renders comes from the generated record `Scripts/Prepare.ts` extracted out of
// `Module/Aphrodite/README.md`, never reworded or rounded. The anchors cite the
// README lines each fact came from, and those line numbers are produced by the
// same pass that produced the figure.
//
// What stays here is the page's own: the labels, the explanations, the
// sentences that turn a figure into a claim. What left is every number.

// The Sep 2026 real-world study (README.md, "Real-world savings"). Only the
// figures the hero monument states live here: the full study - the ledger, the
// session bands, the retrieval tax, the caveat - is the canonical StudyLedger
// module on /benchmarks/, and this page does not carry a second copy of it.
const Study = StudyFacts;

// The three secondary figures, as a labelled strip: the label is the claim and
// the unit is the qualifier, so neither travels without the other. Every value
// is a RECORD joined by ID - the label and the unit are this page's voice, the
// figure, its kind and its scope are the register's - so none of the three can
// be retyped here and drift from the ledger on /benchmarks/. The figures used to
// climb to their values on a counter; a historical measurement is not live
// telemetry, so they are printed settled.
const Metrics = [
	{
		Id: "study.average-per-call",
		Label: "AVERAGE SAVED PER CALL",
		Unit: "TOKENS PER CALL",
		Accent: "text-weathered-teal",
	},
	{
		Id: "study.sessions.saved",
		Label: "SESSIONS WITH NONZERO ESTIMATED REDUCTION",
		Unit: `OF THE ${Study.Sessions} MEASURED`,
		Accent: "text-bone-white",
	},
	{
		Id: "study.median-ratio",
		Label: "MEDIAN SESSION RATIO",
		Unit: "SAVED OF THE BUDGET",
		Accent: "text-weathered-teal",
	},
].map(({ Id, Label, Unit, Accent }) => ({ Label, Unit, Accent, Fact: Figure(Id) }));

// Savings by session shape (README.md, "Real-world savings"). The label
// carries the shape and the range carries the measured band, and the two are
// joined BY ID: `Band(Id)` finds the generated row whose range the ID claims,
// so a README that reorders its shapes relabels nothing and a README that
// renames a range stops the build. The fourth shape is a SIMULATED workload and
// travels with that kind, because a stress test is not a fourth observation.
const Shape = [
	{ Id: "study.band.chat-only", Label: "CHAT-ONLY SESSIONS", Bar: "bg-zinc-dust" },
	{ Id: "study.band.light-developer", Label: "LIGHT DEVELOPER SESSION", Bar: "bg-weathered-teal" },
	{ Id: "study.band.tool-heavy", Label: "LONG TOOL-HEAVY SESSIONS", Bar: "bg-stamped-canary" },
	{ Id: "study.band.pure-tool", Label: "PURE-TOOL WORKLOADS", Bar: "bg-raw-blood" },
];

const Bands = Shape.map(({ Id, Label, Bar }) => ({ Label, Bar, ...Band(Id) }));

// The three claims the page argues, in the order the sections prove them. Each
// is one stamp, one subject, one verb and one sentence - the page's thesis in
// three lines, before the evidence starts.
const Claims = [
	{
		Stamp: "bg-raw-blood text-bone-white",
		Subject: "THE MARKER",
		Verb: "IS THE CONTRACT",
		Body: "<<<CCR:hash|type|size>>> - the address, the kind, and the cost of going back, in one string both the agent and every retrieval entry point understand.",
	},
	{
		Stamp: "bg-stamped-canary text-soot-black",
		Subject: "THE CLASSIFIER",
		Verb: "IS THE GATE",
		Body: "Nothing moves until the type is named - because the type is what decides whether content earns visibility or a squeeze.",
	},
	{
		Stamp: "bg-weathered-teal text-bone-white",
		Subject: "THE THRESHOLDS",
		Verb: "ARE THE KNOBS",
		Body: "A handful of per-type multipliers and a fill threshold - each mapped to one question the agent asks, each tuned by what sessions prove.",
	},
] as const;

// Real-world per-output compression, orig tokens -> ~33-tok marker (README.md,
// "Real-world savings"). `Percent` is the ratio read as a bar width: the column
// is a comparison of magnitudes, so 74x is 74% of the scale and the bars stay
// honest. The generator computes that width from the ratio.
const RealWorld = Benchmark.RealWorld.map(({ Type, Ratio, Percent }) => ({
	Type: Type.replace(/_/g, " ").toUpperCase(),
	Ratio,
	Percent,
}));

// The per-type benchmark table (README.md, "Performance"). The `Width` is the
// bar the corpus plate draws - the ratio's log-scale position, computed by the
// generator so a bar can never disagree with the figure beside it - and the
// label carries the before -> after pair the table states, because a bar alone
// cannot.
const BenchTypes = Benchmark.Classes.map(({ Label, Without, With, Savings, Percent }) => ({
	Type: Label.toUpperCase(),
	Pair: `${Without} → ${With}`,
	Savings,
	Width: Percent,
}));

// The one corpus figure the narrative quotes (README.md, "Performance").
const Bench = { Latency: Benchmark.Latency } as const;

// The threshold tiers - the knobs (README.md, "Threshold Tiers"). Tier, types
// and multiplier are the README's table; the note is this page's reading of
// what the multiplier means. The note is joined to the tier BY NAME, not by
// position, so a reordered table cannot inherit its neighbour's explanation and
// a renamed tier stops the build.
const TierNotes: { Tier: string; Note: string }[] = [
	{ Tier: "ERROR", Note: "errors stay visible longest" },
	{ Tier: "CODE", Note: "source sits at the base threshold unless code_multiplier raises it" },
	{ Tier: "DIFF / TRACKED", Note: "history, halved" },
	{ Tier: "DEFAULT", Note: "the baseline" },
	{ Tier: "NOISY (BASE)", Note: "never halved, always squeezed" },
];

const Tiers = TierNotes.map(({ Tier: Name, Note }) => ({ ...Tier(Name), Note }));

// The classifier's visible surface: the types the README's catalog renders,
// backed by the full registry in the docs tree. Both counts are generated, so
// the footnote cannot outlive the table it describes.
const Classifier = { PipelineTypes: Narrative.CatalogTypes, RegistryTypes: Registry.Types } as const;

// The four pipeline layers (README.md, "Performance" and "How It Works"). The
// one measured figure among them - the classifier's own cost - is generated;
// the rest are the layer's names, not numbers.
const Layers = [
	{ N: "01", Name: "CLASSIFY", Figure: Benchmark.Classify, Tone: "teal", Note: "the gate: one type per invocation, first match wins" },
	{ N: "02", Name: "PREVIEW", Figure: Narrative.PreviewTokens, Tone: "canary", Note: "the answer to 'do I care?' without the content" },
	{ N: "03", Name: "STORE", Figure: "BLAKE3", Tone: "raw", Note: "SQLite / in-memory, the marker is the receipt" },
	{ N: "04", Name: "DECIDE", Figure: "RETRIEVE?", Tone: "bone", Note: "the agent, not the engine, spends the budget" },
] as const;

// EXHIBIT: the 142-line build, kept by the terminal and replaced by one line
// in the model's context. ZineSplit reads the leading `dim:` / `fade:` / `mute:`
// as the suppression tones (70 / 40 / 25%), so the array is the same nine lines
// in the same order and the tone travels in the text, not in a second field.
const Flood = [
	"result:$ cargo build --release 2>&1",
	"dim:    Compiling libc v0.2.168",
	"dim:    Compiling tokio v1.47.1",
	"fade:    Compiling serde v1.0.219",
	"fade:    Compiling axum v0.8.4",
	"mute:    Compiling aphrodite v1.6.6",
	"mute:... 136 more identical lines ...",
	"canary:warning: unused import: `HashMap`",
	"mute:Finished `release` [optimized] in 41.7s",
];

// The page's own section list - SectionNav's only input, which is what keeps
// the index truthful: a link can never name a section this page does not render.
const Sections = [
	{ Id: "claims", Label: "THE CLAIMS" },
	{ Id: "problem", Label: "PROBLEM" },
	{ Id: "gate", Label: "GATE" },
	{ Id: "contract", Label: "CONTRACT" },
	{ Id: "loop", Label: "LOOP" },
	{ Id: "knobs", Label: "KNOBS" },
	{ Id: "evidence", Label: "EVIDENCE" },
	{ Id: "history", Label: "HISTORY" },
];

// The five incidents that set the laws - the page's history spine. Each arc
// runs three beats; a beat is one sentence, or an array of sentences when the
// record states more than one, so the template can render the breakdown law's
// one-<p>-per-sentence without touching a word.
const Arcs = [
	{
		N: "ARC 1",
		Span: "v1.3.0 -> v1.3.2",
		Law: "THE LOSSLESSNESS LAW",
		Tone: "canary",
		Border: "border-raw-blood",
		Title: "Hash the ORIGINAL, never the wrapper",
		Incident: [
			[
				"Compressing a Hermes wrapper stored the <em>extracted</em> content under",
				"<code class=\"font-mono text-base\">hash(extracted)</code> and discarded the original.",
			].join(" "),
			[
				"A failed command's <code class=\"font-mono text-base\">exit_code</code> and",
				"<code class=\"font-mono text-base\">error</code> fields were unrecoverable after",
				"compression, and caller JSON that merely matched a wrapper shape - e.g.",
				"<code class=\"font-mono text-base\">{\"content\":\"hi\",\"id\":42}</code> - got",
				"permanently collapsed to one field.",
			].join(" "),
		],
		Fix: [
			"Both the hook and the tool paths now hash and store the ORIGINAL content always;",
			"the unwrapped view is used only for classification and preview.",
		].join(" "),
		Today: [
			"Retrieval is byte-exact by construction - backends store and return content",
			"verbatim as UTF-8 strings, no zstd on the path - and a full-document retrieval",
			"(<code class=\"font-mono text-base\">limit: 0</code>) returns the exact original",
			"bytes, hashing back to the marker's own hash.",
		].join(" "),
		Src: "SRC: CHANGELOG.md:683-706 · docs/api/retrieve.md (\"byte-exact by construction\")",
	},
	{
		N: "ARC 2",
		Span: "v1.3.8 -> v1.3.9",
		Law: "THE PUBLISHING INCIDENT",
		Tone: "canary",
		Border: "border-stamped-canary",
		Title: "The tarball that compiled locally and failed everywhere else",
		Incident: [
			[
				"v1.3.8 published to crates.io but was <em>uninstallable</em>:",
				"<code class=\"font-mono text-base\">Cargo.toml</code> had",
				"<code class=\"font-mono text-base\">exclude = [..., \"*.md\", ...]</code>, and cargo",
				"applies <code class=\"font-mono text-base\">exclude</code> at publish time -",
				"recursively.",
			].join(" "),
			[
				"The six <code class=\"font-mono text-base\">builtin_directives/*.md</code>",
				"files embedded via <code class=\"font-mono text-base\">include_str!</code> were",
				"stripped from the tarball, so the local checkout built fine and CI's Test job",
				"passed - but <code class=\"font-mono text-base\">cargo install aphrodite</code>",
				"failed at compile time.",
			].join(" "),
		],
		Fix: [
			"Drop the recursive <code class=\"font-mono text-base\">*.md</code> exclusion (and",
			"never combine <code class=\"font-mono text-base\">include</code> with",
			"<code class=\"font-mono text-base\">exclude</code> - cargo would ignore",
			"<code class=\"font-mono text-base\">exclude</code> and drop the targets), add a",
			"<code class=\"font-mono text-base\">cargo package --list</code> packaging guard to",
			"CI, and a durable in-crate regression test that fails when",
			"<code class=\"font-mono text-base\">*.md</code> returns to",
			"<code class=\"font-mono text-base\">exclude</code>.",
		].join(" "),
		Today: [
			"crates.io versions are immutable - v1.3.8 stays broken forever, superseded as",
			"the working release; the packaging guard means this class of regression can",
			"never reach crates.io again.",
		].join(" "),
		Src: "SRC: CHANGELOG.md:408-450",
	},
	{
		N: "ARC 3",
		Span: "v1.6.3",
		Law: "ONE RUNTIME HOME",
		Tone: "teal",
		Border: "border-weathered-teal",
		Title: "One decision, made once, by both halves",
		Incident: [
			[
				"Issue #40: the plugin's Python shim resolved the runtime home from",
				"<code class=\"font-mono text-base\">$HERMES_HOME</code> while the Rust half",
				"resolved it from <code class=\"font-mono text-base\">$HOME</code>.",
			].join(" "),
			[
				"Whenever they diverged - the shipped Docker image, profile gateways - the shim",
				"looked for binaries in a directory that never existed, disabled the plugin, and",
				"orphaned the previous runtime home, config and provider API key included.",
			].join(" "),
		],
		Fix: [
			[
				"The shim resolves the runtime home once",
				"(<code class=\"font-mono text-base\">$APHRODITE_HOME</code> override, then",
				"<code class=\"font-mono text-base\">&lt;hermes-home&gt;/aphrodite</code>, then",
				"<code class=\"font-mono text-base\">~/.hermes/aphrodite</code>) and exports it to",
				"the Rust half through <code class=\"font-mono text-base\">APHRODITE_HOME</code>, so",
				"the dylib and the spawned proxy agree by construction.",
			].join(" "),
			"Legacy installs are adopted with a one-line warning, never migrated.",
		],
		Today: [
			"Per-Hermes-home isolation extends to the whole stack, and the startup log names",
			"the decision: <code class=\"font-mono text-base\">runtime home: &lt;path&gt; (decided by ...)</code>.",
		].join(" "),
		Src: "SRC: CHANGELOG.md:104-154",
	},
	{
		N: "ARC 4",
		Span: "v1.6.5",
		Law: "THE CHECKSUM LAW",
		Tone: "dust",
		Border: "border-raw-blood",
		Title: "In-tree SHA256SUMS.txt is the only truth",
		Incident: [
			[
				"The download scripts used to fetch the release-hosted per-target checksums and",
				"had warn-and-skip paths - a missing checksum file or tool degraded to a warning",
				"instead of a refusal.",
			].join(" "),
			"A plugin-hardening catalog review called it out.",
		],
		Fix: [
			[
				"The pinned tree's <code class=\"font-mono text-base\">SHA256SUMS.txt</code> became",
				"the only checksum source of truth: a missing file, a",
				"<code class=\"font-mono text-base\">BINARY_VERSION</code> mismatch, a missing",
				"target block, or a missing asset entry is a hard refusal (exit 1), and a missing",
				"<code class=\"font-mono text-base\">shasum</code>/<code class=\"font-mono text-base\">sha256sum</code>",
				"tool is a hard refusal rather than a skipped check.",
			].join(" "),
			[
				"The legacy",
				"<code class=\"font-mono text-base\">~/.hermes/aphrodite</code> home adoption in the",
				"runtime lookup is also gone.",
			].join(" "),
		],
		Today: [
			"Every release ships 12 artifacts - 4 targets x (binary, plugin dylib,",
			"SHA256SUMS) - and the dylib arm refuses installs when the in-tree checksums are",
			"missing.",
		].join(" "),
		Src: "SRC: CHANGELOG.md:39-67 · the Aphrodite/v1.6.5 release note",
	},
	{
		N: "ARC 5",
		Span: "v1.6.6",
		Law: "THE PATH GUARDS",
		Tone: "canary",
		Border: "border-stamped-canary",
		Title: "Some paths are never read",
		Incident: [
			"Nothing stopped the prefetch path from reading the files most likely to contain",
			"secrets - environment files, auth tokens, SSH keys, or the Hermes home itself.",
		].join(" "),
		Fix: [
			"<code class=\"font-mono text-base\">aphrodite_prefetch</code> refuses",
			"<code class=\"font-mono text-base\">.env</code>,",
			"<code class=\"font-mono text-base\">auth.json</code>,",
			"<code class=\"font-mono text-base\">~/.ssh</code>, the Hermes home, and non-file",
			"paths outright, answering with",
			"<code class=\"font-mono text-base\">ReadOutcome::Refused</code> plus a",
			"<code class=\"font-mono text-base\">refuse_reason</code> instead of reading them.",
		].join(" "),
		Today: [
			"Setup is hardened the same way: the Hermes-home plugin directory is report-only -",
			"no writes, no deletes - and the same release re-described the context engine as",
			"opt-in with a <code class=\"font-mono text-base\">requires_hermes &gt;= 0.20.2</code>",
			"floor.",
		].join(" "),
		Src: "SRC: CHANGELOG.md:3-37 · the Aphrodite/v1.6.6 release note",
	},
] as const;

// Every version an arc's span names must exist in the CHANGELOG. The history
// spine is the one place this page asserts that a release happened, so this is
// where a citation of a release the repository never cut stops the build -
// `Release` throws with the version it could not find.
for (const Arc of Arcs) {
	for (const Version of Arc.Span.match(/v[\d.]+/g) ?? []) Release(Version);
}

// The arcs with their three beats normalized: `[Beat].flat()` turns a
// single-sentence beat into a one-entry array and leaves a multi-sentence beat
// as it is, so the template has exactly one shape to render.
const ArcsWithBeats = Arcs.map((Arc) => ({
	...Arc,
	Beats: [
		{ Label: "The incident.", Sentences: [Arc.Incident].flat() },
		{ Label: "The fix.", Sentences: [Arc.Fix].flat() },
		{ Label: "Mechanics today.", Sentences: [Arc.Today].flat() },
	],
}));
---

<Base
	Title="CASE STUDY // APHRODITE"
	Description={`Why Aphrodite is shaped this way: the marker is the contract, the classifier is the gate, the thresholds are the knobs - measured at ${Study.TokensSaved} context tokens saved across ${Study.Sessions} real sessions.`}
>
	<PageShell Rhythm="wide">
		<!-- ============ HERO // THE MANIFESTO OPEN ============ -->
		<header class="relative flex w-full flex-col items-start pt-12" data-enter>
			<ZineTape Variant="strip" Label="CASE FILE // APHRODITE-CCR · SEP 2026 · MEASURED" />
			<ZineBox Tone="crimson" Size="lg" Class="w-full lg:p-16">
				<ZineKicker Tone="dust">THE CASE STUDY // WHY, NOT HOW</ZineKicker>
				<h1
					class="mt-8 font-headline text-5xl font-black uppercase leading-[0.9] tracking-tighter text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-7xl lg:text-8xl"
				>
					Why Aphrodite<br />is shaped <span class="text-stamped-canary">this way</span>
				</h1>
				<p class="mt-16 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Not a tour of the code - an argument about the shape.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					An agent's context is a budget, and every tool call spends it on raw output
					before the agent can decide whether any of it mattered.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Aphrodite's answer is structural: show the shape of the output, keep the
					substance on call, and make the agent - not the engine - the one who pays for
					detail.
				</p>
				<!-- Monument stat: the hook. The study's full ledger lives on /benchmarks/.
				     It is its own entrance root, 240ms behind the manifesto it follows,
				     and the two figures climb to their values once. -->
				<div
					class="zine-box-subtle mt-24 w-full max-w-4xl border-[3px] border-raw-blood bg-soot-black p-8 sm:p-10"
					data-enter="240"
				>
					<ZineKicker Tone="dust">CONTEXT TOKENS SAVED · 200 REAL SESSIONS</ZineKicker>
					<div
						class="mt-6 font-headline text-5xl font-black tracking-tighter text-bone-white drop-shadow-[3px_3px_0px_#520612] sm:text-7xl"
					>
						<span>{Study.TokensSaved}</span>
					</div>
					<div class="mt-6 flex flex-wrap items-center gap-8 font-mono text-base font-bold">
						<span class="text-stamped-canary"
							>{Study.SavedPct.replace("%", "")}% OF THE TOTAL BUDGET</span
						>
					</div>
					<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
						The percentage is the honest way to read the number: {Study.TokensSaved} tokens is
						only impressive once you know what it was a share of. {Study.SessionsUnsaved} of
						the {Study.Sessions} sessions saved nothing at all, and the mean is pulled up by
						the long tool-heavy runs - which is why the median sits beside it.
					</p>
					<div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-3">
						{
							Metrics.map(({ Label, Fact, Unit, Accent }) => (
								<div class="border-t border-oxblood-dark pt-4">
									<div class="type-meta font-black text-zinc-dust">{Label}</div>
									<div class={`mt-2 font-headline text-2xl font-black tracking-tight ${Accent}`}>
										{Fact.Value}
									</div>
									<div class="mt-1 type-caption text-zinc-dust">{Unit}</div>
									<div class="mt-1 type-body text-zinc-dust">
										<span class="type-meta">{Fact.Kind.toUpperCase()}</span>{" "}&bull; {Fact.Scope}
									</div>
								</div>
							))
						}
					</div>
					<ZineSource Lines={[`SRC: ${Cite(Study.From)}.`]} />
				</div>
			</ZineBox>
		</header>

		<!-- ============ THE THREE CLAIMS ============ -->
		<section id="claims" class="relative w-full" data-reveal>
			<ZineTape Variant="tab" Label="THE THREE CLAIMS" Color="raw" />
			<p class="mt-16 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				The whole argument fits in three lines, and every section that follows is the evidence for one of
				them.
			</p>
			<!-- The three claims arrive as one plate on a delay of their own: they
			     are a single argument stated three ways, so staggering them one by
			     one would make them read as three separate points. -->
			<div
				class="mt-16 isolate grid grid-cols-1 gap-16 lg:grid-cols-3"
				data-enter="180"
			>
				{
					Claims.map(({ Stamp, Subject, Verb, Body }) => (
						<div class="zine-box-subtle relative border-[3px] border-oxblood-dark bg-carbon-void p-6 pt-9 transition-transform duration-200 hover:rotate-0 sm:-rotate-[1deg] sm:hover:rotate-0">
							<div
								class={`inline-block px-3 py-1 font-mono text-base font-black uppercase tracking-widest ${Stamp}`}
							>
								{Subject}
							</div>
							<h2 class="mt-8 font-headline text-2xl font-black uppercase tracking-tight text-bone-white">
								{Verb}
							</h2>
							<p class="mt-6 font-body text-base leading-relaxed text-bone-newsprint">{Body}</p>
						</div>
					))
				}
			</div>
			<p class="mt-16 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				That is the whole architecture.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				The agent keeps its budget for reasoning, and pays for detail only when detail is the
				answer.
			</p>
		</section>

		<SectionNav Sections={Sections} />

		<!-- ============ I. THE PROBLEM // CONTEXT FLOOD ============ -->
		<section id="problem" class="relative w-full" data-reveal>
			<ZineTape Variant="tab" Label="I // THE PROBLEM" Color="raw" />
			<ZineBox Tone="crimson" Size="lg" Rotate="-rotate-[0.6deg]" Class="w-full" Wipe>
				<h2 class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl">
					The flood is not the data's fault
				</h2>
				<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Every file read, build, code search, or browser open floods the agent's
					context with raw output - compilation logs, accessibility trees, JSON blobs.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The agent spends its budget reading noise instead of reasoning.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The structural failure is that raw output arrives{" "}
					<em>before any decision</em>: the context pays the full price for content
					the agent may never use.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Compression applied after the fact cannot refund a turn that already
					happened.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					So the intervention point has to be{" "}
					<strong class="text-bone-white">before the LLM sees anything</strong>.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					That is the first design commitment: intercept at the tool boundary, not
					inside the prompt.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Aphrodite replaces the output with a compact, structured preview - {Narrative.PreviewTokens}
					of metadata instead of hundreds - and keeps the full content
					retrievable.
				</p>
			</ZineBox>
			<!-- THE PAIR: the terminal keeps the flood, the model reads one line. -->
			<div class="mt-24">
				<ZineSplit
					Raw={Flood}
					Preview="[build:1E 1W 142L | error[E0432]: unresolved import ...]"
					Hash="&lt;&lt;&lt;CCR:0e3a5c9f...a1e|build|1420&gt;&gt;&gt;"
				/>
			</div>
			<div class="mt-8">
				<ZineKicker Tone="dust" As="div">
					≈ 1,400 TOKENS · MOSTLY NOISE · ONE LINE MATTERED
				</ZineKicker>
			</div>
		</section>

		<!-- ============ II. THE GATE // CLASSIFY ============ -->
		<section id="gate" class="relative w-full" data-reveal>
			<ZineTape Variant="tab" Label="II // THE GATE" Color="canary" Rotate="rotate-1" />
			<ZineBox Tone="canary" Size="lg" Rotate="rotate-[0.5deg]" Class="w-full" Wipe>
				<h2 class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl">
					The classifier is the gate
				</h2>
				<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Why classify before compressing?
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Because "compress everything equally" destroyed signal.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					A compiler error and a verbose build log are both output - but one must
					stay visible and the other should never have been shown in full.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					A single compression policy cannot serve both.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					So the type-aware classifier runs first - {Benchmark.Classify}, first
					match wins - and each content type carries its own compression threshold
					tier.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The README's pipeline renders {Classifier.PipelineTypes} types in its
					catalog, from <code class="font-mono text-base">build</code> to{" "}
					<code class="font-mono text-base">text</code>; the full classification
					registry backing it is {Classifier.RegistryTypes} types
					(docs/classification/content-types.md).
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					When the classifier only reaches a generic bucket, a conservative semantic
					detector upgrades it to the high-signal shapes (git, gitlog, grep, ls,
					test); ordinary prose is never mis-tagged.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					This is the "secret sauce" made plain:{" "}
					<strong class="text-bone-white">the classifier is the gate</strong>.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Nothing is compressed, stored, or marked until the gate has named it - and
					the name is what everything downstream keys on.
				</p>
			</ZineBox>
			<figure
				class="mt-24 border border-oxblood-dark bg-asphalt-panel p-4"
				data-diagram="preview-flow"
				data-enter="220"
			>
				<div class="overflow-x-auto" set:html={PreviewFlow} />
				<figcaption class="mt-6 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
					M2 // PREVIEW FLOW
				</figcaption>
				<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The figure runs in one direction: every blob is classified first, then routed into
					one of five threshold groups:
				</p>
				<ul class="mt-3 max-w-3xl space-y-2 font-body text-base leading-relaxed text-bone-newsprint">
					<li class="border-l-4 border-raw-blood pl-4">error ×8</li>
					<li class="border-l-4 border-raw-blood pl-4">code ×3.0</li>
					<li class="border-l-4 border-raw-blood pl-4">tracked ×2</li>
					<li class="border-l-4 border-raw-blood pl-4">default ×1</li>
					<li class="border-l-4 border-raw-blood pl-4">and the noisy base group.</li>
				</ul>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The noisy group is pinned - linter, build_output and log are never halved and
					never tuned.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					On top of the tier sits the EMA auto-tune:
				</p>
				<ul class="mt-3 max-w-3xl space-y-2 font-body text-base leading-relaxed text-bone-newsprint">
					<li class="border-l-4 border-raw-blood pl-4">
						a type whose measured ratio stays above 20 doubles its patience
					</li>
					<li class="border-l-4 border-raw-blood pl-4">a type under 3 halves it</li>
					<li class="border-l-4 border-raw-blood pl-4">
						and the budget header scales the result between ×0.5 and ×1.0.
					</li>
				</ul>
			</figure>
		</section>

		<!-- ============ III. THE CONTRACT // THE MARKER ============ -->
		<section id="contract" class="relative w-full" data-reveal>
			<ZineTape Variant="tab" Label="III // THE CONTRACT" Color="teal" />
			<ZineBox Tone="teal" Size="lg" Rotate="-rotate-[0.4deg]" Class="w-full" Wipe>
				<h2 class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl">
					The marker is the contract
				</h2>
				<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Replacing output with a summary only works if the missing content stays
					reachable.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The bridge between the two is a single string:
				</p>
				<div class="ccr-marker mt-6 border border-oxblood-dark bg-soot-black px-4 py-3 font-mono text-base text-weathered-teal">
					{"<<<CCR:0e3a5c9f2b8d4e6a1c3f5b7d9e0a2c4b6d8f0a1e|build|1420>>>"}
				</div>
				<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Hash, type, size - in that order, on purpose.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The <strong class="text-bone-white">hash</strong> is the full 40-char BLAKE3
					digest, the address of the stored original.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The <strong class="text-bone-white">type</strong> tells the agent what kind
					of thing it skipped.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The <strong class="text-bone-white">size</strong> tells it how much.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Three fields are all an agent needs to decide whether retrieval is worth it
					- which is exactly why the marker, not a tool call, is the contract: every
					retrieval entry point (<code class="font-mono text-base">aphrodite_retrieve</code>,
					<code class="font-mono text-base">/retrieve</code>,
					<code class="font-mono text-base">resolve</code>) accepts the marker body
					directly, suffix or no suffix.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The marker carries no content of its own - three fields and no payload - so it can
					be printed, copied and passed around without spending the budget it was minted to
					save.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The store behind it is deliberately boring: BLAKE3 → SQLite (persistent, the
					<span class="text-weathered-teal">:9798</span> token listener) or in-memory
					DashMap (10K entries, the <span class="text-weathered-teal">:9797</span>
					cache listener).
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Storage is not the interesting problem; the interesting problem is that the
					agent's decision needs a stable address - and that is all the marker has to
					be.
				</p>
			</ZineBox>
		</section>

		<!-- ============ IV. THE LOOP // FOUR LAYERS ============ -->
		<section id="loop" class="relative w-full" data-reveal>
			<ZineTape Variant="tab" Label="IV // THE LOOP" Color="raw" Rotate="rotate-1" />
			<ZineBox Tone="crimson" Size="lg" Rotate="rotate-[0.4deg]" Class="w-full" Wipe>
				<h2 class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl">
					Four layers, one decision
				</h2>
				<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The pipeline is short on purpose: classify, preview, store, decide.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The whole compress step is sub-millisecond - end-to-end latency is {Bench.Latency}
					including the HTTP round-trip - because the design spends its complexity budget
					on the decision, not the transform.
				</p>
				<!-- The layer grid: 2x2 until xl - aligned with the index stage grid,
				     where 4-across between 1024-1279px squished the cards. -->
				<div
					class="mt-16 isolate grid grid-cols-1 items-start gap-16 sm:grid-cols-2 xl:grid-cols-4"
					data-enter="200"
				>
					{
						Layers.map(({ N, Name, Figure, Tone, Note }) => (
							<div class="zine-box-subtle relative border-[3px] border-oxblood-dark bg-carbon-void p-6 pt-9 transition-transform duration-200 hover:rotate-0 sm:-rotate-[1.2deg] sm:hover:rotate-0">
								<ZineTape Label={`LAYER // ${N}`} Color={Tone} Side="left" />
								<div class="font-headline text-2xl font-black tracking-tight text-bone-white">
									{Figure}
								</div>
								<ZineKicker Tone="canary" As="div">
									{Name}
								</ZineKicker>
								<div class="mt-8 border-t border-oxblood-dark pt-8 text-base leading-relaxed text-zinc-dust">
									{Note}
								</div>
							</div>
						))
					}
				</div>
				<div class="mt-16 border border-oxblood-dark bg-asphalt-panel p-5 font-body text-base leading-relaxed text-bone-newsprint">
					<p>
						And the engine stays polite about it: compression is opt-in and non-destructive
						- everything the agent ever saw stays retrievable unchanged.
					</p>
					<p class="mt-3">
						What the <code class="font-mono text-base">pre_llm_call</code> hook adds each
						turn is an injection assembler, not a rewrite: directives are never dropped,
						nudges are capped at 2, background status and recall are the first things to
						yield, and the whole injection lives inside a 4,000-character budget.
					</p>
					<p class="mt-3">
						Two modes cover every entry point -
						<strong class="text-bone-white">plugin hooks</strong> intercept tool results
						directly with no API round-trip, and the{" "}
						<strong class="text-bone-white">reverse proxy</strong> compresses Chat
						Completions responses for any OpenAI-compatible client.
					</p>
					<p class="mt-3">
						No clever model, no lossy summarizer in the loop - just an honest receipt, a
						fast gate, and a set of knobs the evidence can turn.
					</p>
				</div>
				<!-- THE DECIDE BRANCH: the fourth layer, made visible. -->
				<h3 class="mt-24 font-headline text-xl font-black uppercase tracking-tight text-bone-white sm:text-2xl">
					The decision, in two branches
				</h3>
				<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Every marker ends in the same question, and the agent answers it twice: the
					preview either carried enough, or it did not.
				</p>
				<div class="mt-16">
					<ZinePipeline Mode="decide" />
				</div>
			</ZineBox>
		</section>

		<!-- ============ V. THE KNOBS // THRESHOLDS ============ -->
		<section id="knobs" class="relative w-full" data-reveal>
			<ZineTape Variant="tab" Label="V // THE KNOBS" Color="canary" />
			<ZineBox Tone="canary" Size="lg" Rotate="-rotate-[0.5deg]" Class="w-full" Wipe>
				<div class="grid grid-cols-1 gap-32 lg:grid-cols-2" data-enter="200">
					<div>
						<h2 class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl">
							The thresholds are the knobs
						</h2>
						<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
							A compression policy that cannot be tuned is a policy that will be fought.
						</p>
						<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
							Aphrodite's tunables are deliberately few and deliberately at the layer
							where they matter: the threshold multipliers per type (from
							<code class="font-mono text-base">aphrodite.toml</code>'s{" "}
							<code class="font-mono text-base">[compression]</code>), the{" "}
							<code class="font-mono text-base">preview_max_chars</code> preview budget,
							and the context engine's fill threshold (
							<code class="font-mono text-base">engine_threshold_pct</code>).
						</p>
						<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
							Why so few?
						</p>
						<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
							Because each knob maps to a question the agent actually asks:{" "}
							<em>how patient should I be with this kind of output?</em>
						</p>
						<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
							The adaptive layer answers it statistically -{" "}
							<code class="font-mono text-base">post_llm_call</code> captures savings and
							updates EMA state per type - so the defaults move toward what the sessions
							themselves prove useful, and the config only has to set the priors.
						</p>
						<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
							The savings those priors produce across 200 real sessions - the ledger, the
							session-shape bands, the retrieval tax - are on the benchmarks page, which owns
							the study.
						</p>
					</div>
					<!-- THRESHOLD TIERS: the multiplier each content type carries. -->
					<div class="flex flex-col gap-6">
						<ZineKicker Tone="dust">THRESHOLD TIERS</ZineKicker>
						{
							Tiers.map(({ Tier, Types, Multiplier, Note }) => (
								<div class="flex items-center justify-between gap-8 border border-oxblood-dark bg-asphalt-panel px-4 py-3">
									<div class="min-w-0">
										<div class="font-mono text-base font-black uppercase tracking-widest text-bone-white">
											{Tier}
											<span class="ml-2 text-stamped-canary">{Multiplier}</span>
										</div>
										<div class="truncate font-mono text-base text-zinc-dust">{Types}</div>
									</div>
									<div class="hidden shrink-0 text-right font-mono text-base text-weathered-teal sm:block">
										{Note}
									</div>
								</div>
							))
						}
						<div class="font-mono text-base leading-relaxed text-zinc-dust">
							HIGHER MULTIPLIER = LONGER THE CONTENT STAYS VISIBLE BEFORE COMPRESSION
						</div>
						<div class="font-mono text-base leading-relaxed text-zinc-dust">
							CODE {Narrative.CodeMultiplier} IS THE SHIPPED DEFAULT ({Narrative.CodeMultiplierKey.toUpperCase()}) - SOURCE SITS AT THE BASE THRESHOLD UNTIL AN OPERATOR RAISES IT
						</div>
						<ZineSource Lines={[`SRC: ${Cite(Narrative.From)}.`]} />
					</div>
				</div>
			</ZineBox>
		</section>

		<!-- ============ VI. THE EVIDENCE // TWO PLATES ============ -->
		<section id="evidence" class="relative w-full" data-reveal>
			<ZineTape Variant="tab" Label="VI // THE EVIDENCE" Color="teal" Rotate="rotate-1" />
			<ZineBox Tone="teal" Size="lg" Rotate="-rotate-[0.4deg]" Class="w-full" Wipe>
				<h2 class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl">
					What one output costs
				</h2>
				<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Two views survive here because they are the argument's own: what each output
					class compressed to in the wild, and what the standard corpus paid per type.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The corpus ratios, the {Benchmark.Ceiling} ceiling, the median and the reproduce
					commands are on the benchmarks page.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Every bar is its ratio read as a width - {Benchmark.RealWorld[0]!.Ratio} fills{" "}
					{Benchmark.RealWorld[0]!.Percent}% of the scale - so the two columns compare
					magnitudes without normalising either one.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Read together, the plates carry the argument's sharpest claim: the ratio is a
					property of the content type, not of the session that produced it.
				</p>
				<div class="mt-16 grid grid-cols-1 gap-24 lg:grid-cols-2" data-enter="200">
					<!-- Real-world per-output compression -->
					<div class="flex flex-col gap-8">
						<ZineKicker Tone="dust" As="div">
							REAL-WORLD PER-OUTPUT COMPRESSION (ORIG → {Narrative.MarkerTokens.toUpperCase()} MARKER) &bull; ESTIMATED
						</ZineKicker>
						{
							RealWorld.map(({ Type, Ratio, Percent }) => (
								<ZineStatBar Label={Type} Ratio={Ratio} Percent={Percent} Color="canary" />
							))
						}
					</div>
					<!-- Per-type standard-corpus bars -->
					<div class="flex flex-col gap-8">
						<ZineKicker Tone="dust" As="div">
							PER-TYPE COMPRESSION (STANDARD CORPUS) &bull; MEASURED
						</ZineKicker>
						{
							BenchTypes.map(({ Type, Pair, Savings, Width }) => (
								<ZineStatBar Label={`${Type} · ${Pair}`} Ratio={Savings} Percent={Width} Color="teal" />
							))
						}
						<ZineKicker Tone="canary" As="div">
							20/20 COMPRESSED · 20/20 RETRIEVE OK
						</ZineKicker>
					</div>
				</div>
				<!-- THE RETRIEVAL TAX AND THE CONFIDENCE NOTE -->
				<div class="mt-24 grid grid-cols-1 gap-16 lg:grid-cols-2" data-enter="320">
					<div class="border-l-4 border-weathered-teal pl-6">
						<ZineKicker Tone="teal" As="div">RETRIEVAL TAX</ZineKicker>
						<p class="mt-6 font-body text-base leading-relaxed text-bone-newsprint">
							Retrieval re-entry cost <span class="text-stamped-canary">{Study.TaxCalls}</span> calls
							and <span class="text-stamped-canary">{Study.TaxTokens}</span> tokens across the
							study - the price of going back for detail.
						</p>
						<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
							It is the reason the design pushes previews so hard: the tax only gets paid
							when the preview fails to answer the question, so the preview is engineered
							to answer most of them.
						</p>
						<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
							Read against the ledger, that is about {Study.TaxPct} of the tokens the study saved:
							the whole cost of going back, paid only on the turns a preview did not
							answer. Paying the full output again instead would have cost roughly {Study.TaxFactor}
							times as much.
						</p>
					</div>
					<div
						class="border border-oxblood-dark bg-asphalt-panel p-5 font-body text-base leading-relaxed text-bone-newsprint"
					>
						<p>
							<span class="font-mono text-base font-bold uppercase tracking-widest text-zinc-dust">
								CONFIDENCE ·{" "}
							</span>The causal result - CCR removes context pressure for large repeated tool
							outputs, and tool-heavy usage benefits far more than chat - is high.
						</p>
						<p class="mt-3">
							The exact percentage is a band: the marker's byte size is the only trace of
							the original content (the inline store is session-scoped), so savings were
							estimated with a calibrated chars/tok ratio; sensitivity across{" "}
							{Study.CharsPerTok} chars/tok spans {Study.Band}, centered {Study.BandCenter}.
						</p>
						<p class="mt-3">
							And the study is an author-run reconstruction, not a randomised comparison: it establishes
							neither better task success nor universal cost savings. What it measures is how much context
							the markers replaced in these sessions, and what that reconstruction cost in tokens.
						</p>
					</div>
				</div>
				<!-- SAVINGS BY SESSION SHAPE -->
				<div class="mt-24" data-enter="440">
					<ZineKicker Tone="dust" As="div">SAVINGS BY SESSION SHAPE</ZineKicker>
					<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
						The same engine saves nothing in a chat and almost everything in a tool-heavy run,
						because the ratio tracks how much raw output the session produces at all.
					</p>
					<div class="mt-8 flex flex-col gap-6">
						{
							Bands.map(({ Label, Range, Percent, Bar, Kind }) => (
								<div>
									<div class="flex flex-wrap items-baseline justify-between gap-4 font-mono text-base">
										<span class="font-black uppercase tracking-widest text-bone-white">{Label}</span>
										<span class="flex items-baseline gap-3">
											{
												Kind === "simulated" && (
													<span class="border border-raw-blood px-1.5 py-0.5 type-meta font-black text-raw-blood">
														SIMULATED
													</span>
												)
											}
											<span class="text-stamped-canary">{Range}</span>
										</span>
									</div>
									<div class="mt-2 h-3 w-full border border-oxblood-dark bg-soot-black">
										<div class={`h-full ${Bar}`} style={`width: ${Percent}%`} />
									</div>
								</div>
							))
						}
					</div>
					<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
						A pure-tool workload is the ceiling case and a chat-only session is the floor, which is
						why the study reports a median beside the mean. The fourth bar is a simulated loop, not a
						recorded session: it is marked as one because a stress test read as a fourth observation would
						be the page's own over-claim.
					</p>
					<div class="mt-6 font-mono text-base leading-relaxed text-zinc-dust">
						SAVINGS SCALE WITH TOOL-OUTPUT VOLUME AND SESSION LENGTH - THE SAME ENGINE, FOUR
						DIFFERENT PAYOFFS, ALL FROM THE SAME KNOBS.
					</div>
				</div>
				<ZineSource
					Lines={[
						`SRC: ${Cite(Study.From)} (the per-output compression and the session-shape bands) · ${Cite(Benchmark.From)} (the per-type table and the round trips).`,
					]}
				/>
			</ZineBox>
		</section>

		<!-- ============ VII. THE HISTORY SPINE ============ -->
		<section id="history" class="relative w-full" data-reveal>
			<ZineTape Variant="tab" Label="VII // THE HISTORY SPINE" Color="raw" />
			<ZineBox Tone="crimson" Size="lg" Rotate="-rotate-[0.3deg]" Class="w-full" Wipe>
				<h2 class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl">
					Five incidents that set the laws
				</h2>
				<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Every rule in the engine was paid for once.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Each arc runs the same three beats: the incident, the fix, and the
					mechanic that still stands today.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					All of it is public record - the CHANGELOG entries and the release notes.
				</p>
				<div class="mt-24 flex flex-col gap-32">
					{
						ArcsWithBeats.map(({ N, Span, Law, Tone, Border, Title, Beats, Src }) => (
							<article class={`border-l-4 ${Border} pl-6 sm:pl-10`} data-reveal>
								<ZineKicker Tone={Tone} As="div">
									{`${N} · ${Span} · ${Law}`}
								</ZineKicker>
								<h3 class="mt-6 font-headline text-xl font-black uppercase tracking-tight text-bone-white sm:text-2xl">
									{Title}
								</h3>
								{
									Beats.map((Beat, BeatIndex) =>
										Beat.Sentences.map((Sentence, Index) => (
											<p
												class:list={[
													BeatIndex === 0 && Index === 0 ? "mt-6" : "mt-3",
													"max-w-3xl font-body text-base leading-relaxed text-bone-newsprint",
												]}
											>
												{Index === 0 && (
													<>
														<strong class="text-bone-white">{Beat.Label}</strong>{" "}
													</>
												)}
												<span set:html={Sentence} />
											</p>
										)),
									)
								}
								<ZineSource Lines={[Src]} />
							</article>
						))
					}
				</div>
			</ZineBox>
		</section>

		<!-- RELATED: the natural neighbors. -->
