---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import CodeFence from "@Component/CodeFence.astro";
import ZineDiagramNav from "@Component/ZineDiagramNav.astro";
import PreviewFlow from "../Content/Mermaid/preview-flow.svg?raw";

// Case-study content ledger - the page's single source of truth (the borrowed
// Content.ts pattern, scoped to this page): every dynamic figure the narrative
// renders comes from this block, exactly as printed in README.md, never
// reworded or rounded. Anchors cite the README lines each fact came from.

// The Sep 2026 real-world study (README.md:467-511).
const Study = {
	Sessions: "200",
	Calls: "6,843",
	Window: "SEP 18-20",
	WithMarkers: "424,959,588",
	Expanded: "581,302,405",
	Saved: "156,342,817",
	SavedPct: "26.9%",
	AvgPerCall: "22,921",
	SessionsSaved: "183 / 200",
	MedianRatio: "22.9%",
	TaxCalls: "2,275",
	TaxTokens: "2,011,583",
	Band: "~24-33%",
	BandCenter: "~27%",
	CharsPerTok: "3.0-4.5",
} as const;

// Savings by session shape (README.md:497-499).
const Bands = [
	{ Label: "CHAT-ONLY SESSIONS", Range: "~0%", Width: "4%", Bar: "bg-zinc-dust" },
	{ Label: "LIGHT DEVELOPER SESSION", Range: "~5%", Width: "10%", Bar: "bg-weathered-teal" },
	{ Label: "LONG TOOL-HEAVY SESSIONS", Range: "20-25%", Width: "38%", Bar: "bg-stamped-canary" },
	{ Label: "PURE-TOOL WORKLOADS", Range: "76-82%", Width: "92%", Bar: "bg-raw-blood" },
] as const;

// Real-world per-output compression, orig tokens -> ~33-tok marker (README.md:485-495).
const RealWorld = [
	{ Type: "TERMINAL", Ratio: "74×" },
	{ Type: "TABLE", Ratio: "61×" },
	{ Type: "SOURCE_CODE", Ratio: "45×" },
	{ Type: "LS", Ratio: "37×" },
	{ Type: "DIFF", Ratio: "23×" },
	{ Type: "BUILD", Ratio: "23×" },
	{ Type: "SEARCH", Ratio: "20×" },
] as const;

// Standard-corpus benchmarks (README.md:444-465).
const Bench = {
	Max: "610×",
	Overall: "132×",
	Latency: "8-40 ms",
	Classify: "40-123 ns",
	Median: "23×",
	Corpus: "106 KB → 800 B",
	RoundTrips: "20/20 COMPRESSED · 20/20 RETRIEVE OK",
} as const;

// The per-type benchmark table (README.md:451-457).
const BenchTypes = [
	{ Type: "GIT DIFF (42L)", Without: "~350 tok", With: "~15 tok", Savings: "23×", Width: "18%" },
	{ Type: "BUILD OUTPUT (142L)", Without: "~1,400 tok", With: "~10 tok", Savings: "140×", Width: "80%" },
	{ Type: "TERMINAL OUTPUT", Without: "~200 tok", With: "~10 tok", Savings: "20×", Width: "16%" },
	{ Type: "JSON BLOB (30 KEYS)", Without: "~400 tok", With: "~10 tok", Savings: "40×", Width: "30%" },
	{ Type: "BROWSER SNAPSHOT (342 EL)", Without: "~5,000 tok", With: "~12 tok", Savings: "416×", Width: "98%" },
] as const;

// The threshold tiers - the knobs (README.md:187-198).
const Tiers = [
	{ Tier: "ERROR", Types: "error", Multiplier: "×8", Note: "errors stay visible longest" },
	{ Tier: "CODE", Types: "code_rust · code_python · code_go · code_js · code", Multiplier: "×3.0", Note: "source earns patience" },
	{ Tier: "DIFF / TRACKED", Types: "diff · git · text", Multiplier: "×2", Note: "history, halved" },
	{ Tier: "DEFAULT", Types: "tool_output · json · everything else", Multiplier: "×1", Note: "the baseline" },
	{ Tier: "NOISY (BASE)", Types: "linter · build_output · log", Multiplier: "×1", Note: "never halved, always squeezed" },
] as const;

// The classifier's visible surface: the 16 pipeline types the README's
// catalog renders (README.md:155-176), backed by the full 30-type registry in
// docs/classification/content-types.md:118-151 (the footnote).
const Classifier = { PipelineTypes: 16, RegistryTypes: 30 } as const;

// The four pipeline layers (README.md:133-138).
const Layers = [
	{ N: "01", Name: "CLASSIFY", Figure: "40-123 ns", Note: "the gate: one type per invocation, first match wins" },
	{ N: "02", Name: "PREVIEW", Figure: "~15 tok", Note: "the answer to 'do I care?' without the content" },
	{ N: "03", Name: "STORE", Figure: "BLAKE3", Note: "SQLite / in-memory, the marker is the receipt" },
	{ N: "04", Name: "DECIDE", Figure: "RETRIEVE?", Note: "the agent, not the engine, spends the budget" },
] as const;
---

<Base
	Title="CASE STUDY // APHRODITE"
	Description="Why Aphrodite is shaped this way: the marker is the contract, the classifier is the gate, the thresholds are the knobs - measured at 156,342,817 context tokens saved across 200 real sessions."
>
	<main
		class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-40 px-5 py-24 sm:px-8 lg:gap-64 lg:px-14 lg:py-40"
	>
		<!-- ============ HERO // THE MANIFESTO OPEN ============ -->
		<header class="relative flex w-full flex-col items-start pt-12">
			<div
				class="tape-strip absolute -top-6 left-0 z-10 -rotate-1 border-b border-t border-bone-newsprint/30 px-4 py-1 text-base font-black uppercase tracking-widest text-bone-newsprint"
			>
				CASE FILE // APHRODITE-CCR · SEP 2026 · MEASURED
			</div>
			<div
				class="zine-box-crimson relative w-full border-4 border-blood-crimson bg-carbon-void p-8 sm:p-12 lg:p-16"
			>
				<p class="font-mono text-base font-bold uppercase tracking-widest text-raw-blood">
					THE CASE STUDY // WHY, NOT HOW
				</p>
				<h1
					class="mt-8 font-headline text-5xl font-black uppercase leading-[0.9] tracking-tighter text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-7xl lg:text-8xl"
				>
					Why Aphrodite<br />is shaped <span class="text-stamped-canary">this way</span>
				</h1>
				<p class="mt-16 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint sm:text-base">
					Not a tour of the code - an argument about the shape.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint sm:text-base">
					An agent's context is a budget, and every tool call spends it on raw output
					before the agent can decide whether any of it mattered.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint sm:text-base">
					Aphrodite's answer is structural: show the shape of the output, keep the
					substance on call, and make the agent - not the engine - the one who pays for
					detail.
				</p>
				<!-- Monument stat -->
				<div
					class="zine-box-subtle mt-24 w-full max-w-2xl border-[3px] border-raw-blood bg-soot-black p-8 sm:p-10"
				>
					<div class="font-mono text-base font-bold uppercase tracking-widest text-zinc-dust">
						CONTEXT TOKENS SAVED · 200 REAL SESSIONS
					</div>
					<div
						class="mt-6 font-headline text-5xl font-black tracking-tighter text-bone-white drop-shadow-[3px_3px_0px_#520612] sm:text-7xl"
					>
						{Study.Saved}
					</div>
					<div class="mt-6 flex flex-wrap items-center gap-8 font-mono text-base font-bold">
						<span class="text-stamped-canary">{Study.SavedPct} OF THE TOTAL BUDGET</span>
						<span class="text-zinc-dust">·</span>
						<span class="text-weathered-teal">{Study.AvgPerCall} TOK AVG / CALL</span>
						<span class="text-zinc-dust">·</span>
						<span class="text-zinc-dust">{Study.MedianRatio} MEDIAN SESSION</span>
					</div>
					<div class="mt-6 font-mono text-base text-zinc-dust">SRC: README.md:467-511.</div>
				</div>
			</div>
		</header>

		<!-- ============ I. THE PROBLEM // CONTEXT FLOOD ============ -->
		<section class="relative w-full">
			<div
				class="relative z-10 -mb-7 ml-6 inline-block -rotate-1 border border-black bg-raw-blood px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				I // THE PROBLEM
			</div>
			<div
				class="zine-box-crimson w-full border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:-rotate-[0.6deg] sm:p-12"
			>
				<div class="grid grid-cols-1 gap-32 lg:grid-cols-2">
					<div class="flex flex-col gap-12">
						<h2
							class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl"
						>
							The flood is not the data's fault
						</h2>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Every file read, build, code search, or browser open floods the agent's
							context with raw output - compilation logs, accessibility trees, JSON blobs.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							The agent spends its budget reading noise instead of reasoning.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							The structural failure is that raw output arrives{" "}
							<em>before any decision</em>: the context pays the full price for content
							the agent may never use.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Compression applied after the fact cannot refund a turn that already
							happened.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							So the intervention point has to be{" "}
							<strong class="text-bone-white">before the LLM sees anything</strong>.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							That is the first design commitment: intercept at the tool boundary, not
							inside the prompt.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Aphrodite replaces the output with a compact, structured preview - ~15
							tokens of metadata instead of hundreds - and keeps the full content
							retrievable.
						</p>
					</div>
					<!-- Stream pane: what the model used to see -->
					<div class="flex flex-col gap-8">
						<div class="font-mono text-base font-bold uppercase tracking-widest text-zinc-dust">
							EXHIBIT A // THE RAW FLOOD (142-LINE BUILD OUTPUT)
						</div>
						<div class="border border-oxblood-dark bg-soot-black p-5 font-mono text-base leading-relaxed">
							<CodeFence Code="$ cargo build --release 2>&1" />
							<div class="text-bone-newsprint opacity-90">   Compiling libc v0.2.168</div>
							<div class="text-bone-newsprint opacity-80">   Compiling tokio v1.47.1</div>
							<div class="text-bone-newsprint opacity-70">   Compiling serde v1.0.219</div>
							<div class="text-bone-newsprint opacity-60">   Compiling axum v0.8.4</div>
							<div class="text-bone-newsprint opacity-50">   Compiling aphrodite v1.6.6</div>
							<div class="text-bone-newsprint opacity-40">
								... 136 more identical lines ...
							</div>
							<div class="text-bone-newsprint opacity-30">
								warning: unused import: `HashMap`
							</div>
							<div class="text-bone-newsprint opacity-20">
								Finished `release` [optimized] in 41.7s
							</div>
							<div
								class="mt-8 border-t border-oxblood-dark pt-8 text-base font-bold text-raw-blood"
							>
								≈ 1,400 TOKENS · MOSTLY NOISE · ONE LINE MATTERED
							</div>
						</div>
						<!-- Paired preview pane -->
						<div class="border border-oxblood-dark bg-asphalt-panel p-5 font-mono text-base">
							<div class="text-base font-bold uppercase tracking-widest text-zinc-dust">
								THE PREVIEW INSTEAD
							</div>
							<div class="mt-6 border border-oxblood-dark bg-soot-black px-4 py-3 text-bone-white">
								[build:1E 1W 142L | error[E0432]: unresolved import ...]
							</div>
							<div class="ccr-marker mt-6 text-weathered-teal">
								&lt;&lt;&lt;CCR:0e3a5c9f...a1e|build|1420&gt;&gt;&gt;
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ II. THE GATE // CLASSIFY ============ -->
		<section class="relative w-full">
			<div
				class="relative z-10 -mb-7 ml-6 inline-block rotate-1 border border-black bg-stamped-canary px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-soot-black shadow-[3px_3px_0px_#000]"
			>
				II // THE GATE
			</div>
			<div
				class="zine-box-canary w-full border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:rotate-[0.5deg] sm:p-12"
			>
				<div class="grid grid-cols-1 gap-32 lg:grid-cols-2">
					<div class="flex flex-col gap-12">
						<h2
							class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl"
						>
							The classifier is the gate
						</h2>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Why classify before compressing?
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Because "compress everything equally" destroyed signal.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							A compiler error and a verbose build log are both output - but one must
							stay visible and the other should never have been shown in full.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							A single compression policy cannot serve both.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							So the type-aware classifier runs first - 40 to 123 nanoseconds, first
							match wins - and each content type carries its own compression threshold
							tier.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							The README's pipeline renders {Classifier.PipelineTypes} types in its
							catalog, from <code class="font-mono text-base">build</code> to
							<code class="font-mono text-base">text</code>; the full classification
							registry backing it is {Classifier.RegistryTypes} types
							(docs/classification/content-types.md).
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							When the classifier only reaches a generic bucket, a conservative semantic
							detector upgrades it to the high-signal shapes (git, gitlog, grep, ls,
							test); ordinary prose is never mis-tagged.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							This is the "secret sauce" made plain:{" "}
							<strong class="text-bone-white">the classifier is the gate</strong>.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Nothing is compressed, stored, or marked until the gate has named it - and
							the name is what everything downstream keys on.
						</p>
					</div>
					<!-- Threshold tier table -->
					<div class="flex flex-col gap-6">
						<div class="font-mono text-base font-bold uppercase tracking-widest text-zinc-dust">
							THRESHOLD TIERS // THE KNOBS
						</div>
						{
							Tiers.map(({ Tier, Types, Multiplier, Note }) => (
								<div class="flex items-center justify-between gap-8 border border-oxblood-dark bg-asphalt-panel px-4 py-3">
									<div class="min-w-0">
										<div class="font-mono text-base font-black uppercase tracking-widest text-bone-white">
											{Tier}
											<span class="ml-2 text-stamped-canary">{Multiplier}</span>
										</div>
										<div class="truncate font-mono text-base text-zinc-dust">{Types}</div>
									</div>
									<div
										class="hidden shrink-0 text-right font-mono text-base text-weathered-teal sm:block"
									>
										{Note}
									</div>
								</div>
							))
						}
						<div class="font-mono text-base leading-relaxed text-zinc-dust">
							HIGHER MULTIPLIER = LONGER THE CONTENT STAYS VISIBLE BEFORE COMPRESSION ·
							CODE ×3.0 IS THE CONFIG DEFAULT · FOOTNOTE: THE FULL REGISTRY IS{" "}
							{Classifier.RegistryTypes} TYPES; THE README CATALOG RENDERS{" "}
							{Classifier.PipelineTypes}. SRC: README.md:187-198.
						</div>
					</div>
				</div>
			</div>
				<figure class="mt-24 border border-oxblood-dark bg-asphalt-panel p-4" data-diagram="preview-flow">
					<div class="overflow-x-auto" set:html={PreviewFlow} />
					<figcaption class="mt-6 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
						M2 // PREVIEW FLOW
					</figcaption>
				</figure>
		</section>

		<!-- ============ III. THE CONTRACT // THE MARKER ============ -->
		<section class="relative w-full">
			<div
				class="relative z-10 -mb-7 ml-6 inline-block -rotate-1 border border-black bg-weathered-teal px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				III // THE CONTRACT
			</div>
			<div
				class="zine-box-teal w-full border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:-rotate-[0.4deg] sm:p-12"
			>
				<div class="grid grid-cols-1 gap-32 lg:grid-cols-2">
					<div class="flex flex-col gap-12">
						<h2
							class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl"
						>
							The marker is the contract
						</h2>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Replacing output with a summary only works if the missing content stays
							reachable.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							The bridge between the two is a single string:
						</p>
						<div
							class="ccr-marker border border-oxblood-dark bg-soot-black px-4 py-3 font-mono text-base text-weathered-teal"
						>
							{"<<<CCR:0e3a5c9f2b8d4e6a1c3f5b7d9e0a2c4b6d8f0a1e|build|1420>>>"}
						</div>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Hash, type, size - in that order, on purpose.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							The <strong class="text-bone-white">hash</strong> is the full 40-char BLAKE3
							digest, the address of the stored original.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							The <strong class="text-bone-white">type</strong> tells the agent what kind
							of thing it skipped.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							The <strong class="text-bone-white">size</strong> tells it how much.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Three fields are all an agent needs to decide whether retrieval is worth it
							- which is exactly why the marker, not a tool call, is the contract: every
							retrieval entry point (<code class="font-mono text-base"
								>aphrodite_retrieve</code
							>, <code class="font-mono text-base">/retrieve</code>,
							<code class="font-mono text-base">resolve</code>) accepts the marker body
							directly, suffix or no suffix.
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							The store behind it is deliberately boring: BLAKE3 → SQLite (persistent, the
							<span class="text-weathered-teal">:9798</span> token listener) or in-memory
							DashMap (10K entries, the <span class="text-weathered-teal">:9797</span>
							cache listener).
						</p>
						<p class="font-body text-base leading-relaxed text-bone-newsprint">
							Storage is not the interesting problem; the interesting problem is that the
							agent's decision needs a stable address - and that is all the marker has to
							be.
						</p>
					</div>
					<!-- Paired panes: stream vs preview with marker -->
					<div class="flex flex-col gap-8">
						<div class="font-mono text-base font-bold uppercase tracking-widest text-zinc-dust">
							EXHIBIT B // ONE OUTPUT, TWO FORMS
						</div>
						<div class="border border-oxblood-dark bg-soot-black p-5 font-mono text-base">
							<div class="text-base font-bold uppercase tracking-widest text-zinc-dust">
								WHAT THE AGENT SEES
							</div>
							<div class="mt-6 text-bone-newsprint opacity-90">
								[build:1E 1W 142L | error[E0432]: unresolved import ...]
							</div>
							<div class="ccr-marker mt-4 text-weathered-teal">
								&lt;&lt;&lt;CCR:0e3a5c9f...|build|1420&gt;&gt;&gt;
							</div>
							<div class="mt-8 border-t border-oxblood-dark pt-4 text-base text-zinc-dust">
								≈ 15 TOKENS
							</div>
						</div>
						<div
							class="flex items-center justify-center text-center font-mono text-base font-black uppercase tracking-widest text-stamped-canary"
						>
							↓ APHRODITE_RETRIEVE(HASH) ONLY IF NEEDED ↓
						</div>
						<div class="border border-oxblood-dark bg-asphalt-panel p-5 font-mono text-base">
							<div class="text-base font-bold uppercase tracking-widest text-zinc-dust">
								WHAT RETRIEVAL RETURNS
							</div>
							<div
								class="mt-6 border border-oxblood-dark bg-soot-black px-4 py-3 text-bone-newsprint opacity-90"
							>
								1,420 BYTES OF ORIGINAL OUTPUT · UNCHANGED
							</div>
							<div class="mt-6 text-base text-zinc-dust">
								RECURSIVE RESOLUTION · NESTED MARKERS HANDLED
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ IV. THE LOOP // FOUR LAYERS ============ -->
		<section class="relative w-full">
			<div
				class="relative z-10 -mb-7 ml-6 inline-block rotate-1 border border-black bg-raw-blood px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				IV // THE LOOP
			</div>
			<div
				class="zine-box-crimson w-full border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:rotate-[0.4deg] sm:p-12"
			>
				<h2
					class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl"
				>
					Four layers, one decision
				</h2>
				<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The pipeline is short on purpose: classify, preview, store, decide.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The whole compress step is sub-millisecond - end-to-end latency is {Bench.Latency}
