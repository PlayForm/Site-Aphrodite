---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import CodeFence from "@Component/CodeFence.astro";
import ZineTape from "@Component/ZineTape.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineKicker from "@Component/ZineKicker.astro";
import ZineStamp from "@Component/ZineStamp.astro";
import ZineStatBar from "@Component/ZineStatBar.astro";
import ZineLesson from "@Component/ZineLesson.astro";
import ZinePullQuote from "@Component/ZinePullQuote.astro";
import ZineReveal from "@Component/ZineReveal.astro";
import ZineFlow from "@Component/ZineFlow.astro";
import ZineSource from "@Component/ZineSource.astro";
import ZineDiagramNav from "@Component/ZineDiagramNav.astro";
import ContextEngine from "../Content/Mermaid/context-engine.svg?raw";
import HookChain from "../Content/Mermaid/hook-chain.svg?raw";
import { Stamps, Versions } from "@Library/Versions";
import { ExternalLinks } from "@Library/Links";
import { Assert, HookNames, Hooks as Roster } from "@Library/Roster";
import { PluginHookCard, PluginSequence as Sequence } from "@Library/Prose/Hooks";
import { ToolNames } from "@Library/Roster";

/** One heading voice for every section and sub-beat on the page. */
const Head = "font-headline text-lg font-black uppercase text-bone-white sm:text-xl";

/**
 * THE INSTALL SEQUENCE - one string, two readers: the fence above prints it
 * with the `$ ` prompts, and the copy control on that fence copies this exact
 * payload, so what a reader pastes is what a reader saw. The payload is one
 * line of source with escaped newlines, because it is copied verbatim.
 */
const InstallCommands =
	"git clone https://github.com/PlayForm/Aphrodite-Hermes.git\ncd Aphrodite-Hermes\nln -s \"$(pwd)\" ~/.hermes/plugins/aphrodite\nbash download.sh\ncd ..\nhermes plugins enable aphrodite\nhermes";

/** The same seven lines as the fence prints them - prompts and the pwsh note. */
const InstallFence = `$ git clone https://github.com/PlayForm/Aphrodite-Hermes.git
$ cd Aphrodite-Hermes
$ ln -s "$(pwd)" ~/.hermes/plugins/aphrodite
$ bash download.sh // or: pwsh ./download.ps1
$ cd ..
$ hermes plugins enable aphrodite
$ hermes`;


// THE SIX - from `plugins/aphrodite/plugin.yaml`, in manifest order. The
// roster is the manifest's: a hook added upstream appears here with no edit
// to this page, and `Assert` fails the build if the page's prose names one
// the plugin does not register.
Assert("Source/Library/Prose/Hooks.ts", PluginHookCard, HookNames);

const Hooks = Roster.map((Hook) => {
	const Prose = PluginHookCard[Hook.Name];

	return {
		...Hook,
		Tape: Prose?.Tape ?? "raw",
		Tone: Prose?.Tone ?? "subtle",
		Rotate: Prose?.Rotate ?? "",
		// A hook the manifest declares and this page has not written a card for
		// still renders: the roster is the manifest's, the prose is the page's,
		// and a missing sentence must not hide a registered seam.
		Body: Prose?.Body ?? ["The manifest registers this seam; its card is not written yet."],
	};
});

// THE SIX LANES - the same six seams as a WHEN / DOES grid, which is the shape
// a reader scans when they already know the names and only want the trigger.
const Lanes = [
	{
		Hook: "on_session_start",
		When: "session starts",
		Does: "resets all per-session state to a clean baseline - injects nothing",
	},
	{
		Hook: "pre_tool_call",
		When: "before a tool executes",
		Does: "auto-backgrounds long-running calls; splits chained commands",
	},
	{
		Hook: "transform_tool_result",
		When: "after every tool call",
		Does: "compresses large tool results into CCR markers",
	},
	{
		Hook: "transform_terminal_output",
		When: "after every terminal execution",
		Does: "compresses large terminal output into CCR markers",
	},
	{
		Hook: "pre_llm_call",
		When: "before each LLM request",
		Does: "injects directives, nudges, and the recall catalog",
	},
	{
		Hook: "post_llm_call",
		When: "after each LLM response",
		Does: "archives the turn, advances the counter, expires stale state",
	},
];

// THE FOUR LAYERS - each one names its job and the failure it owns. The point
// of the table is that no layer can absorb another's failure: the boundary
// between them is the JSON contract.
const Layers = [
	{
		N: "01",
		Name: "Hermes Agent",
		Role: "Owns the turn loop, the tool registry and the model call. It fires a hook because plugin.yaml promised one, and it reads the reply only as an object it can hand back.",
		Fails: "A seam that was never registered is invisible here: the turn runs without it, so a plugin that failed to load looks exactly like a plugin with nothing to say.",
	},
	{
		N: "02",
		Name: "__init__.py",
		Role: "Declares the ctypes signatures, asks the dylib for its hook names and tool schemas, and registers one callback per name. It holds no state between calls.",
		Fails: "A dylib built against a different ABI raises at import, and the whole plugin is disabled - it does not degrade into a partial surface.",
	},
	{
		N: "03",
		Name: "libaphrodite_hermes.dylib",
		Role: "The Hermes bridge: one JSON contract in, one JSON contract out, six hooks and thirteen tools with their schemas attached.",
		Fails: "A reply the shim cannot parse is a hard error, never a guess - the bridge does not repair a malformed payload.",
	},
	{
		N: "04",
		Name: "libaphrodite (core)",
		Role: "All the compression logic: classification, hashing, marker composition, preview extraction, directives, retrieval. Every number on this page is decided here.",
		Fails: "A store that will not open degrades to the in-memory backend - the compression still happens, the persistence does not.",
	},
	{
		N: "05",
		Name: "CCR store",
		Role: "SQLite at :9798, in-memory at :9797, or inline. It is the address space the markers point into, and the only layer that outlives the process.",
		Fails: "A lost database loses markers, not the transcript: the previews still read, and a marker that no longer resolves returns an explicit miss.",
	},
];

// THE DISPATCH WALK - one hook call, seen from both sides at once.
const Dispatch = [
	{
		Title: "A HOOK FIRES",
		Agent: ["Hermes is about to run a tool", "· the seam is pre_tool_call"],
		System: [
			"the shim's callback receives the tool name and arguments as a Python dict; it does no work of its own",
		],
	},
	{
		Title: "THE SHIM SERIALIZES",
		Agent: ["the call is still untouched", "· nothing has been rewritten yet"],
		System: [
			"the dict becomes JSON and crosses the FFI boundary; the shim keeps no state between calls",
		],
	},
	{
		Title: "THE BRIDGE DISPATCHES",
		Agent: ["· the hook name is matched to its handler"],
		System: [
			"libaphrodite_hermes matches the hook name to its Rust handler and hands the payload to the core",
		],
	},
	{
		Title: "THE CORE DECIDES",
		Agent: ["the call may come back rewritten", "» cd x && cargo build && cargo test"],
		System: [
			"the core applies the hook's rule: background the call, split the chain, compress the result, assemble the context",
		],
	},
	{
		Title: "THE REPLY RETURNS",
		Agent: ["the model sees the result, not the machinery"],
		System: [
			"the JSON reply crosses back and the shim returns it to Hermes unchanged; the store keeps the bytes the marker addresses",
		],
	},
];
---

<Base
	Title="PLUGIN // APHRODITE"
	Description={`The Aphrodite Hermes plugin, v${Versions.Plugin}: a thin Python registration shim over a Rust dylib - ${HookNames.length} hooks, ${ToolNames.length} tools, an opt-in context engine, and an explicit SHA-256-verified download flow.`}
>
	<PageShell Rhythm="wide">
		<PageHeader
			Tape="PLUGIN // THE THIN LOADER"
			Title="The plugin"
			Lead={[
				`Aphrodite ships as a Hermes Agent plugin: a thin Python registration shim over a Rust dylib.`,
				`Six hooks, thirteen tools, and an opt-in context engine - all declared in <code class="font-mono text-base text-weathered-teal">plugin.yaml</code>, all logic living in <code class="font-mono text-base text-weathered-teal">libaphrodite_hermes.dylib</code>.`,
				`This page documents the v${Versions.Plugin} plugin spec.`,
			]}
		/>

		<div class="flex max-w-4xl flex-wrap items-center gap-6">
			<ZineStamp Label={`${Stamps.Plugin()} STANDALONE`} Color="raw" Rotate="sm:-rotate-2" />
			<ZineStamp Label="6 HOOKS" Color="teal" Rotate="sm:rotate-1" />
			<ZineStamp Label={`${ToolNames.length} TOOLS`} Color="teal" Rotate="sm:-rotate-1" />
			<ZineStamp Label="ZERO LOGIC IN PYTHON" Color="canary" Rotate="sm:rotate-2" />
		</div>

		<ZinePullQuote
			Text="A plugin is a promise about a binary. The manifest says which seams exist and which tools answer; validation exists to keep that promise and the running surface identical."
			Attribution="plugin.yaml // the contract"
			Tone="subtle"
			Rotate="sm:rotate-[0.6deg]"
		/>

		<!-- SLOT 3: one claim's evidence - the declared surface, the chain, the gates -->
		<section class="relative w-full" data-reveal>
			<ZineTape Variant="section" Label="plugin.yaml // THE DECLARED SURFACE" />
			<ZineBox Size="lg" Rotate="-rotate-[1deg]">
				<h2 id="manifest" class={`mb-8 ${Head}`}>
					What the manifest declares
				</h2>
				<p class="mb-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The manifest is read before a line of Python loads. Hermes takes:
				</p>
				<ul class="mb-12 max-w-3xl space-y-2 font-body text-base leading-relaxed text-bone-newsprint">
					<li class="border-l-4 border-raw-blood pl-4">the name it will list</li>
					<li class="border-l-4 border-raw-blood pl-4">the spec version it will pin</li>
					<li class="border-l-4 border-raw-blood pl-4">
						the six hook names it must find a registration for
					</li>
					<li class="border-l-4 border-raw-blood pl-4">
						the thirteen tool schemas it will advertise to the model
					</li>
					<li class="border-l-4 border-raw-blood pl-4">
						and the flag that says an engine is present.
					</li>
				</ul>
				<p class="mb-12 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Nothing in the file describes behavior. Every field is an identity, a
					requirement, or a promise about what the dylib will answer when it is asked -
					which is why a manifest that overstates the surface fails validation instead of
					failing at runtime.
				</p>

				<div class="grid grid-cols-1 gap-10 md:grid-cols-2">
					<div class="space-y-4 border border-oxblood-dark bg-soot-black p-5 font-mono text-base">
						<div>
							<span class="text-zinc-dust">name:</span>{" "}
							<span class="text-bone-white">aphrodite</span>
						</div>
						<div>
							<span class="text-zinc-dust">version:</span>{" "}
							<span class="text-bone-white">{Versions.Plugin}</span>
						</div>
						<div>
							<span class="text-zinc-dust">kind:</span>{" "}
							<span class="text-bone-white">standalone</span>
						</div>
						<div>
							<span class="text-zinc-dust">requires_hermes:</span>
							<span class="text-stamped-canary">&gt;=0.20.2</span>
						</div>
						<div>
							<span class="text-zinc-dust">requires_hooks:</span>
							<span class="text-bone-white">true</span>
						</div>
						<div>
							<span class="text-zinc-dust">provides_context_engine:</span>
							<span class="text-bone-white">true</span>
						</div>
					</div>
					<div class="space-y-4 border border-oxblood-dark bg-soot-black p-5 font-mono text-base">
						<div class="text-weathered-teal"># provides_hooks (6)</div>
						<div class="text-bone-newsprint">on_session_start · pre_tool_call</div>
						<div class="text-bone-newsprint">
							transform_tool_result · transform_terminal_output
						</div>
						<div class="text-bone-newsprint">pre_llm_call · post_llm_call</div>
						<div class="pt-6 text-weathered-teal"># provides_tools (13)</div>
						<div class="text-bone-newsprint">
							retrieve · compress · stats · rebuild · files · diff
						</div>
						<div class="text-bone-newsprint">search · directive · test · catalog</div>
						<div class="text-bone-newsprint">
							reclassify · prefetch · prefetch_status
						</div>
					</div>
				</div>

				<div class="mt-12 grid grid-cols-1 gap-8 border-t border-oxblood-dark pt-8 md:grid-cols-2">
					<div class="space-y-4">
						<ZineStatBar
							Label="DECLARED SURFACE = RUNNING SURFACE"
							Ratio="13 / 13"
							Percent={100}
						/>
						<p class="font-body text-base leading-relaxed text-zinc-dust">
							The bar is full because the two sets are compared, not assumed: the
							manifest's
							<code class="font-mono text-base text-weathered-teal">
								provides_tools
							</code>{" "}
							list and the schemas the release dylib reports are held to the same
							thirteen names.
						</p>
					</div>
					<div class="space-y-4">
						<ZineStatBar
							Label="LOGIC IN THE PYTHON SHIM"
							Ratio="0%"
							Percent={0}
							Color="raw"
						/>
						<p class="font-body text-base leading-relaxed text-zinc-dust">
							The bar is empty on purpose. Nothing in the shim decides anything - a
							Python traceback means a load failure, never a compression bug.
						</p>
					</div>
				</div>

				<div class="mt-12 space-y-3 border-t border-oxblood-dark pt-8">
					<p class="text-base leading-relaxed text-zinc-dust">
						ENGINE THRESHOLD SEMANTICS: -1 = ALWAYS COMPRESS · 0 = DISABLED · &gt;0 =
						FILL PERCENT.
					</p>
					<p class="text-base leading-relaxed text-zinc-dust">
						SKILLS ARE NOT SHIPPED WITH THE PLUGIN - THEY LIVE DEV-SIDE.
					</p>
				</div>

				<div class="mt-12">
					<ZineLesson
						Label="ZERO LOGIC IN PYTHON"
						Text="The Python is a registration shim: ctypes signatures, one callback per name, and the JSON reply handed back untouched. Every threshold, every marker and every classification lives in the dylib."
					/>
				</div>

				<ZineTape Variant="section" Label="ENGINE // OPT-IN, AND OFF BY DEFAULT" />
				<h3 id="engine" class={`mb-8 mt-4 ${Head}`}>
					The engine is a flag, not a behavior
				</h3>
				<p class="max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					<code class="font-mono text-base text-weathered-teal">
						provides_context_engine: true
					</code>
					does not turn anything on.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					It tells Hermes that the dylib can answer the engine's questions - which file is
					being read, what the turn's markers were, how much context is left - so the host
					knows to ask.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The engine's own thresholds are the ones that decide whether a result is
					compressed at all.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The three threshold values are the whole tuning surface, and their polarity is
					the one thing readers get wrong: <span class="text-stamped-canary">-1</span>{" "}
					compresses everything, <span class="text-stamped-canary">0</span> disables the
					engine, and a positive number is the fill percentage at which compression
					starts. A{" "}<span class="text-stamped-canary">0</span> that reads as "off by
					default" is the correct reading.
				</p>
			</ZineBox>
			<ZineSource
				Lines={[
					"SRC: plugins/aphrodite/plugin.yaml (provides_hooks, provides_tools)",
					"SRC: docs/plugin/context-engine.md:38-48",
				]}
			/>
		</section>

		<section class="relative w-full" data-reveal>
			<ZineTape Variant="section" Label="ARCHITECTURE // CALL CHAIN" />
			<ZineBox Size="lg" Rotate="rotate-[1.2deg]">
				<h2 id="architecture" class={`mb-8 ${Head}`}>
					A thin shim, a Rust brain
				</h2>
				<p class="mb-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Five layers, one contract between each pair. Read top to bottom, the list is the
					path a single tool result takes; read bottom to top, it is the path a retrieval
					takes when the model asks for the bytes back.
				</p>
				<div class="space-y-0 border border-oxblood-dark bg-soot-black p-5 font-mono text-base leading-relaxed">
					<div class="text-bone-white">Hermes Agent (hooks + tool dispatch)</div>
					<div class="pl-4 text-zinc-dust">│</div>
					<div class="pl-4 text-bone-newsprint">
						__init__.py - ctypes FFI, registers hooks/tools/engine · no logic
					</div>
					<div class="pl-4 text-zinc-dust">│</div>
					<div class="pl-4 text-stamped-canary">
						libaphrodite_hermes.dylib - Hermes bridge (JSON contract) · 6 hooks · 13
						tools · schemas
					</div>
					<div class="pl-4 text-zinc-dust">│</div>
					<div class="pl-4 text-bone-newsprint">
						libaphrodite (core engine) - ALL compression logic: hooks · resolve ·
						retrieve · marker · preview · directives
					</div>
					<div class="pl-4 text-zinc-dust">│</div>
					<div class="pl-4 text-weathered-teal">
						CCR store - SQLite :9798 / in-memory :9797 / inline
					</div>
				</div>
				<p class="mt-8 font-body text-base leading-relaxed text-zinc-dust">
					Registration is driven by the dylib: the shim asks the dylib for its hook names
					and tool schemas and registers one callback per name.
				</p>
				<p class="mt-3 font-body text-base leading-relaxed text-zinc-dust">
					It is the reason there is no hot-reload: the dylib is resolved once per process,
					so to pick up a new build you restart the Hermes session.
				</p>
				<p class="mt-3 font-body text-base leading-relaxed text-zinc-dust">
					The same resolve-once rule is why the plugin never half-loads. Either the dylib
					opens and every seam registers, or the import raises and nothing registers -
					there is no state in which three hooks fire and three do not.
				</p>

				<h3 id="layers" class={`mb-8 mt-20 ${Head}`}>
					What each layer does, and what it fails on
				</h3>
				<div class="isolate grid grid-cols-1 items-start gap-10 lg:grid-cols-2">
					{Layers.map(({ N, Name, Role, Fails }) => (
						<div class="relative border-2 border-oxblood-dark bg-soot-black p-6 transition-transform duration-200 hover:rotate-0 sm:even:rotate-[0.6deg] sm:odd:-rotate-[0.6deg]">
							<div class="flex items-baseline gap-3">
								<span class="font-mono text-base font-black text-raw-blood">
									{N}
								</span>
								<span class="font-mono text-base font-black text-bone-white">
									{Name}
								</span>
							</div>
							<p class="mt-4 font-body text-base leading-relaxed text-bone-newsprint">
								{Role}
							</p>
							<div class="mt-4 border-l-4 border-stamped-canary pl-4">
								<ZineKicker Tone="canary">FAILS ON</ZineKicker>
								<p class="mt-2 font-body text-base leading-relaxed text-zinc-dust">
									{Fails}
								</p>
							</div>
						</div>
					))}
				</div>

				<figure
					class="mt-20 border border-oxblood-dark bg-soot-black p-4"
					data-diagram="context-engine"
				>
					<div class="overflow-x-auto" set:html={ContextEngine} />
					<figcaption class="mt-6 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
						M9 // CONTEXT ENGINE
					</figcaption>
				</figure>

				<h3 id="dispatch" class={`mb-8 mt-20 ${Head}`}>
					One call, end to end
				</h3>
				<p class="mb-10 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The left pane is what the agent sees; the right pane is what the process does.
					Step through it once and the split becomes obvious: every intervention is
					invisible on the agent's side, and every rewrite is decided on the system's
					side.
				</p>
				<ZineFlow
					Title="THE DISPATCH // ONE HOOK CALL"
					Complete="REPLY RETURNED"
					Steps={Dispatch}
				/>
				<p class="mt-10 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
					The failure mode of the whole chain sits at the boundary, not in the middle:
				</p>
				<ul class="mt-3 max-w-3xl space-y-2 font-body text-base leading-relaxed text-zinc-dust">
					<li class="border-l-2 border-oxblood-dark pl-3">
						a hook that raises is logged and skipped
					</li>
					<li class="border-l-2 border-oxblood-dark pl-3">
						a hook that returns nothing is a no-op
					</li>
					<li class="border-l-2 border-oxblood-dark pl-3">and neither ever aborts the turn.</li>
				</ul>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
					What a hook cannot do is pretend it ran.
				</p>

				<ZineTape Variant="section" Label="HOOKS // THE CHAIN" />
				<h3 id="chain" class={`mb-8 mt-4 ${Head}`}>
					Six hooks, one turn
				</h3>
				<p class="max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Every hook is a thin dispatch that forwards its arguments to the Rust dylib and
					hands the JSON reply back to Hermes.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					It is the reason the shim registers one callback per name: on plugin load it
					asks the dylib for its hook names, and the six below are always registered
					together.
				</p>
				<h4 class="mb-6 mt-12 font-headline text-lg font-black uppercase text-bone-white">
					The turn, in order
				</h4>
				<div class="space-y-0 border border-oxblood-dark bg-soot-black p-4 font-mono text-base leading-relaxed">
					{Sequence.map(({ Text: Line, Tone }) => (
						<div
							class={
								Tone === "canary"
									? "pl-4 text-stamped-canary"
									: Tone === "mute"
										? "pl-4 text-zinc-dust"
										: Tone === "result"
											? "text-bone-white"
											: "pl-4 text-bone-newsprint"
							}
						>
							{Line}
						</div>
					))}
				</div>
				<p class="mt-8 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The loop closes on itself, so the state a turn leaves behind is the state the
					next turn reads. That is why the reset seam exists: a new session starts from a
					clean baseline instead of inheriting the previous session's counters and
					markers.
				</p>
				<figure
					class="mt-16 border border-oxblood-dark bg-soot-black p-4"
					data-diagram="hook-chain"
				>
					<div class="overflow-x-auto" set:html={HookChain} />
					<figcaption class="mt-6 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
						M3 // HOOK CHAIN
					</figcaption>
				</figure>

				<h3 id="six" class={`mb-8 mt-20 ${Head}`}>
					The six, one card each
				</h3>
