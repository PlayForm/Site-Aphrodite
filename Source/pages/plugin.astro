									4,096
								</td>
								<td class="px-4 py-4 font-body text-body sm:px-5">
									empty · essential tools · self tools ·{" "}
									<span class="text-stamped-canary">0 = always compress</span>
								</td>
							</tr>
							<tr class="border-b border-[color:var(--tier-shell-edge)] align-top">
								<td class="px-4 py-4 font-mono text-code sm:px-5">
									transform_terminal_output
