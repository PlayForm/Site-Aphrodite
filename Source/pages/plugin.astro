---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import CodeFence from "@Component/CodeFence.astro";
import ZineDiagramNav from "@Component/ZineDiagramNav.astro";
import ContextEngine from "../Content/Mermaid/context-engine.svg?raw";
import HookChain from "../Content/Mermaid/hook-chain.svg?raw";
import { Stamps, Versions } from "@Library/Versions";
import { ExternalLinks } from "@Library/Links";
---

<Base
	Title="PLUGIN // APHRODITE"
	Description={`The Aphrodite Hermes plugin, v${Versions.Plugin}: a thin Python registration shim over a Rust dylib - 6 hooks, 13 tools, an opt-in context engine, and an explicit SHA-256-verified download flow.`}
>
	<main
		class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-40 px-5 py-24 sm:px-8 lg:gap-64 lg:px-14 lg:py-40"
	>
		<!-- HERO -->
		<header class="relative flex w-full flex-col items-start">
			<div
				class="mb-12 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				PLUGIN // THE THIN LOADER
			</div>
			<h1
				class="font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-5xl"
			>
				The plugin
			</h1>
			<p class="mt-12 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Aphrodite ships as a Hermes Agent plugin: a thin Python registration shim over a
				Rust dylib. Six hooks, thirteen tools, and an opt-in context engine - all declared
				in <code class="font-mono text-base text-weathered-teal">plugin.yaml</code>, all logic
				living in <code class="font-mono text-base text-weathered-teal"
					>libaphrodite_hermes.dylib</code
				>. This page documents the {`v${Versions.Plugin}`} plugin spec.
			</p>
			<div class="mt-16 flex max-w-4xl flex-wrap items-center gap-8">
				<span
					class="-rotate-2 border-2 border-black bg-raw-blood px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[4px_4px_0px_#000]"
				>
					{Stamps.Plugin()} STANDALONE
				</span>
				<span
					class="rotate-1 border-2 border-black bg-carbon-void px-4 py-1.5 font-mono text-base font-bold uppercase tracking-widest text-weathered-teal shadow-[4px_4px_0px_#000]"
				>
					6 HOOKS
				</span>
				<span
					class="-rotate-1 border-2 border-black bg-carbon-void px-4 py-1.5 font-mono text-base font-bold uppercase tracking-widest text-weathered-teal shadow-[4px_4px_0px_#000]"
				>
					13 TOOLS
				</span>
				<span
					class="rotate-2 border-2 border-black bg-stamped-canary px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-soot-black shadow-[4px_4px_0px_#000]"
				>
					ZERO LOGIC IN PYTHON
				</span>
			</div>
		</header>

		<!-- PLUGIN.YAML FACTS -->
		<section class="relative w-full">
			<div
				class="mb-12 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				plugin.yaml // THE DECLARED SURFACE
			</div>
			<div
				class="zine-box-crimson w-full -rotate-[1.2deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<h2 class="mb-12 font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
					What the manifest declares
				</h2>
				<div class="grid grid-cols-1 gap-10 md:grid-cols-2">
					<div class="space-y-4 border border-oxblood-dark bg-soot-black p-5 font-mono text-base">
						<div><span class="text-zinc-dust">name:</span> <span class="text-bone-white">aphrodite</span></div>
						<div><span class="text-zinc-dust">version:</span> <span class="text-bone-white">{Versions.Plugin}</span></div>
						<div><span class="text-zinc-dust">kind:</span> <span class="text-bone-white">standalone</span></div>
						<div>
							<span class="text-zinc-dust">requires_hermes:</span>
							<span class="text-stamped-canary">&gt;=0.20.2</span>
						</div>
						<div>
							<span class="text-zinc-dust">requires_hooks:</span>
							<span class="text-bone-white">true</span>
						</div>
						<div>
							<span class="text-zinc-dust">provides_context_engine:</span>
							<span class="text-bone-white">true</span>
						</div>
					</div>
					<div class="space-y-4 border border-oxblood-dark bg-soot-black p-5 font-mono text-base">
						<div class="text-weathered-teal"># provides_hooks (6)</div>
						<div class="text-bone-newsprint">on_session_start · pre_tool_call</div>
						<div class="text-bone-newsprint">transform_tool_result · transform_terminal_output</div>
						<div class="text-bone-newsprint">pre_llm_call · post_llm_call</div>
						<div class="pt-6 text-weathered-teal"># provides_tools (13)</div>
						<div class="text-bone-newsprint">retrieve · compress · stats · rebuild · files · diff</div>
						<div class="text-bone-newsprint">search · directive · test · catalog</div>
						<div class="text-bone-newsprint">reclassify · prefetch · prefetch_status</div>
					</div>
				</div>
				<p class="mt-12 border-t border-oxblood-dark pt-8 text-base leading-relaxed text-zinc-dust">
					ENGINE THRESHOLD SEMANTICS: -1 = ALWAYS COMPRESS · 0 = DISABLED · &gt;0 = FILL
					PERCENT. SKILLS ARE NOT SHIPPED WITH THE PLUGIN - THEY LIVE DEV-SIDE.
				</p>
			</div>
		</section>

		<!-- ARCHITECTURE -->
		<section class="relative w-full lg:w-10/12 lg:self-end">
			<div
				class="zine-box-crimson relative rotate-[1.4deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<div
					class="absolute -top-5 left-6 z-10 border border-black bg-stamped-canary px-3 py-0.5 text-base font-black uppercase tracking-widest text-soot-black shadow-[2px_2px_0px_#000]"
				>
					ARCHITECTURE // CALL CHAIN
				</div>
				<h2 class="mb-12 mt-6 font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
					A thin shim, a Rust brain
				</h2>
				<div class="space-y-0 border border-oxblood-dark bg-soot-black p-5 font-mono text-base leading-relaxed">
					<div class="text-bone-white">Hermes Agent (hooks + tool dispatch)</div>
					<div class="pl-4 text-zinc-dust">│</div>
					<div class="pl-4 text-bone-newsprint">__init__.py - ctypes FFI, registers hooks/tools/engine · no logic</div>
					<div class="pl-4 text-zinc-dust">│</div>
					<div class="pl-4 text-stamped-canary">libaphrodite_hermes.dylib - Hermes bridge (JSON contract) · 6 hooks · 13 tools · schemas</div>
					<div class="pl-4 text-zinc-dust">│</div>
					<div class="pl-4 text-bone-newsprint">libaphrodite (core engine) - ALL compression logic: hooks · resolve · retrieve · marker · preview · directives</div>
					<div class="pl-4 text-zinc-dust">│</div>
					<div class="pl-4 text-weathered-teal">CCR store - SQLite :9798 / in-memory :9797 / inline</div>
				</div>
				<p class="mt-12 font-body text-base leading-relaxed text-zinc-dust">
					Registration is driven by the dylib: the shim asks the dylib for its hook names
					and tool schemas and registers one callback per name.
					<span class="mt-1 block text-base">It is the reason there is no hot-reload: the
					dylib is resolved once per process, so to pick up a new build you restart the
					Hermes session.</span>
				</p>
				<figure class="mt-20 border border-oxblood-dark bg-soot-black p-4" data-diagram="context-engine">
					<div class="overflow-x-auto" set:html={ContextEngine} />
					<figcaption class="mt-6 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
						M9 // CONTEXT ENGINE
					</figcaption>
				</figure>
			</div>
		</section>

		<!-- DOWNLOAD FLOW -->
		<section class="relative w-full">
			<div
				class="mb-12 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				DOWNLOAD // EXPLICIT STEPS ONLY
			</div>
			<div
				class="zine-box-crimson w-full -rotate-[1.4deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<h2 class="mb-12 font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
					register() never downloads
				</h2>
				<div class="grid grid-cols-1 gap-16 lg:grid-cols-2">
					<div>
						<p class="mb-8 font-body text-base leading-relaxed text-bone-newsprint">
							Binaries are never shipped in the repository. Fetching them is an explicit
							setup step you run yourself - and the verification is mandatory, not
							best-effort:
						</p>
						<ul class="space-y-6 font-body text-base text-bone-newsprint">
							<li class="border-l-4 border-raw-blood pl-4">
								<span class="font-bold text-bone-white">SHA-256 against the in-tree checksum list</span>
								- <code class="font-mono text-base text-weathered-teal">SHA256SUMS.txt</code>,
								generated by CI into the tree; a mismatch is refused outright.
							</li>
							<li class="border-l-4 border-raw-blood pl-4">
								<span class="font-bold text-bone-white">Magic-byte validation</span> - the
								downloaded file must be a real ELF / Mach-O / PE image, or it is rejected.
							</li>
							<li class="border-l-4 border-raw-blood pl-4">
								<span class="font-bold text-bone-white">Backup + restore</span> - an
								existing install is backed up and restored if any step fails. No
								release-hosted fallback.
							</li>
							<li class="border-l-4 border-raw-blood pl-4">
								<span class="font-bold text-bone-white">A missing binary disables, not breaks</span>
								- the plugin logs the setup command and stays disabled until the binaries
								are present.
							</li>
						</ul>
					</div>
					<div>
						<CodeFence
							Class="mb-10 border border-oxblood-dark"
							Code={`$ git clone https://github.com/PlayForm/Aphrodite-Hermes.git
$ cd Aphrodite-Hermes
$ ln -s "$(pwd)" ~/.hermes/plugins/aphrodite
$ bash download.sh // or: pwsh ./download.ps1
$ cd ..
$ hermes plugins enable aphrodite
$ hermes`}
						/>
						<div
							class="flex items-center justify-between gap-8 border-2 border-oxblood-dark bg-asphalt-panel p-4"
						>
							<span class="text-base font-black uppercase tracking-widest text-stamped-canary">
								COPY THE FULL SEQUENCE:
							</span>
							<button
								class="border border-black bg-raw-blood px-4 py-2 font-mono text-base font-black uppercase text-bone-white shadow-[3px_3px_0px_#000] transition-colors hover:bg-blood-crimson active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
								data-copy={"git clone https://github.com/PlayForm/Aphrodite-Hermes.git\ncd Aphrodite-Hermes\nln -s \"$(pwd)\" ~/.hermes/plugins/aphrodite\nbash download.sh\ncd ..\nhermes plugins enable aphrodite\nhermes"}
							>
								COPY
							</button>
						</div>
					</div>
				</div>
				<p class="mt-8 font-body text-base leading-relaxed text-zinc-dust">
					ALSO ON THE STORE: the plugin is in the Hermes plugin catalog - the reviewed,
					pinned alternative to the manual clone above. <code class="font-mono text-base text-weathered-teal">hermes plugins install aphrodite</code>
					checks out the catalog entry's exact commit, then <code class="font-mono text-base text-weathered-teal">bash download.sh</code>
					from <code class="font-mono text-base text-weathered-teal">~/.hermes/plugins/aphrodite</code>
					still fetches the binaries (never <code class="font-mono text-base text-weathered-teal">aphrodite setup</code>
					against the catalog-managed directory). The full flow is on
					<a class="text-weathered-teal underline transition-colors hover:text-bone-white" href="/setup/">SETUP</a>;
					the mechanics are in <a class="text-weathered-teal underline transition-colors hover:text-bone-white" href={ExternalLinks.HermesGuide}>the Hermes plugin guide</a>.
				</p>
				<p class="mt-12 border-t border-oxblood-dark pt-8 font-body text-base leading-relaxed text-zinc-dust">
					LLM API KEY REQUIRED: the proxy is an OpenAI-compatible forwarder and needs its
					own credentials - <code class="font-mono text-base text-weathered-teal">APHRODITE_API_KEY</code>,
					<code class="font-mono text-base text-weathered-teal">aphrodite setup</code>, or
					<code class="font-mono text-base text-weathered-teal">api_key</code> in
					~/.hermes/aphrodite/aphrodite.toml. Hermes' provider config is NOT reused, and
					there is no keyless mode: without a key the proxy refuses to start.
				</p>
			</div>
		</section>

		<!-- FILESYSTEM MAP -->
		<section class="relative w-full lg:w-9/12 lg:self-start">
			<div
				class="zine-box-crimson relative rotate-[1.2deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<div
					class="absolute -top-5 right-6 z-10 border border-black bg-weathered-teal px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
				>
					FILESYSTEM // CANONICAL LAYOUT
				</div>
				<h2 class="mb-12 mt-6 font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
					What changes after install
				</h2>
				<div class="space-y-0 border border-oxblood-dark bg-soot-black p-5 font-mono text-base leading-relaxed text-bone-newsprint">
					<div>~/.hermes/</div>
					<div class="pl-4">├── plugins/aphrodite <span class="text-zinc-dust">← manual symlink to the plugin repo</span></div>
					<div class="pl-4 text-bone-white">└── aphrodite/ <span class="text-zinc-dust">← runtime home</span></div>
					<div class="pl-10">├── binaries/aphrodite <span class="text-zinc-dust">← proxy binary, fetched + verified</span></div>
					<div class="pl-10">├── binaries/libaphrodite_hermes.dylib</div>
					<div class="pl-10">├── aphrodite.toml <span class="text-zinc-dust">← config</span></div>
					<div class="pl-10">├── directives/ <span class="text-zinc-dust">← 7 built-ins materialized</span></div>
					<div class="pl-10">├── ccr.db <span class="text-zinc-dust">← SQLite CCR store</span></div>
					<div class="pl-10">└── proxy-stderr.log <span class="text-zinc-dust">← proxy logs (empty = healthy)</span></div>
				</div>
				<p class="mt-12 font-body text-base leading-relaxed text-zinc-dust">
					The runtime home self-heals toward
					<code class="font-mono text-base text-weathered-teal">layout_schema.json</code> at
					startup: misplaced config and binaries are moved to their canonical paths, and
					stale plugin-source copies are quarantined.
					<span class="mt-1 block text-base">It is the reason the self-healing stops at the
					Hermes-owned boundary: the
					~/.hermes/plugins/aphrodite install dir is Hermes' territory, and the plugin
					never creates, converts, or modifies it.</span>
				</p>
				<figure
					class="mx-auto mt-20 max-w-md border border-oxblood-dark bg-soot-black p-3"
					data-diagram="hook-chain-mini"
				>
					<div class="overflow-x-auto [&_svg]:h-auto" set:html={HookChain} />
					<figcaption class="mt-4 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
						M3 MINI // HOOK CHAIN
					</figcaption>
				</figure>
			</div>
		</section>

		<!-- EVOLUTION: how the plugin got here -->
		<section class="relative w-full lg:w-11/12 lg:self-end">
			<div
				class="zine-box-crimson relative -rotate-[0.8deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<div
					class="absolute -top-5 right-6 z-10 border border-black bg-weathered-teal px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
				>
					EVOLUTION // HOW THE SURFACE GREW
				</div>
				<h2 class="mb-12 mt-6 font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
					The six hooks, the version pairing, and the 14-to-13 correction
				</h2>
				<!-- The six-lane hook grid: 2x2 through the tablet/wide range;
				     the three-lane form only at xl, where the enlarged hook
				     names ("on_session_start") keep room beside the WHEN chips. -->
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 xl:grid-cols-3 xl:gap-6">
					{
						[
							{ Hook: "on_session_start", When: "session starts", Does: "resets all per-session state to a clean baseline - injects nothing" },
							{ Hook: "pre_tool_call", When: "before a tool executes", Does: "auto-backgrounds long-running calls; splits chained commands" },
							{ Hook: "transform_tool_result", When: "after every tool call", Does: "compresses large tool results into CCR markers" },
							{ Hook: "transform_terminal_output", When: "after every terminal execution", Does: "compresses large terminal output into CCR markers" },
							{ Hook: "pre_llm_call", When: "before each LLM request", Does: "injects directives, nudges, and the recall catalog" },
							{ Hook: "post_llm_call", When: "after each LLM response", Does: "archives the turn, advances the counter, expires stale state" },
						].map(({ Hook, When, Does }) => (
							<div class="border-2 border-oxblood-dark bg-soot-black p-5">
								<div class="font-mono text-base font-black text-bone-white">{Hook}</div>
								<div class="mt-3 font-mono text-base font-bold uppercase tracking-widest text-stamped-canary">{When}</div>
								<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">{Does}</p>
							</div>
						))
					}
				</div>
				<p class="mt-8 font-mono text-base text-zinc-dust">
					SRC: docs/plugin/hooks.md:13-20 - every hook is a thin dispatch that forwards to the Rust dylib; the dylib holds all the behavior.
				</p>
				<!-- The version-pairing strip -->
				<div class="mt-24 border-2 border-raw-blood bg-soot-black p-6">
					<div class="font-mono text-base font-black uppercase tracking-widest text-stamped-canary">
						THE VERSION PAIRING · BINARY_VERSION MECHANICS
					</div>
					<div class="mt-6 grid grid-cols-1 gap-10 lg:grid-cols-3">
						<div>
							<div class="font-headline text-2xl font-black text-bone-white">{Stamps.Pairing()}</div>
							<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
								Today's pairing: binary {Versions.Binary}, plugin {Versions.Plugin}. Every release moves both:
								"{Versions.ChangelogPairing}."
							</p>
						</div>
						<div>
							<div class="font-headline text-2xl font-black text-bone-white">BUMPED LAST</div>
							<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
								<code class="font-mono text-base text-weathered-teal">BINARY_VERSION</code> is
								pinned to a binary release tag the plugin can download. Since the first
								plugin-first release (v1.4.6), the plugin is tagged
								<em>before the parent</em>, so the pinned version points at assets that
								already exist.
							</p>
						</div>
						<div>
							<div class="font-headline text-2xl font-black text-bone-white">OR IT REFUSES</div>
							<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
								The plugin warns before <code class="font-mono text-base">download.sh</code>
								when the pinned <code class="font-mono text-base">BINARY_VERSION</code> points
								at a release with no assets - and since v1.6.5, a checksum mismatch is a
								hard refusal, not a warning.
							</p>
						</div>
					</div>
					<div class="mt-6 font-mono text-base text-zinc-dust">
						SRC: CHANGELOG.md v1.4.6/v1.4.4/v1.6.5/v1.6.6 entries · the Aphrodite/v1.4.6 release note ("released plugin-first ... points at assets that already exist")
					</div>
				</div>
				<!-- The 14 -> 13 tool-surface callout -->
				<div class="mt-16 border-l-4 border-stamped-canary bg-soot-black p-6">
					<div class="font-mono text-base font-black uppercase tracking-widest text-stamped-canary">
						13 TOOLS, NOT 14 · THE CORRECTION IS A BEAT
					</div>
					<p class="mt-4 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
						v1.6.5 corrected the manifest: "14 tools" → "13 tools" - the release dylib
						registers exactly the 13 declared tools. The 14th, <code class="font-mono text-base text-weathered-teal">aphrodite_debug</code>,
						is <code class="font-mono text-base text-weathered-teal">debug_assertions</code>-gated
						out of release builds, matching what <code class="font-mono text-base text-weathered-teal">hermes plugins validate</code>
						enforces. Earlier, v1.6.1 had already removed it from
						<code class="font-mono text-base text-weathered-teal">provides_tools</code>, closing the
						catalog-review mismatch on the pinned tree - and v1.4.6 had done the same for
						<code class="font-mono text-base text-weathered-teal">aphrodite_navigate</code>, the
						navigation tool whose feature was unbuildable. The declared surface and the
						running surface are kept identical on purpose.
					</p>
					<div class="mt-4 font-mono text-base text-zinc-dust">SRC: CHANGELOG.md:61-64 (v1.6.5) · CHANGELOG.md:166-173 (v1.6.1) · v1.4.6 release note</div>
				</div>
			</div>
		</section>

		<!-- RELATED: the natural neighbors -->
		<Related
			Links={[
				{ Href: "/setup/", Label: "SETUP" },
				{ Href: "/hermes/", Label: "HERMES" },
				{ Href: "/hooks/", Label: "HOOKS" },
				{ Href: "/flavors/", Label: "FLAVORS" },
				{ Href: "/tools/", Label: "TOOLS" },
			]}
		/>
	</main>
	<ZineDiagramNav />
</Base>
