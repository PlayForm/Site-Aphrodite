						TapeColor="teal"
					>
						<CodeFence Lang="text" Code={Layout} />
					</ZineBox>
				</div>

				<!-- RIGHT: what the tree means. Two directories, two owners, and
				     neither one writes in the other's half. -->
				<div class="lg:col-span-2">
					<p class="type-body text-bone-newsprint">
						All four routes converge on the same two directories. Nothing else moves: no
						PATH edit, no shell profile, no system-wide install.
					</p>
					<div class="mt-6 grid grid-cols-1 gap-4">
						<div class="well p-4">
							<div class="flex flex-wrap items-center justify-between gap-2">
