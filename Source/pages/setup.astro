												{Step.Prerequisite !== undefined && (
													<p class="mt-2 type-body text-zinc-dust">
														<span class="telemetry-tag">BEFORE</span>{" "}
														<span set:html={Step.Prerequisite} />
													</p>
												)}
												<CodeFence
													Class="mt-3"
													Copy
													Lang={Lane.Lang}
													Code={Step.Command}
												/>
												{Step.Explanation !== undefined && (
													<p
														class="mt-3 type-body text-bone-newsprint"
