// THE INSTALL MODEL - the shape is the point.
//
// This page used to store each route as one transcript STRING with `$` prompts
// and `//` annotations inside it, and hand that whole string to CopyButton: the
// copy payload was the picture of a terminal, not a command. A reader who
// pasted it got `$ hermes plugins install aphrodite // or answer yes at the
// Enable now? prompt` - prompt sigil, annotation and all.
//
// So a route is now a list of STEPS and a step is a list of FACTS:
//
//   Command        the bare, runnable line. This - and only this - is what a
//                  copy control hands to the clipboard. No `$`, no `//`.
//   Explanation    the words that used to ride inside the transcript as a `//`
//                  annotation. Prose beside the block, where a reader can read
//                  it without it ending up in the clipboard.
//   Prerequisite   what has to be true before the line runs.
//   Expected       what a successful run leaves behind.
//   Troubleshooting  the failure THIS step produces. The page used to keep one
//                  `Fails: string[]` per route, mixing prerequisites, directory
//                  conflicts, wrong working directories, platform differences,
//                  optional flags, registration failures and existing-config
//                  behaviour into a list a reader could not map onto a command.
//                  Each one now sits under the step that can cause it, as a
//                  quiet inline warning; the ONE large warning block on the
//                  page is reserved for the catalog rule, which is the only
//                  instruction whose cost is destructive.
interface InstallStep {
	/** The step's short imperative name. */
	Title: string;

	/** The bare, runnable command - the copy payload, byte for byte. */
	Command: string;

	/** Prose beside the block; may carry `<code>`. */
	Explanation?: string;

	/** What must be true before the line runs. */
	Prerequisite?: string;

	/** What a successful run leaves behind. */
	Expected?: string;

	/** The failures this step can produce - one sentence each. */
	Troubleshooting?: string[];
}

// A LANE is one platform's complete sequence. Platform is an input, not a
// footnote: the page used to change exactly one command for Windows
// (`bash download.sh` -> `pwsh ./download.ps1`) and leave the linking step as
// `ln -s`, so the "Windows path" was POSIX with a PowerShell download in the
// middle of it. A lane is complete or it is not offered.
interface InstallLane {
	/** "macOS / Linux" or "Windows" - printed beside every block. */
	Platform: string;

	/** The shell every command in the lane is written for. */
	Shell: "bash" | "powershell";

	/** The Shiki grammar for the lane's fences, so the plate labels itself. */
	Lang: string;

	Steps: InstallStep[];
}

interface InstallRoute {
	/** The anchor id the card's `<h3>` carries. */
	ID: string;

	/** The corner badge, e.g. "#1 // PLUGIN CATALOG". */
	Badge: string;

	/** Badge color: canary for the recommended lane, raw and teal after. */
	BadgeColor: "canary" | "raw" | "teal" | "bone";

	/** Badge side - the tape hangs on the plate's corner. */
	Side: "left" | "right";

	/** The dominant card's tilt from `sm` up; mobile is always flat. */
	Rotate: string;

	/** The dominant card's shadow plane. */
	Tone: "crimson" | "subtle";

	/** The card's `<h3>`. */
	Title: string;

	/**
	 * The one line that says what the route is FOR. Exactly one route carries
	 * `Recommended`; the rest say the situation they fit. The page used to
	 * badge both the catalog and the clone RECOMMENDED while the introduction
	 * told an unsure reader to take the catalog - two recommendations and one
	 * answer.
	 */
	Label: string;

	/** True for exactly one route. Drives the badge shape, not the wording. */
	Recommended: boolean;

	// THE DECISION MATRIX - the three facts every card states. They used to be
	// a table's three columns; a card cannot carry a column, so each fact is a
	// field and the card renders it under the same heading the column had. The
	// sentences are the table's cells, unchanged, because a matrix that says
	// the same thing twice in two words is worse than one table.

	/** WHAT IT INSTALLS. */
	Installs: string;

	/** NEEDS RUST - "yes" or "no", and the card colours the answer. */
	NeedsRust: "yes" | "no";

	/** USE IT WHEN - the situation the route fits. */
	UseWhen: string;

	/** The complete sequence per platform. */
	Lanes: InstallLane[];

	/** Route-level prose: the `//` notes that were never about one command. */
	Notes?: string[];

	/** The outcome kicker, e.g. "OUTCOME // CATALOG INSTALL:". */
	OutcomeTag: string;

	/** The outcome line itself. */
	Outcome: string;

	/** What the route writes, and where. */
	Writes: string;

	/** The verification, one sentence per line. */
	Verify: string[];

	/** The output to expect once the route is done. */
	Expect: string;

	/** Render the external SRC link to the Hermes plugin guide. */
	Guide?: boolean;

	/** The one large warning block on the page - destructive cost only. */
	Warning?: { Label: string; Lines: string[] };

	/** One route-specific aside. */
	Lesson?: { Label: string; Text: string };
}

/** A macOS / Linux lane: POSIX shell, `bash` fences. */
const Posix = (Steps: InstallStep[]): InstallLane => ({
	Platform: "macOS / Linux",
	Shell: "bash",
	Lang: "bash",
	Steps,
});

/** A Windows lane: native PowerShell, `powershell` fences. */
const Windows = (Steps: InstallStep[]): InstallLane => ({
	Platform: "Windows",
	Shell: "powershell",
	Lang: "powershell",
	Steps,
});

/**
 * The "copy all" payload: only executable lines, in order, one per line. It is
 * built from the same `Command` fields the per-step controls copy, so the two
 * can never drift - and a prompt or an annotation has nowhere to enter.
 */
const Executable = (Steps: InstallStep[]): string => Steps.map((Step) => Step.Command).join("\n");

/** The inline-code voice, once, so a route's prose does not repeat the class. */
const Code = (Text: string): string =>
	`<code class="font-mono text-base text-weathered-teal">${Text}</code>`;

