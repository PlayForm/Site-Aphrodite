								)}

								{Route.Lesson !== undefined && (
									<div class="mt-6">
										<ZineLesson
											Label={Route.Lesson.Label}
											Text={Route.Lesson.Text}
											Color="teal"
										/>
									</div>
								)}

								<div class="mt-6 grid grid-cols-1 gap-4 xl:grid-cols-5">
									<div class="border border-[color:var(--tier-well-edge)] bg-[color:var(--tier-well)] p-4 xl:col-span-3">
										<ZineKicker Tone="teal" As="div">
											WHAT IT WRITES
										</ZineKicker>
										<p
											class="mt-2 type-body text-bone-newsprint"
											set:html={Route.Writes}
