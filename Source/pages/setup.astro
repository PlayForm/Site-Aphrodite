		</section>

		<!-- 05 // CONFIGURATION - two files, two parsers, one precedence -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">05 // CONFIGURATION // /CONFIG.TOML</p>
			<h2 id="config" class="mt-3 type-section text-bone-white">
				Configuration
