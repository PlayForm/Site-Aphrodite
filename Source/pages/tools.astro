---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineDiagramNav from "@Component/ZineDiagramNav.astro";
import { Assert, ToolNames, Tools as Roster, Undeclared } from "@Library/Roster";
import { RunBytes, RunMarker, RunPreview } from "@Library/Motion";
import { ToolProse } from "@Library/Prose/Tools";
import type { ToolRecord } from "@Library/Records";
import ToolRelay from "../Content/Mermaid/tool-relay.svg?raw";
import MarkerFormat from "../Content/Mermaid/marker-format.svg?raw";

// THE THIRTEEN - never typed here. `plugin.yaml` decides which tools exist and
// in what order; `schemas.rs` supplies each one's description and every
// argument. A tool added upstream appears in this table with no edit to this
// page, and `Assert` fails the build if the page's prose names one the plugin
// does not register.
Assert("Source/Library/Prose/Tools.ts", ToolProse, ToolNames);

/* ═══ THE DOOR CHIP ════════════════════════════════════════════════════════
 *
 * The matrix's third column says which side of the session store a handle
 * moves, and it is read off the tool's OWN schema sentence - the one printed
 * in the same row - rather than off a list kept somewhere else.
 *
 * Three families, three colours, and the colour is IDENTITY rather than rank:
 * teal is a read, canary is a write, bone is the engine tuning itself. The
 * chip vocabulary is Global.css's published `.telemetry-tag` modifiers, so
 * contrast is the stylesheet's problem and not this page's.
 *
 * A tool added upstream arrives WITHOUT a door chip and that is the honest
 * state: the page does not yet know what it does, and inventing a family for
 * it would be a guess rendered as a fact. The row still renders - identifier,
 * argument count, description - so the matrix never hides a shipped handle.
 */
type Door = "read" | "write" | "control";

const Doors: Record<string, { Label: string; Tone: Door }> = {
	aphrodite_compress: { Label: "Store", Tone: "write" },
	aphrodite_prefetch: { Label: "Preload", Tone: "write" },
	aphrodite_retrieve: { Label: "Pull", Tone: "read" },
	aphrodite_search: { Label: "Find", Tone: "read" },
	aphrodite_stats: { Label: "Status", Tone: "read" },
	aphrodite_files: { Label: "Status", Tone: "read" },
	aphrodite_diff: { Label: "Status", Tone: "read" },
	aphrodite_catalog: { Label: "Status", Tone: "read" },
	aphrodite_prefetch_status: { Label: "Status", Tone: "read" },
	aphrodite_rebuild: { Label: "Status", Tone: "read" },
	aphrodite_directive: { Label: "Tune", Tone: "control" },
	aphrodite_reclassify: { Label: "Re-type", Tone: "control" },
	aphrodite_test: { Label: "Test", Tone: "control" },
	aphrodite_debug: { Label: "Toggle", Tone: "control" },
};

/** The published `.telemetry-tag` modifier per family - colour as identity. */
const DoorTone: Record<Door, string> = {
	read: "telemetry-tag--teal",
	write: "telemetry-tag--canary",
	control: "telemetry-tag--bone",
};

const Tools: (ToolRecord & {
	N: string;
	Note?: string;
	Door?: { Label: string; Tone: Door };
	Args: string;
})[] = Roster.map((Tool, Index) => ({
	...Tool,
	N: String(Index + 1).padStart(2, "0"),
	Note: ToolProse[Tool.Name]?.Note,
	Door: Doors[Tool.Name],
	// Derived, never typed: the schema declares the arguments, so the chip
	// counts them. A tool that gains an argument upstream moves its own chip.
	Args: Tool.Parameters.length === 0 ? "No args" : `${Tool.Parameters.length} args`,
}));

/* ═══ ONE PAYLOAD, ONE MARKER, ONE PREVIEW ═════════════════════════════════
 *
 * A marker and the preview printed beside it are two views of the SAME
 * payload, so both are computed here from one scenario object each. Hand-typed
 * pairs are how a page ends up printing a `build` marker over a terminal
 * preview: three figures, two payloads, one line of prose that cannot be true.
 *
 * `RunPreview`, `RunMarker` and `RunBytes` are the engine's own builders
 * (`crates/aphrodite/src/preview/builders/*.rs`) mirrored line for line in
 * `Source/Library/Motion.ts`, so the pair rendered here is the pair the engine
 * emits for these bytes rather than a description of it. `RunPreview` carries
 * the build, grep, ls, test and json arms and falls back to `[type:NL]` for
 * everything else, so the terminal payload's summary is read off its own
 * exit-code line - the same line `builders/terminal.rs` selects with
 * `.rev().find(|l| l.contains("exit code:") || l.contains("Error:"))`.
 *
 * Both payloads clear their own gate before either becomes a marker: 4,096
 * characters for a tool result, 1,024 for terminal output. Below the gate the
 * engine passes the bytes through raw and no marker exists at all, so a marker
 * over a small payload would be a fiction.
 */

/** The dependency graph a workspace release build prints as it compiles. */
const BuildCrates = [
	"proc-macro2 v1.0.89",
	"unicode-ident v1.0.13",
	"quote v1.0.37",
	"syn v2.0.77",
	"serde_derive v1.0.210",
	"serde v1.0.210",
	"itoa v1.0.11",
	"ryu v1.0.18",
	"memchr v2.7.4",
	"libc v0.2.159",
	"cc v1.1.30",
	"jobserver v0.1.32",
	"num_cpus v1.16.0",
	"bytes v1.7.2",
	"pin-project-lite v0.2.14",
	"futures-core v0.3.31",
	"futures-task v0.3.31",
	"slab v0.4.9",
	"futures-util v0.3.31",
	"tokio-macros v2.4.0",
	"tokio v1.40.0",
	"mio v1.0.2",
	"socket2 v0.5.7",
	"tracing-core v0.1.32",
	"once_cell v1.20.1",
	"log v0.4.22",
	"smallvec v1.13.2",
	"lock_api v0.4.12",
	"scopeguard v1.2.0",
	"parking_lot v0.12.3",
	"ahash v0.8.11",
	"zerocopy v0.7.35",
	"zerocopy-derive v0.7.35",
	"hashbrown v0.14.5",
	"thiserror-impl v1.0.64",
	"thiserror v1.0.64",
	"anyhow v1.0.89",
	"blake3 v1.5.4",
	"crossbeam-utils v0.8.20",
	"crossbeam-epoch v0.9.18",
	"crossbeam-deque v0.8.5",
	"either v1.13.0",
	"rayon-core v1.12.1",
	"rayon v1.10.0",
	"regex-syntax v0.8.5",
	"aho-corasick v1.1.3",
	"regex-automata v0.4.8",
	"regex v1.11.0",
	"tempfile v3.13.0",
	"fastrand v2.1.1",
	"getrandom v0.2.15",
	"rand_chacha v0.3.1",
	"ppv-lite86 v0.2.20",
	"rand v0.8.5",
	"uuid v1.10.0",
	"rmp v0.8.14",
	"rmp-serde v1.3.0",
	"toml_edit v0.22.22",
	"indexmap v2.6.0",
	"equivalent v1.0.1",
	"winnow v0.6.20",
	"toml v0.8.19",
	"num-traits v0.2.19",
	"num-integer v0.1.46",
	"clap v4.5.20",
	"clap_builder v4.5.20",
	"clap_derive v4.5.18",
	"clap_lex v0.7.2",
	"anstream v0.6.15",
	"anstyle v1.0.8",
	"anstyle-parse v0.2.5",
	"anstyle-query v1.1.1",
	"colorchoice v1.0.2",
	"is_terminal_polyfill v1.70.1",
	"utf8parse v0.2.2",
	"strsim v0.11.1",
	"heck v0.5.0",
	"dirs v5.0.1",
	"dirs-sys v0.4.1",
	"option-ext v0.2.0",
	"futures-sink v0.3.31",
	"http v1.1.0",
	"httparse v1.9.5",
	"form_urlencoded v1.2.1",
	"percent-encoding v2.3.1",
];

/** The build's raw output: the compile lines, one warning, three errors. */
const BuildLines: string[] = [
	"$ cargo build --release --workspace",
	...BuildCrates.map((Crate) => `   Compiling ${Crate}`),
	"   Compiling aphrodite-core v0.4.2 (/workspace/crates/aphrodite-core)",
	"warning: unused variable: `Count`",
	"  --> crates/aphrodite-core/src/store.rs:41:9",
	"   |",
	"41 |     let Count = Entries.len();",
	"   |         ^^^^^ help: if this is intentional, prefix it with an underscore: `_Count`",
	"   |",
	"   = note: `#[warn(unused_variables)]` on by default",
	"   Compiling aphrodite v0.4.2 (/workspace/crates/aphrodite)",
	"error[E0432]: unresolved import `crate::store::SessionStore`",
	"  --> crates/aphrodite/src/lib.rs:12:5",
	"   |",
	"12 | use crate::store::SessionStore;",
	"   |     ^^^^^^^^^^^^^^^^^^^^^^^^^ no `SessionStore` in `store`",
	"   |",
	"   = help: consider importing one of these items instead:",
	"   |",
	"12 | use crate::store::Store;",
	"   |     +++++",
	"error[E0308]: mismatched types",
	"   --> crates/aphrodite/src/preview/builders/build.rs:31:9",
	"    |",
	" 30 |     match first_err {",
	"    |           --------- this expression has type `Option<String>`",
	" 31 |         Some(msg) if !msg.is_empty() => {",
	"    |         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^ expected `Option<String>`, found `bool`",
	"    |",
	"    = note: expected enum `Option<String>`",
	"    = note:    found type `bool`",
	"error[E0599]: no method named `take` found for struct `Vec<String>` in the current scope",
	"   --> crates/aphrodite/src/preview/builders/ls.rs:62:22",
	"    |",
	' 62 |         .map(|(e, n)| format!("{}×{}", e, n))',
	"    |                      ^^^^^^ method not found in `Vec<String>`",
	"    |",
	"    = help: items from traits can only be used if the trait is in scope",
	"    = note: the following trait is implemented but not in scope: `itertools::Itertools`",
	"error: could not compile `aphrodite` (lib) due to 3 previous errors",
];

/** A release test run that passes: fourteen lines, the last one the exit code. */
const TerminalLines: string[] = [
	"$ cargo test --release -p aphrodite preview::builders -- --nocapture",
	"    Finished `release` profile [optimized] target(s) in 12.41s",
	"     Running unittests src/lib.rs (/workspace/target/release/deps/aphrodite-7f3c9a1d2b4e5f60)",
	"test preview::builders::build::test::build_counts_error_lines_not_occurrences ... ok",
	"test preview::builders::build::test::build_surfaces_the_first_error_message ... ok",
	"test preview::builders::grep::test::grep_reports_hits_and_distinct_files ... ok",
	"test preview::builders::ls::test::ls_lists_extension_counts ... ok",
	"test preview::builders::test::test::test_reports_pass_fail_ignored ... ok",
	"test preview::builders::json::test::json_counts_items_and_keys ... ok",
	"test preview::builders::terminal::test::terminal_reads_the_exit_code_line ... ok",
	"test preview::builders::search::test::search_reports_hits_and_first_location ... ok",
	"test preview::builders::code::test::code_maps_structure_and_signature ... ok",
	"test result: ok. 9 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.31s",
	"   exit code: 0",
];

/** `builders/terminal.rs`'s summary: the last exit-code line, clipped to 60. */
const TerminalSummary = (Lines: readonly string[]): string =>
	(
		[...Lines]
			.reverse()
			.find((Line) => Line.includes("exit code:") || Line.includes("Error:")) ??
		Lines[0] ??
		""
	)
		.trim()
		.slice(0, 60);

/**
 * One payload: the bytes, the classifier's verdict, and everything derived.
 *
 * `Count` and `Bytes` are what the console pair's row label prints - the
 * payload's own length, not a typed number, so a change to the sample moves
 * the label, the preview and the marker's size field together.
 */
const Scenario = (
	Label: string,
	Hash: string,
	Type: string,
	Lines: readonly string[],
	Preview: string,
) => ({
	Label,
	Hash,
	Type,
	Count: Lines.length,
	Bytes: RunBytes(Lines),
	Preview,
	Marker: RunMarker(Hash, Type, Lines),
});

const Scenarios = [
	Scenario("Build log", "a1b2c3d4", "build", BuildLines, RunPreview("build", BuildLines)),
	Scenario(
		"Test run",
		"e5f6a7b8",
		"terminal",
		TerminalLines,
		`[terminal:${TerminalLines.length}L ${TerminalSummary(TerminalLines)}]`,
	),
];

/** A marker's three fields, in the order `RunMarker` joins them. */
const MarkerFields = (Marker: string): string[] =>
	Marker.slice("<<<CCR:".length, -">>>".length).split("|");
---

<Base
	Title="TOOLS // APHRODITE"
	Description="The thirteen aphrodite_* tools: a thin relay into the Rust dylib with one shared session store, byte-exact marker retrieval, and the <<<CCR:hash|type|size>>> marker contract."
>
	<PageShell Rhythm="wide">
		<PageHeader
			Tape="TOOLS // THE AGENT'S HANDLES"
			Title="Thirteen tools"
			Lead={[
				`A tool call's output becomes part of the model's context, and every one of these handles exists to decide what of it the model keeps.`,
				`Each is a thin relay into the Rust dylib: the plugin registers each tool from the dylib's schema list, and every call dispatches through <code class="font-mono text-base text-weathered-teal">aphrodite_hermes_dispatch_tool</code>, returning the JSON result verbatim.`,
				`It is the reason all handlers share one session store: content compressed by a hook or by <code class="font-mono text-base text-weathered-teal">aphrodite_compress</code> stays resolvable by <code class="font-mono text-base text-weathered-teal">aphrodite_retrieve</code> for the life of the session.`,
			]}
		/>

		<!-- 01 // REGISTRY - one row per handle, hairline-ruled -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">01 // REGISTRY // {Tools.length} ENTRIES</p>
			<h2 class="mt-3 font-headline text-sub font-black uppercase text-bone-white">
				Every handle, one relay
			</h2>
			<p class="mt-6 max-w-[46rem] font-body text-body text-bone-newsprint">
				Each row is one registered handle: the identifier the agent types, the side of the
				session store it moves, the arguments its schema declares, and the sentence the
				schema gives it. The door chip's colour is the family and not a rank - teal reads,
				canary writes, and bone is the engine tuning itself.
			</p>

			<div class="grunge shell-card mt-8" data-grunge data-grunge-mode="edge">
				<div class="overflow-x-auto">
					<table class="w-full border-collapse text-left">
						<thead>
							<tr class="border-b border-[color:var(--tier-well-edge)]">
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									#
								</th>
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									Handle
								</th>
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									Door
								</th>
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									Args
								</th>
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									What the model reads
								</th>
							</tr>
						</thead>
						<tbody>
							{Tools.map((Tool) => (
								<tr class="border-b border-[color:var(--tier-shell-edge)] align-top last:border-b-0">
									<td class="px-4 py-4 font-mono text-meta font-bold text-zinc-dust sm:px-5">
										{Tool.N}
									</td>
									<td class="whitespace-nowrap px-4 py-4 font-mono text-code sm:px-5">
										<a
											class="text-weathered-teal underline decoration-transparent decoration-2 underline-offset-4 transition-colors hover:decoration-stamped-canary"
											href={`#${Tool.Name}`}
										>
											{Tool.Name}
										</a>
									</td>
									<td class="px-4 py-4 sm:px-5">
										{Tool.Door ? (
											<span
												class:list={[
													"telemetry-tag",
													DoorTone[Tool.Door.Tone],
												]}
											>
												{Tool.Door.Label}
											</span>
										) : null}
									</td>
									<td class="px-4 py-4 sm:px-5">
										<span class="telemetry-tag">{Tool.Args}</span>
									</td>
									<td class="max-w-[34rem] px-4 py-4 sm:px-5">
										<p class="font-body text-body text-bone-newsprint">
											{Tool.Summary}
										</p>
										{Tool.Note ? (
											<p class="mt-2 font-body text-body text-zinc-dust">
												{Tool.Note}
											</p>
										) : null}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<p class="mt-8 max-w-[46rem] border-t border-oxblood-dark pt-6 font-body text-body leading-relaxed text-zinc-dust">
				THERE IS AN INTERNAL 14TH REGISTRY ENTRY, context_engine_pre_llm - THE CONTEXT
				ENGINE'S OWN PRE-LLM HOOK, NOT A TOOL AN AGENT CALLS DIRECTLY.
				{Undeclared.length > 0 ? (
					<span class="mt-3 block">
						{Undeclared.map((Tool) => Tool.Name).join(", ")} is compiled in under
						<code class="font-mono text-base text-weathered-teal">
							debug_assertions
						</code>{" "}
						only: a real schema, not a registered tool, so it is named rather than
						counted.
					</span>
				) : null}
			</p>

			<figure
				class="mt-16 border border-oxblood-dark bg-soot-black p-4"
				data-diagram="tool-relay"
			>
				<div class="overflow-x-auto" set:html={ToolRelay} />
				<figcaption class="mt-6 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
					M4 // TOOL RELAY
				</figcaption>
			</figure>
		</section>

		<!-- 02 // CONTRACT - the retrieval vocabulary as one console pair -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">02 // CONTRACT // THE MARKER</p>
			<h2
				id="marker"
				class="mt-3 scroll-mt-24 font-headline text-sub font-black uppercase text-bone-white"
			>
				THE MARKER
			</h2>
			<div class="ccr-marker mt-6 font-headline text-sub font-black uppercase text-bone-white">
				&lt;&lt;&lt;CCR:hash|type|size&gt;&gt;&gt;
			</div>

			<ZineBox
				Emphasis="standard"
				Accent="crimson"
				Size="lg"
				Surface="shell"
				Grunge={true}
				Class="mt-10"
			>
				<div class="overflow-x-auto">
					<table class="w-full border-collapse text-left font-mono">
						<thead>
							<tr>
								<th
									scope="col"
									class="type-meta px-4 py-3 text-left font-bold uppercase text-zinc-dust"
								>
									Payload
								</th>
								<th
									scope="col"
									class="border-l border-[color:var(--tier-well-edge)] px-4 py-3 text-left"
								>
									<span class="telemetry-tag telemetry-tag--canary">MARKER</span>
									<span class="type-meta mt-2 block uppercase text-zinc-dust">
										What the model receives
									</span>
								</th>
								<th
									scope="col"
									class="border-l border-[color:var(--tier-well-edge)] px-4 py-3 text-left"
								>
									<span class="telemetry-tag telemetry-tag--teal">PREVIEW</span>
									<span class="type-meta mt-2 block uppercase text-zinc-dust">
										What it already reads
									</span>
								</th>
							</tr>
						</thead>
						<tbody>
							{Scenarios.map((Payload) => {
								const [Hash = "", Type = "", Size = ""] = MarkerFields(
									Payload.Marker,
								);

								return (
									<tr class="border-t border-[color:var(--tier-shell-edge)] align-top">
										<th scope="row" class="px-4 py-4 text-left align-top">
											<span class="type-meta block uppercase text-zinc-dust">
												{Payload.Label}
											</span>
											<span class="type-meta mt-1 block text-zinc-dust">
												{Payload.Count} lines ·{" "}
												{Payload.Bytes.toLocaleString("en-US")} bytes
											</span>
										</th>
										<td class="border-l border-[color:var(--tier-shell-edge)] px-4 py-4">
											<div class="ccr-marker text-code text-bone-newsprint">
												&lt;&lt;&lt;
												<span class="text-stamped-canary">CCR:</span>
												<span class="text-weathered-teal">{Hash}...</span>
												<span class="text-bone-white">
													|{Type}|{Size}
												</span>
												<span class="text-bone-white">&gt;&gt;&gt;</span>
											</div>
										</td>
										<td class="border-l border-[color:var(--tier-shell-edge)] px-4 py-4">
											<div class="text-code text-zinc-dust">
												{Payload.Preview}
											</div>
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</ZineBox>

			<p class="mt-10 max-w-[46rem] font-body text-body leading-relaxed text-bone-newsprint">
				A marker and its preview are two views of one payload, so both are computed from the
				same bytes: the hash addresses the stored output, the type is the classifier's
				verdict, and the size is the UTF-8 byte count of the bytes behind the hash - which
				is what a retrieval of that marker puts back into the transcript, not an estimate of
				it. The preview beside each one comes from the engine's own builders, so its tallies
				are the payload's own: the build-log sample counts four error lines, one warning
				line and every line it printed, and the test run reports the exit code of the last
				line it printed.
			</p>
			<p class="mt-3 max-w-[46rem] font-body text-body leading-relaxed text-zinc-dust">
				Both payloads clear their gate before either becomes a marker - 4,096 characters for
				a tool result, 1,024 for terminal output - because below the gate the engine passes
				the bytes through raw and no marker exists at all. Every figure here is the
				payload's own length rather than a typed number, so a change to the output moves the
				preview, the tallies and the size together.
			</p>
			<ul class="mt-12 space-y-6 font-body text-base text-bone-newsprint">
				<li class="border-l-4 border-raw-blood pl-4">
					<span class="font-bold text-bone-white">BLAKE3 hash</span> - pattern
					<code class="font-mono text-base text-weathered-teal">
						{"^^[0-9a-fA-F]{8,64}$"}
					</code>
					; truncated hashes never resolve, exact match only.
				</li>
				<li class="border-l-4 border-raw-blood pl-4">
					<span class="font-bold text-bone-white">Byte-exact round-trip</span> -
					<code class="font-mono text-base text-weathered-teal">aphrodite_retrieve</code>
					returns the original bytes, nested markers expanded recursively.
				</li>
				<li class="border-l-4 border-raw-blood pl-4">
					<span class="font-bold text-bone-white">Workspace-confined reads</span> -
					<code class="font-mono text-base text-weathered-teal">path</code> reads are
					capped at 10 MiB and refuse paths outside the workspace.
				</li>
				<li class="border-l-4 border-raw-blood pl-4">
					<span class="font-bold text-bone-white">
						Markers don't survive a session restart
					</span>
					- the dylib is loaded once per process, so a new session starts a fresh store.
				</li>
			</ul>
			<figure
				class="mt-16 border border-oxblood-dark bg-soot-black p-4"
				data-diagram="marker-format"
			>
				<div class="overflow-x-auto" set:html={MarkerFormat} />
				<figcaption class="mt-6 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
					M6 // MARKER FORMAT
				</figcaption>
			</figure>
		</section>

		<!-- 03 // SCHEMAS - one panel per handle, every argument -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">03 // SCHEMAS // EVERY ARGUMENT</p>
			<h2
				id="schemas"
				class="mt-3 scroll-mt-24 font-headline text-sub font-black uppercase text-bone-white"
			>
				SCHEMAS // EVERY TOOL
			</h2>
			<p class="mt-6 max-w-[46rem] font-body text-body leading-relaxed text-bone-newsprint">
				Each panel is the schema the agent is handed: the description it reads, then every
				argument with its type and its own sentence. None of it is retyped - the schema is
				rendered straight from
				<code class="font-mono text-base text-weathered-teal">schemas.rs</code>, so an
				argument added to a tool appears without an edit.
			</p>

			<div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-2">
				{Tools.map((Tool) => (
					<div
						id={Tool.Name}
						class="grunge shell-card scroll-mt-24"
						data-grunge
						data-grunge-mode="edge"
					>
						<div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-[color:var(--tier-shell-edge)] px-5 py-4">
							<span class="font-mono text-meta font-bold text-zinc-dust">
								{Tool.N}
							</span>
							<h4 class="font-mono text-code font-bold text-bone-white">
								{Tool.Name}
							</h4>
							{Tool.Door ? (
								<span class:list={["telemetry-tag", DoorTone[Tool.Door.Tone]]}>
									{Tool.Door.Label}
								</span>
							) : null}
							<span class="telemetry-tag ml-auto">{Tool.Args}</span>
						</div>
						<div class="prose-flow px-5 py-5">
							<div class="well px-4 py-4 font-mono text-code leading-relaxed">
								{Tool.Parameters.length === 0 ? (
									<div class="text-zinc-dust">takes no arguments</div>
								) : (
									Tool.Parameters.map((Parameter) => (
										<div class="mb-3 last:mb-0">
											<div>
												<span class="text-zinc-dust">
													"{Parameter.Name}":
												</span>{" "}
												<span class="text-bone-newsprint">{`{ ${Parameter.Type}${Parameter.Required ? " · required" : " · optional"} }`}</span>
											</div>
											<div class="pl-4 text-zinc-dust">
												{Parameter.Description}
											</div>
										</div>
									))
								)}
							</div>
							<p class="font-body text-body leading-relaxed text-bone-newsprint">
								{Tool.Description}
							</p>
							{(ToolProse[Tool.Name]?.Paragraph ?? []).map((Line) => (
								<p class="font-body text-body leading-relaxed text-zinc-dust">
									{Line}
								</p>
							))}
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- 04 // RULE - the engine's own status is never compressed -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">04 // RULE // META-TOOLS</p>
			<h2
				id="meta-tools"
				class="mt-3 scroll-mt-24 font-headline text-sub font-black uppercase text-bone-white"
			>
				Meta-tool output is auto-expanded
			</h2>
			<div class="prose-flow mt-6 max-w-[46rem]">
				<p class="font-body text-body leading-relaxed text-bone-newsprint">
					Output from meta-tools (like
					<code class="font-mono text-base text-weathered-teal">aphrodite_stats</code> or
					<code class="font-mono text-base text-weathered-teal">aphrodite_catalog</code>)
					is expanded inline, never compressed - the agent always sees its own engine's
					status in full.
				</p>
				<p class="font-body text-body leading-relaxed text-bone-newsprint">
					Compressing the catalog would just be the engine hiding its own ledger.
				</p>
			</div>
		</section>

		<!-- SLOT 4: exactly one onward link -->
		<Related
			Links={[
				{ Href: "/plugin/", Label: "PLUGIN" },
				{ Href: "/hooks/", Label: "HOOKS" },
				{ Href: "/hermes/", Label: "HERMES" },
				{ Href: "/workbench/", Label: "WORKBENCH" },
			]}
		/>
	</PageShell>
	<ZineDiagramNav />
</Base>
