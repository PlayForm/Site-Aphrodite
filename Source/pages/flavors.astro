---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineStamp from "@Component/ZineStamp.astro";
import ZineSource from "@Component/ZineSource.astro";
import { HookNames, ToolNames } from "@Library/Roster";
import ZineSurface from "@Component/ZineSurface.astro";

/* ═══ THE DECISION MATRIX ═══════════════════════════════════════════════════
 *
 * LAYOUT ONLY. This page takes the Stitch ARRANGEMENT and nothing else:
 * numbered chapters, a decision matrix, one dominant plate over subordinate
 * cards, dual pods and a recessed sand pod. It takes none of Stitch's tokens,
 * surfaces, shadows, radii or type scale - the palette, the 4px module
 * boundaries, the hard offset shadows, the grunge ink, the tape and stamp
 * vocabulary and the chip are the ones this page already carried, unchanged.
 *
 * THE ARRANGEMENT answers one question - WHICH FLAVOR DO I RUN - so the page
 * is laid out as a decision rather than as four things of equal weight:
 *
 *   01  THE MATRIX     every flavor in one shape, so the whole surface is
 *                      readable before any detail. The rows are ordered by how
 *                      much of the turn a host can see, and that ordering IS
 *                      the decision: a host can only compress what it sees.
 *                      Beside it, in the two-column split, the one-line answer
 *                      the rows add up to.
 *   02  RECOMMENDED    one dominant plate - the native Hermes plugin - at the
 *                      page's single expressive volume, split into two pods:
 *                      what it is (with the counts the decision turns on) and
 *                      the decision itself (host, reach, trade-off).
 *   03  THE OTHERS     the three subordinate cards, each a standard plate with
 *                      its own boundary accent, a cost chip and the trade-off
 *                      chips that name what it cannot see.
 *
 * WHAT A CARD CARRIES, and why: a decision needs the HOST (what the reader must
 * already run), the REACH (what the flavor sees of the turn), the COST (what
 * adopting it asks), the TRADE-OFF (what it cannot see) and the STATUS (whether
 * it ships today). Every one of those is read off the matrix row this page has
 * always printed, so no card invents a claim - a chip is the row's own words in
 * label form, and the prose under it is the sentence that was already there.
 *
 * COLOUR IS IDENTITY, NOT DECORATION, and every colour below keeps the meaning
 * it already has on this page or elsewhere on the site:
 *
 *   - STATUS keeps this page's own mapping, row for row: canary for the plugin,
 *     teal for the proxy, dust for the other two. Nothing is reassigned.
 *   - The FRAME accent per plate is unchanged: crimson for the recommendation,
 *     then teal, oxblood (none) and canary.
 *   - The EVIDENCE BADGES use the four published `.telemetry-tag` modifiers
 *     with the meanings the rest of the site gives them, one meaning each:
 *     bone = a static declaration (here, the cost), crimson = a limitation
 *     (here, the trade-off), canary and teal = the two live paths. The lead
 *     plate's single trade-off chip is canary rather than crimson because it
 *     states the opposite of a limitation - that the plugin gives up nothing.
 *     No modifier is invented and none is collapsed into another.
 *
 * VOICE. Two sentences whose subject was the page's own furniture were
 * rewritten; the mapping is recorded here so the report can show that no fact
 * went missing:
 *
 *   - lead sentence 4, "The table is the whole surface in one shape; the
 *     sections after it are the detail behind each row." -> carried by the
 *     structure itself (01 is the matrix, 02 and 03 are the detail) and by the
 *     matrix's own lead-in below. Its fact was the order of the sections, which
 *     the sections still state by existing.
 *   - the table caption, "The rows are ordered by how much of the turn each
 *     host can see, because that is what decides which compression the flavor
 *     can perform." -> the same claim with the product as its subject, promoted
 *     from caption to the matrix's lead-in: "A host can only compress what it
 *     can see..."
 *
 * ADDED, never subtracted: the decision line beside the matrix (01), and the
 * pod eyebrows that name what each block of a plate holds. Every sentence,
 * figure, table row, chip, key and SRC line this page already carried is still
 * here, verbatim.
 */

/** The label voice this page's own table header already used - the canary
 * mono label - now expressed in the published type role rather than a literal
 * size. */
const Label = "type-meta font-bold uppercase text-stamped-canary";

/** The quiet eyebrow: the same voice without the accent, for a block whose
 * head is not the thing being decided. */
const Eyebrow = "type-meta font-bold uppercase text-zinc-dust";

/** The four chip voices, one meaning each - see the header. Declared once
 * because a second copy of a class string is a second thing to keep in step. */
const FactTag = "telemetry-tag";
const CostTag = "telemetry-tag telemetry-tag--bone";
const TradeTag = "telemetry-tag telemetry-tag--crimson";
const LeadTradeTag = "telemetry-tag telemetry-tag--canary";

/** The accents ZineBox can frame with. Headroom takes `none` - the oxblood
 * boundary a standard plate ships - because the component has no bone frame;
 * its identity is its tape and its status ink. */
type Accent = "crimson" | "canary" | "teal" | "none";

interface Flavor {
	/** The flavor's own label - the tape text this page has always carried. */
	Label: string;

	/** Matrix cell 1: the flavor's name. */
	Flavor: string;

	/** Matrix cell 2: the host it runs in. */
	Host: string;

	/** Matrix cell 3: what it can see inside the turn. */
	Sees: string;

	/** Matrix cell 4: whether it ships. */
	Status: string;

	/** The status badge - this page's own identity mapping, unchanged. Canary
	 * for the plugin, teal for the proxy, and the badge's quiet default (dust)
	 * for the two that do not ship today. */
	Badge: "" | "telemetry-tag--canary" | "telemetry-tag--teal";

	/** The anchor the matrix row links to, and the card's own id. */
	Id: string;

	/** The card's head. */
	Head: string;

	/** The frame's accent - the flavor's identity, where the frame allows it. */
	Accent: Accent;

	/** The tape's colour role, as this page already printed it. */
	Tape: "raw" | "canary" | "teal" | "bone";

	/** What adopting the flavor asks of the reader, as one label. */
	Cost: string;

	/** What the flavor cannot see - the other half of the decision. */
	Trade: string[];

	/** The capability chips the page already printed for this flavor. */
	Chips: string[];

	/** The flavor's own prose, byte-exact. `set:html`, because a body carries
	 * `<code>` identifiers and a list. */
	Body: string;
}

/** The whole surface in one shape, in the order the matrix prints it. Typed as
 * a NON-EMPTY tuple rather than `Flavor[]`: the first element is the page's
 * recommendation, and under this workspace's `noUncheckedIndexedAccess` a plain
 * array would make `Plugin` below `Flavor | undefined` and force a guard for a
 * record that always exists. */
const Hosts: [Flavor, ...Flavor[]] = [
	{
		Label: "FLAVOR 01 // HERMES PLUGIN",
		Flavor: "HERMES PLUGIN",
		Host: "Hermes Agent",
		Sees: "Everything - hooks, tools, the prompt",
		Status: "TODAY",
		Badge: "telemetry-tag--canary",
		Id: "hermes",
		Head: "The full integration",
		Accent: "crimson",
		Tape: "raw",
		Cost: "REQUIRES HERMES AGENT",
		Trade: ["SEES EVERYTHING"],
		// Both counts are derived, never typed: the roster decides how many hooks
		// and tools the plugin registers, so one added upstream appears here with
		// no edit to this page.
		Chips: [
			`${HookNames.length} HOOKS`,
			`${ToolNames.length} TOOLS`,
			"CONTEXT ENGINE",
			"DIRECTIVES",
			"DUAL PROXIES",
		],
		Body: `<p>Six hooks, thirteen tools, the context engine, auto-launched dual proxies - the native flavor sees everything the agent sees.</p><p>This is the flavor this site documents.</p>`,
	},
	{
		Label: "FLAVOR 02 // STANDALONE PROXY",
		Flavor: "STANDALONE PROXY",
		Host: "Any OpenAI-compatible client",
		Sees: "The HTTP body - no hook interception",
		Status: "SHIPS TODAY",
		Badge: "telemetry-tag--teal",
		Id: "proxy",
		Head: "Any OpenAI-compatible client",
		Accent: "teal",
		Tape: "raw",
		Cost: "REQUIRES OPENAI-COMPATIBLE CLIENT",
		Trade: ["NO HOOK INTERCEPTION", "NO TOOLS", "NO PROMPT INJECTION"],
		Chips: ["OPENAI-COMPATIBLE", "TOKEN :9798", "CACHE :9797"],
		Body: `<p>Point <code class="font-mono text-base text-weathered-teal">base_url</code> at <code class="font-mono text-base text-weathered-teal">:9798</code> (or <code class="font-mono text-base text-weathered-teal">:9797</code>) and the same compression engine sits between the client and its LLM - token and cache listeners, SQLite or in-memory storage.</p><p>What it cannot do is see inside the agent: no hook interception, no tools, no prompt injection.</p>`,
	},
	{
		Label: "FOUNDATION // EMBEDDED HEADROOM",
		Flavor: "EMBEDDED HEADROOM",
		Host: "The engine's own core",
		Sees: "Content types and previews, not agent APIs",
		Status: "FOUNDATION",
		Badge: "",
		Id: "headroom",
		Head: "The portable core",
		Accent: "none",
		Tape: "raw",
		Cost: "REQUIRES THE CORE FORK",
		Trade: ["NOT AGENT APIs"],
		Chips: ["GIT SUBMODULE", "THIN BRIDGE"],
		Body: `<p>Aphrodite embeds Headroom - a custom fork, tracked as a git submodule - as its content-transform core:</p><ul class="space-y-1"><li class="border-l-2 border-oxblood-dark pl-3">the classifier</li><li class="border-l-2 border-oxblood-dark pl-3">the smart crusher</li><li class="border-l-2 border-oxblood-dark pl-3">the tokenizer.</li></ul><p>The Hermes-specific layer is a thin bridge on top.</p><p>It is the reason new host flavors are possible: the engine already speaks in content types and previews, not in agent APIs.</p>`,
	},
	{
		Label: "ROADMAP // PLANNED",
		Flavor: "MORE HOSTS // PLANNED",
		Host: "Additional agents",
		Sees: "Whatever the host exposes - the proxy path already works",
		Status: "PLANNED",
		Badge: "",
		Id: "roadmap",
		Head: "Other agents",
		Accent: "canary",
		Tape: "bone",
		Cost: "REQUIRES THE HOOK-AND-TOOL PATTERN",
		Trade: ["NO DATES PROMISED"],
		Chips: ["PROXY PATH ALREADY WORKS"],
		Body: `<p>Beyond Hermes, additional host flavors are planned - the standalone proxy path already works with any OpenAI-compatible agent today, and deeper native integrations follow the same hook-and-tool pattern the Hermes plugin established.</p><p>No dates are promised; when a new flavor ships, its documentation ships with it.</p>`,
	},
];

/** The one the page recommends, and the three it ranks below it. Keeping them
 * as one array means the matrix, the dominant plate and the cards cannot
 * disagree about a flavor's host, reach or status. */
const [Plugin, ...Others] = Hosts;
---

<Base
	Title="FLAVORS // APHRODITE"
	Description="The Aphrodite roadmap: a native Hermes plugin today, the standalone proxy for any OpenAI-compatible client, and the embedded Headroom core that keeps the engine portable."
>
	<PageShell Rhythm="wide">
		<PageHeader
			Tape="FLAVORS // THE ROADMAP"
			Title="One engine, many hosts"
			Lead={[
				"A tool call's output becomes part of the model's context, and the engine that rewrites it before the model reads it can live in more than one host.",
				"Aphrodite's compression engine does not belong to one agent.",
				`It is the reason the same CCR core ships in more than one shape: the native Hermes plugin is the flagship flavor today - the deepest integration, the most capabilities - while a standalone listener serves any OpenAI-compatible client, and the engine's core is an embedded fork built to stay portable.`,
			]}
		/>

		<!-- 01 // THE MATRIX - the whole surface in one shape, ordered by reach,
		     beside the answer the rows add up to -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">01 // THREE HOSTS // ONE CORE</p>
			<h2 id="surface" class="mt-3 scroll-mt-24 type-section text-bone-white">
				What ships, and what each one sees
			</h2>

			<div class="split mt-6">
				<p class="max-w-[46rem] font-body text-body leading-relaxed text-bone-newsprint">
					A host can only compress what it can see, so the flavors are ordered by how much
					of the turn each one is exposed to - and that ordering is what decides which
					compression the flavor can perform.
				</p>

				<div class="well p-4 sm:p-5">
					<p class={Eyebrow}>WHICH ONE TO RUN</p>
					<p class="mt-3 font-body text-body leading-relaxed text-bone-newsprint">
						If the agent is Hermes, the plugin is the deepest integration and it ships
						today. If it is any other OpenAI-compatible client, the standalone proxy
						already works and simply sees less of the turn.
					</p>
					<p class="mt-3 font-body text-body leading-relaxed text-zinc-dust">
						Embedded Headroom is the core the other flavors carry rather than a host you
						adopt on its own, and further hosts are planned on the same hook-and-tool
						pattern.
					</p>
				</div>
			</div>

			<ZineSurface Class="mt-8" Mode="edge">
				<div class="overflow-x-auto">
					<table class="w-full border-collapse text-left">
						<thead>
							<tr class="border-b border-[color:var(--tier-well-edge)]">
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									FLAVOR
								</th>
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									HOST
								</th>
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									WHAT IT SEES
								</th>
								<th
									scope="col"
									class="type-meta px-4 py-3 font-bold uppercase text-zinc-dust sm:px-5"
								>
									STATUS
								</th>
							</tr>
						</thead>
						<tbody>
							{Hosts.map((Host) => (
								<tr class="border-b border-[color:var(--tier-shell-edge)] align-top last:border-b-0">
									<th
										scope="row"
										class="whitespace-nowrap px-4 py-4 text-left sm:px-5"
									>
										<a
											href={`#${Host.Id}`}
											class="font-mono text-code font-bold text-weathered-teal underline decoration-transparent decoration-2 underline-offset-4 transition-colors hover:decoration-stamped-canary"
										>
											{Host.Flavor}
										</a>
									</th>
									<td class="max-w-[20rem] px-4 py-4 font-body text-body leading-relaxed text-bone-newsprint sm:px-5">
										{Host.Host}
									</td>
									<td class="max-w-[26rem] px-4 py-4 font-body text-body leading-relaxed text-zinc-dust sm:px-5">
										{Host.Sees}
									</td>
									<td class="px-4 py-4 sm:px-5">
										<span class:list={["telemetry-tag", Host.Badge]}>
											{Host.Status}
										</span>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</ZineSurface>
		</section>

		<!-- 02 // RECOMMENDED - the one dominant plate, at the page's single
		     expressive volume, split into what it is and what the decision turns
		     on -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">02 // RECOMMENDED // FLAVOR 01</p>
			<h2 id={Plugin.Id} class="mt-3 scroll-mt-24 type-section text-bone-white">
				{Plugin.Head}
			</h2>

			<ZineBox
				Emphasis="featured"
				Size="lg"
				Surface="shell"
				Tape={Plugin.Label}
				TapeColor="raw"
				Grunge={true}
				Class="mt-8"
			>
				<div class="chips">
					<ZineStamp Label="RECOMMENDED" Color="canary" Rotate="-rotate-2" />
					<span class:list={["telemetry-tag", Plugin.Badge]}>{Plugin.Status}</span>
					<span class={CostTag}>{Plugin.Cost}</span>
				</div>

				<div class="pods mt-8">
					<div>
						<p class={Eyebrow}>WHAT IT IS</p>
						<div
							class="prose-flow mt-3 font-body text-body leading-relaxed text-bone-newsprint"
							set:html={Plugin.Body}
						/>
						<div class="chips mt-6">
							{Plugin.Chips.map((Name) => (
								<span class={FactTag}>{Name}</span>
							))}
						</div>
					</div>

					<div class="well p-4 sm:p-5">
						<p class={Eyebrow}>THE DECISION</p>
						<dl class="mt-4 grid gap-y-4">
							<div>
								<dt class={Label}>HOST</dt>
								<dd class="mt-1 font-body text-body leading-relaxed text-bone-newsprint">
									{Plugin.Host}
								</dd>
							</div>
							<div>
								<dt class={Label}>WHAT IT SEES</dt>
								<dd class="mt-1 font-body text-body leading-relaxed text-zinc-dust">
									{Plugin.Sees}
								</dd>
							</div>
							<div>
								<dt class={Label}>TRADE-OFF</dt>
								<dd class="chips mt-2">
									{Plugin.Trade.map((Name) => (
										<span class={LeadTradeTag}>{Name}</span>
									))}
								</dd>
							</div>
						</dl>
					</div>
				</div>
			</ZineBox>
		</section>

		<!-- 03 // THE OTHERS - three standard plates, subordinate to the
		     recommendation by treatment, never by losing a claim -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">03 // THE OTHER HOSTS</p>
			<h2 class="mt-3 type-section text-bone-white">What each one gives up</h2>
			<p class="mt-6 max-w-[46rem] font-body text-body leading-relaxed text-bone-newsprint">
				Each of these runs the same core behind less of the turn, and each card names the
				reach it trades away - the host it asks for, what it can see, and what it cannot.
			</p>

			<div class="mt-10 grid gap-10 md:grid-cols-2 xl:grid-cols-3">
				{Others.map((Card) => (
					<ZineBox
						Emphasis="standard"
						Accent={Card.Accent}
						Tape={Card.Label}
						TapeColor={Card.Tape}
						Grunge={true}
						Class="flex h-full flex-col"
					>
						<header class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-[color:var(--tier-shell-edge)] pb-4">
							<span class:list={["telemetry-tag", Card.Badge]}>{Card.Status}</span>
							<span class={CostTag}>{Card.Cost}</span>
						</header>

						<h3 id={Card.Id} class="mt-6 scroll-mt-24 type-sub text-bone-white">
							{Card.Head}
						</h3>

						<dl class="mt-4 grid gap-y-3">
							<div>
								<dt class={Label}>HOST</dt>
								<dd class="mt-1 font-body text-body leading-relaxed text-bone-newsprint">
									{Card.Host}
								</dd>
							</div>
							<div>
								<dt class={Label}>WHAT IT SEES</dt>
								<dd class="mt-1 font-body text-body leading-relaxed text-zinc-dust">
									{Card.Sees}
								</dd>
							</div>
						</dl>

						<div
							class="prose-flow mt-5 font-body text-body leading-relaxed text-bone-newsprint"
							set:html={Card.Body}
						/>

						<div class="well mt-auto p-4">
							<p class={Label}>TRADE-OFF</p>
							<div class="chips mt-2">
								{Card.Trade.map((Name) => (
									<span class={TradeTag}>{Name}</span>
								))}
							</div>
							<p class={`${Eyebrow} mt-4`}>CAPABILITIES</p>
							<div class="chips mt-2">
								{Card.Chips.map((Name) => (
									<span class={FactTag}>{Name}</span>
								))}
							</div>
						</div>
					</ZineBox>
				))}
			</div>

			<ZineSource
				Lines={[
					"SRC: README.md; aphrodite.toml.example ([[proxies]])",
					"SRC: plugins/aphrodite/plugin.yaml (provides_hooks, provides_tools)",
				]}
			/>
		</section>

		<!-- SLOT 4: exactly one onward link -->
		<Related
			Links={[
				{ Href: "/hermes/", Label: "HERMES" },
				{ Href: "/plugin/", Label: "PLUGIN" },
				{ Href: "/setup/", Label: "SETUP" },
			]}
		/>
	</PageShell>
</Base>
