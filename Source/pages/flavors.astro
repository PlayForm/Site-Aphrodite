---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import ZineTape from "@Component/ZineTape.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineSource from "@Component/ZineSource.astro";
import { HookNames, ToolNames } from "@Library/Roster";

// THE THREE HOSTS - the table is the page's claim in one shape: what each
// flavor is, what it can see inside the agent, and where it stands today.
// The sections below are the detail behind each row.
const Hosts = [
	{
		Flavor: "HERMES PLUGIN",
		Host: "Hermes Agent",
		Sees: "Everything - hooks, tools, the prompt",
		Status: "TODAY",
		Tone: "text-stamped-canary",
	},
	{
		Flavor: "STANDALONE PROXY",
		Host: "Any OpenAI-compatible client",
		Sees: "The HTTP body - no hook interception",
		Status: "SHIPS TODAY",
		Tone: "text-weathered-teal",
	},
	{
		Flavor: "EMBEDDED HEADROOM",
		Host: "The engine's own core",
		Sees: "Content types and previews, not agent APIs",
		Status: "FOUNDATION",
		Tone: "text-zinc-dust",
	},
	{
		Flavor: "MORE HOSTS // PLANNED",
		Host: "Additional agents",
		Sees: "Whatever the host exposes - the proxy path already works",
		Status: "PLANNED",
		Tone: "text-zinc-dust",
	},
];
---

<Base
	Title="FLAVORS // APHRODITE"
	Description="The Aphrodite roadmap: a native Hermes plugin today, the standalone proxy for any OpenAI-compatible client, and the embedded Headroom core that keeps the engine portable."
>
	<PageShell Rhythm="wide">
		<PageHeader
			Tape="FLAVORS // THE ROADMAP"
			Title="One engine, many hosts"
			Lead={[
				"Aphrodite's compression engine does not belong to one agent.",
				`It is the reason the same CCR core ships in more than one shape: the native Hermes plugin is the flagship flavor today - the deepest integration, the most capabilities - while a standalone listener serves any OpenAI-compatible client, and the engine's core is an embedded fork built to stay portable.`,
				"The table is the whole surface in one shape; the sections after it are the detail behind each row.",
			]}
		/>

		<!-- SLOT 3: one claim's evidence - the three hosts, then one block each -->
		<section class="relative w-full" data-reveal>
			<ZineTape Variant="section" Label="THREE HOSTS // ONE CORE" />
			<ZineBox Size="lg" Rotate="-rotate-[1deg]">
				<h3
					id="surface"
					class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl"
				>
					What ships, and what each one sees
				</h3>
				<div class="overflow-x-auto">
					<table class="w-full border-collapse font-mono text-base">
						<thead>
							<tr class="border-b-2 border-oxblood-dark text-left">
								<th class="py-3 pr-4 text-base font-black uppercase tracking-widest text-stamped-canary">FLAVOR</th>
								<th class="py-3 pr-4 text-base font-black uppercase tracking-widest text-stamped-canary">HOST</th>
								<th class="py-3 pr-4 text-base font-black uppercase tracking-widest text-stamped-canary">WHAT IT SEES</th>
								<th class="py-3 text-base font-black uppercase tracking-widest text-stamped-canary">STATUS</th>
							</tr>
						</thead>
						<tbody class="text-bone-newsprint">
							{
								Hosts.map(({ Flavor, Host, Sees, Status, Tone }) => (
									<tr class="border-b border-oxblood-dark">
										<td class="py-3 pr-4 text-bone-white">{Flavor}</td>
										<td class="py-3 pr-4">{Host}</td>
										<td class="py-3 pr-4 text-zinc-dust">{Sees}</td>
										<td class={`py-3 font-black uppercase tracking-widest ${Tone}`}>{Status}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p class="mt-8 font-body text-base leading-relaxed text-zinc-dust">
					The rows are ordered by how much of the turn each host can see, because that is what
					decides which compression the flavor can perform.
				</p>

				<ZineTape Variant="section" Label="FLAVOR 01 // HERMES PLUGIN" />
				<h3
					id="hermes"
					class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl"
				>
					The full integration
				</h3>
				<p class="font-body text-base leading-relaxed text-bone-newsprint">
					Six hooks, thirteen tools, the context engine, auto-launched dual proxies - the
					native flavor sees everything the agent sees.
				</p>
				<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
					This is the flavor this site documents.
				</p>
				<div class="mt-8 flex flex-wrap gap-6">
					<span class="border border-oxblood-dark bg-soot-black px-3 py-1 font-mono text-base uppercase text-bone-newsprint">{HookNames.length} HOOKS</span>
					<span class="border border-oxblood-dark bg-soot-black px-3 py-1 font-mono text-base uppercase text-bone-newsprint">{ToolNames.length} TOOLS</span>
					<span class="border border-oxblood-dark bg-soot-black px-3 py-1 font-mono text-base uppercase text-bone-newsprint">CONTEXT ENGINE</span>
					<span class="border border-oxblood-dark bg-soot-black px-3 py-1 font-mono text-base uppercase text-bone-newsprint">DIRECTIVES</span>
				</div>

				<ZineTape Variant="section" Label="FLAVOR 02 // STANDALONE PROXY" />
				<h3
					id="proxy"
					class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl"
				>
					Any OpenAI-compatible client
				</h3>
				<p class="font-body text-base leading-relaxed text-bone-newsprint">
					Point <code class="font-mono text-base text-weathered-teal">base_url</code> at
					<code class="font-mono text-base text-weathered-teal">:9798</code> (or
					<code class="font-mono text-base text-weathered-teal">:9797</code>) and the same
					compression engine sits between the client and its LLM - token and cache
					listeners, SQLite or in-memory storage.
				</p>
				<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
					What it cannot do is see inside the agent: no hook interception, no tools, no
					prompt injection.
				</p>
				<div class="mt-8 flex flex-wrap gap-6">
					<span class="border border-oxblood-dark bg-soot-black px-3 py-1 font-mono text-base uppercase text-bone-newsprint">OPENAI-COMPATIBLE</span>
					<span class="border border-oxblood-dark bg-soot-black px-3 py-1 font-mono text-base uppercase text-bone-newsprint">TOKEN :9798</span>
					<span class="border border-oxblood-dark bg-soot-black px-3 py-1 font-mono text-base uppercase text-bone-newsprint">CACHE :9797</span>
				</div>

				<ZineTape Variant="section" Label="FOUNDATION // EMBEDDED HEADROOM" />
				<h3
					id="headroom"
					class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl"
				>
					The portable core
				</h3>
				<p class="font-body text-base leading-relaxed text-bone-newsprint">
					Aphrodite embeds Headroom - a custom fork, tracked as a git submodule - as its
					content-transform core:
				</p>
				<ul class="mt-2 space-y-1 font-body text-base leading-relaxed text-bone-newsprint">
					<li class="border-l-2 border-oxblood-dark pl-3">the classifier</li>
					<li class="border-l-2 border-oxblood-dark pl-3">the smart crusher</li>
					<li class="border-l-2 border-oxblood-dark pl-3">the tokenizer.</li>
				</ul>
				<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
					The Hermes-specific layer is a thin bridge on top.
				</p>
				<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
					It is the reason new host flavors are possible: the engine already speaks in content
					types and previews, not in agent APIs.
				</p>

				<ZineTape Variant="section" Label="ROADMAP // PLANNED" Color="bone" />
				<h3
					id="roadmap"
					class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl"
				>
					Other agents
				</h3>
				<p class="font-body text-base leading-relaxed text-bone-newsprint">
					Beyond Hermes, additional host flavors are planned - the standalone proxy path
					already works with any OpenAI-compatible agent today, and deeper native
					integrations follow the same hook-and-tool pattern the Hermes plugin established.
				</p>
				<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
					No dates are promised; when a new flavor ships, its documentation ships with it.
				</p>
			</ZineBox>
			<ZineSource
				Lines={[
					"SRC: README.md; aphrodite.toml.example ([[proxies]])",
					"SRC: plugins/aphrodite/plugin.yaml (provides_hooks, provides_tools)",
				]}
			/>
		</section>

		<!-- SLOT 4: exactly one onward link -->
		<Related
			Links={[
				{ Href: "/hermes/", Label: "HERMES" },
				{ Href: "/plugin/", Label: "PLUGIN" },
				{ Href: "/setup/", Label: "SETUP" },
			]}
		/>
	</PageShell>
</Base>
