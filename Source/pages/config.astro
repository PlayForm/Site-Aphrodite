---
import Base from "@Layout/Base.astro";
import ConfigResolution from "../Content/Mermaid/config-resolution.svg?raw";
import type { ConfigKeyLadderRecord } from "@Library/Records";
import ZineDiagramNav from "@Component/ZineDiagramNav.astro";
import SectionNav from "@Component/SectionNav.astro";
import CopyButton from "@Component/CopyButton.astro";
import ZineBox from "../Component/ZineBox.astro";
import ZineKicker from "../Component/ZineKicker.astro";
import ZineStamp from "../Component/ZineStamp.astro";
import ZineStream from "../Component/ZineStream.astro";
import ZineTape from "../Component/ZineTape.astro";
import ConfigKeys from "../Component/ConfigKeys.astro";
import PageShell from "@Component/PageShell.astro";
import Related from "@Component/Related.astro";

// The CONFIG PLAYGROUND: the aphrodite.toml surface made explorable, as a
// CLIENT-SIDE SIMULATION (no runtime, no network). Every fact below traces to
// the shipped sources: aphrodite.toml.example (the full annotated file),
// README.md:371-442 (the configuration section), docs/config/aphrodite-toml.md
// (the complete schema) and docs/config/env-vars.md (the overrides). The
// SANITIZATION law: the TOML shown in the editor is the SHIPPED EXAMPLE -
// never a user's real toml, never an api_key value (the key field renders as
// its env-var name).
//
// THE KEYS ARRAY IS THE PAGE'S ONE SOURCE PER KNOB. The table renders it, the
// resolution ladder renders it, the /reload simulation renders it and the
// classify matrix reads its two threshold rows, so a default cannot disagree
// with itself the way the three former copies (a [compression] table, the
// prose enumerating each parser's keys, and the ladder's own chain arrays)
// could. The record shape lives in Source/Library/Records.ts - the page fills
// it, it never declares a second copy of it.

// The editor's default text: the shipped example, byte-faithful except the
// commented api_key sample line, which renders as its env-var name only.
const Example = [
	"# ── Aphrodite Configuration ────────────────────────────────────────────────",
	"# Copy this file to aphrodite.toml and edit to your needs.",
	"# Priority (a subset of fields only - see docs/config/env-vars.md):",
	"# env var > aphrodite.toml > hardcoded default.",
	"#",
	"# Search order: ./aphrodite.toml, then ~/.hermes/aphrodite/aphrodite.toml",
	"# (only when APHRODITE_CONFIG_PATH is NOT set - an explicit override that",
	"# doesn't exist falls through to single-proxy CLI-flag mode instead).",
	"#",
	"# Two independent parsers read this file:",
	"#   - the Rust HTTP proxy (config/proxy.rs, when an aphrodite.toml is found):",
	"#     [[proxies]], [defaults], the four hot-reload thresholds plus",
	"#     auto_expand/auto_expand_limit/max_request_body_size in [compression],",
	"#     and [previews] preview_max_chars (also re-applied by POST /reload and",
	"#     the config-file watcher);",
	"#   - the Hermes dylib session (config_loader.rs): the [compression]",
	"#     engine/chain-split/poll/live_container/recursive_depth keys, [defaults]",
	"#     model/api_url, [flow], [directives], [prompts] session_inject +",
	"#     retrieve_guidance/ccr_marker_hint/catalog_intent_hints, [templates],",
	"#     [previews] preview_max_chars.",
	"#",
	"# ── Proxies ─────────────────────────────────────────────────────────────────",
	"[[proxies]]",
	'name = "cache"',
	'listen = "127.0.0.1:9797"',
	'# listen = "0.0.0.0:9797"  # WARNING: exposes proxy to your network',
	'mode = "cache"',
	"tool_relay = true",
	"timeout = 120",
	"",
	"[[proxies]]",
	'name = "token"',
	'listen = "127.0.0.1:9798"',
	'# listen = "0.0.0.0:9798"  # WARNING: exposes proxy to your network',
	'mode = "token"',
	"tool_relay = true",
	"timeout = 300",
	"",
	"# ── Shared defaults (applied to all proxies unless overridden) ──────────────",
	"[defaults]",
	'api_url = "https://api.openai.com"',
	'model = "default-model"',
	"ccr_ttl_seconds = 3600",
	"# api_key precedence: proxy-level api_key > [defaults] api_key >",
	"# APHRODITE_API_KEY env var. Only uncomment if you cannot use the env var.",
	"",
	"[compression]",
	"engine_threshold_pct = 30   # LOAD-BEARING (dylib): middle-turn archiving + engine_offload prompt; 100+ = off",
	"engine_protect_first = 2    # LOAD-BEARING (dylib): messages kept at the start",
	"engine_protect_last = 5     # LOAD-BEARING (dylib): messages kept at the end",
	"engine_min_msgs = 8         # LOAD-BEARING (dylib): minimum messages before the engine activates",
	"tool_threshold_token = 256  # token proxy threshold (bytes) - hot-reloads",
	"tool_threshold_cache = 2048 # cache proxy threshold (bytes) - hot-reloads",
	"terminal_threshold = 256    # dylib terminal-output threshold (bytes)",
	"inline_threshold = 1024     # inline zlib fallback threshold (bytes) - hot-reloads",
	"auto_expand = true          # WIRED (proxy): resolve just-stored content inline instead of a marker",
	"auto_expand_limit = 102400  # WIRED (proxy): byte cap for auto-expanded content",
	"live_container = false      # WIRED (dylib): instant 'live' CCR markers for large tool results",
	"recursive_depth = 5         # WIRED (dylib): max nested expansion depth",
	"code_multiplier = 1.0       # multiply threshold for code types (hot-reloads)",
	"# ── Store retention (SQLite token proxy) ─────────────────────────────────",
	"# ccr_ttl_seconds bounds the store in TIME; these two bound it in SPACE:",
	"# past either cap the least-recently-accessed rows are evicted, and an",
	"# evicted hash becomes a retrieval miss, exactly like an expired one.",
	"# Read at store open (NOT hot-reloaded); 0 = unlimited.",
	"store_max_entries = 100000  # max live rows (env APHRODITE_STORE_MAX_ENTRIES)",
	"store_max_bytes = 536870912 # max stored payload bytes, SUM(LENGTH(original)) (env APHRODITE_STORE_MAX_BYTES)",
	"context_engine = true       # dylib-path only; the HTTP proxy never reads it",
	"auto_reload = true          # dylib-path: watch aphrodite.toml and re-apply config on change",
	"",
	"[previews]",
	"preview_max_chars = 0       # caps the whole rendered preview string; 0 = unlimited",
	'model_family = "code_first" # selects the [templates.preview.<family>.*] family',
	"",
	"[prompts]",
	'retrieve_guidance = "minimal" # how much the system prompt explains CCR retrieval',
	"ccr_marker_hint = false       # append a retrieval hint after markers",
	"catalog_intent_hints = false  # intent hints in catalog output",
	"",
	"# ── Templates (live config - optional format strings) ───────────────────────",
	'# [templates.preview.<family>.<ctype>] = "format string"  # {type} {ln} {size} {fns} {sigs} ...',
	"# [templates.marker] format/hint · [templates.prompts] session_inject/engine_offload",
	"# [templates.reverse] ctype -> key remap. Absent = hardcoded builders.",
	"",
	"[directives]",
	'active = ["lazy", "lazy-eval", "foresight"]',
	"",
	"[flow]",
	"budget_chars = 2600         # hard cap on per-turn injected context",
].join("\n");

// EVERY KEY, ONCE. Section groups the table; Type/Default/Env are the schema
// doc's own columns (docs/config/aphrodite-toml.md); Reader says which of the
// two parsers reads it; Live says when a change takes effect; Chain and From
// are what the resolution ladder needs to walk the value. The shape itself is
// Records.ts, and the rows are generated - see the roster below.
import { Assert, ConfigKeys as GeneratedKeys, ConfigNames, EnvVars } from "@Library/Roster";
import { ConfigProse } from "@Library/Prose/Config";
// THE KEY ROSTER - generated, never typed here.
//
// `Source/Generated/Facts/Config.json` is built from
// `docs/config/aphrodite-toml.md` joined to `aphrodite.toml.example`, so a key
// the module declares appears on this page with no edit to it, and a key this
// page invents cannot survive `Assert`. The page's own sentences live in
// `@Library/Prose/Config` and may only deepen a row: which keys exist, their
// section, default, env override and reader all come from the module.
const Keys: ConfigKeyLadderRecord[] = GeneratedKeys.map((Key) => {
	const { DefaultNote, ...Prose } = ConfigProse[Key.Key] ?? {};

	// Three sentences can describe one key and each says something the others
	// do not: the module's own annotation, the page's gloss, and the page's
	// wording for a default the module states more tersely. None is dropped.
	const Detail = [Key.Detail, Prose.Detail, DefaultNote].filter(Boolean).join(" \u00b7 ");

	return {
		...Key,
		...Prose,
		Type: Prose.Type ?? Key.Type,
		Effect: Prose.Effect ?? Key.Effect,
		...(Detail === "" ? {} : { Detail }),
	};
});
Assert("Source/Library/Prose/Config.ts", ConfigProse, ConfigNames);


// A sentence under the sections that need one - the table cannot say these.
const SectionNotes: Record<string, string> = {
	"[[proxies]]":
		"One entry per listener; [defaults] repeats api_url, model, ccr_ttl_seconds and api_key one level up, for every proxy that does not set its own.",
	"[compression]":
		"One table, two consumers - the READER column is the split, and it is why the same key can be hot for the proxy and load-once for the dylib.",
	"[templates]":
		"Live configuration: every block is optional, and when a block (or the whole section) is absent the hardcoded builders and shipped defaults apply.",
};

// THE CLASSIFY MATRIX. One row per match arm of `threshold_for`
// (crates/aphrodite/src/proxy.rs:613-644): the base threshold, then one
// multiplier per content type. `code_multiplier` is a knob, so it is named as
// one and resolved from the editor rather than frozen to 3.0 here - the table
// below therefore shows the numbers the running proxy would use, not a
// restatement of the defaults column.
const Types: { Type: string; Factor: number | "code_multiplier" }[] = [
	{ Type: "error", Factor: 8 },
	{ Type: "code_rust", Factor: "code_multiplier" },
	{ Type: "code_python", Factor: "code_multiplier" },
	{ Type: "code_go", Factor: "code_multiplier" },
	{ Type: "code_js", Factor: "code_multiplier" },
	{ Type: "code", Factor: "code_multiplier" },
	{ Type: "diff", Factor: 2 },
	{ Type: "git", Factor: 2 },
	{ Type: "text", Factor: 2 },
	{ Type: "json", Factor: 1 },
	{ Type: "tool_output", Factor: 1 },
	{ Type: "any other type", Factor: 1 },
];

// The compiled defaults, read out of the Keys array rather than repeated: the
// Default cell's leading number is the binary's value ("1024 (example 256)" is
// 1024 with the shipped example beside it).
const CompiledNumber = (Key: string, Fallback: number): number => {
	const Value = Number.parseFloat(Keys.find((Row) => Row.Key === Key)?.Default ?? "");
	return Number.isFinite(Value) ? Value : Fallback;
};

const BaseBytes = CompiledNumber("tool_threshold_token", 1024);
const CodeMultiplier = CompiledNumber("code_multiplier", 3);

const Effective = (Row: { Factor: number | "code_multiplier" }): number =>
	Math.round(BaseBytes * (Row.Factor === "code_multiplier" ? CodeMultiplier : Row.Factor));

const FactorLabel = (Row: { Factor: number | "code_multiplier" }): string =>
	Row.Factor === "code_multiplier" ? "×code_multiplier" : `×${Row.Factor}`;

// What the ladder and the /reload simulation read: the same rows, trimmed to
// the fields the client-side simulation needs. The excluded keys are the ones
// whose value the page must never echo (a key, a callback) or whose absence
// would say nothing about precedence.
const LadderExcluded = new Set(["dev", "notify_url", "notify_key", "max_context", "max_output", "timeout", "name"]);

const Tracked = Keys.filter((Row) => Row.Live !== "unwired" && !LadderExcluded.has(Row.Key)).map(
	({ Key, Section, Env, Default, Reader, Live, Chain, From }) => ({
		Key,
		Section,
		Env,
		Default,
		Reader,
		Live,
		Chain: Chain ?? "env-first",
		From: From ?? "section",
	}),
);

// The page's own sections, in document order - SectionNav renders exactly
// these, so an entry can never name a section the page does not have.
const Sections = [
	{ Id: "pick-chain", Label: "THE FILE" },
	{ Id: "editor", Label: "EDITOR" },
	{ Id: "keys", Label: "EVERY KEY" },
	{ Id: "knobs", Label: "THE KNOBS" },
	{ Id: "flow", Label: "PER-TURN" },
	{ Id: "unwired", Label: "UNWIRED" },
	{ Id: "env", Label: "OVERRIDES" },
	{ Id: "classify", Label: "CLASSIFY" },
	{ Id: "proxies", Label: "THE PAIR" },
	{ Id: "parsers", Label: "TWO PARSERS" },
	{ Id: "reload", Label: "/RELOAD" },
];
---

<Base
	Title="CONFIG // APHRODITE"
	Description="The interactive aphrodite.toml explorer - the pick chain, the two stacks, the [[proxies]] pair and the compression knobs, simulated client-side."
>
	<PageShell Crumbs>
		<!-- Header -->
		<header class="relative border-l-4 border-blood-crimson bg-carbon-void p-8">
			<ZineTape Label="aphrodite.toml" Color="raw" Side="left" />
			<p class="font-mono text-base font-bold uppercase tracking-widest text-stamped-canary">
				THE FILE THAT TUNES EVERYTHING
			</p>
			<h1 class="mt-3 text-3xl font-bold tracking-tight text-bone-white sm:text-4xl">
				Configuration Playground
			</h1>
			<p class="mt-4 max-w-3xl text-base text-zinc-dust">
				A tool call's output becomes part of the model's context, and aphrodite.toml decides
				how much of it is replaced before the model reads it.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				One TOML file, two independent parsers, three places it can live.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				The resolution order re-decides what wins as the shipped example changes - env var,
				per-proxy entry, defaults, or the compiled-in fallback.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">Everything here runs in your browser.</p>
		</header>

		<SectionNav Sections={Sections} />

		<!-- The pick chain -->
		<section id="pick-chain" class="relative w-full" aria-label="The file pick chain" data-reveal>
			<ZineTape Label="the pick chain" Color="teal" Side="right" />
			<h2 class="font-headline text-2xl font-black tracking-tight text-bone-white sm:text-3xl">
				Where the file is found
			</h2>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				Three stops, in order - and a hard fall-through when none of them exists
				(docs/config/aphrodite-toml.md, "File location"):
			</p>
			<div class="mt-8">
				<ZineStream
					Lines={[
						{
							Text: "1&nbsp;&nbsp;APHRODITE_CONFIG_PATH&nbsp;&nbsp;&mdash;&nbsp;explicit override. A path that does not exist still counts as set: it falls through to CLI-flag mode, it never silently redirects.",
							Tone: "canary",
						},
						{
							Text: "2&nbsp;&nbsp;./aphrodite.toml&nbsp;&nbsp;&mdash;&nbsp;the default: the current working directory.",
							Tone: "plain",
						},
						{
							Text: "3&nbsp;&nbsp;~/.hermes/aphrodite/aphrodite.toml&nbsp;&nbsp;&mdash;&nbsp;the fallback, consulted only when the env var was NOT set; this is where <b>aphrodite setup</b> writes its generated config.",
							Tone: "plain",
						},
						{
							Text: "4&nbsp;&nbsp;none found&nbsp;&nbsp;&mdash;&nbsp;CLI-flag mode: a single proxy, --mode / --listen / --api-key and friends.",
							Tone: "fade",
						},
					]}
				/>
			</div>
		</section>

		<!-- The live editor + the resolution ladder -->
		<section id="editor" class="relative w-full" aria-label="The live TOML editor" data-reveal>
			<ZineTape Label="live editor" Color="canary" Side="left" />
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h2 class="font-headline text-2xl font-black tracking-tight text-bone-white sm:text-3xl">
					Edit the shipped example
				</h2>
				<div class="flex flex-wrap items-center gap-3">
					<CopyButton Label="COPY TOML" Payload={Example} Tone="teal" Size="md" />
					<button
						type="button"
						data-action="reset"
						class="inline-block border border-black bg-raw-blood px-4 py-2 font-mono text-base font-black uppercase text-bone-white shadow-[3px_3px_0px_#000] transition-colors hover:bg-blood-crimson active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
					>
						Reset example
					</button>
				</div>
			</div>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				This is the shipped <code class="text-bone-newsprint">aphrodite.toml.example</code> (sanitized:
				the api_key sample renders as its env-var name).
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				Edit it - the resolution ladder on the right re-decides every tracked key as you type.
			</p>

			<div class="mt-8 grid gap-10 lg:grid-cols-2">
				<!-- Editor pane -->
				<div class="flex flex-col border-4 border-blood-crimson bg-carbon-void">
					<div class="flex items-center justify-between border-b-2 border-blood-crimson bg-soot-black px-5 py-3">
						<ZineKicker Tone="canary">aphrodite.toml</ZineKicker>
						<span class="font-mono text-base text-zinc-dust" data-editor-status aria-live="polite">
							parsed
						</span>
					</div>
					<label class="sr-only" for="config-editor">aphrodite.toml contents</label>
					<textarea
						id="config-editor"
						data-editor
						spellcheck="false"
						class="h-[36rem] w-full resize-y bg-transparent p-5 font-mono text-base leading-relaxed text-bone-newsprint"
						placeholder="loading the shipped example..."></textarea>
				</div>

				<!-- Resolution ladder pane -->
				<div class="flex flex-col border-4 border-blood-crimson bg-carbon-void">
					<div class="flex items-center justify-between border-b-2 border-blood-crimson bg-soot-black px-5 py-3">
						<ZineKicker Tone="teal">EFFECTIVE CONFIG - WHO WINS</ZineKicker>
						<span class="font-mono text-base text-zinc-dust">env &gt; toml &gt; compiled</span>
					</div>
					<div class="flex-1 space-y-4 p-5" data-ladder aria-live="polite">
						<!-- rendered client-side from the same Keys array the table uses -->
					</div>
				</div>
			</div>
		</section>

		<!-- The resolution diagram -->
		<section id="diagram" class="w-full" aria-label="The config-resolution diagram" data-reveal>
			<figure class="border-4 border-blood-crimson bg-carbon-void p-4" data-diagram="config-resolution">
				<div class="overflow-x-auto" set:html={ConfigResolution} />
				<figcaption class="mt-3 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
					M7 // CONFIG RESOLUTION
				</figcaption>
			</figure>
		</section>

		<!-- THE KEYS: the page's one reference -->
		<section id="keys" class="relative w-full" aria-label="Every configuration key" data-reveal>
			<ZineTape Label="every key" Color="raw" Side="right" />
			<h2 class="font-headline text-2xl font-black tracking-tight text-bone-white sm:text-3xl">
				Every key, once
			</h2>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				One row per key is the only reference the file gets: its type,
				its compiled default, the env override, which parser reads it, when a change takes effect,
				and what it does.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				Where the shipped example sets a different value, both are shown - an installation using the
				example sees the second, a bare binary sees the first.
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<ZineStamp Label="hot = /reload + watcher" Color="canary" />
				<ZineStamp Label="startup = restart" Color="bone" />
				<ZineStamp Label="load = read at dylib load" Color="bone" />
				<ZineStamp Label="unwired = silent no-op" Color="raw" />
			</div>
			<!-- THE FILTER: a plain input over the rows already in the table. The
			     table below is complete without it - the control is not rendered
			     at all when the head script never set html.js - so a reader
			     without JavaScript reads every key, and a reader with it can
			     narrow the 54 rows to the four they are chasing. -->
			<div
				class="mt-12 border-4 border-blood-crimson bg-carbon-void"
				data-key-filter-wrap
			>
				<div
					class="flex flex-wrap items-baseline justify-between gap-4 border-b-2 border-blood-crimson bg-soot-black px-5 py-3"
				>
					<label
						for="key-filter"
						class="font-mono text-base font-black uppercase tracking-widest text-stamped-canary"
					>
						FILTER THE TABLE
					</label>
					<span
						class="font-mono text-base uppercase tracking-widest text-zinc-dust"
						data-key-filter-count
						aria-live="polite"
					>
						{Keys.length} KEYS
					</span>
				</div>
				<div class="px-5 py-4">
					<input
						id="key-filter"
						data-key-filter
						type="search"
						autocomplete="off"
						spellcheck="false"
						placeholder="threshold · APHRODITE_ · dylib · hot"
						class="w-full border border-oxblood-dark bg-soot-black px-4 py-2 font-mono text-base text-bone-newsprint placeholder:text-zinc-dust"
					/>
					<p class="mt-3 max-w-3xl text-base text-zinc-dust">
						One field, matched against every column of every row: a key name
						(<code class="text-bone-newsprint">threshold</code>), an env override
						(<code class="text-bone-newsprint">APHRODITE_</code>), a reader
						(<code class="text-bone-newsprint">dylib</code>), a live class
						(<code class="text-bone-newsprint">hot</code>) or any word of an effect.
					</p>
					<p class="mt-2 max-w-3xl text-base text-zinc-dust">
						A section whose every row is filtered out takes its heading with it, so what is
						left is the answer and not the shape of the file.
					</p>
					<p class="mt-2 max-w-3xl text-base text-zinc-dust">
						Clear the field to get the whole table back - the filter hides rows that are already in
						the document and never asks the network for anything.
					</p>
					<p
						class="mt-3 hidden font-mono text-base leading-relaxed text-stamped-canary"
						data-key-filter-empty
					>
						No key matches that. Try a section name (<code class="text-bone-newsprint"
							>[compression]</code
						>), a reader (<code class="text-bone-newsprint">dylib</code>) or an env prefix
						(<code class="text-bone-newsprint">APHRODITE_</code>) - and clear the field to
						restore all {Keys.length} rows.
					</p>
				</div>
			</div>

			<div class="mt-12">
				<ConfigKeys Rows={Keys} Notes={SectionNotes} />
			</div>
		</section>

		<!-- THE COMPRESSION KNOBS: what the [compression] rows above actually do -->
		<section id="knobs" class="relative w-full" aria-label="The compression knobs" data-reveal>
			<ZineTape Label="the knobs" Color="canary" Side="right" />
			<h2 class="font-headline text-2xl font-black tracking-tight text-bone-white sm:text-3xl">
				The compression knobs
			</h2>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				The [compression] table is the one section a running proxy re-reads, and only part of it is
				hot.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				Four rows are the hot set: <code class="text-bone-newsprint">tool_threshold_token</code>,
				<code class="text-bone-newsprint">tool_threshold_cache</code>,
				<code class="text-bone-newsprint">inline_threshold</code> and
				<code class="text-bone-newsprint">code_multiplier</code>.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				<code class="text-bone-newsprint">auto_expand</code> and
				<code class="text-bone-newsprint">auto_expand_limit</code> are hot on the same terms, and so
				are <code class="text-bone-newsprint">preview_max_chars</code>, the marker format and hint,
				and <code class="text-bone-newsprint">ccr_marker_hint</code>.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				Everything else in the section is fixed at startup or read once when the dylib loads, which
				is what the LIVE column records row by row.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				<code class="text-bone-newsprint">code_multiplier</code> is the only knob that is a
				multiplier rather than a byte count: the code_* types get the base threshold times its
				value, so 3.0 hands source three times the default patience and 1.0 hands it none.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				<code class="text-bone-newsprint">inline_threshold</code> decides where compressed content
				lives: below it the bytes ride inline as zlib, above it they become a durable store entry
				with a marker.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				<code class="text-bone-newsprint">engine_threshold_pct</code> is the context engine's fill
				gate, and its two extremes are switches: 0 means never archive and 100 or more means the
				engine is off.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				The two store retention caps are the deliberate exception, because a store cannot resize
				while it is serving.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				<code class="text-bone-newsprint">store_max_entries</code> and
				<code class="text-bone-newsprint">store_max_bytes</code> are read when the SQLite store is
				opened, so a change to either takes effect on the next proxy restart, not on save.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				The dylib keys take a third route entirely: they ride
				<code class="text-bone-newsprint">aphrodite_config_set</code> at runtime, so a session can
				move them without a restart and without a file edit.
			</p>
		</section>

		<!-- THE PER-TURN CONTEXT: [flow] / [directives] / [previews] -->
		<section id="flow" class="relative w-full" aria-label="Flow, directives and previews" data-reveal>
			<ZineTape Label="per-turn context" Color="teal" Side="left" />
			<h2 class="font-mono text-2xl font-black uppercase tracking-widest text-bone-white sm:text-3xl">
				[FLOW] / [DIRECTIVES] / [PREVIEWS]
			</h2>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				Three sections decide what the model is handed each turn, and none of them touches
				compression.
			</p>
			<div class="mt-8 grid gap-10 lg:grid-cols-3">
				<ZineBox Tone="teal">
					<ZineKicker As="h3" Tone="teal">[FLOW]</ZineKicker>
					<p class="mt-3 text-base text-zinc-dust">
						<code class="text-bone-newsprint">budget_chars = 2600</code> is the hard cap on ALL
						per-turn injected context.
					</p>
					<p class="mt-3 text-base text-zinc-dust">
						The budget covers directives, nudges, the recall catalog and the retrieve hint
						together, not each one separately.
					</p>
					<p class="mt-3 text-base text-zinc-dust">
						Sections drop bottom-up when the total goes over; directives and nudges never drop.
					</p>
					<p class="mt-3 text-base text-zinc-dust">
						Dylib only, overridable through
						<code class="text-bone-newsprint">APHRODITE_FLOW_BUDGET_CHARS</code>.
					</p>
					<p class="mt-3 text-base text-zinc-dust">
						The compiled default is 4,000 characters, so the shipped example buys a leaner turn
						than a bare binary does.
					</p>
				</ZineBox>
				<ZineBox Tone="subtle">
					<ZineKicker As="h3" Tone="newsprint">[DIRECTIVES]</ZineKicker>
					<p class="mt-3 text-base text-zinc-dust">
						<code class="text-bone-newsprint">active = ["lazy", "lazy-eval", "foresight"]</code>
						names which loaded directives start active.
					</p>
					<p class="mt-3 text-base text-zinc-dust">
						Names that are not in the loaded set are silently filtered out, and an empty list seeds
						focus, foresight and lazy instead.
					</p>
					<p class="mt-3 text-base text-zinc-dust">
						The set is runtime-mutable, so a conversation can swap directives mid-flight through
						<code class="text-bone-newsprint">aphrodite_directive</code>.
					</p>
					<p class="mt-3 text-base text-zinc-dust">
						The built-in set is focus, foresight, ccr-handling, cleanup, explore, lazy and
						lazy-eval - seven files baked into the binary.
					</p>
				</ZineBox>
				<ZineBox Tone="subtle">
					<ZineKicker As="h3" Tone="newsprint">[PREVIEWS]</ZineKicker>
					<p class="mt-3 text-base text-zinc-dust">
						<code class="text-bone-newsprint">preview_max_chars = 0</code> caps the whole rendered
						preview string, not per line, and 0 means unlimited.
					</p>
					<p class="mt-3 text-base text-zinc-dust">
						<code class="text-bone-newsprint">model_family = "code_first"</code> selects the
						<code>[templates.preview.&lt;family&gt;.*]</code> family when
						<code>[templates]</code> is configured.
					</p>
					<p class="mt-3 text-base text-zinc-dust">
						The env var <code>APHRODITE_PREVIEW_MAX_CHARS</code> outranks the file, and the file
						outranks unlimited.
					</p>
					<p class="mt-3 text-base text-zinc-dust">Re-applied by POST /reload.</p>
				</ZineBox>
			</div>
		</section>

		<!-- DOCUMENTED BUT UNWIRED: the honest ledger -->
		<section id="unwired" class="relative w-full" aria-label="Documented but unwired keys" data-reveal>
			<ZineTape Label="honest ledger" Color="bone" Side="right" />
			<h2 class="font-mono text-2xl font-black uppercase tracking-widest text-bone-white sm:text-3xl">
				DOCUMENTED BUT UNWIRED
			</h2>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				Five keys parse and do nothing, and every one of them is marked UNWIRED rather
				than quietly omitted.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				<code class="text-bone-newsprint">catalog_mode</code> lost its reader when the catalog layout
				became compiled-in, so setting it changes nothing.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				<code class="text-bone-newsprint">classifier_poll</code> describes a poll interval the
				classifier never had: classification runs per invocation.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				<code class="text-bone-newsprint">prefetch</code> is dead because the
				<code class="text-bone-newsprint">aphrodite_prefetch</code> tool is registered
				unconditionally.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				<code class="text-bone-newsprint">code_structure_map</code> and
				<code class="text-bone-newsprint">rust_preview_lines</code> are reserved: they describe a
				code preview that includes signatures and a line budget for Rust source, and no builder
				reads either one yet.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				The ledger exists because a key that parses and does nothing is worse than an undocumented
				one: it looks like a lever and behaves like a wall.
			</p>
		</section>

		<!-- THE OVERRIDE LEDGER: every environment variable the module documents -->
		<section id="env" class="relative w-full" aria-label="Every environment variable" data-reveal>
			<ZineTape Label="env" Color="canary" Side="right" />
			<h2 class="font-headline text-2xl font-black tracking-tight text-bone-white sm:text-3xl">
				Every override, live or not
			</h2>
			<p class="mt-4 max-w-3xl text-base text-bone-newsprint">
				A TOML key is only half the story: the environment wins wherever it is set, and the module
				documents {EnvVars.length} variables across three surfaces - the Rust proxy, the
				<code class="text-bone-newsprint">aphrodite setup</code> subcommand, and the Hermes dylib
				session.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				The last two groups are the ones that matter most: a variable with no reader is a silent
				no-op, and a build-time variable exported at runtime changes nothing.
			</p>
			{
				[...new Set(EnvVars.map((Entry) => Entry.Surface))].map((Surface) => (
					<div class="mt-12">
						<h3 class="font-mono text-base font-black uppercase tracking-widest text-stamped-canary">
							{Surface}
						</h3>
						<div class="mt-4 overflow-x-auto">
							<table class="w-full border-collapse font-mono text-base">
								<thead>
									<tr class="border-b-2 border-oxblood-dark text-left">
										<th class="py-3 pr-4 text-base font-black uppercase tracking-widest text-stamped-canary">
											VARIABLE
										</th>
										<th class="py-3 pr-4 text-base font-black uppercase tracking-widest text-stamped-canary">
											PRECEDENCE
										</th>
										<th class="py-3 pr-4 text-base font-black uppercase tracking-widest text-stamped-canary">
											DEFAULT
										</th>
										<th class="py-3 text-base font-black uppercase tracking-widest text-stamped-canary">
											EFFECT
										</th>
									</tr>
								</thead>
								<tbody class="text-bone-newsprint">
									{EnvVars.filter((Entry) => Entry.Surface === Surface).map((Entry) => (
										<tr class="border-b border-oxblood-dark">
											<td class="py-3 pr-4 align-top whitespace-nowrap text-weathered-teal">
												{Entry.Variable}
											</td>
											<td class="py-3 pr-4 align-top text-zinc-dust">{Entry.Precedence ?? "-"}</td>
											<td class="py-3 pr-4 align-top text-bone-white">{Entry.Default ?? "-"}</td>
											<td class="py-3 align-top">{Entry.Effect}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</div>
				))
			}
			<p class="mt-12 border-t border-oxblood-dark pt-8 text-base leading-relaxed text-zinc-dust">
				SRC: docs/config/env-vars.md - every row is generated from it.
			</p>
		</section>

		<!-- THE CLASSIFY MATRIX: one type, one threshold -->
		<section id="classify" class="relative w-full" aria-label="The classify matrix" data-reveal>
			<ZineTape Label="classify" Color="canary" Side="left" />
			<h2 class="font-headline text-2xl font-black tracking-tight text-bone-white sm:text-3xl">
				One type, one threshold
			</h2>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				The gate is <code class="text-bone-newsprint">threshold_for</code> in
				<code class="text-bone-newsprint">crates/aphrodite/src/proxy.rs</code>: the base threshold,
				then one multiplier per content type.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				The base is the proxy's own mode threshold -
				<code class="text-bone-newsprint">tool_threshold_token</code> on the token lane,
				<code class="text-bone-newsprint">tool_threshold_cache</code> on the cache lane.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				The bytes column is computed from the edited file, so the matrix follows those values
				instead of restating the defaults.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-4">
				<ZineKicker Tone="canary">BASE</ZineKicker>
				<span class="font-mono text-base text-bone-newsprint">
					<span data-classify-base>{BaseBytes}</span> B
				</span>
				<ZineKicker Tone="teal">CODE_MULTIPLIER</ZineKicker>
				<span class="font-mono text-base text-bone-newsprint">
					×<span data-classify-mult>{CodeMultiplier}</span>
				</span>
			</div>
			<div class="mt-6 overflow-x-auto border-4 border-blood-crimson bg-carbon-void">
				<table class="w-full min-w-[40rem] text-left text-base">
					<thead>
						<tr class="border-b-2 border-blood-crimson bg-soot-black font-mono text-base uppercase tracking-widest text-zinc-dust">
							<th class="px-5 py-3">Type</th>
							<th class="px-5 py-3">Multiplier</th>
							<th class="px-5 py-3">At the editor's values</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-oxblood-dark/50">
						{Types.map((Row) => (
							<tr class="align-top text-zinc-dust">
								<td class="px-5 py-3 font-mono text-base text-bone-newsprint">{Row.Type}</td>
								<td class="px-5 py-3 font-mono text-base">{FactorLabel(Row)}</td>
								<td class="px-5 py-3 font-mono text-base text-stamped-canary">
									<span
										data-effective
										data-factor={Row.Factor === "code_multiplier" ? 1 : Row.Factor}
										data-knob={Row.Factor === "code_multiplier" ? "code_multiplier" : undefined}
									>
										{Effective(Row)}
									</span>
									B
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="mt-6 max-w-3xl text-base text-zinc-dust">
				<code class="text-bone-newsprint">linter</code>,
				<code class="text-bone-newsprint">build_output</code> and
				<code class="text-bone-newsprint">log</code> return the base before any multiplier, so
				those three never scale.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				Two runtime factors scale the result and neither can be read from the config file:
			</p>
			<ul class="mt-3 max-w-3xl space-y-2 text-base text-zinc-dust">
				<li class="border-l-2 border-oxblood-dark pl-3">
					the compression-ratio auto-tune (×2 above a 20× ratio, ×0.5 below 3×) scales the base
				</li>
				<li class="border-l-2 border-oxblood-dark pl-3">
					and the headroom budget (0.50 to 1.0) scales the result.
				</li>
			</ul>
			<p class="mt-6 font-mono text-base uppercase tracking-widest text-zinc-dust">
				SRC: crates/aphrodite/src/proxy.rs:613-644.
			</p>
		</section>

		<!-- The [[proxies]] pair -->
		<section id="proxies" class="relative w-full" aria-label="The proxies pair" data-reveal>
			<ZineTape Label="the pair" Color="bone" Side="left" />
			<h2 class="font-mono text-2xl font-black uppercase tracking-widest text-bone-white sm:text-3xl">
				[[PROXIES]] - CACHE :9797 + TOKEN :9798
			</h2>
			<div class="mt-8 grid gap-10 md:grid-cols-2">
				<ZineBox Tone="subtle">
					<ZineKicker Tone="newsprint">cache &middot; 127.0.0.1:9797</ZineKicker>
					<p class="mt-2 text-base text-zinc-dust">
						The lane for results that do not need to survive the process.
					</p>
				</ZineBox>
				<ZineBox Tone="subtle">
					<ZineKicker Tone="newsprint">token &middot; 127.0.0.1:9798</ZineKicker>
					<p class="mt-2 text-base text-zinc-dust">
						The lane a retrieval survives a restart from.
					</p>
				</ZineBox>
			</div>
			<div class="mt-10 border-l-4 border-raw-blood bg-soot-black p-6">
				<ZineKicker Tone="dust">WARNING - THE 0.0.0.0 LINES</ZineKicker>
				<p class="mt-2 max-w-3xl text-base text-zinc-dust">
					Listeners bind loopback-only by default, and the router rejects non-loopback peers (and
					non-loopback Host headers) on every route except /health.
				</p>
				<p class="mt-3 max-w-3xl text-base text-zinc-dust">
					Uncommenting <code class="text-bone-newsprint">listen = "0.0.0.0:..."</code> exposes an
					unauthenticated listener to your LAN: /retrieve, /history and /ccr/* have no authentication of
					their own.
				</p>
			</div>
		</section>

		<!-- One file, two parsers -->
		<section id="parsers" class="relative w-full" aria-label="The two parser stacks" data-reveal>
			<ZineTape Label="two stacks" Color="raw" Side="right" />
			<h2 class="font-headline text-2xl font-black tracking-tight text-bone-white sm:text-3xl">
				One file, two parsers
			</h2>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				The READER column is the whole split - these are the two codepaths that own it.
			</p>
			<div class="mt-8 grid gap-10 lg:grid-cols-2">
				<ZineBox Tone="crimson">
					<ZineKicker As="h3" Tone="canary">THE RUST HTTP PROXY</ZineKicker>
					<p class="mt-3 text-base text-zinc-dust">
						<code class="text-bone-newsprint">config/proxy.rs</code>, active whenever an
						aphrodite.toml is found: it reads every row marked PROXY or BOTH, resolving each one as
					</p>
					<ul class="mt-3 space-y-2 text-base text-zinc-dust">
						<li class="border-l-2 border-oxblood-dark pl-3">env var</li>
						<li class="border-l-2 border-oxblood-dark pl-3">then the per-proxy entry</li>
						<li class="border-l-2 border-oxblood-dark pl-3">then <code>[defaults]</code></li>
						<li class="border-l-2 border-oxblood-dark pl-3">then the compiled default.</li>
					</ul>
					<p class="mt-3 text-base text-zinc-dust">
						Three rows are the exceptions, and the ladder marks them: the API key is TOML-first,
						and the bind address and the mode are per-entry by construction.
					</p>
				</ZineBox>
				<ZineBox Tone="teal">
					<ZineKicker As="h3" Tone="teal">THE HERMES DYLIB SESSION</ZineKicker>
					<p class="mt-3 text-base text-zinc-dust">
						<code class="text-bone-newsprint">config_loader.rs</code>, read once at dylib load: it
						reads every row marked DYLIB or BOTH, and the standalone HTTP proxy never reads a
						dylib-only key.
					</p>
					<p class="mt-3 text-base text-zinc-dust">
						The FFI runtime-override variant is the
						<code class="text-bone-newsprint">aphrodite_config_get</code> /
						<code class="text-bone-newsprint">aphrodite_config_set</code> pair on the C-ABI bridge -
						it surfaces values and changes them mid-session.
					</p>
				</ZineBox>
			</div>
		</section>

		<!-- The reload simulation -->
		<section id="reload" class="relative w-full" aria-label="The reload simulation" data-reveal>
			<ZineTape Label="simulation" Color="raw" Side="left" />
