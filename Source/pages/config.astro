---
import Base from "@Layout/Base.astro";
import ConfigResolution from "../Content/Mermaid/config-resolution.svg?raw";
import type { ConfigKeyLadderRecord } from "@Library/Records";
import ZineDiagramNav from "@Component/ZineDiagramNav.astro";
import SectionNav from "@Component/SectionNav.astro";
import CopyButton from "@Component/CopyButton.astro";
import ZineBox from "../Component/ZineBox.astro";
import ZineKicker from "../Component/ZineKicker.astro";
import ZineStamp from "../Component/ZineStamp.astro";
import ZineStream from "../Component/ZineStream.astro";
import ZineTape from "../Component/ZineTape.astro";
import ConfigKeys from "../Component/ConfigKeys.astro";
import PageShell from "@Component/PageShell.astro";
import Related from "@Component/Related.astro";

// The CONFIG PLAYGROUND: the aphrodite.toml surface made explorable, as a
// CLIENT-SIDE SIMULATION (no runtime, no network). Every fact below traces to
// the shipped sources: aphrodite.toml.example (the full annotated file),
// README.md:371-442 (the configuration section), docs/config/aphrodite-toml.md
// (the complete schema) and docs/config/env-vars.md (the overrides). The
// SANITIZATION law: the TOML shown in the editor is the SHIPPED EXAMPLE -
// never a user's real toml, never an api_key value (the key field renders as
// its env-var name).
//
// THE KEYS ARRAY IS THE PAGE'S ONE SOURCE PER KNOB. The table renders it, the
// resolution ladder renders it, the /reload simulation renders it and the
// classify matrix reads its two threshold rows, so a default cannot disagree
// with itself the way the three former copies (a [compression] table, the
// prose enumerating each parser's keys, and the ladder's own chain arrays)
// could. The record shape lives in Source/Library/Records.ts - the page fills
// it, it never declares a second copy of it.

// The editor's default text: the shipped example, byte-faithful except the
// commented api_key sample line, which renders as its env-var name only.
const Example = [
	"# ── Aphrodite Configuration ────────────────────────────────────────────────",
	"# Copy this file to aphrodite.toml and edit to your needs.",
	"# Priority (a subset of fields only - see docs/config/env-vars.md):",
	"# env var > aphrodite.toml > hardcoded default.",
	"#",
	"# Search order: ./aphrodite.toml, then ~/.hermes/aphrodite/aphrodite.toml",
	"# (only when APHRODITE_CONFIG_PATH is NOT set - an explicit override that",
	"# doesn't exist falls through to single-proxy CLI-flag mode instead).",
	"#",
	"# Two independent parsers read this file:",
	"#   - the Rust HTTP proxy (config/proxy.rs, when an aphrodite.toml is found):",
	"#     [[proxies]], [defaults], the four hot-reload thresholds plus",
	"#     auto_expand/auto_expand_limit/max_request_body_size in [compression],",
	"#     and [previews] preview_max_chars (also re-applied by POST /reload and",
	"#     the config-file watcher);",
	"#   - the Hermes dylib session (config_loader.rs): the [compression]",
	"#     engine/chain-split/poll/live_container/recursive_depth keys, [defaults]",
	"#     model/api_url, [flow], [directives], [prompts] session_inject +",
	"#     retrieve_guidance/ccr_marker_hint/catalog_intent_hints, [templates],",
	"#     [previews] preview_max_chars.",
	"#",
	"# ── Proxies ─────────────────────────────────────────────────────────────────",
	"[[proxies]]",
	'name = "cache"',
	'listen = "127.0.0.1:9797"',
	'# listen = "0.0.0.0:9797"  # WARNING: exposes proxy to your network',
	'mode = "cache"',
	"tool_relay = true",
	"timeout = 120",
	"",
	"[[proxies]]",
	'name = "token"',
	'listen = "127.0.0.1:9798"',
	'# listen = "0.0.0.0:9798"  # WARNING: exposes proxy to your network',
	'mode = "token"',
	"tool_relay = true",
	"timeout = 300",
	"",
	"# ── Shared defaults (applied to all proxies unless overridden) ──────────────",
	"[defaults]",
	'api_url = "https://api.openai.com"',
	'model = "default-model"',
	"ccr_ttl_seconds = 3600",
	"# api_key precedence: proxy-level api_key > [defaults] api_key >",
	"# APHRODITE_API_KEY env var. Only uncomment if you cannot use the env var.",
	"",
	"[compression]",
	"engine_threshold_pct = 30   # LOAD-BEARING (dylib): middle-turn archiving + engine_offload prompt; 100+ = off",
	"engine_protect_first = 2    # LOAD-BEARING (dylib): messages kept at the start",
	"engine_protect_last = 5     # LOAD-BEARING (dylib): messages kept at the end",
	"engine_min_msgs = 8         # LOAD-BEARING (dylib): minimum messages before the engine activates",
	"tool_threshold_token = 256  # token proxy threshold (bytes) - hot-reloads",
	"tool_threshold_cache = 2048 # cache proxy threshold (bytes) - hot-reloads",
	"terminal_threshold = 256    # dylib terminal-output threshold (bytes)",
	"inline_threshold = 1024     # inline zlib fallback threshold (bytes) - hot-reloads",
	"auto_expand = true          # WIRED (proxy): resolve just-stored content inline instead of a marker",
	"auto_expand_limit = 102400  # WIRED (proxy): byte cap for auto-expanded content",
	"live_container = false      # WIRED (dylib): instant 'live' CCR markers for large tool results",
	"recursive_depth = 5         # WIRED (dylib): max nested expansion depth",
	"code_multiplier = 1.0       # multiply threshold for code types (hot-reloads)",
	"# ── Store retention (SQLite token proxy) ─────────────────────────────────",
	"# ccr_ttl_seconds bounds the store in TIME; these two bound it in SPACE:",
	"# past either cap the least-recently-accessed rows are evicted, and an",
	"# evicted hash becomes a retrieval miss, exactly like an expired one.",
	"# Read at store open (NOT hot-reloaded); 0 = unlimited.",
	"store_max_entries = 100000  # max live rows (env APHRODITE_STORE_MAX_ENTRIES)",
	"store_max_bytes = 536870912 # max stored payload bytes, SUM(LENGTH(original)) (env APHRODITE_STORE_MAX_BYTES)",
	"context_engine = true       # dylib-path only; the HTTP proxy never reads it",
	"auto_reload = true          # dylib-path: watch aphrodite.toml and re-apply config on change",
	"",
	"[previews]",
	"preview_max_chars = 0       # caps the whole rendered preview string; 0 = unlimited",
	'model_family = "code_first" # selects the [templates.preview.<family>.*] family',
	"",
	"[prompts]",
	'retrieve_guidance = "minimal" # how much the system prompt explains CCR retrieval',
	"ccr_marker_hint = false       # append a retrieval hint after markers",
	"catalog_intent_hints = false  # intent hints in catalog output",
	"",
	"# ── Templates (live config - optional format strings) ───────────────────────",
	'# [templates.preview.<family>.<ctype>] = "format string"  # {type} {ln} {size} {fns} {sigs} ...',
	"# [templates.marker] format/hint · [templates.prompts] session_inject/engine_offload",
	"# [templates.reverse] ctype -> key remap. Absent = hardcoded builders.",
	"",
	"[directives]",
	'active = ["lazy", "lazy-eval", "foresight"]',
	"",
	"[flow]",
	"budget_chars = 2600         # hard cap on per-turn injected context",
].join("\n");

// EVERY KEY, ONCE. Section groups the table; Type/Default/Env are the schema
// doc's own columns (docs/config/aphrodite-toml.md); Reader says which of the
// two parsers reads it; Live says when a change takes effect; Chain and From
// are what the resolution ladder needs to walk the value. The shape itself is
// Records.ts - this array fills it, it does not declare it.
const Keys: ConfigKeyLadderRecord[] = [
	// [[proxies]] - one entry per listener; [defaults] repeats four of these keys.
	{ Key: "name", Section: "[[proxies]]", Type: "string", Default: "the listen address", Reader: "proxy", Live: "startup", Effect: "Proxy label; the port overrides (APHRODITE_CACHE_PORT / APHRODITE_TOKEN_PORT) match on it" },
	{ Key: "listen", Section: "[[proxies]]", Type: '"addr:port"', Default: "127.0.0.1:9797", Env: "port only: APHRODITE_CACHE_PORT / APHRODITE_TOKEN_PORT", Reader: "proxy", Live: "startup", Effect: "Bind address; loopback by default, and non-loopback peers are rejected on every route except /health", Chain: "toml-only", From: "proxy" },
	{ Key: "mode", Section: "[[proxies]]", Type: '"cache" | "token"', Default: '"token"', Reader: "proxy", Live: "startup", Effect: "Backend and compiled threshold: token = SQLite above 1 KB, cache = in-memory above 8 KB", Chain: "toml-only", From: "proxy" },
	{ Key: "api_key", Section: "[[proxies]]", Type: "string", Default: "none - the proxy refuses to start", Env: "APHRODITE_API_KEY (last, not first)", Reader: "proxy", Live: "startup", Effect: "Upstream key; the one chain where TOML outranks the env var", Chain: "toml-first", From: "proxy" },
	{ Key: "api_url", Section: "[[proxies]]", Type: "url", Default: "https://api.openai.com", Env: "APHRODITE_API_URL", Reader: "proxy", Live: "startup", Effect: "Upstream API base URL", From: "proxy" },
	{ Key: "model", Section: "[[proxies]]", Type: "string", Default: '"default-model"', Env: "APHRODITE_MODEL", Reader: "proxy", Live: "startup", Effect: "Model name to forward", From: "proxy" },
	{ Key: "tool_relay", Section: "[[proxies]]", Type: "bool", Default: "false", Reader: "proxy", Live: "startup", Effect: "Enables the /tool/relay endpoint", From: "proxy" },
	{ Key: "dev", Section: "[[proxies]]", Type: "bool", Default: "false", Reader: "proxy", Live: "startup", Effect: "Verbose request and response logging" },
	{ Key: "ccr_ttl_seconds", Section: "[[proxies]]", Type: "int (seconds)", Default: "3600", Env: "APHRODITE_CCR_TTL", Reader: "proxy", Live: "startup", Effect: "CCR entry time-to-live", From: "proxy" },
	{ Key: "ccr_db_path", Section: "[[proxies]]", Type: "path", Default: "~/.hermes/aphrodite/ccr.db", Env: "APHRODITE_DB", Reader: "proxy", Live: "startup", Effect: "SQLite path for the token proxy; a relative path resolves against the binary's directory", From: "proxy" },
	{ Key: "notify_url", Section: "[[proxies]]", Type: "url", Default: "none", Env: "APHRODITE_NOTIFY_URL", Reader: "proxy", Live: "startup", Effect: "Hermes callback URL for CCR-create notifications" },
	{ Key: "notify_key", Section: "[[proxies]]", Type: "string", Default: "none", Env: "APHRODITE_NOTIFY_KEY", Reader: "proxy", Live: "startup", Effect: "Bearer token sent with notify_url" },
	{ Key: "timeout", Section: "[[proxies]]", Type: "int (seconds)", Default: "300", Reader: "proxy", Live: "startup", Effect: "Upstream request timeout, clamped to 600 with a warning" },
	{ Key: "max_context", Section: "[[proxies]]", Type: "int (tokens)", Default: "1,000,000", Reader: "proxy", Live: "startup", Effect: "Max context tokens" },
	{ Key: "max_output", Section: "[[proxies]]", Type: "int (tokens)", Default: "384,000", Reader: "proxy", Live: "startup", Effect: "Max output tokens; the proxy refuses to start when it is at or above max_context" },

	// [compression] - one table, two consumers, which is what the READER column shows.
	{ Key: "tool_threshold_token", Section: "[compression]", Type: "int (bytes)", Default: "1024 (example 256)", Env: "APHRODITE_TOOL_THRESHOLD_TOKEN", Reader: "proxy", Live: "hot", Effect: "Token-proxy compression threshold - the gate every tool result crosses" },
	{ Key: "tool_threshold_cache", Section: "[compression]", Type: "int (bytes)", Default: "8192 (example 2048)", Env: "APHRODITE_TOOL_THRESHOLD_CACHE", Reader: "proxy", Live: "hot", Effect: "Cache-proxy compression threshold" },
	{ Key: "inline_threshold", Section: "[compression]", Type: "int (bytes)", Default: "256 (example 1024)", Env: "APHRODITE_INLINE_THRESHOLD", Reader: "proxy", Live: "hot", Effect: "Inline zlib versus the durable CCR store" },
	{ Key: "code_multiplier", Section: "[compression]", Type: "float", Default: "3.0 (example 1.0)", Env: "APHRODITE_CODE_MULTIPLIER", Reader: "proxy", Live: "hot", Effect: "Multiplies the threshold for code_* content types; 1.0 gives code no extra headroom" },
	{ Key: "auto_expand", Section: "[compression]", Type: "bool", Default: "false (example true)", Env: "APHRODITE_AUTO_EXPAND", Reader: "both", Live: "hot", Effect: "Resolve just-stored content inline instead of emitting a marker, capped by auto_expand_limit" },
	{ Key: "auto_expand_limit", Section: "[compression]", Type: "int (bytes)", Default: "102400", Env: "APHRODITE_AUTO_EXPAND_LIMIT", Reader: "both", Live: "hot", Effect: "Byte cap for auto-expanded content; 0 = unlimited" },
	{ Key: "max_request_body_size", Section: "[compression]", Type: "int (bytes)", Default: "none - no cap", Env: "APHRODITE_MAX_REQUEST_BODY_SIZE", Reader: "proxy", Live: "startup", Effect: "Request-body cap; an over-size body is rejected with 413 while it is read" },
	{ Key: "store_max_entries", Section: "[compression]", Type: "int (rows)", Default: "100000", Env: "APHRODITE_STORE_MAX_ENTRIES", Reader: "proxy", Live: "load", Effect: "Max live rows in the SQLite store; past it the least-recently-accessed rows are evicted; 0 = unlimited" },
	{ Key: "store_max_bytes", Section: "[compression]", Type: "int (bytes)", Default: "536870912", Env: "APHRODITE_STORE_MAX_BYTES", Reader: "proxy", Live: "load", Effect: "Max stored payload bytes, SUM(LENGTH(original)); past it LRU rows are evicted; 0 = unlimited" },
	{ Key: "terminal_threshold", Section: "[compression]", Type: "int (bytes)", Default: "1024 (example 256)", Env: "APHRODITE_TERMINAL_THRESHOLD", Reader: "dylib", Live: "load", Effect: "Terminal-output threshold gating transform_terminal_output" },
	{ Key: "poll_worker", Section: "[compression]", Type: "bool", Default: "true", Env: "APHRODITE_POLL_WORKER", Reader: "dylib", Live: "load", Effect: "Auto-backgrounding of slow terminal and process calls in pre_tool_call" },
	{ Key: "chain_split", Section: "[compression]", Type: "bool", Default: "false", Env: "APHRODITE_CHAIN_SPLIT", Reader: "dylib", Live: "load", Effect: "Opt-in command splitting into per-segment markers" },
	{ Key: "chain_split_min_segments", Section: "[compression]", Type: "int", Default: "2", Env: "APHRODITE_CHAIN_SPLIT_MIN_SEGMENTS", Reader: "dylib", Live: "load", Effect: "Floor for the adaptive split threshold" },
	{ Key: "chain_split_max_segments", Section: "[compression]", Type: "int", Default: "6", Env: "APHRODITE_CHAIN_SPLIT_MAX_SEGMENTS", Reader: "dylib", Live: "load", Effect: "Cap for the adaptive split threshold" },
	{ Key: "context_engine", Section: "[compression]", Type: "bool", Default: "true", Env: "APHRODITE_CONTEXT_ENGINE", Reader: "dylib", Live: "load", Effect: "Enables the context engine; the standalone HTTP proxy never reads it" },
	{ Key: "engine_threshold_pct", Section: "[compression]", Type: "int (%)", Default: "45 (example 30)", Env: "APHRODITE_ENGINE_THRESHOLD_PCT", Reader: "dylib", Live: "load", Effect: "Context-engine fill gate: middle turns are archived at or above this fill; 0 = never, 100+ = off" },
	{ Key: "engine_protect_first", Section: "[compression]", Type: "int (turns)", Default: "2", Env: "APHRODITE_ENGINE_PROTECT_FIRST", Reader: "dylib", Live: "load", Effect: "Turns kept at the start of the index" },
	{ Key: "engine_protect_last", Section: "[compression]", Type: "int (turns)", Default: "5", Env: "APHRODITE_ENGINE_PROTECT_LAST", Reader: "dylib", Live: "load", Effect: "Turns kept at the end of the index" },
	{ Key: "engine_min_msgs", Section: "[compression]", Type: "int (turns)", Default: "8", Env: "APHRODITE_ENGINE_MIN_MSGS", Reader: "dylib", Live: "load", Effect: "Minimum archived turns before the engine may archive" },
	{ Key: "live_container", Section: "[compression]", Type: "bool", Default: "false", Env: "APHRODITE_LIVE_CONTAINER", Reader: "dylib", Live: "load", Effect: "Instant CCR markers with the live type, for progressive retrieval" },
	{ Key: "recursive_depth", Section: "[compression]", Type: "int", Default: "5", Env: "APHRODITE_RECURSIVE_DEPTH", Reader: "dylib", Live: "load", Effect: "Nested marker expansion cap" },
	{ Key: "auto_reload", Section: "[compression]", Type: "bool", Default: "false (example true)", Env: "APHRODITE_AUTO_RELOAD", Reader: "dylib", Live: "load", Effect: "Watch aphrodite.toml and re-apply config fields on change" },
	{ Key: "catalog_mode", Section: "[compression]", Type: "-", Default: "none", Reader: "none", Live: "unwired", Effect: "Parses; the catalog layout is compiled-in, so this is a silent no-op" },
	{ Key: "classifier_poll", Section: "[compression]", Type: "-", Default: "none", Reader: "none", Live: "unwired", Effect: "Parses; nothing reads it back" },
	{ Key: "prefetch", Section: "[compression]", Type: "-", Default: "none", Reader: "none", Live: "unwired", Effect: "Parses; the aphrodite_prefetch tool exists regardless of this key" },

	// [previews] and [prompts] - the render-side knobs.
	{ Key: "preview_max_chars", Section: "[previews]", Type: "int (chars)", Default: "0 (unlimited)", Env: "APHRODITE_PREVIEW_MAX_CHARS", Reader: "both", Live: "hot", Effect: "Caps the whole rendered preview string, not per line; 0 = unlimited" },
	{ Key: "model_family", Section: "[previews]", Type: '"compact" | "code_first" | "balance"', Default: '"code_first"', Reader: "both", Live: "load", Effect: "Selects the [templates.preview.<family>.*] family when templates are configured" },
	{ Key: "code_structure_map", Section: "[previews]", Type: "bool", Default: "none", Reader: "none", Live: "unwired", Effect: "Reserved: include function, struct and class signatures in code previews" },
	{ Key: "rust_preview_lines", Section: "[previews]", Type: "int", Default: "none", Reader: "none", Live: "unwired", Effect: "Reserved: lines of Rust source to include in previews" },
	{ Key: "session_inject", Section: "[prompts]", Type: "string", Default: "the shipped builtin", Env: "APHRODITE_SESSION_INJECT", Reader: "dylib", Live: "load", Effect: 'First-turn orientation text injected on turn 0; "" disables it' },
	{ Key: "retrieve_guidance", Section: "[prompts]", Type: '"minimal" | "standard" | "verbose"', Default: '"minimal"', Env: "APHRODITE_RETRIEVE_GUIDANCE", Reader: "dylib", Live: "load", Effect: "How much retrieval guidance the per-turn assembler renders as the [retrieval: ...] line" },
	{ Key: "ccr_marker_hint", Section: "[prompts]", Type: "bool", Default: "false", Env: "APHRODITE_CCR_MARKER_HINT", Reader: "dylib", Live: "hot", Effect: "Append a retrieval hint after markers - it fills the marker template's {hint}" },
	{ Key: "catalog_intent_hints", Section: "[prompts]", Type: "bool", Default: "false", Env: "APHRODITE_CATALOG_INTENT_HINTS", Reader: "dylib", Live: "load", Effect: "Intent hints alongside the hashes in catalog output" },

	// [directives] and [flow] - the per-turn context knobs.
	{ Key: "active", Section: "[directives]", Type: "array of strings", Default: "an empty list seeds focus, foresight and lazy", Reader: "dylib", Live: "load", Effect: "Which loaded directives start active; unknown names are filtered out, and the set is runtime-mutable through aphrodite_directive" },
	{ Key: "budget_chars", Section: "[flow]", Type: "int (chars)", Default: "4000 (example 2600)", Env: "APHRODITE_FLOW_BUDGET_CHARS", Reader: "dylib", Live: "load", Effect: "Hard cap on ALL per-turn injected context; sections drop bottom-up, and directives and nudges never drop" },

	// [templates] - live format strings, absent means the hardcoded builder.
	{ Key: "preview.<family>.<ctype>", Section: "[templates]", Type: "format string", Default: "the hardcoded builder", Reader: "both", Live: "load", Effect: "Preview format per content type; resolution is family[ctype], then reverse[ctype], then family[_default], then the hardcoded builder" },
	{ Key: "marker.format / marker.hint", Section: "[templates]", Type: "format string", Default: "the shipped default", Reader: "both", Live: "hot", Effect: "Marker block layout, and the retrieval hint appended after markers" },
	{ Key: "prompts.<name>", Section: "[templates]", Type: "format string", Default: "the shipped default", Reader: "dylib", Live: "load", Effect: "Named prompt templates rendered into the per-turn context: session_inject, engine_offload, auto_expand_guidance, catalog_context_warn" },
	{ Key: "reverse.<ctype>", Section: "[templates]", Type: "string", Default: "none", Reader: "both", Live: "load", Effect: "ctype -> key remap: lets a content type borrow another type's format string" },
];

// A sentence under the sections that need one - the table cannot say these.
const SectionNotes: Record<string, string> = {
	"[[proxies]]":
		"One entry per listener; [defaults] repeats api_url, model, ccr_ttl_seconds and api_key one level up, for every proxy that does not set its own.",
	"[compression]":
		"One table, two consumers - the READER column is the split, and it is why the same key can be hot for the proxy and load-once for the dylib.",
	"[templates]":
		"Live configuration: every block is optional, and when a block (or the whole section) is absent the hardcoded builders and shipped defaults apply.",
};

// THE CLASSIFY MATRIX. One row per match arm of `threshold_for`
// (crates/aphrodite/src/proxy.rs:613-644): the base threshold, then one
// multiplier per content type. `code_multiplier` is a knob, so it is named as
// one and resolved from the editor rather than frozen to 3.0 here - the table
// below therefore shows the numbers the running proxy would use, not a
// restatement of the defaults column.
const Types: { Type: string; Factor: number | "code_multiplier" }[] = [
	{ Type: "error", Factor: 8 },
	{ Type: "code_rust", Factor: "code_multiplier" },
	{ Type: "code_python", Factor: "code_multiplier" },
	{ Type: "code_go", Factor: "code_multiplier" },
	{ Type: "code_js", Factor: "code_multiplier" },
	{ Type: "code", Factor: "code_multiplier" },
	{ Type: "diff", Factor: 2 },
	{ Type: "git", Factor: 2 },
	{ Type: "text", Factor: 2 },
	{ Type: "json", Factor: 1 },
	{ Type: "tool_output", Factor: 1 },
	{ Type: "any other type", Factor: 1 },
];

// The compiled defaults, read out of the Keys array rather than repeated: the
// Default cell's leading number is the binary's value ("1024 (example 256)" is
// 1024 with the shipped example beside it).
const CompiledNumber = (Key: string, Fallback: number): number => {
	const Value = Number.parseFloat(Keys.find((Row) => Row.Key === Key)?.Default ?? "");
	return Number.isFinite(Value) ? Value : Fallback;
};

const BaseBytes = CompiledNumber("tool_threshold_token", 1024);
const CodeMultiplier = CompiledNumber("code_multiplier", 3);

const Effective = (Row: { Factor: number | "code_multiplier" }): number =>
	Math.round(BaseBytes * (Row.Factor === "code_multiplier" ? CodeMultiplier : Row.Factor));

const FactorLabel = (Row: { Factor: number | "code_multiplier" }): string =>
	Row.Factor === "code_multiplier" ? "×code_multiplier" : `×${Row.Factor}`;

// What the ladder and the /reload simulation read: the same rows, trimmed to
// the fields the client-side simulation needs. The excluded keys are the ones
// whose value the page must never echo (a key, a callback) or whose absence
// would say nothing about precedence.
const LadderExcluded = new Set(["dev", "notify_url", "notify_key", "max_context", "max_output", "timeout", "name"]);

const Tracked = Keys.filter((Row) => Row.Live !== "unwired" && !LadderExcluded.has(Row.Key)).map(
	({ Key, Section, Env, Default, Reader, Live, Chain, From }) => ({
		Key,
		Section,
		Env,
		Default,
		Reader,
		Live,
		Chain: Chain ?? "env-first",
		From: From ?? "section",
	}),
);

// The page's own sections, in document order - SectionNav renders exactly
// these, so an entry can never name a section the page does not have.
const Sections = [
	{ Id: "pick-chain", Label: "THE FILE" },
	{ Id: "editor", Label: "EDITOR" },
	{ Id: "keys", Label: "EVERY KEY" },
	{ Id: "classify", Label: "CLASSIFY" },
	{ Id: "proxies", Label: "THE PAIR" },
	{ Id: "parsers", Label: "TWO PARSERS" },
	{ Id: "reload", Label: "/RELOAD" },
];
---

<Base
	title="Configuration Playground"
	description="The interactive aphrodite.toml explorer - every key in one table, the pick chain, the two parsers and the compression knobs, simulated client-side."
>
	<PageShell Crumbs>
		<!-- Header -->
		<header class="relative border-l-4 border-blood-crimson bg-carbon-void p-8">
			<ZineTape Label="aphrodite.toml" Color="raw" Side="left" />
			<p class="font-mono text-base font-bold uppercase tracking-widest text-stamped-canary">
				THE FILE THAT TUNES EVERYTHING
			</p>
			<h1 class="mt-3 text-3xl font-bold tracking-tight text-bone-white sm:text-4xl">
				Configuration Playground
			</h1>
			<p class="mt-4 max-w-3xl text-base text-zinc-dust">
				One TOML file, two independent parsers, three places it can live.
			</p>
			<p class="mt-3 max-w-3xl text-base text-zinc-dust">
				Edit the shipped example below and watch the resolution order re-decide what wins - env var,
				per-proxy entry, defaults, or the compiled-in fallback.
			</p>
