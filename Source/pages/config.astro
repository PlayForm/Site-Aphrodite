<style>
	/* The key filter is an enhancement, never a requirement: the head script's
	   html.js is what tells us scripting is alive, so a reader without
	   JavaScript is not shown a control that would do nothing. The table itself
	   is server-rendered and complete in both cases. */
	:global(html:not(.js)) [data-key-filter-wrap] {
		display: none;
	}
</style>

<script>
	// ---- The editor default (captured on first init - the reset restores it
	// verbatim). The element references are re-queried on every init: the
	// view-transitions router swaps the page body, so module-load-time
	// references would point at detached DOM after returning to this page. ----
	let Editor: HTMLTextAreaElement | null = null;
	let Status: Element | null = null;
	let Ladder: Element | null = null;
	let ReloadOut: Element | null = null;

	let InitialValue = "";

	interface TrackedKey {
		Key: string;
		Section: string;
		Env?: string;
		Default: string;
		Reader: string;
		Live: string;
		Chain: "env-first" | "toml-first" | "toml-only";
		From: "section" | "proxy";
	}

	// The shipped example and the tracked keys are serialized into
	// [data-config-*] by the template, PERCENT-ENCODED. Astro does not carry
	// frontmatter variables into a client script, so both travel as attributes
	// - and plain JSON in an attribute does not survive the build: the
	// code-mention pass rewrites every repo-relative path in the finished HTML
	// into an anchor, and an anchor's quotes end the attribute it was written
	// inside. Percent-encoding leaves no quote, no angle bracket and no
	// slash-form path for that pass to match, so the payload arrives whole.
	function Text(Attribute: string): string {
		const Raw = document.querySelector(`[${Attribute}]`)?.getAttribute(Attribute);
		if (!Raw) return "";
		try {
			return decodeURIComponent(Raw);
		} catch {
			return "";
		}
	}

	function TrackedKeys(): TrackedKey[] {
		const Raw = Text("data-config-keys");
		if (!Raw) return [];
		try {
			return JSON.parse(Raw) as TrackedKey[];
		} catch {
			return [];
		}
	}

	interface Parsed {
		Proxies: Record<string, string>[];
		Sections: Record<string, Record<string, string>>;
	}

	// ---- A tolerant browser-side TOML reader: enough for the shipped example's
	// shape (sections, arrays of tables, one triple-quoted string, inline
	// comments). Not the real parser - the simulation boundary says so. ----
	function ParseToml(Text: string): Parsed {
		const Result: Parsed = { Proxies: [], Sections: {} };
		let Section = "";
		let InString = false;

		for (const Raw of Text.split("\n")) {
			if (InString) {
				if (Raw.trim() === '"""') {
					InString = false;
				}
				continue;
			}

			const Line = Raw.trim();
			if (Line === "" || Line.startsWith("#")) continue;

			const Header = /^\[\[(.+)\]\]$/.exec(Line);
			if (Header) {
				if (Header[1] === "proxies") {
					Result.Proxies.push({});
					Section = "proxies";
				} else {
					Section = Header[1];
				}
				continue;
			}

			const Table = /^\[(.+)\]$/.exec(Line);
			if (Table) {
				Section = Table[1];
				if (!Result.Sections[Section]) {
					Result.Sections[Section] = {};
				}
				continue;
			}

			const Pair = /^([A-Za-z0-9_]+)\s*=\s*(.+)$/.exec(Line);
			if (!Pair || Section === "") continue;

			let Value = Pair[2].trim();
			if (Value.startsWith('"""')) {
				if (Value.endsWith('"""') && Value.length > 3) {
					Value = '"""';
				} else {
					InString = true;
				}
			} else {
				// Strip an inline comment, then the quotes.
				const Cut = /(?:^|[^\\])#/.exec(Value);
				if (Cut && Cut.index !== undefined && !Value.startsWith("#")) {
					Value = Value.slice(0, Cut.index).trim();
				}
				Value = Value.replace(/^"(.*)"$/, "$1");
			}

			if (Section === "proxies" && Result.Proxies.length > 0) {
				Result.Proxies[Result.Proxies.length - 1][Pair[1]] = Value;
			} else if (Section !== "proxies") {
				Result.Sections[Section] = { ...Result.Sections[Section], [Pair[1]]: Value };
			}
		}

		return Result;
	}

	// The ladder prints config KEYS and VALUES as text: `preview.<family>.<ctype>`
	// is a key name, not markup. Interpolating it raw let the browser parse
	// <family>/<ctype> as elements, which swallowed the label - the visible
	// line read "preview.." and the page carried three stray elements. Same
	// failure the COPY TOML payload had; the boundary is the escape.
	function Escape(Text: string): string {
		return Text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
	}

	function Chip(Text: string, State: "dim" | "live" | "fallback"): string {
		const Style = {
			dim: "border-oxblood-dark text-zinc-dust opacity-50",
			live: "border-stamped-canary text-stamped-canary",
			fallback: "border-weathered-teal text-weathered-teal",
		}[State];
		return `<span class="inline-block border px-2 py-0.5 font-mono text-base uppercase tracking-widest ${Style}">${Escape(Text)}</span>`;
	}

	function Row(Label: string, Chips: string[], Note: string): string {
		return `<div class="border-l-2 border-oxblood-dark pl-3">
			<p class="font-mono text-base uppercase tracking-widest text-zinc-dust">${Escape(Label)}</p>
			<div class="mt-1 flex flex-wrap items-center gap-2">${Chips.join('<span class="text-zinc-dust">&rarr;</span>')}</div>
			<p class="mt-1 font-mono text-base text-zinc-dust">${Escape(Note)}</p>
		</div>`;
	}

	// The chain notes are constants, not templates, because each one is a claim
	// about a specific chain rather than a phrase stitched from a key name: the
	// ladder prints the claim.
	const DefaultsChainNote = "env > per-proxy > defaults > compiled";
	const TomlWinsHotNote = "TOML wins - one of the four hot-reload thresholds";
	const TomlOnlyNote = "listen / mode (TOML-ONLY)";
	const ApiKeyLabel = "api_key (TOML-FIRST EXCEPTION)";
	const ApiKeyEnvChip = "env: APHRODITE_API_KEY (last, not first)";
	const CacheAbsentChip = "cache proxy: absent";
	const TokenAbsentChip = "token proxy: absent";
	const DylibNote = "read once at dylib load; runtime changes ride aphrodite_config_set";

	const ReaderNote = {
		proxy: "read by the Rust HTTP proxy",
		dylib: DylibNote,
		both: "read by both stacks",
	} as Record<string, string>;

	function RenderLadder(Parsed: Parsed): void {
		if (!Ladder) return;

		const Parts: string[] = [];

		for (const Entry of TrackedKeys()) {
			const SectionValue = Parsed.Sections[Entry.Section]?.[Entry.Key];
			const EnvChip = Entry.Env
				? Chip(`env: ${Entry.Env} (unset here)`, "dim")
				: Chip("env: none documented", "dim");

			// TOML-only: the per-proxy entries own it; a process-wide env var
			// would hit every proxy at once.
			if (Entry.Chain === "toml-only") {
				const Holders = Parsed.Proxies.filter((Proxy) => Proxy[Entry.Key] !== undefined);
				const Chips = Holders.length
					? Holders.map((Proxy) => Chip(`proxy "${Proxy.name ?? "?"}": ${Proxy[Entry.Key]}`, "live"))
					: [Chip("proxy: absent", "dim")];
				// The pair is the point of this key, so name which listener is
				// missing instead of saying that some proxy is.
				if (Entry.Key === "listen" && !Holders.length) {
					if (!Parsed.Proxies.some((Proxy) => Proxy.mode === "cache")) {
						Chips.push(Chip(CacheAbsentChip, "dim"));
					}
					if (!Parsed.Proxies.some((Proxy) => Proxy.mode === "token")) {
						Chips.push(Chip(TokenAbsentChip, "dim"));
					}
				}
				Chips.push(Chip("no env override in multi-proxy mode", "dim"));
				Parts.push(
					Row(
						`${Entry.Key} (TOML-ONLY)`,
						Chips,
						`${TomlOnlyNote} - a process-wide APHRODITE_MODE / APHRODITE_LISTEN would hit every proxy at once`,
					),
				);
				continue;
			}

			// TOML-first: the one chain where the file outranks the env var.
			if (Entry.Chain === "toml-first") {
				const Proxy = Parsed.Proxies.find((Item) => Item[Entry.Key] !== undefined);
				const Default = Parsed.Sections.defaults?.[Entry.Key];
				const Chips = [
					Proxy ? Chip(`proxy "${Proxy.name ?? "?"}": set`, "live") : Chip("proxy: absent", "dim"),
					Default !== undefined ? Chip("defaults: set", "live") : Chip("defaults: absent", "dim"),
					Chip(ApiKeyEnvChip, "dim"),
				];
				Parts.push(
					Row(
						ApiKeyLabel,
						Chips,
						"the only chain where TOML outranks the env var; value never shown - env-var names only",
					),
				);
				continue;
			}

			// env > TOML > compiled. A per-proxy key also walks [defaults].
			const Chips = [EnvChip];
			let Winner = false;
			if (Entry.From === "proxy") {
				const Proxy = Parsed.Proxies.find((Item) => Item[Entry.Key] !== undefined);
				const Default = Parsed.Sections.defaults?.[Entry.Key];
				Proxy
					? Chips.push(Chip(`proxy "${Proxy.name ?? "?"}": ${Proxy[Entry.Key]}`, "live"))
					: Chips.push(Chip("per-proxy: absent", "dim"));
				Default !== undefined
					? Chips.push(Chip(`defaults: ${Default}`, Proxy ? "dim" : "live"))
					: Chips.push(Chip("defaults: absent", "dim"));
				Winner = Boolean(Proxy) || Default !== undefined;
			} else {
				SectionValue !== undefined
					? Chips.push(Chip(`toml: ${SectionValue}`, "live"))
					: Chips.push(Chip("toml: absent", "dim"));
				Winner = SectionValue !== undefined;
			}
			Chips.push(Chip(`compiled: ${Entry.Default}`, Winner ? "dim" : "fallback"));

			// The note names the ladder that decided, not just who won: a hot
			// threshold, a per-proxy key and a dylib key are decided by three
			// different chains.
			const Note = !Winner
				? `${ReaderNote[Entry.Reader] ?? Entry.Reader} - the compiled default wins`
				: Entry.Live === "hot"
					? TomlWinsHotNote
					: Entry.From === "proxy"
						? DefaultsChainNote
						: `${ReaderNote[Entry.Reader] ?? Entry.Reader} - TOML wins`;

			Parts.push(Row(Entry.Key, Chips, Note));
		}

		Ladder.innerHTML = Parts.join("");
	}

	// The compiled default is the leading number of a Default cell ("1024
	// (example 256)" is 1024); an unparsable or absent value falls back to the
	// compiled value the template rendered.
	function Number_(Value: string | undefined, Fallback: number): number {
		const Parsed = Number.parseFloat((Value ?? "").trim());
		return Number.isFinite(Parsed) && Parsed > 0 ? Parsed : Fallback;
	}

	// The classify matrix: the same two rows the keys table carries, read from
	// the editor so the bytes column follows the reader's values. Every cell
	// declares its own factor, so the page renders the table once (server-side,
	// at the compiled defaults) and this only re-solves the arithmetic.
	function RenderClassify(Parsed: Parsed): void {
		const Token = TrackedKeys().find((Entry) => Entry.Key === "tool_threshold_token");
		const Multiplier = TrackedKeys().find((Entry) => Entry.Key === "code_multiplier");

		const Base = Number_(Parsed.Sections.compression?.tool_threshold_token, Number_(Token?.Default, 1024));
		const CodeMultiplier = Number_(
			Parsed.Sections.compression?.code_multiplier,
			Number_(Multiplier?.Default, 3),
		);

		for (const Cell of document.querySelectorAll<HTMLElement>("[data-effective]")) {
			const Factor = Number_(Cell.getAttribute("data-factor") ?? "1", 1);
			const Knob = Cell.getAttribute("data-knob") === "code_multiplier";
			Cell.textContent = String(Math.round(Base * (Knob ? CodeMultiplier : Factor)));
		}

		const BaseOut = document.querySelector("[data-classify-base]");
		const MultOut = document.querySelector("[data-classify-mult]");
		if (BaseOut) BaseOut.textContent = String(Base);
		if (MultOut) MultOut.textContent = String(CodeMultiplier);
	}

	function RenderReload(Parsed: Parsed): void {
		if (!ReloadOut) return;

		const Value = (Entry: TrackedKey): string | undefined =>
			Entry.From === "proxy"
				? (Parsed.Proxies.find((Item) => Item[Entry.Key] !== undefined)?.[Entry.Key] ??
					Parsed.Sections.defaults?.[Entry.Key])
				: Parsed.Sections[Entry.Section]?.[Entry.Key];

		const Rows = TrackedKeys().filter((Entry) => Value(Entry) !== undefined);
		const Quote = (Entry: TrackedKey): string => `"${Entry.Key}": ${Value(Entry)}`;
		const Applied = Rows.filter((Entry) => Entry.Live === "hot").map(Quote);
		const ParsedOnly = Rows.filter((Entry) => Entry.Live !== "hot").map((Entry) => `"${Entry.Key}"`);

		const Lines = [
			'<span class="text-weathered-teal">{</span>',
			'&nbsp;&nbsp;<span class="text-stamped-canary">"applied"</span>: true,',
			`&nbsp;&nbsp;<span class="text-stamped-canary">"applied_values"</span>: { ${Applied.join(", ") || "// none present"} },`,
			`&nbsp;&nbsp;<span class="text-stamped-canary">"parsed_only"</span>: { "startup_or_load": [${ParsedOnly.join(", ")}] },`,
			'&nbsp;&nbsp;<span class="text-stamped-canary">"note"</span>: "simulated - the real response comes from the running proxy"',
			'<span class="text-weathered-teal">}</span>',
		];

		ReloadOut.innerHTML = Lines.map((Line) => `<div>${Line}</div>`).join("");
	}

	function Recompute(): void {
		if (!Editor || !Status) return;
		const Parsed = ParseToml(Editor.value);
		// The copy CTA rides Base.astro's one [data-copy] runtime, which reads
		// the attribute at click time - so the payload tracks the buffer the
		// reader is looking at, never the pristine example they edited away.
		document.querySelector("#editor [data-copy]")?.setAttribute("data-copy", Editor.value);
		RenderLadder(Parsed);
		RenderClassify(Parsed);
		RenderReload(Parsed);
		Status.textContent = `parsed - ${Parsed.Proxies.length} proxies`;
	}

	function Init(): void {
		Editor = document.querySelector<HTMLTextAreaElement>("[data-editor]");
		Status = document.querySelector("[data-editor-status]");
		Ladder = document.querySelector("[data-ladder]");
		ReloadOut = document.querySelector("[data-reload-out]");

		if (!Editor || Editor.dataset.editorBound) {
			return;
		}

		// The bound guard keeps the listeners single under the astro:page-load
		// rebinding (the view-transitions router swaps the page body).
		Editor.dataset.editorBound = "1";

		if (!InitialValue) {
			InitialValue = Text("data-config-example");
			Editor.value = InitialValue;
		}

		Editor.addEventListener("input", Recompute);

		document.querySelector('[data-action="reset"]')?.addEventListener("click", () => {
			Editor.value = InitialValue;
			Recompute();
		});

		document.querySelector('[data-action="reload"]')?.addEventListener("click", Recompute);

		Recompute();
	}

	Init();
	document.addEventListener("astro:page-load", Init);

	// ---- THE KEY FILTER: a plain input over the rows already rendered. No
	// framework, no fetch, no re-render - it toggles `hidden` on rows the table
	// already shipped, which is why it also works with the editor above it
	// untouched. A section whose every row is filtered out is hidden whole, so
	// the reader never sees a heading with nothing under it. ----
	function BindKeyFilter(): void {
		const Input = document.querySelector<HTMLInputElement>("[data-key-filter]");
		const Root = document.querySelector<HTMLElement>("#keys");

		if (!Input || !Root || Input.dataset.filterBound) {
			return;
		}

		Input.dataset.filterBound = "1";

		const Count = Root.querySelector<HTMLElement>("[data-key-filter-count]");
		const Empty = Root.querySelector<HTMLElement>("[data-key-filter-empty]");
		const Groups = Array.from(Root.querySelectorAll<HTMLElement>("[data-key-group]"));
		const Rows = Groups.flatMap((Group) =>
			Array.from(Group.querySelectorAll<HTMLTableRowElement>("[data-key-row]")).map((Row) => ({
				Group,
				Row,
				// The whole row, not one column: a reader searching "hot" wants the
				// live column, searching "APHRODITE_" wants the env column, and both
				// are the same gesture.
				Text: (Row.textContent ?? "").toLowerCase(),
			})),
		);

		if (Rows.length === 0) {
			return;
		}

		const Apply = (): void => {
			const Query = Input.value.trim().toLowerCase();
			let Shown = 0;
			const Live = new Set<HTMLElement>();

			for (const { Group, Row, Text } of Rows) {
				const Match = Query === "" || Text.includes(Query);

				Row.hidden = !Match;

				if (Match) {
					Shown += 1;
					Live.add(Group);
				}
			}

			for (const Group of Groups) {
				Group.hidden = !Live.has(Group);
			}

			if (Count) {
				Count.textContent =
					Query === "" ? `${Shown} KEYS` : `${Shown} OF ${Rows.length} KEYS`;
			}

			// A query that matches nothing must say so: an empty table with no
			// line explaining it reads as a broken page, not as an answer.
			if (Empty) {
				Empty.classList.toggle("hidden", Shown > 0);
			}
		};

		Input.addEventListener("input", Apply);

		// The table ships complete, so the first paint is already the "no query"
		// state; Apply() only normalises the count for a re-entered page.
		Apply();
	}

	BindKeyFilter();
	document.addEventListener("astro:page-load", BindKeyFilter);
</script>
