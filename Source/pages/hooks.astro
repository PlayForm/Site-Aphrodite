---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import HookChain from "../Content/Mermaid/hook-chain.svg?raw";
---

<Base
	Title="HOOKS // APHRODITE"
	Description="The six Aphrodite hooks as a chain: session reset, tool-call pre-flight, dual compression transforms, the pre-LLM context assembler, and post-turn archival - with thresholds, bypass gates, and env-over-TOML precedence."
>
	<main
		class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-40 px-5 py-24 sm:px-8 lg:gap-64 lg:px-14 lg:py-40"
	>
		<!-- HERO -->
		<header class="relative flex w-full flex-col items-start">
			<div
				class="mb-12 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				HOOKS // THE CHAIN
			</div>
			<h1
				class="font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-5xl"
			>
				Six hooks, one turn
			</h1>
			<p class="mt-12 max-w-3xl font-body text-sm leading-relaxed text-bone-newsprint">
				Every hook is a thin dispatch that forwards its arguments to the Rust dylib and
				hands the JSON reply back to Hermes. On plugin load the shim asks the dylib for
				its hook names and registers one callback per name - the six below are always
				registered together.
			</p>
		</header>

		<!-- CHAIN SEQUENCE -->
		<section class="relative w-full">
			<div
				class="mb-12 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				SEQUENCE // PER TURN
			</div>
			<div
				class="zine-box-crimson w-full -rotate-[1.2deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<div class="space-y-0 border border-oxblood-dark bg-soot-black p-4 font-mono text-[12px] leading-relaxed">
					<div class="text-bone-white">session starts</div>
					<div class="pl-4 text-stamped-canary">→ on_session_start · reset per-session state</div>
					<div class="pl-4 text-zinc-dust">↓</div>
					<div class="pl-4 text-bone-white">user turn</div>
					<div class="pl-4 text-stamped-canary">→ pre_tool_call · auto-background, chain split</div>
					<div class="pl-4 text-zinc-dust">↓</div>
					<div class="pl-4 text-bone-white">tool or terminal runs</div>
					<div class="pl-4 text-stamped-canary">→ transform_tool_result / transform_terminal_output · compress to marker</div>
					<div class="pl-4 text-zinc-dust">↓</div>
					<div class="pl-4 text-stamped-canary">→ pre_llm_call · inject directives, nudges, recall catalog</div>
					<div class="pl-4 text-zinc-dust">↓</div>
					<div class="pl-4 text-bone-white">LLM responds</div>
					<div class="pl-4 text-stamped-canary">→ post_llm_call · archive turn, advance counter, expire</div>
					<div class="pl-4 text-zinc-dust">↓</div>
					<div class="pl-4 text-bone-newsprint">⟲ next turn</div>
				</div>
			</div>
		</section>

		<figure
			class="relative w-full border-4 border-blood-crimson bg-carbon-void p-4 shadow-[6px_6px_0px_#7a0a1e]"
			data-diagram="hook-chain"
		>
			<div class="overflow-x-auto" set:html={HookChain} />
			<figcaption class="mt-6 font-mono text-[10px] font-black uppercase tracking-widest text-zinc-dust">
				M3 // HOOK CHAIN
			</figcaption>
		</figure>

		<!-- ONE SECTION PER HOOK -->
		<section class="relative w-full">
			<div
				class="mb-12 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				THE SIX // ONE SECTION EACH
			</div>
			<div class="isolate grid grid-cols-1 items-start gap-16 lg:grid-cols-2 lg:gap-24">
				<!-- 1 on_session_start -->
				<div
					class="zine-box-subtle relative border-[3px] border-oxblood-dark bg-carbon-void p-6 transition-transform duration-200 hover:rotate-0 sm:-rotate-[1.4deg]"
				>
					<div
						class="absolute -top-5 left-4 z-10 border border-black bg-raw-blood px-2 py-0.5 text-[9px] font-black uppercase text-bone-white"
					>
						01 // on_session_start
					</div>
					<p class="mt-4 font-body text-sm leading-relaxed text-bone-newsprint">
						Resets every piece of per-session state to a clean baseline: turn counter,
						conversation index, recent markers, referenced files, tool-event telemetry,
						ephemeral directives. Injects nothing - the one-shot first-turn orientation
						renders later, on the first <span class="font-mono text-xs text-weathered-teal">pre_llm_call</span>.
					</p>
				</div>
				<!-- 2 pre_tool_call -->
				<div
					class="zine-box-canary relative border-[3px] border-stamped-canary/40 bg-carbon-void p-6 transition-transform duration-200 hover:rotate-0 sm:rotate-[1.4deg]"
				>
					<div
						class="absolute -top-5 left-4 z-10 border border-black bg-stamped-canary px-2 py-0.5 text-[9px] font-black uppercase text-soot-black"
					>
						02 // pre_tool_call
					</div>
					<p class="mt-4 font-body text-sm leading-relaxed text-bone-newsprint">
						Two interventions before a tool executes. <span class="font-bold text-bone-white">Auto-backgrounding</span>:
						long-running terminal/process calls are rewritten to run in the background
						(poll worker, default on). <span class="font-bold text-bone-white">Chain splitting</span>
						(opt-in): chained commands get invisible segment markers so each segment
						compresses into its own CCR marker. Otherwise the call passes through
						unchanged.
					</p>
				</div>
				<!-- 3 transform_tool_result -->
				<div
					class="zine-box-crimson relative border-[3px] border-raw-blood bg-carbon-void p-6 transition-transform duration-200 hover:rotate-0 sm:-rotate-[1deg]"
				>
					<div
						class="absolute -top-5 left-4 z-10 border border-black bg-raw-blood px-2 py-0.5 text-[9px] font-black uppercase text-bone-white"
					>
						03 // transform_tool_result
					</div>
					<p class="mt-4 font-body text-sm leading-relaxed text-bone-newsprint">
						After every tool call: record telemetry, run the skip gates, classify the
						content type, hash (BLAKE3), store, and replace the output with
						<span class="font-mono text-xs text-weathered-teal">&lt;&lt;&lt;CCR:hash|type|size&gt;&gt;&gt;</span>
						plus a compact preview. File references are tracked before the gates, so
						<span class="font-mono text-xs text-weathered-teal">aphrodite_files</span> sees
						every read even when nothing was compressed.
					</p>
				</div>
				<!-- 4 transform_terminal_output -->
				<div
					class="zine-box-subtle relative border-[3px] border-zinc-dust/40 bg-carbon-void p-6 transition-transform duration-200 hover:rotate-0 sm:rotate-[2deg]"
				>
					<div
						class="absolute -top-5 left-4 z-10 border border-black bg-bone-newsprint px-2 py-0.5 text-[9px] font-black uppercase text-soot-black"
					>
						04 // transform_terminal_output
					</div>
					<p class="mt-4 font-body text-sm leading-relaxed text-bone-newsprint">
						Same pipeline for shell stdout/stderr. Non-zero exit codes are recorded as
						failures for the error-loop detector; chain-split segments compress
						unconditionally, before the threshold gate, so marked output never leaks raw;
						everything else passes the 1,024-char gate first.
					</p>
				</div>
				<!-- 5 pre_llm_call -->
				<div
					class="zine-box-canary relative border-[3px] border-stamped-canary/40 bg-carbon-void p-6 transition-transform duration-200 hover:rotate-0 sm:-rotate-[1.6deg] lg:-translate-y-1"
				>
					<div
						class="absolute -top-5 left-4 z-10 border border-black bg-stamped-canary px-2 py-0.5 text-[9px] font-black uppercase text-soot-black"
					>
						05 // pre_llm_call
					</div>
					<p class="mt-4 font-body text-sm leading-relaxed text-bone-newsprint">
						Runs the poll-worker checkpoint, then the context assembler: first-turn
						orientation (turn 0 only), <span class="font-mono text-xs text-weathered-teal">[directives:]</span>
						(never dropped), <span class="font-mono text-xs text-weathered-teal">[nudge:]</span>
						one-shots at most two (never dropped), background-task status, and the
						<span class="font-mono text-xs text-weathered-teal">[recall]</span> catalog -
						the first section dropped under pressure. One hard budget: 4,000 chars.
					</p>
				</div>
				<!-- 6 post_llm_call -->
				<div
					class="zine-box-crimson relative border-[3px] border-raw-blood bg-carbon-void p-6 transition-transform duration-200 hover:rotate-0 sm:rotate-[1.2deg] lg:translate-y-2"
				>
					<div
						class="absolute -top-5 left-4 z-10 border border-black bg-raw-blood px-2 py-0.5 text-[9px] font-black uppercase text-bone-white"
					>
						06 // post_llm_call
					</div>
					<p class="mt-4 font-body text-sm leading-relaxed text-bone-newsprint">
						Archives the last marker of the turn into the conversation index (so
						<span class="font-mono text-xs text-weathered-teal">aphrodite_diff</span> can
						report per-turn compressions), advances the turn counter, purges expired
						nudges after the counter advances - a one-shot nudge renders exactly once -
						and expires stale poll-worker tasks.
					</p>
				</div>
			</div>
		</section>

		<!-- ESSENTIAL TOOLS / SKIP GATES -->
		<section class="relative w-full lg:w-10/12 lg:self-end">
			<div
				class="zine-box-crimson relative rotate-[1.2deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<div
					class="absolute -top-5 left-6 z-10 border border-black bg-stamped-canary px-3 py-0.5 text-[10px] font-black uppercase tracking-widest text-soot-black shadow-[2px_2px_0px_#000]"
				>
					BYPASS // THE ESSENTIAL-TOOL GATE
				</div>
				<h2 class="mb-8 mt-6 font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
					What never gets compressed
				</h2>
				<p class="mb-8 font-body text-sm leading-relaxed text-bone-newsprint">
					A result is left untouched when it is empty, below threshold, or from the
					essential set - tools the agent needs raw:
				</p>
				<div class="border border-oxblood-dark bg-soot-black p-4 font-mono text-[12px] text-bone-newsprint">
					skill_view · skills_list · skill_manage · memory · session_search · read_file ·
					read_terminal
				</div>
				<p class="mt-8 font-body text-xs leading-relaxed text-zinc-dust">
					Aphrodite's own tools and headroom helpers are also skipped - compressing
					<span class="font-mono text-xs text-weathered-teal">aphrodite_retrieve</span>
					would just replace resolved content with another marker.
				</p>
			</div>
		</section>

		<!-- THRESHOLDS TABLE -->
		<section class="relative w-full">
			<div
				class="mb-12 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				THRESHOLDS // GATES AND BYPASSES
			</div>
			<div
				class="zine-box-crimson w-full -rotate-[1deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<div class="overflow-x-auto">
					<table class="w-full border-collapse font-mono text-[12px]">
						<thead>
							<tr class="border-b-2 border-oxblood-dark text-left">
								<th class="py-3 pr-4 text-[10px] font-black uppercase tracking-widest text-stamped-canary">HOOK</th>
								<th class="py-3 pr-4 text-[10px] font-black uppercase tracking-widest text-stamped-canary">SETTING</th>
								<th class="py-3 pr-4 text-[10px] font-black uppercase tracking-widest text-stamped-canary">DEFAULT</th>
								<th class="py-3 text-[10px] font-black uppercase tracking-widest text-stamped-canary">BYPASS</th>
							</tr>
						</thead>
						<tbody class="text-bone-newsprint">
							<tr class="border-b border-oxblood-dark">
								<td class="py-3 pr-4">transform_tool_result</td>
								<td class="py-3 pr-4 text-weathered-teal">tool_threshold_token</td>
								<td class="py-3 pr-4 text-bone-white">4,096</td>
								<td class="py-3">empty · essential tools · self tools · <span class="text-stamped-canary">0 = always compress</span></td>
							</tr>
							<tr class="border-b border-oxblood-dark">
								<td class="py-3 pr-4">transform_terminal_output</td>
								<td class="py-3 pr-4 text-weathered-teal">terminal_threshold</td>
								<td class="py-3 pr-4 text-bone-white">1,024</td>
								<td class="py-3">empty · below threshold · <span class="text-stamped-canary">0 = always compress</span></td>
							</tr>
							<tr class="border-b border-oxblood-dark">
								<td class="py-3 pr-4">pre_llm_call</td>
								<td class="py-3 pr-4 text-weathered-teal">flow budget_chars</td>
								<td class="py-3 pr-4 text-bone-white">4,000</td>
								<td class="py-3">recall catalog drops first; directives and nudges never drop</td>
							</tr>
							<tr>
								<td class="py-3 pr-4">pre_tool_call (chain split)</td>
								<td class="py-3 pr-4 text-weathered-teal">chain_split_min_segments</td>
								<td class="py-3 pr-4 text-bone-white">-</td>
								<td class="py-3">feature off by default (chain_split = false)</td>
							</tr>
						</tbody>
					</table>
				</div>
				<p class="mt-12 border-t border-oxblood-dark pt-8 text-[11px] leading-relaxed text-zinc-dust">
					PRECEDENCE: ENVIRONMENT &gt; TOML &gt; DEFAULT
					(APHRODITE_TOOL_THRESHOLD_TOKEN · APHRODITE_TERMINAL_THRESHOLD ·
					APHRODITE_FLOW_BUDGET_CHARS · APHRODITE_CHAIN_SPLIT).
				</p>
			</div>
		</section>

		<!-- RELATED: the natural neighbors -->
		<Related
			Links={[
				{ Href: "/plugin/", Label: "PLUGIN" },
				{ Href: "/tools/", Label: "TOOLS" },
				{ Href: "/setup/", Label: "SETUP" },
			]}
		/>
	</main>
</Base>
