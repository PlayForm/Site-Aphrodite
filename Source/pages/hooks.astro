---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import ZineTape from "@Component/ZineTape.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineSource from "@Component/ZineSource.astro";
import ZineDiagramNav from "@Component/ZineDiagramNav.astro";
import HookChain from "../Content/Mermaid/hook-chain.svg?raw";

// THE SIX HOOKS - one turn, in order. Every line is a seam the dylib exposes
// to the Hermes turn loop; the sequence below is the loop itself, and the six
// cards are what each seam does when its turn arrives.
const Sequence = [
	{ Text: "session starts", Tone: "result" },
	{ Text: "→ on_session_start · reset per-session state", Tone: "canary" },
	{ Text: "↓", Tone: "mute" },
	{ Text: "user turn", Tone: "result" },
	{ Text: "→ pre_tool_call · auto-background, chain split", Tone: "canary" },
	{ Text: "↓", Tone: "mute" },
	{ Text: "tool or terminal runs", Tone: "result" },
	{ Text: "→ transform_tool_result / transform_terminal_output · compress to marker", Tone: "canary" },
	{ Text: "↓", Tone: "mute" },
	{ Text: "→ pre_llm_call · inject directives, nudges, recall catalog", Tone: "canary" },
	{ Text: "↓", Tone: "mute" },
	{ Text: "LLM responds", Tone: "result" },
	{ Text: "→ post_llm_call · archive turn, advance counter, expire", Tone: "canary" },
	{ Text: "↓", Tone: "mute" },
	{ Text: "⟲ next turn", Tone: "plain" },
];

// One card per seam. `Body` is one sentence per entry - the prose breakdown
// is structural here, so a card never ships a paragraph wall.
const Hooks = [
	{
		N: "01",
		Name: "on_session_start",
		Tape: "raw",
		Tone: "subtle",
		Rotate: "sm:-rotate-[1.4deg]",
		Body: [
			"Resets every piece of per-session state to a clean baseline: turn counter, conversation index, recent markers, referenced files, tool-event telemetry, ephemeral directives.",
			"Injects nothing - the one-shot first-turn orientation renders later, on the first <span class=\"font-mono text-base text-weathered-teal\">pre_llm_call</span>.",
		],
	},
	{
		N: "02",
		Name: "pre_tool_call",
		Tape: "canary",
		Tone: "canary",
		Rotate: "sm:rotate-[1.4deg]",
		Body: [
			"Two interventions before a tool executes.",
			"<span class=\"font-bold text-bone-white\">Auto-backgrounding</span>: the hook rewrites long-running terminal/process calls to run in the background (poll worker, default on).",
			"<span class=\"font-bold text-bone-white\">Chain splitting</span> (opt-in): the hook splits chained commands with invisible segment markers so each segment compresses into its own CCR marker.",
			"Otherwise the call passes through unchanged.",
		],
	},
	{
		N: "03",
		Name: "transform_tool_result",
		Tape: "raw",
		Tone: "crimson",
		Rotate: "sm:-rotate-[1deg]",
		Body: [
			"After every tool call: record telemetry, run the skip gates, classify the content type, hash (BLAKE3), store, and replace the output with <span class=\"ccr-marker font-mono text-base text-weathered-teal\">&lt;&lt;&lt;CCR:hash|type|size&gt;&gt;&gt;</span> plus a compact preview.",
			"The hook tracks file references before the gates, so <span class=\"font-mono text-base text-weathered-teal\">aphrodite_files</span> sees every read even when nothing was compressed.",
		],
	},
	{
		N: "04",
		Name: "transform_terminal_output",
		Tape: "bone",
		Tone: "subtle",
		Rotate: "sm:rotate-[2deg]",
		Body: [
			"Same pipeline for shell stdout/stderr.",
			"The hook records non-zero exit codes as failures for the error-loop detector; chain-split segments compress unconditionally, before the threshold gate, so marked output never leaks raw; everything else passes the 1,024-char gate first.",
		],
	},
	{
		N: "05",
		Name: "pre_llm_call",
		Tape: "canary",
		Tone: "canary",
		Rotate: "sm:-rotate-[1.6deg] lg:-translate-y-1",
		Body: [
			"Runs the poll-worker checkpoint, then the context assembler: first-turn orientation (turn 0 only), <span class=\"font-mono text-base text-weathered-teal\">[directives:]</span> (never dropped), <span class=\"font-mono text-base text-weathered-teal\">[nudge:]</span> one-shots at most two (never dropped), background-task status, and the <span class=\"font-mono text-base text-weathered-teal\">[recall]</span> catalog - the first section dropped under pressure.",
			"One hard budget: 4,000 chars.",
		],
	},
	{
		N: "06",
		Name: "post_llm_call",
		Tape: "raw",
		Tone: "crimson",
		Rotate: "sm:rotate-[1.2deg] lg:translate-y-2",
		Body: [
			"Archives the last marker of the turn into the conversation index (so <span class=\"font-mono text-base text-weathered-teal\">aphrodite_diff</span> can report per-turn compressions), advances the turn counter, purges expired nudges after the counter advances - a one-shot nudge renders exactly once - and expires stale poll-worker tasks.",
		],
	},
];
---

<Base
	Title="HOOKS // APHRODITE"
	Description="The six Aphrodite hooks as a chain: session reset, tool-call pre-flight, dual compression transforms, the pre-LLM context assembler, and post-turn archival - with thresholds, bypass gates, and env-over-TOML precedence."
>
	<PageShell Rhythm="wide">
		<PageHeader
			Tape="HOOKS // THE CHAIN"
			Title="Six hooks, one turn"
			Lead={[
				"Every hook is a thin dispatch that forwards its arguments to the Rust dylib and hands the JSON reply back to Hermes.",
				"It is the reason the shim registers one callback per name: on plugin load it asks the dylib for its hook names, and the six below are always registered together.",
				`The chain is the whole integration: each seam below fires in turn order, and nothing reaches the model that a seam did not first see.`,
			]}
		/>

		<!-- SLOT 3: one claim's evidence - the loop, the six seams, the gates -->
		<section class="relative w-full" data-reveal>
			<ZineTape Variant="section" Label="SEQUENCE // PER TURN" />
			<ZineBox Size="lg" Rotate="-rotate-[1deg]">
				<h3
					id="sequence"
					class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl"
				>
					The loop a turn walks
				</h3>
				<div class="space-y-0 border border-oxblood-dark bg-soot-black p-4 font-mono text-base leading-relaxed">
					{
						Sequence.map(({ Text: Line, Tone }) => (
							<div class={Tone === "canary" ? "pl-4 text-stamped-canary" : Tone === "mute" ? "pl-4 text-zinc-dust" : Tone === "result" ? "text-bone-white" : "pl-4 text-bone-newsprint"}>
								{Line}
							</div>
						))
					}
				</div>
				<p class="mt-8 font-body text-base leading-relaxed text-bone-newsprint">
					The loop closes on itself, so the state a turn leaves behind is the state the next
					turn reads.
				</p>
				<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
					That is why the reset seam exists: a new session starts from a clean baseline instead
					of inheriting the previous session's counters and markers.
				</p>
				<figure
					class="mt-16 border border-oxblood-dark bg-soot-black p-4"
					data-diagram="hook-chain"
				>
					<div class="overflow-x-auto" set:html={HookChain} />
					<figcaption class="mt-6 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
						M3 // HOOK CHAIN
					</figcaption>
				</figure>

				<ZineTape Variant="section" Label="THE SIX // ONE SECTION EACH" />
				<h3
					id="six"
					class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl"
				>
					What each seam does
				</h3>
				<div class="isolate grid grid-cols-1 items-start gap-16 lg:grid-cols-2 lg:gap-24">
					{
						Hooks.map(({ N, Name, Tape, Tone, Rotate, Body }) => (
							<div
								class={`zine-box-${Tone} relative border-[3px] bg-carbon-void p-6 transition-transform duration-200 hover:rotate-0 ${Rotate} ${
									Tone === "canary"
										? "border-stamped-canary/40"
										: Tone === "crimson"
											? "border-raw-blood"
											: N === "04"
												? "border-zinc-dust/40"
												: "border-oxblood-dark"
								}`}
							>
								<h4
									class={`absolute -top-5 left-4 z-10 border border-black px-2 py-0.5 text-base font-black uppercase ${
										Tape === "canary"
											? "bg-stamped-canary text-soot-black"
											: Tape === "bone"
												? "bg-bone-newsprint text-soot-black"
												: "bg-raw-blood text-bone-white"
									}`}
								>
									{N} // {Name}
								</h4>
								{Body.map((Paragraph, I) => (
									<p
										class={I === 0
											? "mt-4 font-body text-base leading-relaxed text-bone-newsprint"
											: "mt-3 font-body text-base leading-relaxed text-bone-newsprint"}
										set:html={Paragraph}
									/>
								))}
							</div>
						))
					}
				</div>

				<ZineTape Variant="section" Label="BYPASS // THE ESSENTIAL-TOOL GATE" />
				<h3
					id="gate"
					class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl"
				>
					What never gets compressed
				</h3>
				<p class="mb-8 font-body text-base leading-relaxed text-bone-newsprint">
					A result is left untouched when it is empty, below threshold, or from the essential
					set - tools the agent needs raw:
				</p>
				<div class="border border-oxblood-dark bg-soot-black p-4 font-mono text-base text-bone-newsprint">
					skill_view · skills_list · skill_manage · memory · session_search · read_file ·
					read_terminal
				</div>
				<p class="mt-8 font-body text-base leading-relaxed text-zinc-dust">
					Aphrodite also skips its own tools and headroom helpers - compressing
					<span class="font-mono text-base text-weathered-teal">aphrodite_retrieve</span>
					would just replace resolved content with another marker.
				</p>
				<p class="mt-3 font-body text-base leading-relaxed text-zinc-dust">
					The gate is the reason retrieval stays cheap: a marker the model resolves comes back
					whole, because nothing downstream of the gate rewrites it a second time.
				</p>

				<ZineTape Variant="section" Label="THRESHOLDS // GATES AND BYPASSES" />
				<h3
					id="thresholds"
					class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl"
				>
					The numbers that decide
				</h3>
				<div class="overflow-x-auto">
					<table class="w-full border-collapse font-mono text-base">
						<thead>
							<tr class="border-b-2 border-oxblood-dark text-left">
								<th class="py-3 pr-4 text-base font-black uppercase tracking-widest text-stamped-canary">HOOK</th>
								<th class="py-3 pr-4 text-base font-black uppercase tracking-widest text-stamped-canary">SETTING</th>
								<th class="py-3 pr-4 text-base font-black uppercase tracking-widest text-stamped-canary">DEFAULT</th>
								<th class="py-3 text-base font-black uppercase tracking-widest text-stamped-canary">BYPASS</th>
							</tr>
						</thead>
						<tbody class="text-bone-newsprint">
							<tr class="border-b border-oxblood-dark">
								<td class="py-3 pr-4">transform_tool_result</td>
								<td class="py-3 pr-4 text-weathered-teal">tool_threshold_token</td>
								<td class="py-3 pr-4 text-bone-white">4,096</td>
								<td class="py-3">empty · essential tools · self tools · <span class="text-stamped-canary">0 = always compress</span></td>
							</tr>
							<tr class="border-b border-oxblood-dark">
								<td class="py-3 pr-4">transform_terminal_output</td>
								<td class="py-3 pr-4 text-weathered-teal">terminal_threshold</td>
								<td class="py-3 pr-4 text-bone-white">1,024</td>
								<td class="py-3">empty · below threshold · <span class="text-stamped-canary">0 = always compress</span></td>
							</tr>
							<tr class="border-b border-oxblood-dark">
								<td class="py-3 pr-4">pre_llm_call</td>
								<td class="py-3 pr-4 text-weathered-teal">flow budget_chars</td>
								<td class="py-3 pr-4 text-bone-white">4,000</td>
								<td class="py-3">recall catalog drops first; directives and nudges never drop</td>
							</tr>
							<tr>
								<td class="py-3 pr-4">pre_tool_call (chain split)</td>
								<td class="py-3 pr-4 text-weathered-teal">chain_split_min_segments</td>
								<td class="py-3 pr-4 text-bone-white">-</td>
								<td class="py-3">feature off by default (chain_split = false)</td>
							</tr>
						</tbody>
					</table>
				</div>
				<p class="mt-12 border-t border-oxblood-dark pt-8 text-base leading-relaxed text-zinc-dust">
					PRECEDENCE: ENVIRONMENT &gt; TOML &gt; DEFAULT
					(APHRODITE_TOOL_THRESHOLD_TOKEN · APHRODITE_TERMINAL_THRESHOLD ·
					APHRODITE_FLOW_BUDGET_CHARS · APHRODITE_CHAIN_SPLIT).
				</p>
			</ZineBox>
			<ZineSource
				Lines={[
					"SRC: docs/plugin/hooks.md; plugins/aphrodite/plugin.yaml (provides_hooks)",
					"SRC: docs/architecture/04-hook-ffi.md",
				]}
			/>
		</section>

		<!-- SLOT 4: exactly one onward link -->
		<Related
			Links={[
				{ Href: "/plugin/", Label: "PLUGIN" },
				{ Href: "/tools/", Label: "TOOLS" },
				{ Href: "/hermes/", Label: "HERMES" },
			]}
		/>
	</PageShell>
	<ZineDiagramNav />
</Base>
