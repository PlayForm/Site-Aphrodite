---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";

import PageShell from "@Component/PageShell.astro";
import ZineSplit from "@Component/ZineSplit.astro";
import ZineTape from "@Component/ZineTape.astro";

// THE PAIR - the product's whole argument, drawn once. The left pane is the
// raw stream the terminal keeps (the suppression opacities: dim 70, fade 40,
// mute 25); the right pane is the one line the model actually reads, plus the
// marker that addresses the original bytes. The lines are the build output the
// showcase's traversal A narrates; the preview line is a corpus sample.
//
// ZineSplit takes the lines as strings and reads a leading "dim:", "fade:" or
// "mute:" as the suppression tone, so the array is the same nine lines in the
// same order with the tone carried in the text instead of a second field.
const RawStream = [
	"$ cargo build --release -p aphrodite",
	"dim:   Compiling aphrodite-headroom-core v0.2.0",
	"fade:   Compiling aphrodite v1.8.0",
	"mute: warning: unused variable: `noise`",
	"mute: warning: 1 warning emitted",
	"canary: error[E0432]: unresolved import `crate::noise`",
	"mute:   --> crates/aphrodite/src/preview.rs:12:5",
	"canary: error: could not compile `aphrodite`",
	"result: 48,213 characters · 142 lines · the whole thing enters the context",
];
---

<Base
	Title="APHRODITE // CCR COMPRESSION ENGINE"
	Description="Context management for tool-using AI agents. Aphrodite turns verbose tool output - logs, diffs, files, searches, JSON, and browser snapshots - into compact, retrievable previews. Up to 610x compression on the standard corpus (132x overall), ~10 ms end-to-end."
>
	<PageShell Rhythm="hero">
		<!-- HERO SLAB -->
		<!-- SHARED-SLOT NOTE: PageHeader (t_130e5ed4) is deliberately NOT used on
		     this page. PageHeader renders its own <h1>; the landing's <h1> is the
		     stamped wordmark below, which is the page's identity, so a swap would
		     ship two h1s and shrink the wordmark from 144px to 48px. The lead below
		     keeps PageHeader's rhythm - one sentence, one <p>. -->
		<header
			class="relative flex w-full flex-col items-center justify-center pt-4 text-center"
			data-enter
		>
			<!-- Brand card: the red aphrodite.svg mark in the crimson module,
			     oxblood offset underlay (user instruction: the red mark everywhere) -->
			<div
				class="group relative mb-24 -rotate-[2.5deg] cursor-pointer transition-transform duration-300 hover:rotate-0"
			>
				<div
					class="pointer-events-none absolute -inset-2 translate-x-3 translate-y-3 border border-black bg-oxblood-dark opacity-80"
				>
				</div>
				<div class="zine-box-crimson relative border-4 border-blood-crimson bg-carbon-void p-5 sm:p-7">
					<div
						class="tape-strip absolute -top-3.5 left-1/2 -translate-x-1/2 -rotate-1 border-b border-t border-bone-newsprint/30 px-6 py-1 text-[13px] font-black uppercase tracking-widest text-bone-newsprint"
					>
						// REPRO_PROOF #001
					</div>
					<img
						class="h-32 w-auto sm:h-44"
						src="/Brand/aphrodite.svg"
						alt="Aphrodite brand mark"
						width="160"
						height="160"
					/>
					<div
						class="absolute -bottom-3.5 -right-3 border border-black bg-raw-blood px-2.5 py-0.5 text-base font-black tracking-widest text-bone-white shadow"
					>
						CCR CORE // STENCIL
					</div>
				</div>
			</div>
			<!-- Stamped wordmark -->
			<div class="relative flex flex-col items-center">
				<!-- The wordmark clamps at the small breakpoints: at 320px the
				     fixed 72px measures ~346px wide and clips both edges against
				     the overflow-x-hidden body; 17.5vw keeps the full name inside
				     the viewport until the fixed scale resumes above ~412px. -->
				<h1
					class="select-none font-headline text-[min(72px,17.5vw)] font-black uppercase leading-[0.85] tracking-tighter text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-[108px] lg:text-[144px]"
				>
					Aphrodite
				</h1>
				<div
					class="mb-10 mt-2 h-2 w-full max-w-xl -rotate-1 border border-black bg-raw-blood shadow-[3px_3px_0px_#000]"
				>
				</div>
			</div>
			<div
				class="mb-8 inline-block -rotate-1 border border-black bg-carbon-void px-3 py-1 text-base font-black uppercase tracking-widest text-weathered-teal shadow-[3px_3px_0px_#000]"
			>
				CONTEXT MANAGEMENT FOR TOOL-USING AI AGENTS
			</div>
			<!-- THE LEAD: one sentence states the product. The justification that
			     used to follow it here is the pair's, and reads below it. -->
			<p class="max-w-3xl font-body text-base leading-relaxed text-bone-newsprint sm:text-base">
				Aphrodite keeps noisy tool output out of your agent's context - it turns logs, diffs, files,
				searches, JSON, and browser snapshots into compact previews the agent can act on,
				with the original always one retrieval away.
			</p>
			<p class="mt-8 font-mono text-base font-bold uppercase tracking-widest text-zinc-dust">
				One binary. Zero dependencies. Millions of tokens saved.
			</p>
			<!-- Rotated stat badges: the hook, kept (plan 3.3), and each one now
			     carries its own one-line reading. A figure without its qualifier is
			     a poster; the caption is what makes it a measurement. The grid lands
			     after the lead rather than with it, and each figure climbs to its
			     value once ([data-count]) - the three exact counts, not the ~10ms
			     estimate, because a count-up on an approximation is false precision. -->
			<div
				class="mt-20 flex max-w-4xl flex-wrap items-start justify-center gap-3 sm:gap-4"
				data-enter="260"
			>
				<div class="flex flex-col items-center gap-2">
					<span
						class="-rotate-2 border-2 border-black bg-raw-blood px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[4px_4px_0px_#000] sm:text-base"
					>
						<span data-count="610">610</span>&times; COMPRESSION
					</span>
					<span class="max-w-[13rem] text-base leading-relaxed text-zinc-dust">
						Best case, on large low-entropy prose.
					</span>
				</div>
				<div class="flex flex-col items-center gap-2">
					<span
						class="rotate-1 border-2 border-black bg-carbon-void px-4 py-1.5 font-mono text-base font-bold uppercase tracking-widest text-weathered-teal shadow-[4px_4px_0px_#000] sm:text-base"
					>
						<span data-count="132">132</span>&times; OVERALL
					</span>
					<span class="max-w-[13rem] text-base leading-relaxed text-zinc-dust">
						The whole standard corpus: 106 KB to 800 B.
					</span>
				</div>
				<div class="flex flex-col items-center gap-2">
					<span
						class="rotate-2 border-2 border-black bg-raw-blood px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[4px_4px_0px_#000] sm:text-base"
					>
						~10MS E2E OVERHEAD
					</span>
					<span class="max-w-[13rem] text-base leading-relaxed text-zinc-dust">
						Including the HTTP round-trip; the spread is 8-40 ms.
					</span>
				</div>
				<div class="flex flex-col items-center gap-2">
					<span
						class="-rotate-1 border-2 border-black bg-stamped-canary px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-soot-black shadow-[4px_4px_0px_#000] sm:text-base"
					>
						<span data-count="156">156</span>M+ TOKENS SAVED
					</span>
					<span class="max-w-[13rem] text-base leading-relaxed text-zinc-dust">
						200 real sessions, 6,843 API calls, Sep 2026.
					</span>
				</div>
			</div>
		</header>

		<!-- THE PAIR // STREAM + PREVIEW - the product's whole argument, and the
		     second thing on the page. ZineSplit owns the plate and the two panes;
		     the prose above it is the section's claim, the note below it the one
		     caption. The section is the entrance root: it reveals on first view,
		     its plate wipes once, the raw pane prints line by line and the preview
		     lands on the frame the last line finishes. -->
		<section class="relative w-full" data-reveal>
			<!-- The tape keeps its fitted width: ZineTape's section shape is in
			     flow without `w-fit`, and the 103 hand-rolled section stamps this
			     replaces were all fitted. -->
			<div class="w-fit">
				<ZineTape Variant="section" Label="THE PAIR // STREAM + PREVIEW" />
			</div>
			<h2 class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
				The agent spends its budget reading noise
			</h2>
			<p class="max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Every file read, build, code search, or browser open floods the agent's context
				with raw output - compilation logs, accessibility trees, JSON blobs.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				The agent spends its budget reading noise instead of reasoning.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Aphrodite intercepts output before it reaches the LLM and replaces it with a compact,
				structured preview - because the agent's reasoning budget is the context budget,
				and raw noise spends both.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				The agent sees ~15 tokens of metadata instead of hundreds - and retrieves the full content
				only when it actually needs it.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				It is the reason tool-heavy agents keep working: the context window stops paying for noise
				before the reasoning starts.
			</p>
			<div class="mt-12">
				<ZineSplit
					Raw={RawStream}
					Preview="[build:1E 1W 142L | error[E0432]: unresolved import ...]"
					Hash="&lt;&lt;&lt;CCR:a1b2c3d4|build|48213&gt;&gt;&gt;"
					Label="ONE LINE, ONE MARKER"
				/>
			</div>
			<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
				The marker is the address of the original bytes.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
				The agent pays for them only when the preview fails to answer the question.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
				Watch the left pane print: that is the flood arriving, one line at a time, and
				every line of it is budget. The right pane lands after the last one, because a
				marker only means something once there is a flood behind it to address.
			</p>
		</section>

		<!-- THE HOW // 4-STAGE ABSORPTION - below the pair, because the pair is
		     the argument and this is the mechanism behind it. -->
		<section class="relative w-full" data-reveal>
			<div class="w-fit">
				<ZineTape Variant="section" Label="PIPELINE // 4-STAGE ABSORPTION" />
			</div>
			<h2 class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
				Four steps, one decision
			</h2>
			<p class="max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Every tool result runs the same four steps in the same order, and only one of them
				costs anything measurable.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				The first two are the engine's: name the content, then render the one line that
				describes it. The third is storage, and it is deliberately boring. The fourth is
				not the engine's at all - it is the agent's, and it is the only step that spends
				the budget the other three just saved.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
				Read the grid left to right, then top to bottom: each card is one step, the figure
				on it is what that step costs, and the line under the rule is what it decides.
			</p>
			<!-- The stage grid: 2x2 through the tablet/wide range - at 4-across
			     the enlarged stage labels ("STAGE // B 02 // ENRICH") squished
			     against the stamp chips between 1024-1279px. 4-across returns
			     only at xl, where each card gets ~330px+. It follows the heading
			     on a delay of its own rather than arriving with it. -->
			<div
				class="mt-16 grid grid-cols-1 items-start gap-12 sm:grid-cols-2 sm:gap-14 xl:grid-cols-4 xl:gap-14"
				data-enter="180"
			>
				<!-- Stage 01 -->
				<div
					class="zine-box-subtle isolate relative border-[3px] border-oxblood-dark bg-carbon-void p-5 transition-transform duration-200 hover:rotate-0 sm:-rotate-[1.8deg] lg:-translate-y-2"
				>
					<div
						class="absolute -top-2.5 left-4 z-10 border border-zinc-dust/40 bg-zinc-dust/20 px-2 py-0.5 text-base font-bold uppercase text-bone-newsprint"
					>
						STAGE // A
					</div>
					<div class="mb-3 mt-1 flex items-center justify-between">
						<h3 class="text-base font-bold tracking-wider text-weathered-teal">01 // CLASSIFY</h3>
						<span
							class="border border-weathered-teal/30 bg-weathered-teal/10 px-2 py-0.5 text-base font-black text-weathered-teal"
						>
							SIMD BYTE
						</span>
					</div>
					<div class="font-headline text-2xl font-black tracking-tight text-bone-white">
						40 - 123 ns
					</div>
					<div class="mt-4 border-t border-oxblood-dark pt-3 text-base text-zinc-dust">
						Type-aware classifier names the content.
					</div>
				</div>
				<!-- Stage 02 -->
				<div
					class="zine-box-canary isolate relative border-[3px] border-stamped-canary/40 bg-carbon-void p-5 transition-transform duration-200 hover:rotate-0 sm:rotate-[2.2deg] lg:translate-y-4"
				>
					<div
						class="absolute -top-2.5 left-4 z-10 border border-black bg-stamped-canary px-2 py-0.5 text-base font-black uppercase text-soot-black"
					>
						STAGE // B
					</div>
					<div class="mb-3 mt-1 flex items-center justify-between">
						<h3 class="text-base font-bold tracking-wider text-stamped-canary">
							02 // ENRICH &amp; PREVIEW
						</h3>
						<span
							class="border border-stamped-canary/30 bg-stamped-canary/10 px-2 py-0.5 text-base font-black text-stamped-canary"
						>
							TYPE-AWARE
						</span>
					</div>
					<div class="font-headline text-2xl font-black tracking-tight text-bone-white">~1 ms</div>
					<div class="mt-4 border-t border-oxblood-dark pt-3 text-base text-stamped-canary">
						Enriched, type-aware preview rendering.
					</div>
				</div>
				<!-- Stage 03 -->
				<div
					class="zine-box-crimson isolate relative border-[3px] border-raw-blood bg-carbon-void p-5 transition-transform duration-200 hover:rotate-0 sm:-rotate-[1deg]"
				>
					<div
						class="absolute -top-2.5 left-4 z-10 border border-black bg-raw-blood px-2 py-0.5 text-base font-black uppercase text-bone-white"
					>
						STAGE // C
					</div>
					<div class="mb-3 mt-1 flex items-center justify-between">
						<h3 class="text-base font-bold tracking-wider text-zinc-dust">03 // BLAKE3 STORE</h3>
						<span class="border border-raw-blood/40 bg-raw-blood/10 px-2 py-0.5 text-base font-black text-zinc-dust">
							DUAL TIER
						</span>
					</div>
					<div class="font-headline text-2xl font-black tracking-tight text-bone-white">SQLite</div>
					<div class="ccr-marker mt-4 border-t border-oxblood-dark pt-3 text-base text-zinc-dust">
						CCR marker: &lt;&lt;&lt;CCR:hash|type|size&gt;&gt;&gt;
					</div>
				</div>
				<!-- Stage 04 -->
				<div
					class="zine-box-subtle isolate relative border-[3px] border-zinc-dust/40 bg-carbon-void p-5 transition-transform duration-200 hover:rotate-0 sm:rotate-[2.5deg] lg:translate-y-3"
				>
					<div
						class="absolute -top-2.5 left-4 z-10 border border-black bg-bone-newsprint px-2 py-0.5 text-base font-black uppercase text-soot-black"
					>
						STAGE // D
					</div>
					<div class="mb-3 mt-1 flex items-center justify-between">
						<h3 class="text-base font-bold tracking-wider text-bone-newsprint">
							04 // AGENT DECIDES
						</h3>
						<span class="border border-bone-newsprint/30 bg-bone-newsprint/10 px-2 py-0.5 text-base font-black text-bone-newsprint">
							ON DEMAND
						</span>
					</div>
					<div class="font-headline text-2xl font-black tracking-tight text-bone-white">
						aphrodite_retrieve
					</div>
					<div class="mt-4 truncate border-t border-oxblood-dark pt-3 text-base text-weathered-teal">
						Full content only when needed.
					</div>
				</div>
			</div>
		</section>

		<!-- ONWARD // one install line, then the routing block. The install
		     harness that used to sit here is /setup/'s story (install-surfaces 1)
		     and the telemetry module that used to sit above it is /benchmarks/'. -->
		<p
			class="w-full border-t border-oxblood-dark pt-8 font-mono text-base font-bold uppercase tracking-widest text-zinc-dust"
			data-reveal
		>
			FULL INSTRUCTIONS ON THE <a class="text-stamped-canary" href="/setup/">SETUP PAGE</a>
		</p>

		<!-- RELATED: the natural neighbors -->
		<Related
			Links={[
				{ Href: "/setup/", Label: "SETUP" },
				{ Href: "/showcase/", Label: "SHOWCASE" },
				{ Href: "/docs/", Label: "DOCS" },
			]}
		/>
	</PageShell>
</Base>
