matchit 0.8.4
mime 0.3.18
sync_wrapper 1.0.2
serde_path_to_error 0.1.20
form_urlencoded 1.2.2
percent-encoding 2.3.2
serde_urlencoded 0.7.1
axum-core 0.5.6
axum-macros 0.5.1
axum 0.8.9
bitflags 2.13.2
anstyle 1.0.14
utf8parse 0.2.2
anstyle-parse 1.0.0
anstyle-query 1.1.5
colorchoice 1.0.5
is_terminal_polyfill 1.70.2
anstream 1.0.0
clap_lex 1.1.1
strsim 0.11.1
clap_builder 4.6.7
heck 0.5.0
clap_derive 4.6.7
clap 4.6.7
hashbrown 0.17.1
lru 0.19.0
dirs-sys 0.5.0
option-ext 0.2.0
dirs 7.0.0
winnow 1.0.5
serde_spanned 1.1.3
toml_datetime 1.1.3
toml_parser 1.1.5
toml_writer 1.2.0
toml 1.2.1
notify-types 2.3.0
