/**
 * A pretty-printed session listing. It does not parse until its closing bracket
 * arrives, so the preview runs the engine's crude `~Nitems` fallback first and
 * only reaches the real `keys:` arm on the last line.
 */
const JsonBody = [
	"[",
	'  {"id": "sess_4f2a", "type": "build", "tokens_in": 48213, "tokens_out": 46, "ratio": 1048.1, "stored": true, "tier": "hot", "hits": 3, "age_s": 12, "sha": "a1b2c3d4", "hash": "9e8f7a6b", "model": "deepseek-v4", "session": "4f2a"},',
	'  {"id": "sess_9b71", "type": "grep", "tokens_in": 3118, "tokens_out": 29, "ratio": 107.5, "stored": true, "tier": "hot", "hits": 11, "age_s": 41, "sha": "7e1f90ab", "hash": "2c6d8e10", "model": "deepseek-v4", "session": "9b71"},',
	'  {"id": "sess_2c08", "type": "ls", "tokens_in": 1042, "tokens_out": 18, "ratio": 57.9, "stored": true, "tier": "warm", "hits": 4, "age_s": 96, "sha": "3c4d5e6f", "hash": "80b1a2c3", "model": "deepseek-v4", "session": "2c08"},',
	'  {"id": "sess_e5d3", "type": "test", "tokens_in": 8821, "tokens_out": 34, "ratio": 259.4, "stored": true, "tier": "hot", "hits": 7, "age_s": 8, "sha": "b8a9c0d1", "hash": "4f5e6d7c", "model": "deepseek-v4", "session": "e5d3"},',
	'  {"id": "sess_71fa", "type": "json", "tokens_in": 2604, "tokens_out": 41, "ratio": 63.5, "stored": true, "tier": "warm", "hits": 2, "age_s": 187, "sha": "5f6e7d8c", "hash": "d9c8b7a6", "model": "deepseek-v4", "session": "71fa"},',
	'  {"id": "sess_0a4e", "type": "diff", "tokens_in": 12760, "tokens_out": 58, "ratio": 220.0, "stored": true, "tier": "warm", "hits": 5, "age_s": 240, "sha": "6b7c8d9e", "hash": "1a2b3c4d", "model": "deepseek-v4", "session": "0a4e"},',
	'  {"id": "sess_c3b9", "type": "html", "tokens_in": 21455, "tokens_out": 52, "ratio": 412.6, "stored": true, "tier": "cold", "hits": 1, "age_s": 611, "sha": "8e9fa0b1", "hash": "5c6d7e8f", "model": "deepseek-v4", "session": "c3b9"},',
	'  {"id": "sess_6f2d", "type": "log", "tokens_in": 5310, "tokens_out": 37, "ratio": 143.5, "stored": true, "tier": "hot", "hits": 9, "age_s": 3, "sha": "0d1e2f3a", "hash": "b4a59687", "model": "deepseek-v4", "session": "6f2d"}',
	"]",
];

/**
 * The cycle. Each command carries its own rhythm, because the pace is part of
 * the characterisation: a build stalls and bursts, a search arrives flat and
 * fast, a test run ticks, a JSON body lands in chunky beats.
 */
const Cycle: RunScript[] = [
	{
		Type: "build",
		Command: "cargo build --release -p aphrodite",
		Hash: "a1b2c3d4",
		Hold: 3400,
		Lines: [...Dependencies, ...Workspace].map(Compile).concat(BuildTail),
		Pace: { Beat: 26, Jitter: 18, Every: 11, Stall: 240, Turn: 420 },
	},
	{
		Type: "grep",
		Command: 'rg -n "noise" crates/aphrodite/src',
		Hash: "7e1f90ab",
		Hold: 2600,
		Lines: GrepHits,
		Pace: { Beat: 34, Jitter: 22, Every: 0, Stall: 0, Turn: 0 },
	},
	{
		Type: "ls",
		Command: "ls -F crates/aphrodite/src/preview",
		Hash: "3c4d5e6f",
		Hold: 2400,
		Lines: Listings,
		Pace: { Beat: 40, Jitter: 20, Every: 0, Stall: 0, Turn: 0 },
	},
	{
		Type: "test",
		Command: "cargo test -p aphrodite --lib",
		Hash: "b8a9c0d1",
		Hold: 3200,
		Lines: TestRuns,
		Pace: { Beat: 74, Jitter: 12, Every: 9, Stall: 160, Turn: 180 },
	},
	{
		Type: "json",
		Command: "curl -sS localhost:9797/session",
		Hash: "5f6e7d8c",
		Hold: 2800,
		Lines: JsonBody,
		Pace: { Beat: 110, Jitter: 45, Every: 3, Stall: 220, Turn: 0 },
	},
];

/**
 * The demonstration's method, as one disclosure.
 *
 * These five paragraphs used to stand between the reader and the plate: a
 * reader had to get through the instructions before seeing the thing they
 * describe. Moved here VERBATIM, they are still readable on demand, and the
 * plate is the first thing the eye lands on. Nothing was cut - the fold holds
 * the same sentences, in the same order, and the reader opens it when the
 * demonstration has raised the question it answers.
 *
 * `ZineFold` renders `Body` through `set:html`, so the payload is the markup
 * rather than a second string the component would have to parse.
 */
const MethodFold = `
<div class="prose-flow">
	<p>
		A tool call's output arrives in exactly this order and at this pace: a release build,
		then a code search, then a directory listing, then a test run, then a
		JSON body, then back to the build - indefinitely, each at the pace its own tool really
		prints at. Every line is output the named command produces,
		and the preview is recomputed from those lines as they land.
	</p>
	<p>
		Each line the tool prints is budget: the model reads it, and pays for it. As the lines
		land, the counts climb, the
		marker's size grows, and the preview settles on the one line the agent would
		actually have read. A marker only means something once there is a flood behind it to
		address, which is why Aphrodite draws it from the flood rather than beside it.
	</p>
	<p>
		Five commands, five shapes of answer: the build counts errors, warnings and lines; the
		search counts hits and files; the listing counts entries and extensions; the test run
		counts passes and failures; the JSON body counts items and keys. That is one engine
		reading five kinds of output - the tool naming the type, and the preview rendering
		the answer that name earns.
	</p>
	<p>The marker is the address of the original bytes.</p>
	<p>The agent pays for them only when the preview fails to answer the question.</p>
</div>
`.trim();

/**
 * The grid's reading instruction, demoted to a disclosure above the plate.
 * A reader who needs to be told how to read four cards is already lost; the
 * sentence stays because it is true and useful, one click away from the grid
 * it describes.
 */
const GridFold = `
<div class="prose-flow">
	<p>
		The four stages run in order: each card is one step, the figure
		on it is what that step costs, and the line under the rule is what it decides.
	</p>
	<p>
		What happens between the tool printing and the model reading is four steps, run
		in the same order every time, and only one of them costs anything measurable.
	</p>
	<p>
		The first two are the engine's: name the content, then render the one line that
		describes it. The third is storage, and it is deliberately boring. The fourth is
		not the engine's at all - it is the agent's, and it is the only step that spends
		the budget the other three just saved.
	</p>
	<p>
		The agent sees ${Narrative.PreviewTokens} of metadata instead of hundreds - and
		retrieves the full content only when it actually needs it.
	</p>
	<p>
		It is the reason tool-heavy agents keep working: the context window stops paying
		for noise before the reasoning starts.
	</p>
</div>
`.trim();

/**
 * The two-lane decision matrix, as rows of one axis each.
 *
 * Every cell is a fact the lane's own prose states below it, said once in the
 * matrix's voice: WHERE IT RUNS, WHAT IT SEES, WHAT IT SHARES, THE LIMIT. The
 * matrix is the summary and the prose is the source, so a cell may compress a
 * sentence but may never carry a claim the lane's prose does not already make.
 * Laid out as three ruled columns rather than a <table>: the cells hold
 * sentences, and a sentence in a table cell wraps against a fixed track.
 */
const Decision = [
	{
		Axis: "WHERE IT RUNS",
		One: "Inside the turn, as a native Hermes plugin - not a proxy you point a client at.",
		Two: "On a port, as an OpenAI-compatible listener the plugin already spawns.",
	},
	{
		Axis: "WHAT IT SEES",
		One: "Tool output, before it becomes message history: six hooks, thirteen tools, and an optional context engine, every call forwarded into the Rust dylib.",
		Two: "HTTP traffic only. SSE streams pass through uncompressed.",
	},
	{
		Axis: "WHAT IT SHARES",
		One: "The turn's own context. The inline store is session-scoped.",
		Two: "A persistent SQLite store that survives a restart, shared with any client that speaks HTTP, and the tool relay that retrieves or creates CCR entries.",
	},
	{
		Axis: "THE LIMIT",
		One: "The hooks are Hermes' contract - no other client can register them, so this lane works with Hermes only.",
		Two: "No tool-output interception, no terminal compression, no directives, no context engine. It extends the stack to other callers; it does not replace the hooks inside Hermes.",
	},
];

/**
 * THE TWO LANES, as the decision matrix's cards.
 *
 * `Decision` is the axis table read across a row: one axis, two values. The
 * cards are that same data read down a COLUMN, so a card cannot say anything
 * the axis rows do not - a lane is its four axis values, its name, its "best
 * for" line and the one action it offers. `Dominant` is the recommended route:
 * it takes the wider track, the crimson top line and the RECOMMENDED tag, which
 * is how Stitch draws a matrix with one lead without a second layout.
 *
 * The `Lead` is the lane's own thesis, kept because the axis cells compress it
 * rather than contain it: `tool output never hits a wire`, `base_url at :9798`,
 * `a second agent, a script, an external tool`. Nothing from the two lane
 * articles is dropped - each sentence's fact is either in the Lead or in the
 * row that summarises it.
 */
const Lanes = [
	{
		Path: "PATH 01 // NATIVE PLUGIN",
		Name: "Hermes plugin",
		Badge: "RECOMMENDED",
		BestFor: "BEST FOR: HERMES",
		Dominant: true,
		Lead: "Aphrodite connects to Hermes Agent as a native plugin, not as a proxy you point a client at. Tool output never hits a wire, so only hook-level registration catches it before it becomes message history.",
		Rows: Decision.map((Row) => ({ Axis: Row.Axis, Value: Row.One })),
		Action: { Label: "THE INTEGRATION", Href: Routes.Hermes },
	},
	{
		Path: "PATH 02 // OPENAI-COMPATIBLE PROXY",
		Name: "Standalone proxy",
		Badge: "HTTP",
		BestFor: "BEST FOR: OTHER CLIENTS",
		Dominant: false,
		Lead: "The plugin already spawns both listeners, so this lane needs no extra setup: point base_url at :9798 and any OpenAI-compatible client - a second agent, a script, an external tool - gets the same CCR compression over plain HTTP.",
		Rows: Decision.map((Row) => ({ Axis: Row.Axis, Value: Row.Two })),
		Action: { Label: "THE PROXY LANE", Href: Anchor(Routes.Setup, "proxy") },
	},
];

/**
 * WHAT LANDS ON DISK - the persistence band's tree, one row per line.
 *
 * Every line is a fact the page already states elsewhere: the catalog entry is
 * a reviewed pinned checkout of `plugin.yaml` plus the `__init__.py` shim (step
 * 1), `download.sh` fetches the binary and the dylib into
 * `~/.hermes/aphrodite/binaries/` validated against the in-tree
 * `SHA256SUMS.txt` (step 3), the store is SQLite and survives a restart (lane
 * 02), and the directives are the plugin lane's own (lane 02's limit names
 * them). `Prefix` is the drawing, `Name` the path segment, `Note` the comment -
 * so a new file is one row, never a redrawn branch.
 */
const Topology = [
	{ Prefix: "", Name: "~/.hermes/", Note: "" },
	{
		Prefix: "├── ",
		Name: "plugins/aphrodite/",
		Note: "the catalog entry: a reviewed pinned checkout",
	},
	{ Prefix: "│   ├── ", Name: "plugin.yaml", Note: "Hermes manifest" },
	{ Prefix: "│   ├── ", Name: "__init__.py", Note: "loader shim" },
	{ Prefix: "│   ├── ", Name: "BINARY_VERSION", Note: "the release this tree pins" },
	{
		Prefix: "│   └── ",
		Name: "SHA256SUMS.txt",
		Note: "in-tree checksums, BINARY_VERSION header",
	},
	{ Prefix: "└── ", Name: "aphrodite/", Note: "the runtime home" },
	{
		Prefix: "    ├── ",
		Name: "binaries/",
		Note: "fetched by download.sh, SHA-256 and magic-byte verified",
	},
	{ Prefix: "    │   ├── ", Name: "aphrodite", Note: "the proxy binary" },
	{
		Prefix: "    │   └── ",
		Name: "libaphrodite_hermes.*",
		Note: "the dylib the plugin loads",
	},
	{ Prefix: "    ├── ", Name: "ccr.db", Note: "SQLite store: survives a restart" },
	{ Prefix: "    └── ", Name: "directives/", Note: "agent directives, hot-reloaded" },
];

/**
 * THE TWO LAYERS BESIDE THE TREE - Stitch's right column: one card per
 * directory, each with its own accent edge, plus the two guarantees that make
 * the layout safe to reason about. The accents are identity (teal = the
 * checked-in plugin tree, blood = the runtime home), not decoration, so they
 * travel with the card rather than with a rule.
 */
const Layers = [
	{
		Tone: "weathered-teal",
		Label: "THE PLUGIN DIRECTORY // HOOKS-ONLY",
		Path: "~/.hermes/plugins/aphrodite",
		Body: "Carries the manifest, the loader shim and the checksum list, and nothing else: a reviewed pinned checkout of the catalog entry. Enabling is a separate write to Hermes' own config.yaml, so a finished download alone does not register the hooks.",
	},
	{
		Tone: "raw-blood",
		Label: "THE RUNTIME HOME // PERSISTENCE",
		Path: "~/.hermes/aphrodite",
		Body: "Houses everything fetched or written at runtime: the binary and the dylib, and the SQLite store that survives a restart and is shared with any client that speaks HTTP. The plugin lane's inline store is session-scoped instead.",
	},
];

/**
 * The two guarantees the persistence band closes on. Both are failure-path
 * facts the install panel already stated, and both are about what does NOT get
 * written - which is exactly what a reader deciding to install wants to know.
 */
const Guarantees = [
	"aphrodite setup runs hermes --version as its first step and fails fast with a clear error, before anything is written.",
	"If the binaries are missing, the plugin logs the setup command and stays disabled until you run it.",
];
---

<Base
	Title="APHRODITE // CCR COMPRESSION ENGINE"
	Description={`Context management for tool-using AI agents. Aphrodite turns verbose tool output - logs, diffs, files, searches, JSON, and browser snapshots - into compact, retrievable previews. Up to ${Benchmark.Ceiling} compression on the standard corpus (${Benchmark.Overall} overall), ${Benchmark.LatencyHeadline} end-to-end.`}
>
	<PageShell Rhythm="hero">
		<!-- HERO SLAB -->
		<!-- SHARED-SLOT NOTE: PageHeader (t_130e5ed4) is deliberately NOT used on
		     this page. PageHeader renders its own <h1>; the landing's <h1> is the
		     stamped wordmark below, which is the page's identity, so a swap would
		     ship two h1s and shrink the wordmark from 144px to 48px. The lead below
		     keeps PageHeader's rhythm - one sentence, one <p>. -->
		<!-- SIX BANDS, ONE RULE. Bands 02-06 are `.band`, whose chapter rule is
		     `--oxblood-dark`; `.blueprint-section`'s default is the grey
		     `--blueprint-rule`. Band 01 therefore states the same crimson through
		     the documented knob, so the six numbered bands open on one rule and a
		     reader can see the chapter grammar before the second band repeats it. -->
		<header
			class="blueprint-section relative flex w-full flex-col items-start justify-start pt-4 text-start"
			style="--blueprint-rule: var(--oxblood-dark)"
			data-enter
		>
			<!-- Beat 01. The folio, in the published blueprint voice: six of these
			     number the six chapters, and each is quiet on purpose - a chapter
			     number is navigation, not decoration. This one is the hero's
			     BREADCRUMB as well as its coordinate, so it names the publication
			     the chapter sits in - the same shape Stitch's overline takes
			     (`01 / SYSTEM PROVISIONING / RUNTIME INTEGRATION PLAYBOOK`). -->
			<p class="section-index !mb-10">01 // POSITIONING // CCR COMPRESSION ENGINE</p>
			<!-- Brand card: the red aphrodite.svg mark in the crimson module,
			     oxblood offset underlay (user instruction: the red mark everywhere).
			     The card's 24-unit drop to the wordmark was the ceremonial stack
			     this beat was paying for: the product's own name now follows its
			     mark at reading distance.

			     The build chip sits BESIDE the card, not under it: the version is
			     the one number on this page a reader can check against their own
			     install (`Versions.Binary`, read from the module's
			     `crates/aphrodite/Cargo.toml`), and a fact belongs in the same row
			     as the identity it is a fact about. -->
			<div class="mb-10 flex flex-wrap items-center gap-6">
				<div class="group relative -rotate-[2.5deg] cursor-pointer transition-transform duration-300 hover:rotate-0">
					<div class="pointer-events-none absolute -inset-2 translate-x-3 translate-y-3 border border-black bg-oxblood-dark opacity-80"></div>
					<div class="zine-box-crimson relative border-4 border-blood-crimson bg-carbon-void p-5 sm:p-7">
						<div class="tape-strip absolute -top-3.5 left-1/2 -translate-x-1/2 -rotate-1 border-b border-t border-bone-newsprint/30 px-6 py-1 text-[13px] font-black uppercase tracking-widest text-bone-newsprint">
							// REPRO_PROOF #001
						</div>
						<img
							class="h-32 w-auto sm:h-44"
							src="/Brand/aphrodite.svg"
							alt="Aphrodite brand mark"
							width="160"
							height="160"
						/>
						<div class="absolute -bottom-3.5 -right-3 border border-black bg-raw-blood px-2.5 py-0.5 text-base font-black tracking-widest text-bone-white shadow">
							CCR CORE // STENCIL
						</div>
					</div>
				</div>
				<span class="telemetry-tag telemetry-tag--teal">Binary v{Versions.Binary}</span>
			</div>
			<!-- Stamped wordmark. THE HERO'S EXPRESSIVE BUDGET IS THE BRAND CARD
			     above; the wordmark carries the scale jump and nothing else. The
			     red rule that used to sit under it was the beat's fourth device
			     (card, wordmark, rule, chip), and a 2px bar cannot add emphasis
			     to a 144px word - it only spends the section's budget. Its 56px
			     of vertical space is kept as spacing, so nothing else moves.

			     The oxblood drop-shadow that used to sit under these letters is
			     gone for the same reason, and it was the LAST duplicate: the
			     card above already carries an oxblood offset plane
			     (`bg-oxblood-dark` at translate 12/12) plus its own hard shadow,
			     so a third oxblood offset under the wordmark was the same device
			     spent twice in one section - measured: the hero carried
			     rotate(-2.5deg) + translate(12,12) plane + 6px hard shadow +
			     rotated tape + stamp chip + a 4px oxblood drop-shadow on the
			     144px word. The wordmark's identity is the NAME at scale in bone
			     white, which no shadow was ever carrying; the offset plane
			     belongs to the card alone now. Verified in the rendered page:
			     the hero's only remaining offset planes are the card's. -->
			<div class="relative flex flex-col items-start">
				<!-- The wordmark clamps at the small breakpoints: at 320px the
				     fixed 72px measures ~346px wide and clips both edges
				     against the overflow-x-hidden body; 17.5vw keeps the full
				     name inside the viewport until the fixed scale resumes
				     above ~412px. -->
				<h1 class="select-none font-headline text-[min(72px,17.5vw)] font-black uppercase leading-[0.85] tracking-tighter text-bone-white sm:text-[108px] lg:text-[144px]">
					Aphrodite
				</h1>
			</div>
			<!-- The positioning line is a SUBTITLE, not a chip. Boxed, shadowed
			     and tilted, it made the page's third-strongest element out of one
			     sentence - and its teal made the hero carry two accents against
			     the card's crimson. As a line of type under the wordmark it still
			     states the product, and the hero speaks one colour.

			     It starts on the same vertical as everything above it now: a
			     centred hero makes the eye hunt for a starting edge on every line,
			     and the arrangement this beat takes from Stitch starts the whole
			     stack on one edge. -->
			<p class="mb-8 mt-14 text-start font-mono text-base font-black uppercase tracking-widest text-bone-newsprint">
				CONTEXT MANAGEMENT FOR TOOL-USING AI AGENTS
			</p>
			<!-- THE BODY, IN TWO COLUMNS: the reader's path on the left, the
			     instrument panel on the right. The panel is the Stitch hero's side
			     cluster - ours carries the four standing claims rather than abstract
			     telemetry, because a panel with no words in it is decoration, and
			     the four claims are exactly what a reader should be able to read
			     without scrolling. Below `lg` the panel stacks under the actions,
			     which is the same reading order. -->
			<div class="grid w-full grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start lg:gap-12">
				<div class="flex min-w-0 flex-col items-start">
					<!-- THE LEAD: one sentence states the product, and the two actions are
					     the only two things a reader can do from here - install it, or
					     watch it work. The justification that used to follow the lead is
					     beat 03's, and the stat grid that used to sit under it is beat
					     04's: four figures with four different measurement domains belong
					     beside the study that qualifies them, not between the reader and
					     the demonstration. -->
					<p class="type-body max-w-[40rem] text-bone-newsprint">
						A tool call's output becomes part of the model's context, and a release build adds
						thousands of lines the model reads - and pays for - before it can answer. Aphrodite
						intercepts that result: logs, diffs, files, searches, JSON, and browser snapshots
						arrive as compact previews the agent can act on, with the original always one
						retrieval away.
					</p>
					<!-- THE TELEMETRY MATRIX. Four status chips, each one a fact a reader
					     can check without reading further: the engine is Rust, the
					     integration is a Hermes plugin, the proxy is its own process with
					     two listeners, and the licence is CC0-1.0. They replace the four
					     claim chips that used to sit here - those claims are the panel on
					     the right now, in the readout voice, so the hero states each fact
					     once instead of twice. The four accents keep their original order
					     (bone / teal / canary / crimson), so no chip changes identity. -->
					<ul class="chips mt-10">
						<li class="telemetry-tag telemetry-tag--bone">Rust engine</li>
						<li class="telemetry-tag telemetry-tag--teal">Hermes plugin</li>
						<li class="telemetry-tag telemetry-tag--canary">Standalone proxy // :9797 :9798</li>
						<li class="telemetry-tag telemetry-tag--crimson">Licensed CC0-1.0</li>
					</ul>
					<!-- THE TWO ACTIONS, under the chips: the reader has been told what
					     it is and what is true of it, so the next thing they meet is the
					     two things they can do from here. -->
					<div class="mt-8 flex flex-wrap items-center gap-4">
						<ZineButton Label="Install for Hermes" Href="/setup/" />
						<ZineButton Label="See the before / after" Href="#hero-run" Role="secondary" />
					</div>
				</div>
				<!-- THE TELEMETRY PANEL. Index on the left, claim on the right, ruled
				     like a ledger - the hero's standing claims in the voice every later
				     chapter speaks. `.well` is grunge-safe by construction (it sets no
				     isolation, z-index, transform, filter or opacity), so the hero's
				     right column carries the page's own texture instead of reading as
				     the one clean block on the sheet. -->
				<aside
					class="grunge well w-full p-4 sm:p-5"
					data-grunge
					data-grunge-mode="edge"
					aria-label="Aphrodite in four claims"
				>
					<p class="section-index">// STANDING CLAIMS</p>
					<ul class="mt-3 flex flex-col border-t border-[color:var(--tier-well-edge)]">
						{Claims.map((Claim, Index) => (
							<li class="flex items-baseline justify-between gap-3 border-b border-[color:var(--tier-well-edge)] py-2 font-mono text-meta font-bold uppercase last:border-b-0">
								<span class="text-zinc-dust">{String(Index + 1).padStart(2, "0")}</span>
								<span class="text-end text-bone-newsprint">{Claim}</span>
							</li>
						))}
					</ul>
				</aside>
			</div>
		</header>

		<!-- 02 // DECISION MATRIX - the Stitch route matrix, and the first thing
		     after the hero: a reader who has read the lead has exactly one
		     question left, and it is which lane they are installing.

		     ONE DOMINANT CARD. The plugin lane is the recommended route, so it
		     takes the wider track, the crimson top line and the RECOMMENDED tag;
		     the proxy card keeps its own facts at the quiet tier. Both cards carry
		     the same four axes as ruled rows, so the comparison survives the change
		     of shape: `Decision` is read down a COLUMN instead of across a row, and
		     a card can therefore never say anything its rows do not.

		     The two lane articles that used to stand below the axis table are gone
		     as ARTICLES, not as content: each lane's thesis is its card's `Lead`,
		     its four comparison facts are the card's rows, its "best for" line is
		     the card's footer and its link is the card's one action. The /plugin/
		     link the plugin lane carried is reachable from the site's own
		     navigation (MenuLinks carries PLUGIN immediately before HERMES), which
		     is why the card spends its one action on THE INTEGRATION. -->
		<section class="band relative w-full" data-reveal>
			<div
				class="flex flex-col gap-4 border-b border-oxblood-dark pb-5 md:flex-row md:items-end md:justify-between"
			>
				<div class="flex flex-col gap-2">
					<p class="section-index !mb-0">02 // DECISION MATRIX</p>
					<h2 class="type-section text-bone-white">Two ways to run it</h2>
				</div>
				<p class="type-body max-w-md text-zinc-dust">
					Both lanes run the same engine over the same CCR store. One lives inside the
					turn; the other can only see traffic that arrives over HTTP.
				</p>
			</div>
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
				{Lanes.map((Lane) => (
					<article
						class:list={[
							"grunge shell-card flex flex-col p-6 sm:p-8",
							{ "shadow-[6px_6px_0px_var(--oxblood-dark)]": Lane.Dominant },
						]}
						data-grunge
						data-grunge-mode="edge"
					>
						<span
							class:list={[
								"absolute inset-x-0 top-0 h-1",
								Lane.Dominant ? "bg-raw-blood" : "bg-oxblood-dark",
							]}
							aria-hidden="true"
						></span>
						<div class="flex flex-wrap items-center justify-between gap-3">
							<span
								class:list={[
									"telemetry-tag",
									Lane.Dominant ? "telemetry-tag--crimson" : "telemetry-tag--teal",
								]}
							>
								{Lane.Badge}
							</span>
							<span class="type-meta font-bold uppercase tracking-widest text-zinc-dust">
								{Lane.Path}
							</span>
						</div>
						<h3 class="type-sub mt-4 text-bone-white">{Lane.Name}</h3>
						<p class="type-body mt-3 text-bone-newsprint">{Lane.Lead}</p>
						<dl class="mt-6 flex flex-col">
							{Lane.Rows.map((Row) => (
								<div class="grid grid-cols-1 gap-1 border-t border-[color:var(--tier-shell-edge)] py-3 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-5">
									<dt class="type-meta font-bold uppercase tracking-widest text-zinc-dust">
										{Row.Axis}
									</dt>
									<dd class="type-body max-w-[40rem] text-bone-newsprint">{Row.Value}</dd>
								</div>
							))}
						</dl>
						<div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-oxblood-dark pt-4">
							<span class="type-meta font-bold uppercase tracking-widest text-zinc-dust">
								{Lane.BestFor}
							</span>
							<a
								class="type-code font-bold text-stamped-canary hover:underline"
								href={Lane.Action.Href}
							>
								{Lane.Action.Label} &rarr;
							</a>
						</div>
					</article>
				))}
			</div>
		</section>

		<!-- 03 // OPERATIONAL WORKFLOW - the product's whole argument, moving, and
		     the band the page is built around. Stitch's operational-workflow band
		     is a header, a terminal with its own ribbon and a footer callout; ours
		     is the pair `ZineSplit` already owns (two pods, each a ribbon over a
		     recessed well), the compression cutoff stated as the strip beneath it,
		     and the four steps the pair is running.

		     THE FOUR STAGES LIVE HERE, and not in a band of their own. The six
		     bands are the Stitch sequence, and the four stage figures are the
		     workflow's own measurements - `40 - 123 ns` to name the content, `~1
		     ms` to render it, `SQLite` to store it, `aphrodite_retrieve` to get it
		     back. A separate MECHANISM band would have been a seventh coordinate
		     for a subject this band already states, so the stage row sits under the
		     pair as the workflow's step list. Every figure, unit, stage letter and
		     chip survives verbatim; only the coordinate moved.

		     The section is the entrance root: it reveals on first view, and the
		     grunge ink rides behind the stage plate at the band's foot. The left
		     pane is a terminal that never stops - five commands in a cycle, each
		     streaming its real output on its own rhythm - and the right pane is
		     recomputed from the stream so far, so the marker is never a lie about
		     a flood that has not finished arriving. -->
		<section class="band relative w-full" data-reveal>
			<div
				class="flex flex-col gap-4 border-b border-oxblood-dark pb-5 md:flex-row md:items-end md:justify-between"
			>
				<div class="flex flex-col gap-2">
					<p class="section-index !mb-0">
						03 // OPERATIONAL WORKFLOW // THE PAIR // STREAM + PREVIEW
					</p>
					<h2 class="type-section text-bone-white">
						The agent spends its budget reading noise
					</h2>
				</div>
				<p class="type-body max-w-md text-zinc-dust">
					Every file read, build, code search or browser open floods the agent's context
					with raw output - compilation logs, accessibility trees, JSON blobs - and the
					agent spends its budget reading noise instead of reasoning.
				</p>
			</div>
			<ZineSplit Run={Cycle} Label="ONE LINE, ONE MARKER" Id="hero-run" />
			<!-- The one visible caption. It belongs to the plate - it names what
			     the two panes are, so a reader who scrolled straight to the image
			     knows what they are looking at without opening anything. -->
			<p class="figure-caption">
				The flood arrives one line at a time; the line the agent would have read instead is
				recomputed as each line lands.
			</p>
			<!-- THE COMPRESSION CUTOFF. Stitch closes its console band on a footer
			     callout that states the one fact the two panes add up to; ours is
			     the line the flood stops being read at, said once, between the
			     demonstration and the machinery. It is a ruled strip rather than a
			     second plate: the band already spends its expressive budget on the
			     pair above it. -->
			<div
				class="flex flex-col gap-3 border-y border-oxblood-dark py-4 md:flex-row md:items-center md:justify-between md:gap-8"
			>
				<span class="type-meta font-bold uppercase tracking-widest text-raw-blood">
					COMPRESSION CUTOFF
				</span>
				<p class="type-meta max-w-2xl text-zinc-dust">
					Everything above the line is stored and addressed; the agent reads the one line,
					and pays for the rest only when the preview cannot answer.
				</p>
				<span class="telemetry-tag telemetry-tag--canary">ONE RETRIEVAL AWAY</span>
			</div>
			<div class="max-w-[62ch]">
				<ZineFold Tag="METHOD" Label="How the demonstration works" Body={MethodFold} />
			</div>
			<!-- THE FOUR STEPS // the workflow's own step list, under the pair it
			     runs. The instructions for reading the grid stay one click away, so
			     the four figures are the first thing the eye lands on. -->
			<div class="flex flex-col gap-4 border-b border-oxblood-dark pb-5">
				<p class="type-meta font-bold uppercase tracking-widest text-zinc-dust">
					THE FOUR STEPS // WHAT HAPPENS BETWEEN THE TOOL PRINTING AND THE MODEL READING
				</p>
				<p class="type-body text-bone-newsprint">
					A tool result is appended to the model's context the moment the tool returns, so
					a build log the agent never needed is read in full, and paid for in full.
					Aphrodite intercepts that output before it reaches the LLM and replaces it with
					a compact, structured preview - because the agent's reasoning budget is the
					context budget, and raw noise spends both.
				</p>
				<div class="max-w-[62ch]">
					<ZineFold Tag="GUIDE" Label="How to read the four stages" Body={GridFold} />
				</div>
			</div>
			<!-- The section's one expressive assembly. BENTO GRAMMAR: the four
			     stages are not four equal boxes - 01 and 04 take 45% more width
			     than 02 and 03, because those are the two whose figure needs the
			     room (`40 - 123 ns`, `aphrodite_retrieve`) and because a cluster
			     of four identical tiles reads as a list, not as a mechanism with
			     a shape. Weighted TRACKS rather than column spans: a span of
			     2-of-6 put the narrow cards at 163px and wrapped every sentence
			     in them; 1.45fr against 1fr gives the same two-size read at 308
			     against 212 and keeps the cards readable. The grid keeps its 2x2
			     shape through the tablet range and only splits into weighted
			     tracks at xl, where each track has room to mean something.
			     The plate is inset (`mx-3`/`sm:mx-4`) so the grunge ink that bleeds
			     past its edge has somewhere to go: `main > section` clips overflow,
			     so a full-bleed plate would have its splats shaved off at the page
			     edge and the texture would read as a hard cut rather than as ink. -->
			<div
				class="grunge grunge--bone emphasis-quiet mx-3 p-5 sm:mx-4 sm:p-8 lg:p-10"
				data-grunge
			>
				<div
					class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4"
					data-enter="180"
				>
					<!-- Stage 01 // CLASSIFY - teal: the technical voice, the type
					     that names the content. -->
					<div class="emphasis-quiet stage-card stage-card--a flex flex-col p-5">
						<div class="flex flex-col gap-1">
							<h3 class="type-meta font-bold stage-ink">01 // CLASSIFY</h3>
							<span class="type-meta stage-ink">STAGE // A</span>
						</div>
						<div class="metric mt-4 mb-4">40 - 123 ns</div>
						<div class="stage-rule mt-auto border-t pt-3">
							<p class="type-body text-bone-newsprint">
								Type-aware classifier names the content.
							</p>
							<p class="type-meta mt-2 stage-ink">SIMD BYTE</p>
						</div>
					</div>
					<!-- Stage 02 // ENRICH & PREVIEW - canary: the result the reader
					     acts on. -->
					<div class="emphasis-quiet stage-card stage-card--b flex flex-col p-5">
						<div class="flex flex-col gap-1">
							<h3 class="type-meta font-bold stage-ink">
								02 // ENRICH &amp; PREVIEW
							</h3>
							<span class="type-meta stage-ink">STAGE // B</span>
						</div>
						<div class="metric mt-4 mb-4">~1 ms</div>
						<div class="stage-rule mt-auto border-t pt-3">
							<p class="type-body text-bone-newsprint">
								Enriched, type-aware preview rendering.
							</p>
							<p class="type-meta mt-2 stage-ink">TYPE-AWARE</p>
						</div>
					</div>
					<!-- Stage 03 // BLAKE3 STORE - blood: storage, and the marker it
					     hands back. -->
					<div class="emphasis-quiet stage-card stage-card--c flex flex-col p-5">
						<div class="flex flex-col gap-1">
							<h3 class="type-meta font-bold stage-ink">03 // BLAKE3 STORE</h3>
							<span class="type-meta stage-ink">STAGE // C</span>
						</div>
						<div class="metric mt-4 mb-4">SQLite</div>
