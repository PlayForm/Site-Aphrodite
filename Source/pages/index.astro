					     rather than an engine accent. -->
					<div class="emphasis-quiet stage-card stage-card--d p-5">
						<div class="flex items-baseline justify-between gap-3">
							<h3 class="type-meta font-bold stage-ink">04 // AGENT DECIDES</h3>
							<span class="type-meta stage-ink">STAGE // D</span>
