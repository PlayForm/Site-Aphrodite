tracing-subscriber 0.3.23
`
	.trim()
	.split("\n")
	.map((Row) => Row.trim())
	.filter((Row) => Row !== "");

/** The two path crates compile last, and their versions are the generated ones. */
const Workspace = [`aphrodite-headroom-core ${Versions.Headroom}`, `aphrodite ${Versions.Binary}`];

/** `name version` -> the line cargo prints for it. */
const Compile = (Row: string): string => {
	const Space = Row.indexOf(" ");

	return `   Compiling ${Row.slice(0, Space)} v${Row.slice(Space + 1)}`;
};

/**
 * What rustc prints after the last crate compiles: one warning with its source
 * snippet, one error with its snippet and note, then the per-unit warning
 * summary and the compile failure. Two warning LINES and two error LINES - the
 * engine counts lines, not occurrences, so `warning: ... generated 1 warning`
 * is itself a second warning line. That is why the settled marker reads `2E 2W`.
 */
const BuildTail = [
	"warning: unused variable: `noise`",
	"  --> crates/aphrodite/src/preview/render.rs:41:9",
	"   |",
	"41 |     let noise = self.estimate_noise(&body);",
	"   |         ^^^^^ help: if this is intentional, prefix it with an underscore: `_noise`",
	"   |",
	"   = note: `#[warn(unused_variables)]` on by default",
	"error[E0432]: unresolved import `crate::noise`",
	"  --> crates/aphrodite/src/preview.rs:12:5",
	"   |",
	"12 | use crate::noise::{estimate_noise, NoiseFloor};",
	"   |     ^^^^^^^^^^^^ no `noise` in the crate root",
	"   |",
	"note: found an item that was configured out",
	"  --> crates/aphrodite/src/lib.rs:88:9",
	"   |",
	"88 | pub mod noise;",
	"   |         ^^^^^",
	"   = note: the item is gated behind the `noise` feature",
	'warning: `aphrodite` (bin "aphrodite") generated 1 warning',
	'error: could not compile `aphrodite` (bin "aphrodite") due to 1 previous error',
];

/** `rg -n "noise"` - the shape the grep arm reads: `path:line:text`. */
const GrepHits = [
	"crates/aphrodite/src/preview/render.rs:41:    let noise = self.estimate_noise(&body);",
	"crates/aphrodite/src/preview/render.rs:42:    let floor = noise.floor();",
	"crates/aphrodite/src/preview/render.rs:58:    if noise > self.noise_budget() {",
	"crates/aphrodite/src/preview/render.rs:63:    self.noise_estimate = Some(noise);",
	"crates/aphrodite/src/preview.rs:12:use crate::noise::{estimate_noise, NoiseFloor};",
	"crates/aphrodite/src/preview.rs:88:        let noise = estimate_noise(body);",
	"crates/aphrodite/src/preview.rs:91:        NoiseFloor::from(noise)",
	"crates/aphrodite/src/lib.rs:88:pub mod noise;",
	"crates/aphrodite/src/lib.rs:191:    noise::estimate(&content)",
	"crates/aphrodite/src/lib.rs:244:    let floor = noise::floor(&content);",
	"crates/aphrodite/src/config.rs:63:    noise_floor: f32,",
	"crates/aphrodite/src/config.rs:118:        noise_floor: 0.42,",
	"crates/aphrodite/src/config.rs:204:        out.noise_floor = self.noise_floor.max(0.0);",
	"crates/aphrodite/src/config.rs:211:        out.noise_floor = out.noise_floor.min(1.0);",
	"crates/aphrodite/src/proxy.rs:412:        let noise = crate::noise::estimate(&body);",
	"crates/aphrodite/src/proxy.rs:418:        if noise >= cfg.noise_floor {",
	"crates/aphrodite/src/proxy.rs:701:    // the noise estimate never gates a retrieve",
	"crates/aphrodite/src/proxy.rs:1188:        noise::estimate(&buffered)",
	"crates/aphrodite/src/home.rs:96:    let noise = content.len() as f32 / tokens as f32;",
	"crates/aphrodite/src/home.rs:97:    floor: noise.floor() as usize,",
	"crates/aphrodite/src/preview/builders/build.rs:29:    // a word containing noise can never inflate the tally",
	"crates/aphrodite/src/preview/builders/generic.rs:44:    let noise = inp.bytes.saturating_sub(inp.raw.trim_end().len());",
	"crates/aphrodite/src/preview/state.rs:31:    pub(crate) noise_budget: f32,",
	"crates/aphrodite/src/preview/state.rs:77:    noise_budget: 0.42,",
];

/** `ls -F` of the preview module: directories carry the trailing slash. */
const Listings = [
	"builders/",
	"detect.rs",
	"detectors/",
	"input.rs",
	"lang.rs",
	"line/",
	"mod.rs",
	"state.rs",
	"tests.rs",
	"text/",
	"type.rs",
];

/** `cargo test --lib`: a tick per test, one failure, then the summary. */
const TestRuns = [
	"    Finished `test` profile [unoptimized + debuginfo] target(s) in 0.11s",
	"     Running unittests src/lib.rs (target/debug/deps/aphrodite-9f3c1a2b7d4e5f60)",
	"",
	"running 21 tests",
	"test preview::build_tally_counts_error_lines ... ok",
	"test preview::build_tally_counts_warning_lines ... ok",
	"test preview::grep_hits_and_files ... ok",
	"test preview::ls_counts_entries ... ok",
	"test preview::json_keys_and_items ... ok",
	"test preview::detect_type_build ... ok",
	"test preview::cap_applies_to_every_arm ... ok",
	"test classify::simd_byte_stable ... ok",
	"test classify::byte_classes ... ok",
	"test markers::roundtrip_compress_retrieve ... ok",
	"test markers::retrieve_unknown_hash_is_none ... ok",
	"test session::registry_is_per_session ... ok",
	"test session::bounded_try_lock_degrades ... ok",
	"test store::blake3_is_stable ... ok",
	"test store::dual_tier_evicts_oldest ... ok",
	"test config::defaults_carry_two_proxies ... ok",
	"test config::reload_from_disk ... ok",
	"test hooks::transform_terminal_output_overrides_type ... ok",
	"test proxy::test_build_preview_code_has_ct_prefix ... ok",
	"test proxy::test_build_preview_json_has_ct_prefix ... ok",
	"test preview::build_tally_counts_errors ... FAILED",
	"",
	"failures:",
	"",
	"---- preview::build_tally_counts_errors stdout ----",
	"",
	"thread 'preview::build_tally_counts_errors' panicked at crates/aphrodite/src/preview/builders/build.rs:30:5:",
	"assertion `left == right` failed",
	"  left: 1",
	" right: 2",
	"",
	"failures:",
	"    preview::build_tally_counts_errors",
	"",
	"test result: FAILED. 20 passed; 1 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.31s",
];

/**
 * A pretty-printed session listing. It does not parse until its closing bracket
 * arrives, so the preview runs the engine's crude `~Nitems` fallback first and
 * only reaches the real `keys:` arm on the last line.
 */
const JsonBody = [
	"[",
	'  {"id": "sess_4f2a", "type": "build", "tokens_in": 48213, "tokens_out": 46, "ratio": 1048.1, "stored": true, "tier": "hot", "hits": 3, "age_s": 12, "sha": "a1b2c3d4", "hash": "9e8f7a6b", "model": "deepseek-v4", "session": "4f2a"},',
	'  {"id": "sess_9b71", "type": "grep", "tokens_in": 3118, "tokens_out": 29, "ratio": 107.5, "stored": true, "tier": "hot", "hits": 11, "age_s": 41, "sha": "7e1f90ab", "hash": "2c6d8e10", "model": "deepseek-v4", "session": "9b71"},',
	'  {"id": "sess_2c08", "type": "ls", "tokens_in": 1042, "tokens_out": 18, "ratio": 57.9, "stored": true, "tier": "warm", "hits": 4, "age_s": 96, "sha": "3c4d5e6f", "hash": "80b1a2c3", "model": "deepseek-v4", "session": "2c08"},',
	'  {"id": "sess_e5d3", "type": "test", "tokens_in": 8821, "tokens_out": 34, "ratio": 259.4, "stored": true, "tier": "hot", "hits": 7, "age_s": 8, "sha": "b8a9c0d1", "hash": "4f5e6d7c", "model": "deepseek-v4", "session": "e5d3"},',
	'  {"id": "sess_71fa", "type": "json", "tokens_in": 2604, "tokens_out": 41, "ratio": 63.5, "stored": true, "tier": "warm", "hits": 2, "age_s": 187, "sha": "5f6e7d8c", "hash": "d9c8b7a6", "model": "deepseek-v4", "session": "71fa"},',
	'  {"id": "sess_0a4e", "type": "diff", "tokens_in": 12760, "tokens_out": 58, "ratio": 220.0, "stored": true, "tier": "warm", "hits": 5, "age_s": 240, "sha": "6b7c8d9e", "hash": "1a2b3c4d", "model": "deepseek-v4", "session": "0a4e"},',
	'  {"id": "sess_c3b9", "type": "html", "tokens_in": 21455, "tokens_out": 52, "ratio": 412.6, "stored": true, "tier": "cold", "hits": 1, "age_s": 611, "sha": "8e9fa0b1", "hash": "5c6d7e8f", "model": "deepseek-v4", "session": "c3b9"},',
	'  {"id": "sess_6f2d", "type": "log", "tokens_in": 5310, "tokens_out": 37, "ratio": 143.5, "stored": true, "tier": "hot", "hits": 9, "age_s": 3, "sha": "0d1e2f3a", "hash": "b4a59687", "model": "deepseek-v4", "session": "6f2d"}',
	"]",
];

/**
 * The cycle. Each command carries its own rhythm, because the pace is part of
 * the characterisation: a build stalls and bursts, a search arrives flat and
 * fast, a test run ticks, a JSON body lands in chunky beats.
 */
const Cycle: RunScript[] = [
	{
		Type: "build",
		Command: "cargo build --release -p aphrodite",
		Hash: "a1b2c3d4",
		Hold: 3400,
		Lines: [...Dependencies, ...Workspace].map(Compile).concat(BuildTail),
		Pace: { Beat: 26, Jitter: 18, Every: 11, Stall: 240, Turn: 420 },
	},
	{
		Type: "grep",
		Command: 'rg -n "noise" crates/aphrodite/src',
		Hash: "7e1f90ab",
		Hold: 2600,
		Lines: GrepHits,
		Pace: { Beat: 34, Jitter: 22, Every: 0, Stall: 0, Turn: 0 },
	},
	{
		Type: "ls",
		Command: "ls -F crates/aphrodite/src/preview",
		Hash: "3c4d5e6f",
		Hold: 2400,
		Lines: Listings,
		Pace: { Beat: 40, Jitter: 20, Every: 0, Stall: 0, Turn: 0 },
	},
	{
		Type: "test",
		Command: "cargo test -p aphrodite --lib",
		Hash: "b8a9c0d1",
		Hold: 3200,
		Lines: TestRuns,
		Pace: { Beat: 74, Jitter: 12, Every: 9, Stall: 160, Turn: 180 },
	},
	{
		Type: "json",
		Command: "curl -sS localhost:9797/session",
		Hash: "5f6e7d8c",
		Hold: 2800,
		Lines: JsonBody,
		Pace: { Beat: 110, Jitter: 45, Every: 3, Stall: 220, Turn: 0 },
	},
];
---

<Base
	Title="APHRODITE // CCR COMPRESSION ENGINE"
	Description={`Context management for tool-using AI agents. Aphrodite turns verbose tool output - logs, diffs, files, searches, JSON, and browser snapshots - into compact, retrievable previews. Up to ${Benchmark.Ceiling} compression on the standard corpus (${Benchmark.Overall} overall), ${Benchmark.LatencyHeadline} end-to-end.`}
>
	<PageShell Rhythm="hero">
		<!-- HERO SLAB -->
		<!-- SHARED-SLOT NOTE: PageHeader (t_130e5ed4) is deliberately NOT used on
		     this page. PageHeader renders its own <h1>; the landing's <h1> is the
		     stamped wordmark below, which is the page's identity, so a swap would
		     ship two h1s and shrink the wordmark from 144px to 48px. The lead below
		     keeps PageHeader's rhythm - one sentence, one <p>. -->
		<header
			class="relative flex w-full flex-col items-center justify-center pt-4 text-center"
			data-enter
		>
			<!-- Brand card: the red aphrodite.svg mark in the crimson module,
			     oxblood offset underlay (user instruction: the red mark everywhere) -->
			<div
				class="group relative mb-24 -rotate-[2.5deg] cursor-pointer transition-transform duration-300 hover:rotate-0"
			>
				<div
					class="pointer-events-none absolute -inset-2 translate-x-3 translate-y-3 border border-black bg-oxblood-dark opacity-80"
				>
				</div>
				<div class="zine-box-crimson relative border-4 border-blood-crimson bg-carbon-void p-5 sm:p-7">
					<div
						class="tape-strip absolute -top-3.5 left-1/2 -translate-x-1/2 -rotate-1 border-b border-t border-bone-newsprint/30 px-6 py-1 text-[13px] font-black uppercase tracking-widest text-bone-newsprint"
					>
						// REPRO_PROOF #001
					</div>
					<img
						class="h-32 w-auto sm:h-44"
						src="/Brand/aphrodite.svg"
						alt="Aphrodite brand mark"
						width="160"
						height="160"
					/>
					<div
						class="absolute -bottom-3.5 -right-3 border border-black bg-raw-blood px-2.5 py-0.5 text-base font-black tracking-widest text-bone-white shadow"
					>
						CCR CORE // STENCIL
					</div>
				</div>
			</div>
			<!-- Stamped wordmark -->
			<div class="relative flex flex-col items-center">
				<!-- The wordmark clamps at the small breakpoints: at 320px the
				     fixed 72px measures ~346px wide and clips both edges against
				     the overflow-x-hidden body; 17.5vw keeps the full name inside
				     the viewport until the fixed scale resumes above ~412px. -->
				<h1
					class="select-none font-headline text-[min(72px,17.5vw)] font-black uppercase leading-[0.85] tracking-tighter text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-[108px] lg:text-[144px]"
				>
					Aphrodite
				</h1>
				<div
					class="mb-10 mt-2 h-2 w-full max-w-xl -rotate-1 border border-black bg-raw-blood shadow-[3px_3px_0px_#000]"
				>
				</div>
			</div>
			<div
				class="mb-8 inline-block -rotate-1 border border-black bg-carbon-void px-3 py-1 text-base font-black uppercase tracking-widest text-weathered-teal shadow-[3px_3px_0px_#000]"
			>
				CONTEXT MANAGEMENT FOR TOOL-USING AI AGENTS
			</div>
			<!-- THE LEAD: one sentence states the product. The justification that
			     used to follow it here is the pair's, and reads below it. -->
			<p class="max-w-3xl font-body text-base leading-relaxed text-bone-newsprint sm:text-base">
				Aphrodite keeps noisy tool output out of your agent's context - it turns logs, diffs, files,
				searches, JSON, and browser snapshots into compact previews the agent can act on,
				with the original always one retrieval away.
			</p>
			<p class="mt-8 font-mono text-base font-bold uppercase tracking-widest text-zinc-dust">
				One binary. Zero dependencies. Millions of tokens saved.
			</p>
			<!-- Rotated stat badges: the hook, kept (plan 3.3), and each one now
			     carries its own one-line reading. A figure without its qualifier is
			     a poster; the caption is what makes it a measurement. The grid lands
			     after the lead rather than with it, and each figure climbs to its
			     value once ([data-count]) - the three exact counts, not the ~10ms
			     estimate, because a count-up on an approximation is false precision. -->
			<div
				class="mt-20 flex max-w-4xl flex-wrap items-start justify-center gap-3 sm:gap-4"
				data-enter="260"
			>
				<div class="flex flex-col items-center gap-2">
					<span
						class="-rotate-2 border-2 border-black bg-raw-blood px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[4px_4px_0px_#000] sm:text-base"
					>
						<span data-count={Benchmark.Ceiling.replace("×", "")}>{Benchmark.Ceiling.replace("×", "")}</span>&times; COMPRESSION
					</span>
					<span class="max-w-[13rem] text-base leading-relaxed text-zinc-dust">
						Best case, on large low-entropy prose.
					</span>
				</div>
				<div class="flex flex-col items-center gap-2">
					<span
						class="rotate-1 border-2 border-black bg-carbon-void px-4 py-1.5 font-mono text-base font-bold uppercase tracking-widest text-weathered-teal shadow-[4px_4px_0px_#000] sm:text-base"
					>
						<span data-count={Benchmark.Overall.replace("×", "")}>{Benchmark.Overall.replace("×", "")}</span>&times; OVERALL
					</span>
					<span class="max-w-[13rem] text-base leading-relaxed text-zinc-dust">
						The whole standard corpus: {Benchmark.CorpusIn} to {Benchmark.CorpusOut}.
					</span>
				</div>
				<div class="flex flex-col items-center gap-2">
					<span
						class="rotate-2 border-2 border-black bg-raw-blood px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[4px_4px_0px_#000] sm:text-base"
					>
						{Benchmark.LatencyHeadline.toUpperCase().replace(" ", "")} E2E OVERHEAD
					</span>
					<span class="max-w-[13rem] text-base leading-relaxed text-zinc-dust">
						Including the HTTP round-trip; the spread is {Benchmark.Latency}.
					</span>
				</div>
				<div class="flex flex-col items-center gap-2">
					<span
						class="-rotate-1 border-2 border-black bg-stamped-canary px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-soot-black shadow-[4px_4px_0px_#000] sm:text-base"
					>
						<span data-count={Study.SavedMillions.replace("M+", "")}>{Study.SavedMillions.replace("M+", "")}</span>M+ TOKENS SAVED
					</span>
					<span class="max-w-[13rem] text-base leading-relaxed text-zinc-dust">
						{Study.Sessions} real sessions, {Study.ApiCalls} API calls, {Study.Measured}.
					</span>
				</div>
			</div>
		</header>

		<!-- THE PAIR // STREAM + PREVIEW - the product's whole argument, and the
		     second thing on the page. ZineSplit owns the plate and the two panes;
		     the prose above it is the section's claim, the notes below it the one
		     caption. The section is the entrance root: it reveals on first view
		     and its plate wipes once. The left pane is a terminal that never
		     stops - five commands in a cycle, each streaming its real output on
		     its own rhythm - and the right pane is recomputed from the stream so
		     far, so the marker is never a lie about a flood that has not finished
		     arriving. `Cycle` above holds the scripts. -->
		<section class="relative w-full" data-reveal>
			<!-- The tape keeps its fitted width: ZineTape's section shape is in
			     flow without `w-fit`, and the 103 hand-rolled section stamps this
			     replaces were all fitted. -->
			<div class="w-fit">
				<ZineTape Variant="section" Label="THE PAIR // STREAM + PREVIEW" />
			</div>
			<h2 class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
				The agent spends its budget reading noise
			</h2>
			<p class="max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Every file read, build, code search, or browser open floods the agent's context
				with raw output - compilation logs, accessibility trees, JSON blobs.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				The agent spends its budget reading noise instead of reasoning.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Aphrodite intercepts output before it reaches the LLM and replaces it with a compact,
				structured preview - because the agent's reasoning budget is the context budget,
				and raw noise spends both.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				The agent sees {Narrative.PreviewTokens} of metadata instead of hundreds - and retrieves the full content
				only when it actually needs it.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				It is the reason tool-heavy agents keep working: the context window stops paying for noise
				before the reasoning starts.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
				The pane below is not a screenshot of that idea. It is a terminal that keeps running:
				a release build, then a code search, then a directory listing, then a test run, then a
				JSON body, then back to the build - indefinitely, each at the pace its own tool really
				prints at. Nothing in it is invented: every line is the output that command produces,
				and the one line on the right is recomputed from those lines as they land.
			</p>
			<div class="mt-12">
				<ZineSplit Run={Cycle} Label="ONE LINE, ONE MARKER" Id="hero-run" />
			</div>
			<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
				The marker is the address of the original bytes.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
				The agent pays for them only when the preview fails to answer the question.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
				Watch the left pane print: that is the flood arriving, one line at a time, and every
				line of it is budget. Watch the right pane while it prints - the counts climb, the
				marker's size grows, and the whole thing settles on the one line the agent would
				actually have read. A marker only means something once there is a flood behind it to
				address, which is why it is drawn from the flood and not beside it.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
				Five commands, five shapes of answer: the build counts errors, warnings and lines; the
				search counts hits and files; the listing counts entries and extensions; the test run
				counts passes and failures; the JSON body counts items and keys. That is one engine
				reading five kinds of output - the tool naming the type, and the preview rendering
				the answer that name earns.
			</p>
		</section>

		<!-- THE HOW // 4-STAGE ABSORPTION - below the pair, because the pair is
		     the argument and this is the mechanism behind it. -->
		<section class="relative w-full" data-reveal>
			<div class="w-fit">
				<ZineTape Variant="section" Label="PIPELINE // 4-STAGE ABSORPTION" />
			</div>
			<h2 class="mb-8 font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
				Four steps, one decision
			</h2>
			<p class="max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Every tool result runs the same four steps in the same order, and only one of them
				costs anything measurable.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				The first two are the engine's: name the content, then render the one line that
				describes it. The third is storage, and it is deliberately boring. The fourth is
				not the engine's at all - it is the agent's, and it is the only step that spends
				the budget the other three just saved.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-zinc-dust">
				Read the grid left to right, then top to bottom: each card is one step, the figure
				on it is what that step costs, and the line under the rule is what it decides.
			</p>
			<!-- The stage grid: 2x2 through the tablet/wide range - at 4-across
