---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";

import PageShell from "@Component/PageShell.astro";
import ZineSplit from "@Component/ZineSplit.astro";
import ZineTape from "@Component/ZineTape.astro";

import { Benchmark, Narrative, Study } from "@Library/Numbers";
import { Versions } from "@Library/Versions";

import type { RunScript } from "@Library/Motion";

// THE RUNNING TERMINAL - the product's whole argument, moving. The left pane is
// a terminal that never stops: five commands, each streaming its real output on
// its own rhythm, then clearing for the next. The right pane is the one line the
// engine would emit for the stream so far, recomputed on every arrival, so the
// counts climb and the marker's size grows with the bytes actually behind it.
//
// Every line is engine-shaped output, never filler:
//
//   build  The real dependency order of `cargo build --release -p aphrodite`,
//          captured from `cargo tree -p aphrodite` in Module/Aphrodite - names
//          and versions verbatim - then the rustc warning and error blocks a
//          build of that crate really prints, in the order rustc prints them.
//   grep   `rg -n` hits: `path:line:text`, which is exactly the shape the
//          engine's grep arm reads.
//   ls     `ls -F`: entries, with a trailing `/` on the directories.
//   test   `cargo test --lib`: a tick per test, then the failure block, then
//          the summary line the engine tallies from.
//   json   a pretty-printed array of session records - unparseable until its
//          last line arrives, which is what makes the crude `~Nitems` fallback
//          honest rather than staged.
//
// The settled build frame must equal what `build_preview` emits for that exact
// stream. ZineSplit renders it with RunPreview/RunMarker - the same functions
// the runtime calls - so the frame a reader without JavaScript sees and the
// frame the animation lands on can never drift apart.

/**
 * The release build's dependency order, as `cargo tree -p aphrodite` resolves
 * it. `name version`, one per line, so the list reads like the lockfile it is
 * and the terminal line above it is derived rather than retyped.
 */
const Dependencies = `
cfg-if 1.0.5
libc 0.2.191
memchr 2.8.3
proc-macro2 1.0.107
unicode-ident 1.0.27
quote 1.0.47
syn 3.0.10
serde_core 1.0.229
serde_derive 1.0.229
serde 1.0.229
itoa 1.0.19
ryu 1.0.23
zmij 1.0.23
serde_json 1.0.154
thiserror-impl 2.0.21
thiserror 2.0.21
aho-corasick 1.1.5
regex-syntax 0.8.11
regex-automata 0.4.18
regex 1.13.1
arrayvec 0.7.8
constant_time_eq 0.4.2
blake3 1.8.7
bytes 1.12.1
pin-project-lite 0.2.17
once_cell 1.21.4
futures-core 0.3.34
futures-task 0.3.34
futures-sink 0.3.34
futures-channel 0.3.34
futures-io 0.3.34
slab 0.4.12
futures-util 0.3.34
futures-executor 0.3.34
futures 0.3.34
tracing-core 0.1.36
tracing-attributes 0.1.31
tracing 0.1.44
log 0.4.35
