						<div class="mt-4 font-mono text-sub font-bold tracking-tight text-bone-white">
							aphrodite_retrieve
						</div>
						<div class="stage-rule mt-4 border-t pt-3">
							<p class="type-body text-bone-newsprint">Full content only when needed.</p>
							<p class="type-meta mt-2 stage-ink">ON DEMAND</p>
						</div>
					</div>
