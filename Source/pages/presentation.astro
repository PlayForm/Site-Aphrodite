---
// presentation.astro - the 64-second browser deck for aphrodite.playform.cloud.
//
// The route renders every beat at build time (the deck is readable and
// inspectable without JavaScript) and hands the clock to Presentation/Player.ts.
//
// The deck is a film AND a document. Every beat is addressable at its
// Identifier (`/presentation/#classify`), the transport steps and scrubs
// between beats instead of only watching them, and the exit link always names
// the page that carries the current beat's argument - so the brief funnels
// into the docs instead of looping back on itself.
//
// The frame is a fixed 16:9 box, so a recording of any window carries the same
// composition; the transport retracts during playback and the progress hairline
// stays. Without JavaScript the transport reduces to the exit link (the noscript
// rule below hides the controls the player would drive) and the frame to beat
// 01, which is the only scene not marked aria-hidden at build time.
//
// Each scene is wrapped in an anchor so the fragment has a real target in the
// document. The wrapper is display:contents - it carries the id and generates
// no box, so the scene keeps positioning against .deck-frame exactly as before.
//
// The transport's BEATS disclosure is the deck's index, and it is a MATRIX: one
// numbered cell per scene, three to a row, carrying the ordinal and the beat's
// own span on its top line, the scene's claim in the middle, and the page that
// carries the argument named at the foot. The cells are the same anchors the
// player seeks on (data-beat), so the index navigates the film rather than
// describing it; the arrangement is the page's own, in the deck's container
// units, and the film itself is untouched.
//
// The route already has its <h1>: DeckScene renders the opening beat's title as
// one (DeckScene.astro:213). A second, sr-only heading here would give the page
// two <h1>s, which is a worse defect than the one it would fix.

import Base from "@Layout/Base.astro";

import DeckScene from "@Component/DeckScene.astro";

import { Scenes } from "../Presentation/Scenes.ts";
import { Timeline } from "../Presentation/Timeline.ts";

import "@Stylesheet/Deck.css";

const Total = Scenes.length;

// The static clock reads the same total the player seeks against, so the
// no-JavaScript frame is not a wrong number.
const Span = `${String(Math.floor(Timeline.Total / 60)).padStart(2, "0")}:${(Timeline.Total % 60).toFixed(1).padStart(4, "0")}`;

// The scrubber counts tenths of a second - the resolution the clock prints.
const ScrubMax = Math.round(Timeline.Total * 10);

// The build-time state of the transport: beat 01's exit, and beat 01's ordinal.
const Opening = Scenes[0]?.Exit ?? { Href: "/", Label: "OVERVIEW" };
---

<Base
	Title="PRESENTATION // APHRODITE"
	Description="A 64-second browser presentation of what Aphrodite does between a tool printing and the model reading: the default raw log, the split between what the user keeps and what the agent reads, and the four steps - classify, preview, store, decide - behind Aphrodite's Hermes plugin. Every beat links to the page that explains it in full."
>
	<main class="deck" data-deck data-ui="hidden">
		<div class="deck-frame" data-frame>
			{Scenes.map((Scene, Index) => (
				<div class="deck-beat" id={Scene.Identifier}>
					<DeckScene Scene={Scene} Index={Index} Total={Total} />
				</div>
			))}

			<div class="deck-progress" aria-hidden="true">
				<div class="deck-progress-fill" data-progress-fill></div>
				{Timeline.Starts.map((Start, Index) =>
					Index === 0 ? null : (
						<span
							class="deck-progress-tick"
							style={`left:${((Start / Timeline.Total) * 100).toFixed(3)}%`}
						/>
					),
				)}
			</div>

			<p class="sr-only" role="status" data-live></p>

			<div class="deck-ui" data-control>
				<details class="deck-beats" data-beats data-control data-js-only>
					<summary class="deck-ui-button deck-beats-summary">BEATS</summary>
					<div class="deck-beats-panel">
						<p class="deck-beats-index">
							<span class="deck-beats-index-tag">BEAT INDEX</span>
							<span class="deck-beats-index-count">
								{`${String(Total).padStart(2, "0")} SCENES // ${Span}`}
							</span>
						</p>
						<nav aria-label="Beats">
							<ol class="deck-beats-matrix">
								{Scenes.map((Scene, Index) => (
									<li class="deck-beats-cell">
										<a
											class="deck-beats-link"
											href={`#${Scene.Identifier}`}
											data-beat={Index}
											aria-current={Index === 0 ? "true" : undefined}
										>
											<span class="deck-beats-head">
												<span class="deck-beats-ordinal">
													{String(Index + 1).padStart(2, "0")}
												</span>
												<span class="deck-beats-span">
													{`${Scene.Duration.toFixed(1)}s`}
												</span>
											</span>
											<span class="deck-beats-name">{Scene.Title}</span>
											<span class="deck-beats-exit">{Scene.Exit.Label}</span>
										</a>
									</li>
								))}
							</ol>
						</nav>
						<p class="deck-beats-keys">
							SPACE PLAY/PAUSE · LEFT/RIGHT BEAT · HOME/END FIRST/LAST · R RESTART · F
							FULLSCREEN · H HIDE CONTROLS
						</p>
					</div>
				</details>

				<button
					class="deck-ui-button"
					type="button"
					data-prev
					data-control
					data-js-only
					aria-label="Previous beat"
				>
					PREV
				</button>
				<button class="deck-ui-button" type="button" data-toggle data-control data-js-only>
					PLAY
				</button>
				<button
					class="deck-ui-button"
					type="button"
					data-next
					data-control
					data-js-only
					aria-label="Next beat"
				>
					NEXT
				</button>

				<span class="deck-ui-clock" data-clock>{`00:00.0 / ${Span}`}</span>
				<span class="deck-ui-status" data-status>
					PAUSED
				</span>
				<span
					class="deck-ui-beat"
					data-beat-label
				>{`01 / ${String(Total).padStart(2, "0")}`}</span>

				<input
					class="deck-scrub"
					type="range"
					min="0"
					max={ScrubMax}
					step="1"
					value="0"
					data-scrub
					data-control
					data-js-only
					aria-label="Seek through the brief"
				/>

				<a
					class="deck-ui-exit"
					data-exit
					href={Opening.Href}
					aria-label={`Read on: ${Opening.Label}`}
				>
					<span>READ ON</span>
					<span class="deck-ui-exit-label" data-exit-label>
						{Opening.Label}
					</span>
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</main>

	<noscript>
		<style>
			/* Without the player the controls are dead weight: keep the exit link,
			   which is a plain anchor and works. */
			[data-js-only] {
				display: none;
			}

			.deck[data-ui="hidden"] .deck-ui {
				opacity: 1 !important;
				pointer-events: auto !important;
			}
		</style>
	</noscript>

	<script>
		import Player from "../Presentation/Player.ts";

		Player();
	</script>

	<style>
		/* The beat anchor: it carries the fragment target and generates no box, so
		   .deck-frame stays the containing block for the absolute scenes. */
		.deck-beat {
			display: contents;
		}

		/* ---- The transport additions ---- */

		/* The beat list is a disclosure: closed by default (the film owns the
		   frame), one press away when a reader wants to jump. */
		.deck-beats {
			position: relative;
			flex: none;
		}

		.deck-beats-summary {
			list-style: none;
			display: inline-block;
		}

		.deck-beats-summary::-webkit-details-marker {
			display: none;
		}

		.deck-beats-panel {
			position: absolute;
			bottom: calc(100% + 0.8cqw);
			left: 0;
			z-index: 2;
			width: 46cqw;
			max-width: 46cqw;
			border: 2px solid var(--oxblood-dark);
			border-radius: 0;
			background: var(--carbon-void);
			box-shadow: 4px 4px 0 #000;
			padding: 1.1cqw 1.3cqw;
		}

		/* The index head is the blueprint chapter rule, in the deck's own units:
		   a hairline across the panel, the tag at its left, the count at its
		   right. Both values are the ones the film already prints - the scene
		   count the transport steps through and the span it runs for. */
		.deck-beats-index {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 1.2cqw;
			margin: 0 0 0.8cqw;
			border-bottom: 1px solid var(--oxblood-dark);
			padding-bottom: 0.55cqw;
			font-size: max(11px, calc(0.56cqw * var(--type-scale)));
			font-weight: 400;
			letter-spacing: 0.14em;
			text-transform: uppercase;
		}

		.deck-beats-index-tag {
			color: var(--weathered-teal);
			font-weight: 700;
		}

		.deck-beats-index-count {
			color: var(--zinc-dust);
			font-variant-numeric: tabular-nums;
		}

		/* The index is a MATRIX: one numbered cell per scene, three to a row.
		   The ordinal and the beat's own span sit on the cell's top line, the
		   scene's claim in the middle, and the page that carries the argument
		   named at the foot - the same anchor, the same data-beat wiring the
		   player seeks on, only the arrangement changed. */
		.deck-beats-matrix {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.5cqw;
			max-height: 58cqh;
			margin: 0;
			padding: 0;
			overflow-y: auto;
			overscroll-behavior: contain;
			list-style: none;
		}

		.deck-beats-cell {
			display: flex;
		}

		.deck-beats-link {
			display: grid;
			grid-template-rows: auto 1fr auto;
			gap: 0.35cqw;
			width: 100%;
			border: 1px solid var(--oxblood-dark);
			padding: 0.5cqw 0.7cqw 0.55cqw;
			background: var(--void-inset);
			color: var(--zinc-dust);
			font-size: calc(0.62cqw * var(--type-scale));
			letter-spacing: 0.1em;
			text-decoration: none;
			text-transform: uppercase;
			/* Deck.css makes every anchor in the deck inert for recording; a beat
			   link is the exception, and so is the exit below. */
			pointer-events: auto;
		}

		.deck-beats-head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 0.6cqw;
		}

		.deck-beats-ordinal {
			color: var(--weathered-teal);
			font-size: max(12px, calc(0.6cqw * var(--type-scale)));
			font-variant-numeric: tabular-nums;
		}

		.deck-beats-span {
			color: var(--zinc-dust);
			font-size: max(11px, calc(0.54cqw * var(--type-scale)));
			font-variant-numeric: tabular-nums;
			letter-spacing: 0.08em;
		}

		/* The scene's claim takes the deck's display voice - the same face and
		   uppercase setting the frame gives it - and the readable floor, because
		   a cell holds a whole sentence, not a label. */
		.deck-beats-name {
			color: var(--bone-newsprint);
			font-family: "Space Grotesk", sans-serif;
			font-size: max(var(--deck-floor), calc(0.78cqw * var(--type-scale)));
			font-weight: 700;
			letter-spacing: -0.01em;
			line-height: 1.1;
			overflow-wrap: break-word;
		}

		.deck-beats-exit {
			color: var(--stamped-canary);
			font-size: max(11px, calc(0.54cqw * var(--type-scale)));
			letter-spacing: 0.16em;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.deck-beats-link:hover,
		.deck-beats-link:focus-visible {
			border-color: var(--raw-blood);
			background: rgba(147, 17, 40, 0.18);
		}

		.deck-beats-link:hover .deck-beats-name,
		.deck-beats-link:focus-visible .deck-beats-name {
			color: var(--bone-white);
		}

		.deck-beats-link:focus-visible {
			outline: 2px solid var(--stamped-canary);
			outline-offset: 1px;
		}

		/* The beat being played keeps its identity in the matrix: the crimson
		   edge moves inside the cell, so the current scene reads as the same
		   stamp it wears in the frame. */
		.deck-beats-link[aria-current="true"] {
			border-color: var(--raw-blood);
			box-shadow: inset 3px 0 0 var(--raw-blood);
		}

		.deck-beats-link[aria-current="true"] .deck-beats-name {
			color: var(--bone-white);
		}

		.deck-beats-keys {
			margin: 0.9cqw 0 0;
			border-top: 1px solid var(--oxblood-dark);
			padding-top: 0.7cqw;
			color: var(--zinc-dust);
			font-size: calc(0.58cqw * var(--type-scale));
			font-weight: 400;
			letter-spacing: 0.08em;
		}

		/* The scrubber takes the room the old spacer held: one row, always. */
		.deck-scrub {
			flex: 1 1 8cqw;
			min-width: 6cqw;
			height: 1.1cqw;
			margin: 0;
			accent-color: var(--raw-blood);
			background: transparent;
			cursor: pointer;
		}

		.deck-scrub:focus-visible {
			outline: 2px solid var(--stamped-canary);
			outline-offset: 2px;
		}

		.deck-ui-beat {
			color: var(--weathered-teal);
			font-variant-numeric: tabular-nums;
			white-space: nowrap;
		}

		/* The exit is the deck's funnel: the one control that leaves the film. */
		.deck-ui-exit {
			display: inline-flex;
			gap: 0.6cqw;
			align-items: baseline;
			border: 1px solid var(--oxblood-dark);
			border-radius: 0;
			background: var(--raw-blood);
			padding: 0.38cqw 0.9cqw;
			color: var(--bone-white);
			letter-spacing: 0.16em;
			text-decoration: none;
			white-space: nowrap;
			pointer-events: auto;
		}

		.deck-ui-exit:hover,
		.deck-ui-exit:focus-visible {
			background: var(--bone-white);
			color: var(--soot-black);
		}

		.deck-ui-exit:focus-visible {
			outline: 2px solid var(--stamped-canary);
			outline-offset: 2px;
		}

		.deck-ui-exit-label {
			color: var(--stamped-canary);
		}

		.deck-ui-exit:hover .deck-ui-exit-label,
		.deck-ui-exit:focus-visible .deck-ui-exit-label {
			color: var(--raw-blood);
		}

		/* The column layout's transport: these rules are scoped to this page, so
		   the narrow-viewport overrides for the scrubber and the beat list live
		   here, reading the same label step Deck.css declares. */
		@media (max-width: 1023px) {
			.deck-beats-panel {
				width: min(22rem, calc(100vw - 2rem));
				max-width: min(22rem, calc(100vw - 2rem));
			}

			/* One column on a phone: three 7rem cells are not a matrix, they are
			   a grid of unreadable columns. */
			.deck-beats-matrix {
				grid-template-columns: 1fr;
			}

			.deck-beats-index {
				font-size: calc(var(--deck-floor-label) - 1px);
			}

			/* A beat cell wraps in the column layout instead of running off the
			   panel, and the row gets a thumb's height. */
			.deck-beats-link {
				padding: 0.5rem 0.65rem;
			}

			.deck-beats-span,
			.deck-beats-exit {
				font-size: var(--deck-floor-label);
			}

			.deck-beats-keys {
				font-size: calc(var(--deck-floor-label) - 1px);
			}

			/* A 4px-tall scrubber is not a control: give it a thumb's height. */
			.deck-scrub {
				flex: 1 1 100%;
				min-width: 0;
				height: 1.75rem;
			}

			.deck-ui-exit {
				padding: 0.4rem 0.7rem;
			}
		}
	</style>
</Base>
