---
import Base from "@Layout/Base.astro";
import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import SectionNav from "@Component/SectionNav.astro";
import ZineTape from "@Component/ZineTape.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineFlow from "@Component/ZineFlow.astro";
import ZineToggle from "@Component/ZineToggle.astro";
import Related from "@Component/Related.astro";
import ExampleCase from "@Component/ExampleCase.astro";
import { Link, OurRepo } from "@Library/Links";
import type { ExampleOutputLine, ExampleRecord } from "@Library/Records";
import Examples from "../Content/Showcase/Examples.json";

// ---- The bank, typed at the annotation (the Astro compiler's frontmatter
// parser accepts object-literal types in annotation position but not inside
// `as` casts - probe-verified). ----
const Bank: {
	defaults: Record<string, number | string>;
	examples: {
		id: string;
		title: string;
		category: string;
		corpus: boolean;
		raw: string | null;
		preview: string | null;
		marker: string | null;
		retrieval: {
			tool: string;
			args: { hash: string };
			returns: { found: boolean; source: string; hash: string; content: string };
		} | null;
		note: string;
	}[];
} = Examples;

// ---- The section label is now ZineTape's `section` variant (the site's one
// tape shape). The traversals keep the canary accent through its `Color` prop,
// so the page no longer carries a second class string that can drift. ----

// ---- The gallery: ONE array of ONE record shape. Every entry below supplies
// every field `ExampleCase` renders, so adding or removing an example is a
// change to the bank (Source/Content/Showcase/Examples.json) and never a
// change to this file. ----

// The three record fields that carry markup (`Claim`, `Output`, `Marker`) are
// rendered through `set:html`, so a `<` in a compiler's own output has to be
// escaped or the browser reads it as a tag. The ampersand goes first: escaping
// it last would rewrite the entities the other two replacements produce.
function Escape(Text: string): string {
	return Text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
}

// One sentence per block: the PROSE BREAKDOWN applied to a bank note. The
// lookahead keeps "e.g. before ..." whole - a break needs a new subject after
// the period, not merely a period.
function Sentences(Note: string): string[] {
	return Note.split(/(?<=[.!?])\s+(?=[A-Z(`"\u2014-])/)
		.map((Sentence) => Sentence.trim())
		.filter(Boolean);
}

// The bank's raw stream, one line per entry, in the suppression fade law 4
// describes: the context keeper brightest, failures canary, the tail dimmed.
function OutputLines(Raw: string | null): ExampleOutputLine[] {
	if (!Raw) {
		return [{ Text: "(no raw stream - the block is generated, not captured)", Tone: "dim" }];
	}
	const Lines = Raw.split("\n");
	return Lines.map((Text, Index) => ({
		Text: Escape(Text) || "&nbsp;",
		Tone: /error|fail|warn|panic|traceback/i.test(Text)
			? "canary"
			: Index === 0
				? "result"
				: Index === Lines.length - 1
					? "dim"
					: "fade",
	}));
}

// The CCR marker contract, taken from the bank's own marker string instead of
// rebuilt from parsed parts: <<<CCR:hash|type|size>>>.
function MarkerLine(Marker: string | null): string {
	const Match = Marker?.match(/<<<CCR:[^>]+>>>/);
	return Match ? Escape(Match[0]) : "(stays raw - no marker stored)";
}

// The round-trip is the entry's command: the call the agent made. What the call
// answers is invariant across all twenty entries, so the answer - and the
// store's read rules - are stated once on the page, under the gallery heading,
// instead of repeated inside every entry.
function CommandCode(Retrieval: { tool: string; args: { hash: string } } | null): string {
	if (!Retrieval) {
		return "(stays raw - no retrieval call)";
	}
	return `${Retrieval.tool}(hash: "${Retrieval.args.hash}")`;
}

// The scenario number the tape carries, computed from the entry's position so
// the bank can grow past twenty without a table to edit.
function Roman(Value: number): string {
	const Numerals: [number, string][] = [
		[10, "X"],
		[9, "IX"],
		[5, "V"],
		[4, "IV"],
		[1, "I"],
	];
	let Left = Value;
	let Out = "";
	for (const [Amount, Numeral] of Numerals) {
		while (Left >= Amount) {
			Out += Numeral;
			Left -= Amount;
		}
	}
	return Out;
}

const Cases: ExampleRecord[] = Bank.examples.map(
	(Example, Index): ExampleRecord => ({
		Id: Example.id,
		N: Roman(Index + 1),
		Label: Example.category.toUpperCase(),
		Title: Example.title,
		Tone: Example.corpus ? "teal" : "crimson",
		Rotate: Index % 2 === 0 ? "rotate-[0.5deg]" : "-rotate-[0.5deg]",
		Claim: Sentences(Example.note).map(Escape),
		Command: { Lang: "text", Code: CommandCode(Example.retrieval) },
		Output: OutputLines(Example.raw),
		Preview: Example.preview ?? "(stays raw - no preview line)",
		Marker: MarkerLine(Example.marker),
		Src: `SRC: Source/Content/Showcase/Examples.json · ${Example.id}`,
	}),
);

// The category registry for the filter bar, in first-appearance order, read off
// the records the gallery renders so the buttons cannot list a category no
// entry carries.
const Categories = [...new Set(Cases.map((Scenario) => Scenario.Label.toLowerCase()))];
---

<Base
	Title="SHOWCASE // APHRODITE"
	Description="The plugin in action: 20 anonymized worked examples - build, test, terminal, code, grep, git, diff, json, error, log, the tool relay, the directives, the chain split, and the threshold tiers - each showing the raw stream, the enriched preview, the retrieval round-trip and the threshold decision."
>
	<!-- The four slots the rest of the site renders: shell, header, sections,
	     one Related. The gallery inside them is unchanged - one Cases array,
	     one ExampleCase render site. -->
	<PageShell Rhythm="wide" Crumbs>
		<PageHeader
			Tape="SHOWCASE // THE PLUGIN IN ACTION"
			Title="The plugin, worked"
			Lead={[
				"Every example below is a real behavior of the pipeline dressed in generic content: what the agent sends (the raw stream), what it sees back (the enriched preview), how the bytes come home (the retrieval round-trip), and why the thresholds made that decision.",
				"All previews marked as corpus lines are byte-identical to the docs catalog; the rest are faithful fragments.",
				"That catalog is the enriched-preview table in docs/proxy/compression.md together with the preview-form table in the repository README - both are public, so every corpus line on this page can be checked against them, character for character.",
				"Anonymized throughout - no names, no secrets, no real sessions.",
			]}
		/>

		<SectionNav
			Sections={[
				{ Id: "defaults", Label: "DEFAULTS" },
				{ Id: "registry", Label: "REGISTRY" },
				{ Id: "examples", Label: "EXAMPLES" },
				{ Id: "traversals", Label: "TRAVERSALS" },
				{ Id: "deeper", Label: "GO DEEPER" },
			]}
		/>

		<!-- THE DEFAULTS IN PLAY -->
		<section id="defaults" class="relative w-full scroll-mt-24">
			<ZineTape Variant="section" Label="THE DEFAULTS // APHRODITE.TOML" />
			<ZineBox Tone="crimson" Rotate="rotate-[0.8deg]">
				<p class="font-mono text-base leading-loose text-bone-newsprint">
					{Object.entries(Bank.defaults).map(([Key, Value]) => (
						<span class="mr-6 inline-block whitespace-nowrap">
							<span class="text-zinc-dust">{Key}</span>
							<span class="text-weathered-teal"> = {String(Value)}</span>
						</span>
					))}
				</p>
				<p class="mt-6 border-t border-oxblood-dark pt-4 font-body text-base leading-relaxed text-bone-newsprint">
					These seven numbers decide every example below.
				</p>
				<p class="mt-3 font-body text-base leading-relaxed text-bone-newsprint">
					It is the reason compression is never a judgment call: it is a byte count against
					the surface's threshold, and the essential tools plus the
					<code class="font-mono text-base text-weathered-teal">aphrodite_*</code>
					tools themselves are always raw regardless of size.
				</p>
			</ZineBox>
		</section>

		<!-- FILTER BAR -->
		<section id="registry" class="relative w-full scroll-mt-24" data-registry>
			<ZineTape Variant="section" Label="THE REGISTRY // FILTER BY CATEGORY, SEARCH BY KEYWORD" />
			<ZineBox Tone="crimson" Rotate="-rotate-[0.6deg]">
				<div class="flex flex-wrap items-center gap-2" data-filters>
					<button
						type="button"
						data-filter="*"
						class="border-2 border-black bg-raw-blood px-3 py-1 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
					>
						ALL · {Bank.examples.length}
					</button>
					{Categories.map((Category) => (
						<button
							type="button"
							data-filter={Category}
							class="border-2 border-black bg-soot-black px-3 py-1 font-mono text-base font-bold uppercase tracking-widest text-zinc-dust shadow-[2px_2px_0px_#000] transition-colors hover:text-bone-white"
						>
							{Category}
						</button>
					))}
				</div>
				<input
					type="search"
					placeholder="SEARCH THE EXAMPLES..."
					aria-label="Search the examples"
					data-search
					class="mt-5 w-full border-2 border-oxblood-dark bg-soot-black px-4 py-2 font-mono text-base tracking-widest text-bone-white placeholder:text-zinc-dust focus:border-weathered-teal focus:outline-none"
				/>
				<p class="mt-4 font-mono text-base tracking-widest text-zinc-dust" data-count>
					SHOWING {Bank.examples.length} OF {Bank.examples.length}
				</p>
			</ZineBox>
		</section>

		<!-- THE EXAMPLES // ONE SHAPE EACH -->
		<section id="examples" class="relative flex w-full scroll-mt-24 flex-col" data-examples>
			<div class="w-full">
				<ZineTape Variant="section" Label="THE EXAMPLES // ONE SHAPE EACH" />
				<h2 class="font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
					{Bank.examples.length} worked examples
				</h2>
				<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					A teal tape marks a corpus-exact preview; a blood-red one marks a faithful
					fragment.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Every retrieval answers the same way:
				</p>
				<p class="mt-3 max-w-3xl font-mono text-base leading-relaxed text-bone-newsprint">
					→ {'{ found: true, source: "ccr", content: the original bytes, byte-for-byte }'}
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Reads are workspace-confined and capped at 10 MiB; a hash resolves
					only by exact match - truncated hashes never resolve.
				</p>
			</div>
			<div class="mt-24 flex w-full flex-col gap-28 lg:gap-36">
				{
					Cases.map((Scenario, Index) => (
						<div
							data-example
							data-category={Scenario.Label.toLowerCase()}
							data-search={`${Scenario.Title} ${Scenario.Label} ${Scenario.Preview} ${Scenario.Claim.join(" ")}`.toLowerCase()}
							class={`w-full lg:w-11/12 ${Index % 2 === 0 ? "lg:self-start" : "lg:self-end"}`}
						>
							<ExampleCase {...Scenario} />
						</div>
					))
				}
			</div>
		</section>

		<!-- THE TRAVERSALS: the interactive flows, agent view vs system path -->
		<section id="traversals" class="relative flex w-full scroll-mt-24 flex-col gap-28 lg:gap-36">
			<div class="w-full">
				<ZineTape Variant="section" Color="canary" Label="THE TRAVERSALS // AGENT-VIEW vs SYSTEM-PATH, STEP BY STEP" />
				<h2 class="font-headline text-lg font-black uppercase text-bone-white sm:text-xl">
					The traversals
				</h2>
				<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The five pipelines above are worked examples; these are the pipes they run
					through.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Each traversal steps through its hook or endpoint with two synchronized panes -
					what the agent sees, what the system does - and every step carries its source
					anchor.
				</p>
				<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					Press PLAY to watch one run.
				</p>
			</div>

			<!-- Traversal A: tool-output compression -->
			<div class="w-full lg:w-11/12 lg:self-start">
				<ZineFlow
					Title="TRAVERSAL A // TRANSFORM_TOOL_RESULT"
					Complete="COMPRESSED · RETRIEVABLE"
					Steps={[
						{
							Title: "THE RESULT ARRIVES",
							Agent: [
								"user: build it and show me what's wrong",
								"» tool result: 48,213 characters arrive raw in the transcript",
								"· at this point the agent sees the full bytes, nothing special",
							],
							System: [
								"telemetry first: status, error type/message, arguments and duration recorded into the tool-event ring (feeds the error-loop and phase detectors)",
								"empty results are skipped here",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:69-75",
						},
						{
							Title: "FILE REFERENCES TRACKED",
							Agent: "nothing changes yet - the output is untouched",
							System: [
								"read_file and search_files results are recorded for aphrodite_files and the recall catalog BEFORE the skip gates",
								"· they feed the catalog even when never compressed",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:92-94",
						},
						{
							Title: "THE SKIP GATES",
							Agent: [
								"essential tools stay raw:",
								"skill_view, skills_list, skill_manage, memory,",
								"session_search, read_file, read_terminal",
							],
							System: [
								"gates in order: empty result; essential set; Aphrodite's own tools and headroom helpers (compressing aphrodite_retrieve would replace resolved content with another marker)",
								"· below the tool threshold (default 4,096 chars; 0 disables the gate)",
								"· raw stays raw when it matters",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:76-84",
						},
						{
							Title: "CLASSIFY",
							Agent: [
								"the output now has a name - and the name decides everything downstream",
								"» [build:1E 1W 142L | error[E0432]: unresolved import ...]",
							],
							System: [
								"the content-type detector assigns a type; generic text/log/plain results get a semantic upgrade (git status, ls, test, grep) so the preview carries high-signal shape",
								"· preview shapes: the enriched preview catalog, docs/proxy/compression.md:228-241",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:85-88",
						},
						{
							Title: "THRESHOLD + EMA",
							Agent: "invisible - the agent never tunes this by hand",
							System: [
								"the per-type threshold (EMA auto-tuned by what past turns saved) decides compress vs. pass-through",
								"· env overrides TOML overrides the default",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:139-146",
						},
						{
							Title: "STORE",
							Agent: "still just the output - but the receipt is being written",
							System: [
								"the content is hashed (BLAKE3) and stored in the inline session store",
								"→ durable backend: SQLite at ~/.hermes/aphrodite/ccr.db (docs/install/macos-linux.md:129)",
								"the marker's hash is the address of the original bytes, taken over the ORIGINAL, never a wrapper's extracted view (the v1.3.2 losslessness law)",
							],
							Anchor: Link(OurRepo, "CHANGELOG.md"),
							AnchorLabel: "CHANGELOG v1.3.2",
						},
						{
							Title: "THE SWAP",
							Agent: [
								"the tool output is now a preview line plus a marker - roughly fifteen tokens",
								"» [build:1E 1W 142L | error[E0432]: unresolved import ...]",
								"» <<<CCR:abc123|build_error|67097>>>",
								"· the 48,213 characters are gone from the transcript - retrievable by hash",
							],
							System: [
								"Hermes swaps the tool output for the marker; the transcript carries hash, type, size instead of the bytes",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:89-91",
						},
						{
							Title: "DECIDE / RETRIEVE",
							Agent: [
								"the agent - not the engine - spends the budget: call aphrodite_retrieve only if the preview did not answer the question",
								"» aphrodite_retrieve(hash: \"abc123...\")",
								"→ { found: true, source: \"ccr\", content: the original bytes, truncated: false }",
							],
							System: [
								"retrieval returns the exact original bytes, byte-exact by construction; the loop closes with nothing lost",
								"→ no zstd on this path; backends store and return content verbatim as UTF-8 strings, so a trailing newline survives (retrieve.md:184-212)",
							],
							Anchor: Link(OurRepo, "docs/api/retrieve.md"),
							AnchorLabel: "retrieve.md",
						},
					]}
				/>
			</div>

			<!-- Traversal B: terminal transform -->
			<div class="w-full lg:w-10/12 lg:self-end">
				<ZineFlow
					Title="TRAVERSAL B // TRANSFORM_TERMINAL_OUTPUT"
					Complete="TERMINAL HANDLED"
					Steps={[
						{
							Title: "THE OUTPUT ARRIVES",
							Agent: [
								"user: run the tests again",
								"» the terminal's stdout and its exit code arrive as one blob",
								"· short output would stay right here, verbatim",
							],
							System: [
								"telemetry: the command and return code are recorded; a non-zero exit code marks the event as a failure and feeds the error-loop detector",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:98-101",
						},
						{
							Title: "CHAIN SPLIT FIRST",
							Agent: [
								"if pre_tool_call marked the segments, each one is about to get its own receipt",
								"» cd x && cargo build && cargo test → three compact previews, not one blob",
							],
							System: [
								"when chain splitting is enabled and the output carries the segment markers, each segment is compressed into its own marker - unconditional, BEFORE the threshold gate, so marked output never leaks raw. Per-segment error hints merge into previews",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:102-106",
						},
						{
							Title: "THE THRESHOLD GATE",
							Agent: "short output stays exactly as it was",
							System: [
								"unmarked output below the terminal threshold (default 1,024 characters; 0 disables the gate) passes through untouched",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:107-108",
						},
						{
							Title: "CLASSIFY",
							Agent: [
								"a failed run is named terminal - the type keeps errors visible longest",
								"» [terminal:14L exit code: 0]",
							],
							System: [
								"output containing 'exit code:' or 'Error:' is typed terminal; other output gets the normal content-type detection with the same semantic upgrade as tool results",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:109-111",
						},
						{
							Title: "STORE + THE NUDGE LOOP",
							Agent: [
								"next turn opens with a nudge, not a surprise",
								"→ a poll-worker status nudge for the failed task surfaces at the next pre_llm_call",
							],
							System: [
								"above-threshold content is hashed, stored (inline session store, backed by the durable ~/.hermes/aphrodite/ccr.db), and replaced by a marker",
								"the failure recorded in step 1 surfaces as a poll-worker status nudge at the next pre_llm_call",
							],
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:111-112,114-121",
						},
					]}
				/>
			</div>

			<!-- Traversal C: retrieval round-trip -->
			<div class="w-full lg:w-10/12 lg:self-start">
				<ZineFlow
					Title="TRAVERSAL C // THE RETRIEVAL ROUND-TRIP"
					Complete="BYTE-EXACT"
					Steps={[
						{
							Title: "THE CALL",
							Agent: [
								"the agent hands back the marker it kept - or just the hash",
								"» aphrodite_retrieve(hash: \"abc123...\")",
								"· truncated hashes never resolve - exact match only",
							],
							System: [
								"the hash argument is normalized before lookup: a type/size marker-body suffix and surrounding whitespace are stripped, so a hash echoed back in full marker form still resolves",
								"→ normalize_hash - strip |type|size suffix, trim (POST /retrieve with hash, query?, offset?, limit?)",
							],
							Anchor: Link(OurRepo, "docs/api/retrieve.md"),
							AnchorLabel: "retrieve.md:41-43",
						},
						{
							Title: "LOOKUP",
							Agent: [
								"one answer either way: found or not",
								"→ { found: true, source: \"ccr\", content: \"original content...\", truncated: false }",
							],
							System: [
								"the inline session store is checked first (inline_ccr.get); on a miss, ccr_get on the CCR backend (SQLite/In-memory via a blocking thread)",
								"→ durable backend: SQLite at ~/.hermes/aphrodite/ccr.db (docs/install/macos-linux.md:129)",
								"the success path always reports source 'ccr' regardless of which store served the content",
							],
							Anchor: Link(OurRepo, "docs/api/retrieve.md"),
							AnchorLabel: "retrieve.md:196-212",
						},
						{
							Title: "PAGINATION",
							Agent: [
								"a window, or the whole thing",
								"→ [lines 101-200/1421] header + truncated: true",
								"limit: 0 asks for the FULL document with no cap - the round-trip contract",
							],
							System: [
								"any explicit limit, including one above 10,000, is clamped to a 10,000-line server cap; a windowed result carries a lines a-b/total header and truncated: true, so a caller can tell truncated from genuinely short",
							],
							Anchor: Link(OurRepo, "docs/api/retrieve.md"),
							AnchorLabel: "retrieve.md:184-192",
						},
						{
							Title: "BYTE-EXACT",
							Agent: [
								"the original bytes return unchanged - a trailing newline included",
								"→ the body hashes back to the marker's own hash",
							],
							System: [
								"a full-document retrieval returns the exact original bytes: the lossy lines/join round-trip is skipped entirely",
								"→ no zstd on this path: backends store and return content verbatim as UTF-8 strings, so retrieval is byte-exact by construction",
							],
							Anchor: Link(OurRepo, "docs/api/retrieve.md"),
							AnchorLabel: "retrieve.md:184-188",
						},
					]}
				/>
			</div>

			<!-- Traversal G: the proxy lane -->
			<div class="w-full lg:w-11/12 lg:self-end">
				<ZineFlow
					Title="TRAVERSAL G // THE PROXY LANE"
					Complete="COMPRESSED OR PASSED THROUGH"
					Steps={[
						{
							Title: "POST /V1/CHAT/COMPLETIONS",
							Agent: [
								"an ordinary OpenAI-compatible client - no Aphrodite plugin required",
								"» POST /v1/chat/completions (headers + body)",
								"· a cache hit answers early with X-Aphrodite-Cache: HIT",
							],
							System: [
								"the request cache is checked first (cache_key_from_body; skipped when stream is true) - a hit returns early with X-Aphrodite-Cache: HIT",
							],
							Anchor: Link(OurRepo, "docs/architecture/02-chat-compression.md"),
							AnchorLabel: "02-chat-compression.md",
						},
						{
							Title: "UPSTREAM",
