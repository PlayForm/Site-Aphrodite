---
import Base from "@Layout/Base.astro";
import ZineTape from "@Component/ZineTape.astro";
import ZinePreview from "@Component/ZinePreview.astro";
import Examples from "../Content/Showcase/Examples.json";

// ---- The bank, typed at the annotation (the Astro compiler's frontmatter
// parser accepts object-literal types in annotation position but not inside
// `as` casts - probe-verified). ----
const Bank: {
	defaults: Record<string, number | string>;
	examples: {
		id: string;
		title: string;
		category: string;
		corpus: boolean;
		raw: string | null;
		preview: string | null;
		marker: string | null;
		retrieval: {
			tool: string;
			args: { hash: string };
			returns: { found: boolean; source: string; hash: string; content: string };
		} | null;
		note: string;
	}[];
} = Examples;

// The CCR marker contract pieces, parsed from the bank's marker strings:
// <<<CCR:hash|type|size>>>.
function MarkerParts(Marker: string | null): { Hash: string; Type: string; Size: string } | null {
	if (!Marker) return null;
	const Match = Marker.match(/<<<CCR:([0-9a-f]+)\|([a-z_]+)\|(\d+)>>>/);
	return Match ? { Hash: Match[1], Type: Match[2], Size: Match[3] } : null;
}

// The enriched preview pane's teal hash line, escaped so set:html renders the
// angle brackets literally instead of parsing them.
function EscapeAngle(Text: string): string {
	return Text.replaceAll("<", "&lt;").replaceAll(">", "&gt;");
}

// The raw stream pane's line tones: the first line is the context keeper the
// preview carries forward, error/failure lines are canary highlights, and the
// rest sit at the suppression opacities - the fade the model still sees.
function RawLines(Raw: string | null): { Text: string; Tone: string }[] {
	if (!Raw) return [];
	return Raw.split("\n").map((Line, Index) => {
		const Failure = /error|fail|warn|panic|traceback/i.test(Line);
		const Tone = Failure
			? "text-stamped-canary"
			: Index === 0
				? "text-bone-newsprint"
				: Index === Raw.split("\n").length - 1
					? "opacity-70"
					: "opacity-40";
		return { Text: Line, Tone };
	});
}

// The category registry for the filter bar, in first-appearance order.
const Categories = [...new Set(Bank.examples.map((Example) => Example.category))];
---

<Base
	Title="SHOWCASE // APHRODITE"
	Description="The plugin in action: 20 anonymized worked examples - build, test, terminal, code, grep, git, diff, json, error, log, the tool relay, the directives, the chain split, and the threshold tiers - each showing the raw stream, the enriched preview, the retrieval round-trip and the threshold decision."
>
	<main
		class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-28 px-5 py-20 sm:px-8 lg:gap-44 lg:px-14 lg:py-32"
	>
		<!-- HERO -->
		<header class="relative flex w-full flex-col items-start">
			<div
				class="mb-6 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				SHOWCASE // THE PLUGIN IN ACTION
			</div>
			<h1
				class="font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-5xl"
			>
				The plugin, worked
			</h1>
			<p class="mt-6 max-w-3xl font-body text-sm leading-relaxed text-bone-newsprint">
				Every example below is a real behavior of the pipeline dressed in generic
				content: what the agent sends (the raw stream), what it sees back (the enriched
				preview), how the bytes come home (the retrieval round-trip), and why the
				thresholds made that decision. All previews marked as corpus lines are
				byte-identical to the docs catalog; the rest are faithful fragments.
				Anonymized throughout - no names, no secrets, no real sessions.
			</p>
			<div class="mt-8 flex max-w-4xl flex-wrap items-center gap-4">
				<span
					class="-rotate-2 border-2 border-black bg-raw-blood px-4 py-1.5 font-mono text-xs font-black uppercase tracking-widest text-bone-white shadow-[4px_4px_0px_#000]"
				>
					{Bank.examples.length} WORKED EXAMPLES
				</span>
				<span
					class="rotate-1 border-2 border-black bg-carbon-void px-4 py-1.5 font-mono text-xs font-bold uppercase tracking-widest text-weathered-teal shadow-[4px_4px_0px_#000]"
				>
					{Categories.length} CATEGORIES
				</span>
			</div>
		</header>

		<!-- THE DEFAULTS IN PLAY -->
		<section class="relative w-full">
			<div
				class="mb-6 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				THE DEFAULTS // APHRODITE.TOML
			</div>
			<div
				class="zine-box-crimson w-full rotate-[0.8deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<p class="font-mono text-[11px] leading-loose text-bone-newsprint">
					{Object.entries(Bank.defaults).map(([Key, Value]) => (
						<span class="mr-6 inline-block whitespace-nowrap">
							<span class="text-zinc-dust">{Key}</span>
							<span class="text-weathered-teal"> = {String(Value)}</span>
						</span>
					))}
				</p>
				<p class="mt-6 border-t border-oxblood-dark pt-4 font-body text-sm leading-relaxed text-bone-newsprint">
					These six numbers decide every example below. Compression is never a judgment
					call - it is a byte count against the surface's threshold, and the essential
					tools plus the
					<code class="font-mono text-xs text-weathered-teal">aphrodite_*</code>
					tools themselves are always raw regardless of size.
				</p>
			</div>
		</section>

		<!-- FILTER BAR -->
		<section class="relative w-full" data-registry>
			<div
				class="mb-6 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				THE REGISTRY // FILTER BY CATEGORY, SEARCH BY KEYWORD
			</div>
			<div
				class="zine-box-crimson relative -rotate-[0.6deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-8"
			>
				<div class="flex flex-wrap items-center gap-2" data-filters>
					<button
						type="button"
						data-filter="*"
						class="border-2 border-black bg-raw-blood px-3 py-1 font-mono text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
					>
						ALL · {Bank.examples.length}
					</button>
					{Categories.map((Category) => (
						<button
							type="button"
							data-filter={Category}
							class="border-2 border-black bg-soot-black px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-widest text-zinc-dust shadow-[2px_2px_0px_#000] transition-colors hover:text-bone-white"
						>
							{Category}
						</button>
					))}
				</div>
				<input
					type="search"
					placeholder="SEARCH THE EXAMPLES…"
					aria-label="Search the examples"
					data-search
					class="mt-5 w-full border-2 border-oxblood-dark bg-soot-black px-4 py-2 font-mono text-xs tracking-widest text-bone-white placeholder:text-zinc-dust focus:border-weathered-teal focus:outline-none"
				/>
				<p class="mt-4 font-mono text-[11px] tracking-widest text-zinc-dust" data-count>
					SHOWING {Bank.examples.length} OF {Bank.examples.length}
				</p>
			</div>
		</section>

		<!-- THE EXAMPLE MODULES -->
		<section class="relative flex w-full flex-col gap-28 lg:gap-36" data-examples>
			{Bank.examples.map((Example, Index) => {
				const Parts = MarkerParts(Example.marker);
				const Hash = Parts ? EscapeAngle(`<<<CCR:${Parts.Hash}|${Parts.Type}|${Parts.Size}>>>`) : null;
				const Lines = RawLines(Example.raw);
				const Rotate = Index % 2 === 0 ? "rotate-[0.5deg]" : "-rotate-[0.5deg]";
				return (
					<article
						id={Example.id}
						data-example
						data-category={Example.category}
						data-search={`${Example.title} ${Example.category} ${Example.preview ?? ""} ${Example.note}`.toLowerCase()}
						class={`relative w-full scroll-mt-24 lg:w-11/12 ${Index % 2 === 0 ? "lg:self-start" : "lg:self-end"}`}
					>
						<div
							class={`zine-box-crimson relative w-full border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-10 ${Rotate}`}
						>
							<ZineTape
								Label={`EX ${String(Index + 1).padStart(2, "0")} // ${Example.category.toUpperCase()}`}
								Color={Example.corpus ? "teal" : "bone"}
								Side={Index % 2 === 0 ? "left" : "right"}
							/>
							<div class="mt-4 flex flex-wrap items-baseline justify-between gap-3">
								<h2 class="font-headline text-xl font-black uppercase text-bone-white sm:text-2xl">
									{Example.title}
								</h2>
								<span
									class={`border border-oxblood-dark px-2 py-0.5 font-mono text-[10px] font-black uppercase tracking-widest ${Example.corpus ? "text-weathered-teal" : "text-stamped-canary"}`}
								>
									{Example.corpus ? "CORPUS-EXACT PREVIEW" : "GENERIC FRAGMENT"}
								</span>
							</div>

							<!-- RAW STREAM: the generic input, with the suppression fade -->
							<div class="mt-8">
								<div class="mb-2 font-mono text-[10px] font-black uppercase tracking-widest text-zinc-dust">
									RAW STREAM // WHAT THE AGENT SENT
								</div>
								<div class="border border-oxblood-dark bg-soot-black p-3.5 font-mono text-[12px] leading-relaxed">
									{Lines.length === 0 ? (
										<div class="opacity-70">(no raw stream - the block is generated, not captured)</div>
									) : (
										Lines.map(({ Text: Raw, Tone }) => (
											<div class={Tone}>{Raw || "\u00a0"}</div>
										))
									)}
								</div>
							</div>

							<!-- ENRICHED PREVIEW: the corpus-exact line + the teal CCR hash -->
							<div class="mt-5">
								<ZinePreview
									Label="ENRICHED PREVIEW // WHAT THE AGENT SEES"
									Result={Example.preview ?? "(stays raw - no preview line)"}
									Hash={Hash ?? undefined}
									Color="canary"
								/>
							</div>

							<!-- RETRIEVAL: the byte-exact round-trip -->
							{Example.retrieval && (
								<div class="mt-5 border border-oxblood-dark bg-asphalt-panel p-3.5">
									<div class="mb-2 font-mono text-[10px] font-black uppercase tracking-widest text-weathered-teal">
										RETRIEVAL // THE BYTE-EXACT ROUND-TRIP
									</div>
									<div class="font-mono text-[11px] leading-relaxed text-bone-newsprint">
										<div>
											<span class="text-weathered-teal">{Example.retrieval.tool}</span>
											<span class="text-zinc-dust">(hash: "</span>
											<span class="text-stamped-canary">{Example.retrieval.args.hash}</span>
											<span class="text-zinc-dust">")</span>
										</div>
										<div class="text-zinc-dust">
											→ {'{ found: true, source: "ccr", content: the original bytes, byte-for-byte }'}
										</div>
										<div class="pt-1 text-zinc-dust">
											Reads are workspace-confined and capped at 10 MiB; a hash resolves
											only by exact match - truncated hashes never resolve.
										</div>
									</div>
								</div>
							)}

							<!-- BEHAVIOR LESSON: the threshold decision -->
							<div class="mt-6 border-l-4 border-raw-blood pl-4">
								<div class="font-mono text-[10px] font-black uppercase tracking-widest text-raw-blood">
									BEHAVIOR LESSON // THE THRESHOLD DECISION
								</div>
								<p class="mt-2 font-body text-sm leading-relaxed text-bone-newsprint">
									{Example.note}
								</p>
							</div>
						</div>
					</article>
				);
			})}
		</section>

		<!-- CROSS-LINKS -->
		<section class="relative w-full">
			<div
				class="mb-6 rotate-1 border border-black bg-raw-blood px-3 py-1 text-[11px] font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				GO DEEPER // THE SURFACES THESE EXAMPLES EXERCISE
			</div>
			<div
				class="zine-box-crimson w-full rotate-[-0.8deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<ul class="grid gap-5 font-body text-sm text-bone-newsprint sm:grid-cols-2">
					<li class="border-l-4 border-weathered-teal pl-4">
						<a class="font-bold text-bone-white underline decoration-raw-blood" href="/tools/"
							>THE THIRTEEN TOOLS</a
						>
						- the registry behind every retrieval chip above.
					</li>
					<li class="border-l-4 border-weathered-teal pl-4">
						<a class="font-bold text-bone-white underline decoration-raw-blood" href="/workbench/"
							>THE WORKBENCH</a
						>
						- paste your own output and watch the preview build live.
					</li>
					<li class="border-l-4 border-weathered-teal pl-4">
						<a class="font-bold text-bone-white underline decoration-raw-blood" href="/hooks/"
							>THE HOOK CHAIN</a
						>
						- where in the turn each raw stream gets classified.
					</li>
					<li class="border-l-4 border-weathered-teal pl-4">
						<a class="font-bold text-bone-white underline decoration-raw-blood" href="/plugin/"
							>THE PLUGIN</a
						>
						- the shim and the dylib that make all of it run.
					</li>
				</ul>
			</div>
		</section>
	</main>
</Base>

<script>
	// ---- The registry filter: category buttons + keyword search over the
	// server-rendered example modules. The examples' search keys arrive by DOM
	// (data-search attributes), so no JSON island is needed here. ----
	function BindRegistry() {
		const Root = document.querySelector("[data-registry]");
		if (!Root || Root.dataset.registryBound) {
			return;
		}
		Root.dataset.registryBound = "1";

		const Modules = Array.from(document.querySelectorAll<HTMLElement>("[data-example]"));
		const Counter = Root.querySelector("[data-count]");
		const Search = Root.querySelector<HTMLInputElement>("[data-search]");
		const Buttons = Array.from(Root.querySelectorAll<HTMLButtonElement>("[data-filter]"));
		let Category = "*";

		const Apply = () => {
			const Needle = (Search?.value ?? "").trim().toLowerCase();
			let Visible = 0;
			for (const Module of Modules) {
				const MatchCategory = Category === "*" || Module.dataset.category === Category;
				const MatchSearch = Needle === "" || (Module.dataset.search ?? "").includes(Needle);
				const Show = MatchCategory && MatchSearch;
				Module.classList.toggle("hidden", !Show);
				if (Show) Visible += 1;
			}
			if (Counter) {
				Counter.textContent = `SHOWING ${Visible} OF ${Modules.length}`;
			}
		};

		for (const Button of Buttons) {
			Button.addEventListener("click", () => {
				Category = Button.dataset.filter ?? "*";
				for (const Other of Buttons) {
					const Active = Other === Button;
					Other.classList.toggle("bg-raw-blood", Active);
					Other.classList.toggle("text-bone-white", Active);
					Other.classList.toggle("bg-soot-black", !Active);
					Other.classList.toggle("text-zinc-dust", !Active);
				}
				Apply();
			});
		}

		Search?.addEventListener("input", Apply);
	}

	BindRegistry();
	document.addEventListener("astro:page-load", BindRegistry);
</script>
