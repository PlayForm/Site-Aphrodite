<script>
	// ---- The registry filter: category buttons + keyword search over the
	// server-rendered example modules. The examples' search keys arrive by DOM
	// (data-search attributes), so no JSON island is needed here. ----
	//
	// The filter is STATE, so it says so: `aria-pressed` on the category
	// buttons, a `role="status"` count that announces itself, a zero-result
	// panel that explains the bank instead of leaving an empty page, and the
	// filter and the query in the URL so a filtered view is a link someone can
	// send. Every one of those is a degradation of the same variable - a reader
	// who never touches the filter sees the unfiltered page.
	function BindRegistry() {
		const Root = document.querySelector<HTMLElement>("[data-registry]");
		if (!Root || Root.dataset.registryBound) {
			return;
		}
		Root.dataset.registryBound = "1";

		const Modules = Array.from(document.querySelectorAll<HTMLElement>("[data-example]"));
		const Counter = Root.querySelector<HTMLElement>("[data-count]");
		const Search = Root.querySelector<HTMLInputElement>("[data-search]");
		const Buttons = Array.from(Root.querySelectorAll<HTMLButtonElement>("[data-filter]"));
		const Empty = Root.querySelector<HTMLElement>("[data-empty]");
		const EmptyQuery = Root.querySelector<HTMLElement>("[data-empty-query]");
		const Reset = Root.querySelector<HTMLButtonElement>("[data-reset]");
		let Category = "*";

		/** The zero-result panel names what was asked for, in the reader's words. */
		const Describe = (Needle: string): string => {
			const Quoted = (Search?.value ?? "").trim();
			if (Quoted !== "") {
				return `"${Quoted}"`;
			}
			if (Needle === "*") {
				return "this filter";
			}
			return `the "${Needle}" category`;
		};

		/** Paint the pressed state on every button: the class AND the attribute. */
		const Paint = (Active: HTMLButtonElement | undefined): void => {
			for (const Button of Buttons) {
				const On = Button === Active;
				Button.setAttribute("aria-pressed", On ? "true" : "false");
				Button.classList.toggle("bg-raw-blood", On);
				Button.classList.toggle("text-bone-white", On);
				Button.classList.toggle("bg-soot-black", !On);
				Button.classList.toggle("text-zinc-dust", !On);
			}
		};

		const Apply = (Write: boolean): void => {
			const Needle = (Search?.value ?? "").trim().toLowerCase();
			let Visible = 0;
			for (const Module of Modules) {
				const MatchCategory = Category === "*" || Module.dataset.category === Category;
				const MatchSearch = Needle === "" || (Module.dataset.search ?? "").includes(Needle);
				const Show = MatchCategory && MatchSearch;
				Module.classList.toggle("hidden", !Show);
				if (Show) {
					Visible += 1;
				}
			}
			if (Counter) {
				Counter.textContent = `SHOWING ${Visible} OF ${Modules.length}`;
			}
			if (Empty) {
				Empty.classList.toggle("hidden", Visible > 0);
			}
			if (EmptyQuery) {
				EmptyQuery.textContent = Describe(Category);
			}
			if (Write) {
				// The URL is the state: a filtered view is a link someone can send.
				const Next = new URLSearchParams();
				if (Category !== "*") {
					Next.set("category", Category);
				}
				if ((Search?.value ?? "").trim() !== "") {
					Next.set("q", (Search?.value ?? "").trim());
				}
				const Query = Next.toString();
				window.history.replaceState(
					null,
					"",
					`${window.location.pathname}${Query === "" ? "" : `?${Query}`}`,
				);
			}
		};

		for (const Button of Buttons) {
			Button.addEventListener("click", () => {
				Category = Button.dataset.filter ?? "*";
				Paint(Button);
				Apply(true);
			});
		}

		Search?.addEventListener("input", () => Apply(true));

		Reset?.addEventListener("click", () => {
			Category = "*";
			if (Search) {
				Search.value = "";
			}
			Paint(Buttons.find((Button) => Button.dataset.filter === "*"));
			Apply(true);
			Search?.focus();
		});

		// A shared link opens in the state it was shared in. An unknown category
		// falls back to ALL rather than to an empty page.
		const Wanted = new URLSearchParams(window.location.search);
		const Shared = Wanted.get("category");
		const Start =
			Buttons.find((Button) => Button.dataset.filter === Shared) ??
			Buttons.find((Button) => Button.dataset.filter === "*");
		Category = Start?.dataset.filter ?? "*";
		if (Search) {
			Search.value = Wanted.get("q") ?? "";
		}
		Paint(Start);
		Apply(false);
	}

	BindRegistry();
	document.addEventListener("astro:page-load", BindRegistry);
</script>
