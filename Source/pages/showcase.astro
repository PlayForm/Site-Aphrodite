---
import Base from "@Layout/Base.astro";
import ZineTape from "@Component/ZineTape.astro";
import ZinePreview from "@Component/ZinePreview.astro";
import ZineFlow from "@Component/ZineFlow.astro";
import { Link, OurRepo } from "@Library/Links";
import ZineToggle from "@Component/ZineToggle.astro";
import ZineAnatomy from "@Component/ZineAnatomy.astro";
import Breadcrumbs from "@Component/Breadcrumbs.astro";
import Related from "@Component/Related.astro";
import Examples from "../Content/Showcase/Examples.json";

// ---- The bank, typed at the annotation (the Astro compiler's frontmatter
// parser accepts object-literal types in annotation position but not inside
// `as` casts - probe-verified). ----
const Bank: {
	defaults: Record<string, number | string>;
	examples: {
		id: string;
		title: string;
		category: string;
		corpus: boolean;
		raw: string | null;
		preview: string | null;
		marker: string | null;
		retrieval: {
			tool: string;
			args: { hash: string };
			returns: { found: boolean; source: string; hash: string; content: string };
		} | null;
		note: string;
	}[];
} = Examples;

// The CCR marker contract pieces, parsed from the bank's marker strings:
// <<<CCR:hash|type|size>>>.
function MarkerParts(Marker: string | null): { Hash: string; Type: string; Size: string } | null {
	if (!Marker) return null;
	const Match = Marker.match(/<<<CCR:([0-9a-f]+)\|([a-z_]+)\|(\d+)>>>/);
	return Match ? { Hash: Match[1], Type: Match[2], Size: Match[3] } : null;
}

// The enriched preview pane's teal hash line, escaped so set:html renders the
// angle brackets literally instead of parsing them.
function EscapeAngle(Text: string): string {
	return Text.replaceAll("<", "&lt;").replaceAll(">", "&gt;");
}

// The raw stream pane's line tones: the first line is the context keeper the
// preview carries forward, error/failure lines are canary highlights, and the
// rest sit at the suppression opacities - the fade the model still sees.
function RawLines(Raw: string | null): { Text: string; Tone: string }[] {
	if (!Raw) return [];
	return Raw.split("\n").map((Line, Index) => {
		const Failure = /error|fail|warn|panic|traceback/i.test(Line);
		const Tone = Failure
			? "text-stamped-canary"
			: Index === 0
				? "text-bone-newsprint"
				: Index === Raw.split("\n").length - 1
					? "opacity-70"
					: "opacity-40";
		return { Text: Line, Tone };
	});
}

// The category registry for the filter bar, in first-appearance order.
const Categories = [...new Set(Bank.examples.map((Example) => Example.category))];
---

<Base
	Title="SHOWCASE // APHRODITE"
	Description="The plugin in action: 20 anonymized worked examples - build, test, terminal, code, grep, git, diff, json, error, log, the tool relay, the directives, the chain split, and the threshold tiers - each showing the raw stream, the enriched preview, the retrieval round-trip and the threshold decision."
>
	<main
		class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-28 px-5 py-20 sm:px-8 lg:gap-44 lg:px-14 lg:py-32"
	>
		<Breadcrumbs />
		<!-- HERO -->
		<header class="relative flex w-full flex-col items-start">
			<div
				class="mb-6 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				SHOWCASE // THE PLUGIN IN ACTION
			</div>
			<h1
				class="font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-5xl"
			>
				The plugin, worked
			</h1>
			<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Every example below is a real behavior of the pipeline dressed in generic
				content: what the agent sends (the raw stream), what it sees back (the enriched
				preview), how the bytes come home (the retrieval round-trip), and why the
				thresholds made that decision. All previews marked as corpus lines are
				byte-identical to the docs catalog; the rest are faithful fragments.
				Anonymized throughout - no names, no secrets, no real sessions.
			</p>
			<div class="mt-8 flex max-w-4xl flex-wrap items-center gap-4">
				<span
					class="-rotate-2 border-2 border-black bg-raw-blood px-4 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[4px_4px_0px_#000]"
				>
					{Bank.examples.length} WORKED EXAMPLES
				</span>
				<span
					class="rotate-1 border-2 border-black bg-carbon-void px-4 py-1.5 font-mono text-base font-bold uppercase tracking-widest text-weathered-teal shadow-[4px_4px_0px_#000]"
				>
					{Categories.length} CATEGORIES
				</span>
			</div>
		</header>

		<!-- THE DEFAULTS IN PLAY -->
		<section class="relative w-full">
			<div
				class="mb-6 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				THE DEFAULTS // APHRODITE.TOML
			</div>
			<div
				class="zine-box-crimson w-full rotate-[0.8deg] border-4 border-blood-crimson bg-carbon-void p-8 transition-transform duration-300 hover:rotate-0 sm:p-12"
			>
				<p class="font-mono text-base leading-loose text-bone-newsprint">
					{Object.entries(Bank.defaults).map(([Key, Value]) => (
						<span class="mr-6 inline-block whitespace-nowrap">
							<span class="text-zinc-dust">{Key}</span>
							<span class="text-weathered-teal"> = {String(Value)}</span>
						</span>
					))}
				</p>
				<p class="mt-6 border-t border-oxblood-dark pt-4 font-body text-base leading-relaxed text-bone-newsprint">
					These seven numbers decide every example below.
					<span class="mt-1 block text-base">It is the reason compression is never a
					judgment call: it is a byte count against the surface's threshold, and the
					essential tools plus the
					<code class="font-mono text-base text-weathered-teal">aphrodite_*</code>
					tools themselves are always raw regardless of size.</span>
				</p>
			</div>
		</section>

		<!-- FILTER BAR -->
		<section class="relative w-full" data-registry>
			<div
				class="mb-6 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				THE REGISTRY // FILTER BY CATEGORY, SEARCH BY KEYWORD
			</div>
			<div
				class="zine-box-crimson relative -rotate-[0.6deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-8"
			>
				<div class="flex flex-wrap items-center gap-2" data-filters>
					<button
						type="button"
						data-filter="*"
						class="border-2 border-black bg-raw-blood px-3 py-1 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
					>
						ALL · {Bank.examples.length}
					</button>
					{Categories.map((Category) => (
						<button
							type="button"
							data-filter={Category}
							class="border-2 border-black bg-soot-black px-3 py-1 font-mono text-base font-bold uppercase tracking-widest text-zinc-dust shadow-[2px_2px_0px_#000] transition-colors hover:text-bone-white"
						>
							{Category}
						</button>
					))}
				</div>
				<input
					type="search"
					placeholder="SEARCH THE EXAMPLES…"
					aria-label="Search the examples"
					data-search
					class="mt-5 w-full border-2 border-oxblood-dark bg-soot-black px-4 py-2 font-mono text-base tracking-widest text-bone-white placeholder:text-zinc-dust focus:border-weathered-teal focus:outline-none"
				/>
				<p class="mt-4 font-mono text-base tracking-widest text-zinc-dust" data-count>
					SHOWING {Bank.examples.length} OF {Bank.examples.length}
				</p>
			</div>
		</section>

		<!-- THE EXAMPLE MODULES -->
		<section class="relative flex w-full flex-col gap-28 lg:gap-36" data-examples>
			{Bank.examples.map((Example, Index) => {
				const Parts = MarkerParts(Example.marker);
				const Hash = Parts ? EscapeAngle(`<<<CCR:${Parts.Hash}|${Parts.Type}|${Parts.Size}>>>`) : null;
				const Lines = RawLines(Example.raw);
				const Rotate = Index % 2 === 0 ? "rotate-[0.5deg]" : "-rotate-[0.5deg]";
				return (
					<article
						id={Example.id}
						data-example
						data-category={Example.category}
						data-search={`${Example.title} ${Example.category} ${Example.preview ?? ""} ${Example.note}`.toLowerCase()}
						class={`relative w-full scroll-mt-24 lg:w-11/12 ${Index % 2 === 0 ? "lg:self-start" : "lg:self-end"}`}
					>
						<div
							class={`zine-box-crimson relative w-full border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-10 ${Rotate}`}
						>
							<ZineTape
								Label={`EX ${String(Index + 1).padStart(2, "0")} // ${Example.category.toUpperCase()}`}
								Color={Example.corpus ? "teal" : "bone"}
								Side={Index % 2 === 0 ? "left" : "right"}
							/>
							<div class="mt-4 flex flex-wrap items-baseline justify-between gap-3">
								<h2 class="font-headline text-xl font-black uppercase text-bone-white sm:text-2xl">
									{Example.title}
								</h2>
								<span
									class={`border border-oxblood-dark px-2 py-0.5 font-mono text-base font-black uppercase tracking-widest ${Example.corpus ? "text-weathered-teal" : "text-stamped-canary"}`}
								>
									{Example.corpus ? "CORPUS-EXACT PREVIEW" : "GENERIC FRAGMENT"}
								</span>
							</div>

							<!-- RAW STREAM: the generic input, with the suppression fade -->
							<div class="mt-8">
								<div class="mb-2 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
									RAW STREAM // WHAT THE AGENT SENT
								</div>
								<div class="ccr-marker border border-oxblood-dark bg-soot-black p-3.5 font-mono text-base leading-relaxed">
									{Lines.length === 0 ? (
										<div class="opacity-70">(no raw stream - the block is generated, not captured)</div>
									) : (
										Lines.map(({ Text: Raw, Tone }) => (
											<div class={Tone}>{Raw || "\u00a0"}</div>
										))
									)}
								</div>
							</div>

							<!-- ENRICHED PREVIEW: the corpus-exact line + the teal CCR hash -->
							<div class="mt-5">
								<ZinePreview
									Label="ENRICHED PREVIEW // WHAT THE AGENT SEES"
									Result={Example.preview ?? "(stays raw - no preview line)"}
									Hash={Hash ?? undefined}
									Color="canary"
								/>
							</div>

							<!-- RETRIEVAL: the byte-exact round-trip -->
							{Example.retrieval && (
								<div class="mt-5 border border-oxblood-dark bg-asphalt-panel p-3.5">
									<div class="mb-2 font-mono text-base font-black uppercase tracking-widest text-weathered-teal">
										RETRIEVAL // THE BYTE-EXACT ROUND-TRIP
									</div>
									<div class="font-mono text-base leading-relaxed text-bone-newsprint">
										<div>
											<span class="text-weathered-teal">{Example.retrieval.tool}</span>
											<span class="text-zinc-dust">(hash: "</span>
											<span class="text-stamped-canary">{Example.retrieval.args.hash}</span>
											<span class="text-zinc-dust">")</span>
										</div>
										<div class="text-zinc-dust">
											→ {'{ found: true, source: "ccr", content: the original bytes, byte-for-byte }'}
										</div>
										<div class="pt-1 text-zinc-dust">
											Reads are workspace-confined and capped at 10 MiB; a hash resolves
											only by exact match - truncated hashes never resolve.
										</div>
									</div>
								</div>
							)}

							<!-- BEHAVIOR LESSON: the threshold decision -->
							<div class="mt-6 border-l-4 border-raw-blood pl-4">
								<div class="font-mono text-base font-black uppercase tracking-widest text-raw-blood">
									BEHAVIOR LESSON // THE THRESHOLD DECISION
								</div>
								<p class="mt-2 font-body text-base leading-relaxed text-bone-newsprint">
									{Example.note}
								</p>
							</div>
						</div>
					</article>
				);
			})}
		</section>

		<!-- THE TRAVERSALS: the interactive flows, agent view vs system path -->
		<section class="relative flex w-full flex-col gap-28 lg:gap-36">
			<div class="w-full">
				<div
					class="mb-6 -rotate-1 border border-black bg-stamped-canary px-3 py-1 text-base font-black uppercase tracking-widest text-soot-black shadow-[3px_3px_0px_#000]"
				>
					THE TRAVERSALS // AGENT-VIEW vs SYSTEM-PATH, STEP BY STEP
				</div>
				<p class="max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
					The five pipelines above are worked examples; these are the pipes they run
					through. Each traversal steps through its hook or endpoint with two
					synchronized panes - what the agent sees, what the system does - and every
					step carries its source anchor. Press PLAY to watch one run.
				</p>
			</div>

			<!-- Traversal A: tool-output compression -->
			<div class="w-full lg:w-11/12 lg:self-start">
				<ZineFlow
					Title="TRAVERSAL A // TRANSFORM_TOOL_RESULT"
					Complete="COMPRESSED · RETRIEVABLE"
					Steps={[
						{
							Title: "THE RESULT ARRIVES",
							Agent: "the full tool output, still raw, on its way into the transcript",
							System: "telemetry first: status, error type/message, arguments and duration recorded into the tool-event ring (feeds the error-loop and phase detectors). Empty results are skipped here.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:69-75",
						},
						{
							Title: "FILE REFERENCES TRACKED",
							Agent: "nothing changes yet - the output is untouched",
							System: "read_file and search_files results are recorded for aphrodite_files and the recall catalog BEFORE the skip gates, so they feed the catalog even when never compressed.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:92-94",
						},
						{
							Title: "THE SKIP GATES",
							Agent: "essential tools stay raw: skill_view, skills_list, skill_manage, memory, session_search, read_file, read_terminal",
							System: "gates in order: empty result; essential set; Aphrodite's own tools and headroom helpers (compressing aphrodite_retrieve would replace resolved content with another marker); below the tool threshold (default 4,096 chars, 0 disables the gate). Raw stays raw when it matters.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:76-84",
						},
						{
							Title: "CLASSIFY",
							Agent: "the output now has a name - and the name decides everything downstream",
							System: "the content-type detector assigns a type; generic text/log/plain results get a semantic upgrade (git status, ls, test, grep) so the preview carries high-signal shape.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:85-88",
						},
						{
							Title: "THRESHOLD + EMA",
							Agent: "invisible - the agent never tunes this by hand",
							System: "the per-type threshold (EMA auto-tuned by what past turns saved) decides compress vs. pass-through; env overrides TOML overrides the default.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:139-146",
						},
						{
							Title: "STORE",
							Agent: "still just the output - but the receipt is being written",
							System: "the content is hashed (BLAKE3) and stored in the inline store; the marker's hash is the address of the original bytes, taken over the ORIGINAL, never a wrapper's extracted view (the v1.3.2 losslessness law).",
							Anchor: Link(OurRepo, "CHANGELOG.md"),
							AnchorLabel: "CHANGELOG v1.3.2",
						},
						{
							Title: "THE SWAP",
							Agent: "the tool output is now a preview line plus a marker - roughly fifteen tokens",
							System: "Hermes swaps the tool output for the marker; the transcript carries hash, type, size instead of the bytes.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:89-91",
						},
						{
							Title: "DECIDE / RETRIEVE",
							Agent: "the agent - not the engine - spends the budget: call aphrodite_retrieve only if the preview did not answer the question",
							System: "retrieval returns the exact original bytes, byte-exact by construction; the loop closes with nothing lost.",
							Anchor: Link(OurRepo, "docs/api/retrieve.md"),
							AnchorLabel: "retrieve.md",
						},
					]}
				/>
			</div>

			<!-- Traversal B: terminal transform -->
			<div class="w-full lg:w-10/12 lg:self-end">
				<ZineFlow
					Title="TRAVERSAL B // TRANSFORM_TERMINAL_OUTPUT"
					Complete="TERMINAL HANDLED"
					Steps={[
						{
							Title: "THE OUTPUT ARRIVES",
							Agent: "the terminal's stdout and its exit code, as one blob",
							System: "telemetry: the command and return code are recorded; a non-zero exit code marks the event as a failure and feeds the error-loop detector.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:98-101",
						},
						{
							Title: "CHAIN SPLIT FIRST",
							Agent: "if pre_tool_call marked the segments, each one is about to get its own receipt",
							System: "when chain splitting is enabled and the output carries the segment markers, each segment is compressed into its own marker - unconditional, BEFORE the threshold gate, so marked output never leaks raw. Per-segment error hints merge into previews.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:102-106",
						},
						{
							Title: "THE THRESHOLD GATE",
							Agent: "short output stays exactly as it was",
							System: "unmarked output below the terminal threshold (default 1,024 characters; 0 disables the gate) passes through untouched.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:107-108",
						},
						{
							Title: "CLASSIFY",
							Agent: "a failed run is named terminal - the type keeps errors visible longest",
							System: "output containing 'exit code:' or 'Error:' is typed terminal; other output gets the normal content-type detection with the same semantic upgrade as tool results.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:109-111",
						},
						{
							Title: "STORE + THE NUDGE LOOP",
							Agent: "next turn opens with a nudge, not a surprise",
							System: "above-threshold content is hashed, stored, and replaced by a marker; the failure recorded in step 1 surfaces as a poll-worker status nudge at the next pre_llm_call.",
							Anchor: Link(OurRepo, "docs/plugin/hooks.md"),
							AnchorLabel: "hooks.md:111-112,114-121",
						},
					]}
				/>
			</div>

			<!-- Traversal C: retrieval round-trip -->
			<div class="w-full lg:w-10/12 lg:self-start">
				<ZineFlow
					Title="TRAVERSAL C // THE RETRIEVAL ROUND-TRIP"
					Complete="BYTE-EXACT"
					Steps={[
						{
							Title: "THE CALL",
							Agent: "the agent hands back the marker it kept - or just the hash",
							System: "the hash argument is normalized before lookup: a type/size marker-body suffix and surrounding whitespace are stripped, so a hash echoed back in full marker form still resolves.",
							Anchor: Link(OurRepo, "docs/api/retrieve.md"),
							AnchorLabel: "retrieve.md:41-43",
						},
						{
							Title: "LOOKUP",
							Agent: "one answer either way: found or not",
							System: "the inline store is checked first, then the CCR backend; the success path always reports source 'ccr' regardless of which store served the content. No zstd decompression happens on this path - content is stored and returned verbatim as UTF-8 strings.",
							Anchor: Link(OurRepo, "docs/api/retrieve.md"),
							AnchorLabel: "retrieve.md:196-212",
						},
						{
							Title: "PAGINATION",
							Agent: "a window, or the whole thing",
							System: "limit 0 requests the FULL document with no cap - the round-trip contract; any explicit limit, including one above 10,000, is clamped to a 10,000-line server cap. A windowed result carries a lines a-b/total header and truncated: true, so a caller can tell truncated from genuinely short.",
							Anchor: Link(OurRepo, "docs/api/retrieve.md"),
							AnchorLabel: "retrieve.md:184-192",
						},
						{
							Title: "BYTE-EXACT",
							Agent: "the original bytes return unchanged - a trailing newline included",
							System: "a full-document retrieval returns the exact original bytes: the lossy lines/join round-trip is skipped entirely, and the body hashes back to the marker's own hash. The losslessness law, verified per call.",
							Anchor: Link(OurRepo, "docs/api/retrieve.md"),
							AnchorLabel: "retrieve.md:184-188",
						},
					]}
				/>
			</div>

			<!-- Traversal G: the proxy lane -->
			<div class="w-full lg:w-11/12 lg:self-end">
				<ZineFlow
					Title="TRAVERSAL G // THE PROXY LANE"
					Complete="COMPRESSED OR PASSED THROUGH"
					Steps={[
						{
							Title: "POST /V1/CHAT/COMPLETIONS",
							Agent: "an ordinary OpenAI-compatible client - no Aphrodite plugin required",
							System: "the request cache is checked first (cache_key_from_body; skipped when stream is true) - a hit returns early with X-Aphrodite-Cache: HIT.",
							Anchor: Link(OurRepo, "docs/architecture/02-chat-compression.md"),
							AnchorLabel: "02-chat-compression.md",
						},
						{
							Title: "UPSTREAM",
							Agent: "the request is forwarded unchanged",
							System: "forwarded with at most 3 connection retries; the response comes back with headers and body.",
							Anchor: Link(OurRepo, "docs/architecture/02-chat-compression.md"),
							AnchorLabel: "02-chat-compression.md",
						},
						{
							Title: "SSE BYPASS",
							Agent: "a streaming answer streams, untouched",
							System: "a text/event-stream content-type passes through as a raw stream - NO compression on the SSE path. Long-running streams are never killed mid-answer by the compressor.",
							Anchor: Link(OurRepo, "docs/architecture/02-chat-compression.md"),
							AnchorLabel: "02-chat-compression.md",
						},
						{
							Title: "COMPRESS EACH MESSAGE.CONTENT",
							Agent: "large assistant/tool text comes back as preview + marker",
							System: "each choice.message.content (string) is classified, its threshold is threshold_for(type).max(base) scaled by the x-headroom-budget multiplier (clamped 0.50..1.0); over-threshold content is BLAKE3-hashed, deduped via ccr_get, stored, and swapped for the marker; the ratio feeds the EMA.",
							Anchor: Link(OurRepo, "docs/architecture/02-chat-compression.md"),
							AnchorLabel: "02-chat-compression.md",
						},
						{
							Title: "TOOL_CALLS NEVER",
							Agent: "the client's tool calls keep working - always",
							System: "the loop reads message.content only: tool_calls[].function.arguments is client-executable JSON, not model-facing prose, and is never compressed. The v1.3.2 fix - before it, every OpenAI-tools client broke through the proxy.",
							Anchor: Link(OurRepo, "CHANGELOG.md"),
							AnchorLabel: "CHANGELOG v1.3.2",
						},
						{
							Title: "TWO PIPELINES, SHARED WIRES",
							Agent: "same marker format, whichever lane compressed it",
							System: "the proxy path never calls the staged transform pipeline (transforms::detect, stage2, struct_extract) - those run only on the Hermes hook path. The two pipelines share the BLAKE3 compute_key and the marker wire format, but nothing else.",
