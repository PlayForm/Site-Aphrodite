---
import Base from "@Layout/Base.astro";
import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import SectionNav from "@Component/SectionNav.astro";
import ZineTape from "@Component/ZineTape.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineFlow from "@Component/ZineFlow.astro";
import ZineToggle from "@Component/ZineToggle.astro";
import Related from "@Component/Related.astro";
import ExampleCase from "@Component/ExampleCase.astro";
import { Link, OurRepo, Routes } from "@Library/Links";
import type {
	ExampleOutcome,
	ExampleOutputLine,
	ExampleProvenance,
	ExampleRecord,
	ExampleStage,
} from "@Library/Records";
import Examples from "../Content/Showcase/Examples.json";
import { RunMarker } from "@Library/Motion";

// ---- The bank, typed at the annotation (the Astro compiler's frontmatter
// parser accepts object-literal types in annotation position but not inside
// `as` casts - probe-verified). `provenance` is optional on purpose: an entry
// that names its own provenance wins over the `corpus` flag, so a captured or
// engine-verified example can be added to the data without touching this file.
// ---- The bank is also the ONLY source for the outcome and the provenance the
// page renders: both are read off each entry's own fields, so the page cannot
// claim a mechanism the data does not describe. ----
const Bank: {
	defaults: Record<string, number | string>;
	examples: {
		id: string;
		title: string;
		category: string;
		corpus: boolean;
		provenance?: string;
		raw: string | null;
		preview: string | null;
		marker: string | null;
		retrieval: {
			tool: string;
			args: { hash: string };
			returns: { found: boolean; source: string; hash: string; content: string };
		} | null;
		note: string;
	}[];
} = Examples;

// ---- THE TRAVERSALS' ONE FIXTURE. Traversal B follows a FAILING test run: its
// first step records a non-zero exit code as the failure that feeds the
// error-loop detector, its fourth names the type the failure was given, and its
// last expects the poll-worker nudge for that same failed task. A
// `[terminal:14L exit code: 0]` preview printed under those sentences described
// a passing run - the preview, the marker and the prose could not all be true
// of one payload. Both figures are now computed from these lines, so one
// scenario object carries the whole traversal. ----

/** `builders/terminal.rs`'s summary: the last exit-code or `Error:` line, clipped to 60. */
const TerminalSummary = (Lines: readonly string[]): string =>
	(
		[...Lines].reverse().find((Line) => Line.includes("exit code:") || Line.includes("Error:")) ??
		Lines[0] ??
		""
	)
		.trim()
		.slice(0, 60);

/**
 * `[terminal:NL <summary>]`. `Motion.ts`'s `RunPreview` mirrors the build, grep,
 * ls, test and json arms and falls back to `[type:NL]` for every other type, so
 * the terminal arm is mirrored here against `builders/terminal.rs` - the same
 * helper `tools.astro` carries, so both pages print one terminal preview shape.
 */
const TerminalPreview = (Lines: readonly string[]): string =>
	`[terminal:${Lines.length}L ${TerminalSummary(Lines)}]`;

/** A release test run that fails: eight tests pass, one fails, and the exit code says so. */
const FailureLines: readonly string[] = [
	"$ cargo test --release -p aphrodite preview::builders",
	"   Compiling aphrodite-core v0.4.2 (/workspace/crates/aphrodite-core)",
	"   Compiling aphrodite v0.4.2 (/workspace/crates/aphrodite)",
	"    Finished `release` profile [optimized] target(s) in 18.72s",
	"     Running unittests src/lib.rs (/workspace/target/release/deps/aphrodite-3b81c4d9e07a2f16)",
	"test preview::builders::build::test::build_counts_error_lines_not_occurrences ... ok",
	"test preview::builders::build::test::build_surfaces_the_first_error_message ... ok",
	"test preview::builders::grep::test::grep_reports_hits_and_distinct_files ... ok",
	"test preview::builders::ls::test::ls_lists_extension_counts ... ok",
	"test preview::builders::test::test::test_reports_pass_fail_ignored ... ok",
	"test preview::builders::json::test::json_counts_items_and_keys ... ok",
	"test preview::builders::terminal::test::terminal_reads_the_exit_code_line ... FAILED",
	"test preview::builders::search::test::search_reports_hits_and_first_location ... ok",
	"test preview::builders::code::test::code_maps_structure_and_signature ... ok",
	"",
	"failures:",
	"",
	"---- preview::builders::terminal::test::terminal_reads_the_exit_code_line stdout ----",
	"thread 'preview::builders::terminal::test::terminal_reads_the_exit_code_line' panicked at crates/aphrodite/src/preview/builders/terminal.rs:31:9:",
	"the summary must be the LAST exit-code line, not the first",
	"note: run with `RUST_BACKTRACE=1` environment variable to display a backtrace",
	"",
	"failures:",
	"    preview::builders::terminal::test::terminal_reads_the_exit_code_line",
	"",
	"test result: FAILED. 8 passed; 1 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.41s",
	"",
	"error: test failed, to rerun pass `-p aphrodite --lib`",
	"   exit code: 101",
];

const FailurePreview = TerminalPreview(FailureLines);
const FailureMarker = RunMarker("3f9a2c7e", "terminal", FailureLines);

// ---- The section label is now ZineTape's `section` variant (the site's one
// tape shape). The traversals keep the canary accent through its `Color` prop,
// so the page no longer carries a second class string that can drift. ----

// ---- The gallery: ONE array of ONE record shape. Every entry below supplies
// every field `ExampleCase` renders, so adding or removing an example is a
// change to the bank (Source/Content/Showcase/Examples.json) and never a
// change to this file. ----

// The record fields that carry markup (`Claim`, `Output`, `Marker`) are
// rendered through `set:html`, so a `<` in a compiler's own output has to be
// escaped or the browser reads it as a tag. The ampersand goes first: escaping
// it last would rewrite the entities the other two replacements produce.
function Escape(Text: string): string {
	return Text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
}

// One sentence per block: the PROSE BREAKDOWN applied to a bank note. The
// lookahead keeps "e.g. before ..." whole - a break needs a new subject after
// the period, not merely a period.
function Sentences(Note: string): string[] {
	return Note.split(/(?<=[.!?])\s+(?=[A-Z(`"\u2014-])/)
		.map((Sentence) => Sentence.trim())
		.filter(Boolean);
}

// The bank's raw stream, one line per entry, in the suppression fade law 4
// describes: the context keeper brightest, failures canary, the tail dimmed.
function OutputLines(Raw: string | null): ExampleOutputLine[] {
	if (!Raw) {
		return [{ Text: "(no raw stream - the block is generated, not captured)", Tone: "dim" }];
	}
	const Lines = Raw.split("\n");
	return Lines.map((Text, Index) => ({
		Text: Escape(Text) || "&nbsp;",
		Tone: /error|fail|warn|panic|traceback/i.test(Text)
			? "canary"
			: Index === 0
				? "result"
				: Index === Lines.length - 1
					? "dim"
					: "fade",
	}));
}

// One block of text as stream lines, with the same escaping every other pane
// gets. Used by the sequential mechanisms, whose stages are cut out of the raw
// stream rather than authored beside it.
function ToLines(Block: string): ExampleOutputLine[] {
	return Block.split("\n").map((Text) => ({ Text: Escape(Text) || "&nbsp;" }));
}

// The CCR marker block, taken from the bank's own marker string instead of
// rebuilt from parsed parts. Every line of it is rendered - the token alone is
// the address, but the `[type: ...]` and `[meta: ...]` lines beside it are the
// marker the agent actually sees, and dropping them would show the address
// without the receipt.
function MarkerBlock(Marker: string | null): string | undefined {
	if (!Marker) {
		return undefined;
	}
	return Marker.split("\n").map(Escape).join("<br />");
}

// The round-trip is the entry's command: the call the agent made. What the call
// answers is invariant across every entry that makes one, so the answer - and
// the store's read rules - are stated once on the page, under the gallery
// heading, instead of repeated inside every entry.
function CommandCode(Retrieval: { tool: string; args: { hash: string } } | null): string {
	if (!Retrieval) {
		return "(stays raw - no retrieval call)";
	}
	return `${Retrieval.tool}(hash: "${Retrieval.args.hash}")`;
}

/**
 * The outcome an entry's own data describes. Read off the entry, never typed
 * per example:
 *
 *   category `tool-relay`  -> `callback`  the relay answers once and delivers later
 *   category `directives`  -> `injected`  an assembled prompt block, not a result
 *   a marker in the data   -> `compressed` the output crossed a threshold
 *   anything else          -> `passthrough` it did not, and nothing was stored
 *
 * The order matters: the relay entry DOES carry a marker (on its queued reply),
 * so a marker-first test would file the callback exchange under `compressed`
 * and lose the two deliveries that make it a different mechanism.
 */
function OutcomeOf(Example: {
	category: string;
	marker: string | null;
}): ExampleOutcome {
	if (Example.category === "tool-relay") {
		return "callback";
	}
	if (Example.category === "directives") {
		return "injected";
	}
	return Example.marker ? "compressed" : "passthrough";
}

/**
 * Where an entry's words come from, as a claim printed in text beside the
 * title. The bank's `corpus` flag is the authored/catalog split its own
 * authoring rules define; an entry that names its provenance explicitly wins,
 * and an unrecognised value falls back to the flag rather than rendering a
 * label the page cannot explain.
 */
function ProvenanceOf(Example: { corpus: boolean; provenance?: string }): ExampleProvenance {
	const Named = Example.provenance;
	if (
		Named === "Illustrative" ||
		Named === "Catalog-exact" ||
		Named === "Captured" ||
		Named === "Engine-verified"
	) {
		return Named;
	}
	return Example.corpus ? "Catalog-exact" : "Illustrative";
}

/**
 * The three stages of a callback exchange: the request, the immediate reply and
 * the later delivery. The bank writes all three into ONE raw stream, separated
 * by `--- label ---` rules, so the stages are cut from the entry's own data -
 * the order shown is the order recorded, not an order authored here.
 */
function ExchangeStages(Raw: string | null): ExampleStage[] {
	if (!Raw) {
		return [];
	}
	const Stages: ExampleStage[] = [];
	let Label = "THE REQUEST";
	let Buffer: string[] = [];
	const Flush = (): void => {
		const Block = Buffer.join("\n").trim();
		if (Block !== "") {
			Stages.push({ Label, Lines: ToLines(Block) });
		}
		Buffer = [];
	};
	for (const Line of Raw.split("\n")) {
		const Rule = Line.match(/^---\s*(.+?)\s*---$/);
		if (Rule) {
			Flush();
			Label = Rule[1].toUpperCase();
			continue;
		}
		Buffer.push(Line);
	}
	Flush();
	return Stages;
}

/** The name of one block of an injected assembly, from its own first line. */
function StageLabel(Block: string, Index: number): string {
	if (Index === 0) {
		return "THE ENVELOPE";
	}
	if (Block.startsWith("[directives:")) {
		return "THE DIRECTIVES";
	}
	if (Block.startsWith("[nudge:")) {
		return "THE NUDGES AND THE RECALL CATALOG";
	}
	if (Block.startsWith("[recall:")) {
		return "THE RECALL CATALOG";
	}
	if (/^sections drop/i.test(Block)) {
		return "THE DROP RULE";
	}
	return `SECTION ${String(Index + 1).padStart(2, "0")}`;
}

/**
 * The ordered assembly of an injected block: the envelope, then each section in
 * the order it lands, then the drop rule. Read from the raw stream's
 * blank-line-separated blocks, so the order shown is the order the entry
 * records.
 */
function AssemblyStages(Raw: string | null): ExampleStage[] {
	if (!Raw) {
		return [];
	}
	return Raw.split(/\n\s*\n/)
		.map((Block) => Block.trim())
		.filter((Block) => Block !== "")
		.map((Block, Index) => ({ Label: StageLabel(Block, Index), Lines: ToLines(Block) }));
}

/**
 * The search index, and it is deliberately WIDER than the visible text. A
 * reader looking for a failure is looking for `E0432` or `EXIT:1`; one looking
 * for a surface is looking for `aphrodite_retrieve`; one looking for a knob is
 * looking for `terminal_threshold`; one looking for a language is looking for
 * `.rs`. None of those appear in a title, so an index built from title, claim
 * and preview answers "no such example" to every one of them.
 *
 * Every term below is READ from the entry - nothing is added that the entry
 * does not carry - so the index cannot promise a search hit the card does not
 * support.
 */
function SearchIndex(
	Example: {
		category: string;
		raw: string | null;
		note: string;
		retrieval: {
			tool: string;
			args: { hash: string };
			returns: { content: string };
		} | null;
	},
	Scenario: ExampleRecord,
): string {
	const Raw = Example.raw ?? "";
	const Claim = Scenario.Claim.join(" ");
	const Terms = [
		Scenario.Title,
		Scenario.Label,
		Scenario.Preview,
		Scenario.Marker ?? "",
		Claim,
		Raw,
		Example.retrieval?.tool ?? "",
		Example.retrieval?.args.hash ?? "",
		Example.retrieval?.returns.content ?? "",
		// failure codes: compiler error codes, shell exit codes
		...(Raw.match(/\bE\d{4}\b/g) ?? []),
		...(Raw.match(/\bEXIT:\s?\d+\b/g) ?? []),
		...(Raw.match(/\bexit code:\s?\d+/gi) ?? []),
		// tool names, in the output and in the prose
		...(Raw.match(/\baphrodite_[a-z_]+\b/g) ?? []),
		...(Claim.match(/\baphrodite_[a-z_]+\b/g) ?? []),
		// configuration keys: snake_case identifiers assigned a value
		...(Raw.match(/^[a-z][a-z0-9_]{4,}(?=\s*=)/gm) ?? []),
		// file extensions
		...(Raw.match(/\.[a-z]{1,4}\b/g) ?? []),
		// the two labels the card prints, so they are searchable as words. The
		// passthrough chip reads "PASSED THROUGH" while the union member is one
		// word, so that label's spelling is carried beside it - the only member
		// whose visible wording differs from its token.
		Scenario.Outcome === "passthrough"
			? "passthrough passed through pass-through"
			: (Scenario.Outcome ?? ""),
		Scenario.Provenance ?? "",
	];
	return Terms.filter(Boolean).join(" ").toLowerCase();
}

// The scenario number the tape carries, computed from the entry's position so
// the bank can grow past twenty without a table to edit.
function Roman(Value: number): string {
	const Numerals: [number, string][] = [
		[10, "X"],
		[9, "IX"],
		[5, "V"],
		[4, "IV"],
		[1, "I"],
	];
	let Left = Value;
	let Out = "";
	for (const [Amount, Numeral] of Numerals) {
		while (Left >= Amount) {
			Out += Numeral;
			Left -= Amount;
		}
	}
	return Out;
}

const Cases: ExampleRecord[] = Bank.examples.map((Example, Index): ExampleRecord => {
	const Outcome = OutcomeOf(Example);
	return {
		Id: Example.id,
		N: Roman(Index + 1),
		Label: Example.category.toUpperCase(),
		Title: Example.title,
		Tone: Example.corpus ? "teal" : "crimson",
		// Twenty tilted plates is twenty emphases, so the library presentation is
		// flat: the plate keeps the frame and the shadow plane (the site's
		// identity) and spends its tilt nowhere. The section's one expressive
		// assembly is the registry plate below.
		Rotate: "",
		Claim: Sentences(Example.note).map(Escape),
		Command: { Lang: "text", Code: CommandCode(Example.retrieval) },
		Output: OutputLines(Example.raw),
		Preview: Example.preview ?? "(stays raw - no preview line)",
		Marker: MarkerBlock(Example.marker),
		Outcome,
		Provenance: ProvenanceOf(Example),
		Stages:
			Outcome === "callback"
				? ExchangeStages(Example.raw)
				: Outcome === "injected"
					? AssemblyStages(Example.raw)
					: [],
		Retrieval: Example.retrieval
			? {
					Call: CommandCode(Example.retrieval),
					Tool: Example.retrieval.tool,
					Hash: Example.retrieval.args.hash,
					Found: Example.retrieval.returns.found,
					Source: Example.retrieval.returns.source,
					Content: Example.retrieval.returns.content,
				}
			: undefined,
		Src: `SRC: Source/Content/Showcase/Examples.json · ${Example.id}`,
	};
});

// One search key per record, computed beside it so the two cannot drift.
const Searches: string[] = Bank.examples.map((Example, Index) => SearchIndex(Example, Cases[Index]));

// The category registry for the filter bar, in first-appearance order, read off
// the records the gallery renders so the buttons cannot list a category no
// entry carries.
const Categories = [...new Set(Cases.map((Scenario) => Scenario.Label.toLowerCase()))];

// The categories as one readable line, for the zero-result panel: a reader who
// has filtered everything away is told what the bank actually holds.
const CategoryList = Categories.map((Category) => Category.toUpperCase()).join(" · ");

// How many entries each outcome has, so the legend states the bank's shape
// instead of a number someone has to remember to update.
const OutcomeCount = Cases.reduce<Record<string, number>>((Tally, Scenario) => {
	const Key = Scenario.Outcome ?? "compressed";
	Tally[Key] = (Tally[Key] ?? 0) + 1;
	return Tally;
}, {});
---

<Base
	Title="SHOWCASE // APHRODITE"
	Description="The plugin in action: 20 anonymized worked examples - build, test, terminal, code, grep, git, diff, json, error, log, the tool relay, the directives, the chain split, and the threshold tiers - each showing what the agent saw, how the bytes came home, and why the thresholds made that decision."
>
	<!-- The four slots the rest of the site renders: shell, header, sections,
	     one Related. The gallery inside them is unchanged - one Cases array,
	     one ExampleCase render site. -->
	<PageShell Rhythm="wide" Crumbs>
		<PageHeader
			Tape="SHOWCASE // THE PLUGIN IN ACTION"
			Title="The plugin, worked"
			Lead={[
				"Anonymized throughout - no names, no secrets, no real sessions; every entry is a real behavior of the pipeline dressed in generic content.",
			]}
		/>

		<!-- ============ HOW THESE EXAMPLES WERE PRODUCED ============
		     The four introductory paragraphs lived as four equal blocks under the
		     title, above everything a reader came for. They are all here, word for
		     word - the fold holds the account, the one quiet line above holds the
		     claim, and the first example is now the first thing below the fold. -->
		<details class="group w-full border-2 border-oxblood-dark bg-carbon-void">
			<summary
				class="flex cursor-pointer list-none flex-wrap items-center gap-3 border-b border-transparent bg-soot-black px-4 py-3 font-mono text-base text-bone-newsprint transition-colors group-open:border-oxblood-dark hover:text-bone-white"
			>
				<span
					class="border border-oxblood-dark bg-raw-blood px-2 py-0.5 font-black uppercase tracking-widest text-bone-white"
				>
					HOW THESE EXAMPLES WERE PRODUCED
				</span>
				<span class="grow font-normal text-zinc-dust">
					provenance · what the corpus lines are checked against · the four labels
				</span>
				<span class="text-stamped-canary group-open:hidden" aria-hidden="true">OPEN +</span>
				<span class="hidden text-zinc-dust group-open:inline" aria-hidden="true">CLOSE −</span>
			</summary>
			<div class="prose-flow p-4 sm:p-6">
				<p class="type-body max-w-3xl text-bone-newsprint">
					Every example is a real behavior of the pipeline dressed in generic content: what
					the agent sends (the raw stream), what it sees back (the enriched preview), how the bytes
					come home (the retrieval round-trip), and why the thresholds made that decision.
				</p>
				<p class="type-body max-w-3xl text-bone-newsprint">
					All previews marked as corpus lines are byte-identical to the docs catalog; the rest are
					faithful fragments.
				</p>
				<p class="type-body max-w-3xl text-bone-newsprint">
					That catalog is the enriched-preview table in
					<code class="type-code text-weathered-teal">docs/proxy/compression.md</code> together with
					the preview-form table in the repository README - both are public, so every corpus line can
					be checked against them, character for character.
				</p>
				<p class="type-body max-w-3xl text-bone-newsprint">
					Anonymized throughout - no names, no secrets, no real sessions.
				</p>

				<div class="border-t border-oxblood-dark pt-6">
					<p class="font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
						THE FOUR PROVENANCE LABELS
					</p>
					<p class="type-body mt-3 max-w-3xl text-bone-newsprint">
						"Anonymized" and "illustrative" are not the same claim, so every entry names its own
						provenance in text beside its title. Colour reinforces the label; it never carries the
						distinction on its own.
					</p>
					<ul class="mt-5 flex flex-col gap-3">
						<li class="border-l-2 border-weathered-teal pl-4">
							<span class="font-mono text-base font-black uppercase tracking-widest text-weathered-teal"
								>Catalog-exact</span
							>
							<span class="type-body block text-bone-newsprint"
								>- the preview line is byte-identical to the documented enriched-preview catalog,
								so it can be checked character for character.</span
							>
						</li>
						<li class="border-l-2 border-zinc-dust pl-4">
							<span class="font-mono text-base font-black uppercase tracking-widest text-zinc-dust"
								>Illustrative</span
							>
							<span class="type-body block text-bone-newsprint"
								>- authored: a faithful fragment of the shape with varied generic numbers, not a
								capture and not a catalog line.</span
							>
						</li>
						<li class="border-l-2 border-stamped-canary pl-4">
							<span class="font-mono text-base font-black uppercase tracking-widest text-stamped-canary"
								>Captured</span
							>
							<span class="type-body block text-bone-newsprint"
								>- recorded from a real run and then anonymized. No entry claims it
								today; the label exists so a real capture can be published without being called
								illustrative.</span
							>
						</li>
						<li class="border-l-2 border-bone-white pl-4">
							<span class="font-mono text-base font-black uppercase tracking-widest text-bone-white"
								>Engine-verified</span
							>
							<span class="type-body block text-bone-newsprint"
								>- checked against a named engine version, so the behavior is pinned to a release
								rather than to a reading of the code.</span
							>
						</li>
					</ul>
				</div>

				<div class="border-t border-oxblood-dark pt-6">
					<p class="font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
						THE FOUR OUTCOMES
					</p>
					<p class="type-body mt-3 max-w-3xl text-bone-newsprint">
						An example says how its bytes reached the transcript, because four different mechanisms
						that render identically are four mechanisms a reader cannot tell apart. The counts are
						read off the bank.
					</p>
					<ul class="mt-5 flex flex-col gap-3">
						<li class="border-l-2 border-stamped-canary pl-4">
							<span class="font-mono text-base font-black uppercase tracking-widest text-stamped-canary"
								>Compressed · {OutcomeCount.compressed ?? 0}</span
							>
							<span class="type-body block text-bone-newsprint"
								>- the output crossed the surface's threshold: hashed, stored, and replaced by a
								preview line plus a marker.</span
							>
						</li>
						<li class="border-l-2 border-weathered-teal pl-4">
							<span class="font-mono text-base font-black uppercase tracking-widest text-weathered-teal"
								>Passed through · {OutcomeCount.passthrough ?? 0}</span
							>
							<span class="type-body block text-bone-newsprint"
								>- under the threshold, or stopped by a skip gate: the bytes reach the transcript
								unchanged and nothing is stored.</span
							>
						</li>
						<li class="border-l-2 border-bone-newsprint pl-4">
							<span class="font-mono text-base font-black uppercase tracking-widest text-bone-newsprint"
								>Injected · {OutcomeCount.injected ?? 0}</span
							>
							<span class="type-body block text-bone-newsprint"
								>- never a tool result: behavioural text assembled in a fixed order and placed into
								the prompt.</span
							>
						</li>
