---
import ZineBox from "@Component/ZineBox.astro";
import ZineStatBar from "@Component/ZineStatBar.astro";
import ZineTape from "@Component/ZineTape.astro";

const Rows = [
	{ Type: "A", Ratio: "1×", Percent: 10 },
	{ Type: "B", Ratio: "2×", Percent: 20 },
];
---
<main>
	<ZineTape Variant="tab" Label="I // X" Color="raw" />
	<ZineBox Tone="crimson" Size="lg" Rotate="-rotate-[0.6deg]" Class="w-full">
		<ZineTape Variant="strip" Label="STRIP" />
		{
			Rows.map(({ Type, Ratio, Percent }) => (
				<ZineStatBar Label={`${Type} · pair`} Ratio={Ratio} Percent={Percent} Color="canary" />
			))
		}
	</ZineBox>
</main>
