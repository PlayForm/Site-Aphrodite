---
import Base from "@Layout/Base.astro";

import Breadcrumbs from "@Component/Breadcrumbs.astro";
import CodeFence from "@Component/CodeFence.astro";
import Related from "@Component/Related.astro";
import StudyLedger from "@Component/StudyLedger.astro";
---

<Base
	Title="BENCHMARKS // APHRODITE"
	Description="Aphrodite benchmarks: up to 610x compression on the standard corpus (132x overall, 106 KB to 800 B), 8-40 ms end-to-end, 40-123 ns classification, and the 200-session real-world study."
>
	<main
		class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-24 px-5 py-32 sm:px-8 lg:gap-40 lg:px-14 lg:py-56"
	>
		<Breadcrumbs />
		<header class="relative flex w-full flex-col items-start">
			<div
				class="mb-5 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				BENCHMARKS // MEASURED FIGURES
			</div>
			<h1
				class="font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-5xl"
			>
				Benchmarks
			</h1>
			<p class="mt-6 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				These figures come from the project's own benchmarks and from a study of the
				author's real Hermes sessions.
			</p>
			<p class="mt-3 max-w-3xl font-body text-base leading-relaxed text-bone-newsprint">
				Benchmark ratios are measured; session savings are estimated, and the uncertainty
				band is shown below.
			</p>
		</header>

		<!-- HEADLINE NUMBERS: MONUMENT ROW. 2x2 through the tablet/wide
		     range; the four monument cards only go 4-across at xl, where
		     each card keeps room for the enlarged headline numbers. -->
		<section class="relative grid w-full grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 xl:grid-cols-4 xl:gap-6">
			<div
				class="zine-box-crimson relative -rotate-[1.8deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0"
			>
				<div
					class="absolute -top-3.5 left-6 border border-black bg-raw-blood px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
				>
					MAX COMPRESSION
				</div>
				<div
					class="font-headline text-4xl font-black tracking-tighter text-bone-white drop-shadow-[3px_3px_0px_#520612] sm:text-5xl"
				>
					610&times;
				</div>
				<p class="mt-4 border-t border-oxblood-dark pt-3 text-base text-zinc-dust">
					Best case on large low-entropy prose. <span class="text-weathered-teal">132&times; overall on the same corpus, 106 KB &rarr; 800 B.</span>
					<span class="mt-1 block text-base text-zinc-dust">The best case is not part of the per-type chart below - that chart peaks at 416&times;.</span>
					<span class="mt-1 block text-base text-zinc-dust">SRC: README.md:12, 446</span>
				</p>
			</div>
			<div
				class="zine-box-canary relative rotate-[2.2deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 lg:translate-y-3"
			>
				<div
					class="absolute -top-3.5 left-6 border border-black bg-stamped-canary px-3 py-0.5 text-base font-black uppercase tracking-widest text-soot-black shadow-[2px_2px_0px_#000]"
				>
					END-TO-END
				</div>
				<div
					class="font-headline text-4xl font-black tracking-tighter text-bone-white drop-shadow-[3px_3px_0px_#520612] sm:text-5xl"
				>
					8-40 ms
				</div>
				<p class="mt-4 border-t border-oxblood-dark pt-3 text-base text-zinc-dust">
					Including the HTTP round-trip; the headline figure is ~10 ms.
					<span class="mt-1 block text-base text-zinc-dust">SRC: README.md:460, 12</span>
				</p>
			</div>
			<div
				class="zine-box-subtle relative -rotate-[1deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0"
			>
				<div
					class="absolute -top-3.5 left-6 border border-black bg-weathered-teal px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
				>
					CLASSIFICATION
				</div>
				<div
					class="font-headline text-4xl font-black tracking-tighter text-bone-white drop-shadow-[3px_3px_0px_#520612] sm:text-5xl"
				>
					40-123 ns
				</div>
				<p class="mt-4 border-t border-oxblood-dark pt-3 text-base text-zinc-dust">
					The compress path itself stays under 1 ms.
					<span class="mt-1 block text-base text-zinc-dust">SRC: README.md:461, 133; docs/README.md:7</span>
				</p>
			</div>
			<div
				class="zine-box-subtle relative rotate-[2.5deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 lg:translate-y-3"
			>
				<div
					class="absolute -top-3.5 left-6 border border-black bg-bone-newsprint px-3 py-0.5 text-base font-black uppercase tracking-widest text-soot-black shadow-[2px_2px_0px_#000]"
				>
					MEDIAN
				</div>
				<div
					class="font-headline text-4xl font-black tracking-tighter text-bone-white drop-shadow-[3px_3px_0px_#520612] sm:text-5xl"
				>
					23&times;
				</div>
				<p class="mt-4 border-t border-oxblood-dark pt-3 text-base text-zinc-dust">
					Fewer tokens on tool output - the median the README reports for its per-type table.
					<span class="mt-1 block text-base text-zinc-dust">SRC: README.md:459</span>
				</p>
			</div>
		</section>

		<!-- PER-TYPE STAT BARS -->
		<section class="relative w-full rotate-[0.6deg] transition-transform duration-300 hover:rotate-0">
			<div
				class="absolute -top-4 right-10 z-20 border border-black bg-stamped-canary px-4 py-1 text-base font-black uppercase tracking-widest text-soot-black shadow-[3px_3px_0px_#000]"
			>
				MEASURED // PER-TYPE COMPRESSION
			</div>
			<div
				class="zine-box-crimson relative overflow-hidden border-4 border-blood-crimson bg-carbon-void p-6 sm:p-10"
			>
				<div class="mb-8 text-base font-bold uppercase tracking-wider text-zinc-dust">
					RATIO BY OUTPUT CLASS (README STANDARD CORPUS, LOG SCALE):
				</div>
				<div class="space-y-5">
					<div>
						<div class="mb-1 flex justify-between text-base font-bold">
							<span class="text-bone-newsprint">BROWSER SNAPSHOT</span>
							<span class="text-weathered-teal">416&times;</span>
						</div>
						<div class="flex h-4 w-full overflow-hidden border border-oxblood-dark bg-soot-black">
							<div class="h-full bg-weathered-teal" style="width: 100%;"></div>
							<div class="h-full bg-raw-blood" style="width: 0%;"></div>
						</div>
					</div>
					<div>
						<div class="mb-1 flex justify-between text-base font-bold">
							<span class="text-bone-newsprint">BUILD OUTPUT</span>
							<span class="text-zinc-dust">140&times;</span>
						</div>
						<div class="flex h-4 w-full overflow-hidden border border-oxblood-dark bg-soot-black">
							<div class="h-full bg-raw-blood" style="width: 82%;"></div>
							<div class="h-full bg-stamped-canary" style="width: 18%;"></div>
						</div>
					</div>
					<div>
						<div class="mb-1 flex justify-between text-base font-bold">
							<span class="text-bone-newsprint">JSON</span>
							<span class="text-stamped-canary">40&times;</span>
						</div>
						<div class="flex h-4 w-full overflow-hidden border border-oxblood-dark bg-soot-black">
							<div class="h-full bg-stamped-canary" style="width: 61%;"></div>
							<div class="h-full bg-asphalt-panel" style="width: 39%;"></div>
						</div>
					</div>
					<div>
						<div class="mb-1 flex justify-between text-base font-bold">
							<span class="text-bone-newsprint">GIT DIFF</span>
							<span class="text-zinc-dust">23&times;</span>
						</div>
						<div class="flex h-4 w-full overflow-hidden border border-oxblood-dark bg-soot-black">
							<div class="h-full bg-raw-blood" style="width: 52%;"></div>
							<div class="h-full bg-asphalt-panel" style="width: 48%;"></div>
						</div>
					</div>
					<div>
						<div class="mb-1 flex justify-between text-base font-bold">
							<span class="text-bone-newsprint">TERMINAL</span>
							<span class="text-stamped-canary">20&times;</span>
						</div>
						<div class="flex h-4 w-full overflow-hidden border border-oxblood-dark bg-soot-black">
							<div class="h-full bg-stamped-canary" style="width: 50%;"></div>
							<div class="h-full bg-asphalt-panel" style="width: 50%;"></div>
						</div>
					</div>
				</div>
				<p class="mt-6 text-base text-zinc-dust">SRC: README.md:451-457</p>
			</div>
		</section>

		<!-- REAL-WORLD STUDY -->
		<section class="relative w-full">
			<div
				class="mb-5 -rotate-1 border border-black bg-raw-blood px-3 py-1 text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				REAL-WORLD STUDY // 200 SESSIONS
			</div>
			<div
				class="zine-box-crimson relative w-full -rotate-[1.2deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-10"
			>
				<!-- The canonical structured study module (Component/StudyLedger):
				     header row, key-value ledger with the voice colors, the
				     session-shape ratio bars, the caveat note and the linked SRC
				     citation - one form shared with the index telemetry module. -->
				<StudyLedger Scale="full" ShowBars />
			</div>
		</section>

		<!-- REPRODUCE -->
		<section class="relative w-full lg:w-8/12 lg:self-start">
			<div
				class="zine-box-crimson relative rotate-[1.4deg] border-4 border-blood-crimson bg-carbon-void p-6 transition-transform duration-300 hover:rotate-0 sm:p-8"
			>
				<div
					class="absolute -top-3.5 left-6 border border-black bg-weathered-teal px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
				>
					REPRODUCE // BENCH HARNESS
				</div>
				<CodeFence
					Class="mt-2 border border-oxblood-dark"
					Code={`# requires a source checkout + Rust (see the SETUP page for versions)
$ git clone https://github.com/PlayForm/Aphrodite.git && cd Aphrodite
$ git submodule update --init --recursive
$ cargo run --release -p aphrodite --example bench_01_corpus
$ cargo run --release -p aphrodite --example bench_02_threshold
$ cargo run --release -p aphrodite --example bench_03_retrieve
$ cargo run --release -p aphrodite --example bench_04_ema
$ cargo run --release -p aphrodite --example bench_05_type_coverage`}
				/>
				<p class="mt-4 text-base text-zinc-dust">SRC: README.md:463</p>
			</div>
		</section>

		<!-- RELATED: the natural neighbors -->
		<Related
			Links={[
				{ Href: "/case-study/", Label: "CASE STUDY" },
				{ Href: "/versions/", Label: "VERSIONS" },
				{ Href: "/crates/", Label: "CRATES" },
			]}
		/>
	</main>
</Base>
