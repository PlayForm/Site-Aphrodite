---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import ZineTape from "@Component/ZineTape.astro";
import ZineSource from "@Component/ZineSource.astro";
import ZineStatBar from "@Component/ZineStatBar.astro";
import ZineLedger from "@Component/ZineLedger.astro";
import ZineLesson from "@Component/ZineLesson.astro";
import ZineFold from "@Component/ZineFold.astro";
import ZineReveal from "@Component/ZineReveal.astro";
import StudyLedger from "@Component/StudyLedger.astro";
import CodeFence from "@Component/CodeFence.astro";

import { Routes } from "@Library/Links";
import {
	Band,
	Benchmark,
	ClassId,
	Cite,
	Figure,
	Figures,
	Narrative,
	Provenance,
	SourceRevision,
	Study,
} from "@Library/Numbers";

// ONE QUESTION PER CHAPTER.
//
// The page used to open with four equally emphatic plates and then explain, in
// paragraphs further down, how to read them. That is the wrong way round: a
// reader met four monuments before knowing what question each answered, and
// every one of them shouted, so none of them landed.
//
// It now runs in the Stitch benchmark structure - seven numbered chapters, each
// opening on its own section rule and asking one question:
//
//   01  BENCHMARKS    How much output is replaced?          the headline, the corpus, the method
//   02  PILLARS       What overhead does it add?            the round-trip, the two small costs, what it buys
//   03  MECHANISM     Ratio by output class                 the per-type table, the bars, the log axis
//   04  PROFILE       What happened in recorded sessions?   the study, and the shape of a session
//   05  FIELD AUDIT   What did the field data show?         coverage, the two rates, the retrieval tax
//   06  REPRODUCE     How can I reproduce this?             the harness, the preconditions, the provenance chain
//   07  INTEGRITY     Where the figures stop                the register, the two halves, the limits
//
// Each figure is a record with a stable ID, a unit, a scope, a kind and a
// method (`Source/Library/Numbers.ts`), and this page joins those records by ID.
// Nothing here types a number, and a label cannot drift onto a neighbouring
// figure's value: `Figure("...")` throws naming the ID instead.
//
// EXPRESSIVE BUDGET: ONE ASSEMBLY PER PAGE. The ceiling is the page's brand
// moment, and it is the only inverted sheet on it: a bone sand pod, pasted down
// on the grammar's hard offset plane, leaning two degrees. Every other record is
// a shell card - a workbench module with a one-pixel edge, its stage colour on
// the left edge and its tape on the top. The chapter rule above each section
// does the rest of the hierarchy, so no card has to shout to be found.
//
// COLOUR IS IDENTITY, NEVER DECORATION. The four stage accents survive the
// re-layout exactly where they were: crimson for the ceiling, bone for the
// median, canary for the round-trip, teal for the classification. The four
// evidence badges in the register carry the same rule - measured, estimated,
// simulated, derived - and a badge is a word plus a colour, never a colour alone.

/** A pillar card: one figure, its scope, and the sentence that keeps it honest. */
interface Pillar {
	/** The figure record this card prints. */
	Id: string;

	Tape: string;
	TapeColor: "raw" | "canary" | "teal" | "bone";

	/** The stage colour that identifies this pillar - its tape, its left edge and
	 * its badge. Colour is identity, so this is never picked for contrast alone. */
	Accent: "crimson" | "canary" | "teal" | "bone";

	Caption: string;
	Body: string[];
	Src: string;
}

/** A stage accent as the custom property the card's left edge paints with. The
 * edge is a FILL, not ink: `--raw-blood` measures 2.23:1 as text on a shell card,
 * which is why crimson carries a solid tape and never a crimson sentence. */
const AccentInk = {
	crimson: "--raw-blood",
	canary: "--stamped-canary",
	teal: "--weathered-teal",
	bone: "--bone-newsprint",
} as const;

// THE PER-TYPE VOCABULARY - keyed by FIGURE ID, never by the README's label.
//
// The ID is what `Numbers.ts` registers (`benchmark.class.<slug>`); the label,
// the tone and the corpus sentence are this page's voice. A class the README
// grows without a row here stops the build rather than rendering unlabelled -
// which is the difference between a chart and a list of numbers. `Corpus` says
// what the sample behind each row actually is, because a ratio for "JSON" is
// meaningless until the reader knows which JSON.
const Chart: Record<string, { Label: string; Color: "teal" | "raw" | "canary"; Corpus: string }> = {
	"benchmark.class.browser-snapshot": {
		Label: "BROWSER SNAPSHOT",
		Color: "teal",
		Corpus: "one serialised page: every element, every attribute, the same wrapper nesting repeated to the leaves",
	},
	"benchmark.class.build-output": {
		Label: "BUILD OUTPUT",
		Color: "raw",
		Corpus: "a compiler and linker log - repeated paths, repeated warning shapes, one error restated at the end",
	},
	"benchmark.class.json-blob": {
		Label: "JSON",
		Color: "canary",
		Corpus: "one structured API payload: keys, nesting, and the values a reader needs kept byte-exact",
	},
	"benchmark.class.git-diff": {
		Label: "GIT DIFF",
		Color: "raw",
		Corpus: "a patch: hunk headers, context lines, and the same file path on both sides of every change",
	},
	"benchmark.class.terminal-output": {
		Label: "TERMINAL",
		Color: "canary",
		Corpus: "shell output - listings, test runners, the progress lines that carry no verdict",
	},
};

// THE PER-TYPE ROWS - the README's standard-corpus table, largest ratio first.
// `Scale` is the numeric ratio the generator read; `Percent` is its log-scale
// position, computed by the generator so a bar can never disagree with the
// figure beside it. The table above the bars states the raw counts, because a
// filled bar on a log scale invites a proportional reading a five-sample corpus
// cannot support.
const Classes = [...Benchmark.Classes]
	.sort((Left, Right) => Right.Ratio - Left.Ratio)
	.map((Entry) => {
		const Id = ClassId(Entry.Label);
		const Vocabulary = Chart[Id];

		if (Vocabulary === undefined) {
			throw new Error(
				`[Benchmarks] the per-type table registers "${Id}" (README label "${Entry.Label}"), which this page has no label or corpus sentence for. Add it to the Chart map in Source/pages/benchmarks.astro.`,
			);
		}

		return {
			Id,
			...Vocabulary,
			Fact: Figure(Id),
			Ratio: Entry.Savings,
			Percent: Entry.Percent,
			Scale: Entry.Ratio,
			Without: Entry.Without,
			With: Entry.With,
		};
	});

const Peak = Classes[0]!;
const RunnerUp = Classes[1]!;
const Floor = Classes[Classes.length - 1]!;

// THE LOG AXIS, MADE EXPLICIT. A bar chart whose bars are log positions is a
// ranking, not a proportion; a reader without the ticks reads 416× as "four
// times 100×". These are the decade marks, positioned by the same log function
// the generator used for the widths.
const Ticks = [1, 10, 100].map((Value) => ({
	Label: `${Value}×`,
	Left: (Math.log10(Value) / Math.log10(Peak.Scale)) * 100,
}));

// 01 // BENCHMARKS - THE HEADLINE
//
// The ceiling is the page's one monument and it carries its own qualifier: it is
// the best case on ONE long low-entropy document, and its body says so. It is
// also the only inverted sheet on the page - the sand pod the Stitch structure
// asks for, where every other record is a shell card on the dark ground.
const Ceiling: Pillar = {
	Id: "benchmark.ceiling",
	Tape: "MAX COMPRESSION",
	TapeColor: "raw",
	Accent: "crimson",
	Caption: "THE CEILING // THE BEST CASE, ON ONE DOCUMENT",
	Body: [
		"Best case on large low-entropy prose.",
		`${Benchmark.Overall} overall on the same corpus, ${Benchmark.CorpusIn} → ${Benchmark.CorpusOut}.`,
		`The best case is not part of the per-type chart - that chart peaks at ${Peak.Ratio}.`,
	],
	Src: `SRC: ${Cite(Benchmark.From)}`,
};

// THE MEDIAN - the ordinary case, a record under the method that defines it,
// carrying the qualification its caption used to claim away. Bone accent: the
// median is the plainest of the four figures and its colour says so.
const Median: Pillar = {
	Id: "benchmark.median",
	Tape: "MEDIAN // THE TYPICAL CASE",
	TapeColor: "bone",
	Accent: "bone",
	Caption: "MEDIAN REDUCTION ACROSS THE REPORTED SAMPLES",
	Body: [
		"Fewer tokens on tool output - the median the README reports for its per-type table.",
		`It is the number the README reports for that table, and it is the one to plan a context budget against.`,
		`That over-reads a median across ${Classes.length} selected samples. What a session actually saves depends on the output type, on the size of that output, on how much of it repeats, on where the per-type thresholds sit, and on how often the agent retrieves instead of reading the preview.`,
	],
	Src: `SRC: ${Cite(Benchmark.From)}`,
};

// 02 // PILLARS - THE COST AXIS
//
// Four cards, one per cost a reader weighing a proxy in front of their client
// actually needs: the round-trip they will wait for, the two costs too small to
// see on that axis, and what the overhead buys.
const Latency: Pillar = {
	Id: "benchmark.latency",
	Tape: "END-TO-END",
	TapeColor: "canary",
	Accent: "canary",
	Caption: "THE LATENCY BAND",
	Body: [
		`Including the HTTP round-trip; the headline figure is ${Benchmark.LatencyHeadline}.`,
		"Eight milliseconds is the fast case, forty the slow one: one call, compression and retrieve path included.",
	],
	Src: `SRC: ${Cite(Benchmark.From)}`,
};

const Classification: Pillar = {
	Id: "benchmark.classify",
	Tape: "CLASSIFICATION",
	TapeColor: "teal",
	Accent: "teal",
	Caption: "THE FLOOR",
	Body: [
		"Classification is the step before it: naming the content type costs nanoseconds, and it runs on every call.",
	],
	Src: `SRC: ${Cite(Benchmark.From)}`,
};

// The compress step is the second of the two costs too small for the latency
// axis, and it has its own record - so it is a card of its own rather than a
// sentence inside the classification card.
const CompressStep: Pillar = {
	Id: "benchmark.compress-step",
	Tape: "THE COMPRESS STEP",
	TapeColor: "teal",
	Accent: "teal",
	Caption: "THE STEP BEFORE THE PREVIEW",
	Body: [`The whole compress step is ${Narrative.CompressStep}.`],
	Src: `SRC: ${Cite(Narrative.From)}`,
};

// The four figures the template prints by name rather than through a loop.
const CeilingFact = Figure(Ceiling.Id);
const MedianFact = Figure(Median.Id);
const LatencyFact = Figure(Latency.Id);
const ClassificationFact = Figure(Classification.Id);
const CompressStepFact = Figure(CompressStep.Id);

// THE HARNESS - five examples in the aphrodite crate, one per question the
// figures above answer. Each body is the example's own promise: what it spawns,
// what it asserts, and what makes it exit non-zero.
const Harness = [
	{
		Tag: "01",
		Label: "bench_01_corpus - the standard corpus, end to end",
		Body: "Spawns the cache and token proxies on benchmark ports, pushes one sample per content type through <code>/ccr/create</code>, retrieves each one through <code>/retrieve</code>, then prints the per-label table. Exits non-zero on any retrieve miss, so a ratio it prints is a ratio that survived the round-trip.",
	},
	{
		Tag: "02",
		Label: "bench_02_threshold - the size boundaries",
		Body: "Sweeps <code>/ccr/create</code> and <code>/retrieve</code> across the threshold-adjacent sizes - the inline zone, then 1 KB, 4 KB and 8 KB - in both cache and token mode. Content is always stored, a hash is always returned, and the stored bytes come back byte-for-byte; a boundary violation exits non-zero.",
	},
	{
		Tag: "03",
		Label: "bench_03_retrieve - retrieval correctness",
		Body: "Ten labelled cases: same-port retrieve in both modes, cross-port isolation in both directions, the inline zone, UTF-8 content retrieved byte-for-byte, a fifty-insert storm with no misses, deletion, and a double store of the same content. This is the example that proves a marker is a promise and not a summary.",
	},
	{
		Tag: "04",
		Label: "bench_04_ema - the auto-tune loop",
		Body: "Drives the compression-ratio EMA through three phases: ten highly repetitive payloads, then ten near-incompressible ones, then ten more repetitive ones. The EMA must climb, decay, and partially recover - and the per-type threshold multipliers must not flip a linter or build-output sample to the wrong half.",
	},
	{
		Tag: "05",
		Label: "bench_05_type_coverage - one sample per class",
		Body: "Pushes one representative sample per content type through a token-mode proxy and reports each type's ratio plus the classifier's verdict. Build, diff, git, gitlog, ls, test, grep, Rust, Python, Go, JavaScript, JSON, error, log, linter and plain text: a type that fails to compress, or whose retrieve round-trip misses, exits non-zero.",
	},
];

// WHAT A RUN NEEDS - the preconditions, stated before the commands so a reader
// who lacks one of them learns it here rather than from a linker error.
const Needs = [
	{
		Label: "A source checkout",
		Text: "The examples live in the aphrodite crate, not in the published binary - clone the repository, because cargo install ships the binary and not the harness.",
	},
	{
		Label: "A Rust toolchain",
		Text: "The versions the site builds against are on the SETUP page; the harness is ordinary cargo, so a toolchain that builds the crate builds the benchmarks.",
	},
	{
		Label: "Initialised submodules",
		Text: "The plugin and the vendored Headroom fork are submodules - without them the crate resolves but the integration path does not.",
	},
	{
		Label: "The release profile",
		Text: "Every figure is a release run - the harness commands pass --release - and a debug build is not comparable to the plates.",
	},
];

// THE SESSION SHAPES - the study's four ranges, joined BY ID.
//
// `Band(Id)` finds the generated row whose range the ID claims, so a reordered
// README relabels nothing and a renamed range stops the build. The fourth shape
// is a SIMULATED workload: it never happened, it is tagged, and it is rendered
// in its own block after the three recorded shapes rather than as a fourth peer.
const Shape = [
	{ Id: "study.band.chat-only", Label: "CHAT-ONLY SESSIONS", Color: "zinc" as const },
	{ Id: "study.band.light-developer", Label: "LIGHT DEVELOPER SESSIONS", Color: "teal" as const },
	{ Id: "study.band.tool-heavy", Label: "TOOL-HEAVY SESSIONS", Color: "teal" as const },
	{
		Id: "study.band.pure-tool",
		Label: "SIMULATED PURE-TOOL LOOP",
		Color: "raw" as const,
		Note: "a simulated diff+ls+build+search workload - a stress test, not real usage",
	},
];

const Shapes = Shape.map(({ Id, Label, Color, ...Rest }) => ({
	Id,
	Label,
	Color,
	...Rest,
	...Band(Id),
}));

const RecordedShapes = Shapes.filter(({ Kind }) => Kind !== "simulated");
const SimulatedShapes = Shapes.filter(({ Kind }) => Kind === "simulated");

const BarColor = {
	zinc: "bg-zinc-dust",
	teal: "bg-weathered-teal",
	raw: "bg-raw-blood",
};

const BarText = {
	zinc: "text-zinc-dust",
	teal: "text-weathered-teal",
	// raw-blood is a FILL token: as text on soot it is 2.23:1 and fails the 4.5:1
	// floor, so a raw row would have printed its figure in an unreadable red. The
	// bar keeps the raw fill; the value takes the heading voice (ZineStatBar's
	// `Text` map makes the same call for the same reason).
	raw: "text-bone-white",
};

// THE PROVENANCE TABLE - the chain behind every figure, in the order a reader
// meets the figures on the page. The paths are the generator's own record of
// what it read, so the table cannot name a file the build did not open.
const ProvenanceRows = [
	{
		Fact: "the measured study",
		From: Provenance.Study,
		Feeds: "the session ledger, the session-shape bands, the retrieval tax",
	},
	{
		Fact: "the benchmark corpus",
		From: Provenance.Benchmark,
		Feeds: "the four plates and the per-type chart: the ceiling, the corpus totals, the per-type rows, the latency band, the classification floor",
	},
	{
		Fact: "the classification surface",
		From: Provenance.Narrative,
		Feeds: "the catalog count and the threshold tiers",
	},
	{
		Fact: "the classification registry",
		From: Provenance.Registry,
		Feeds: "the registry size the catalog footnote quotes",
	},
	{
		Fact: "the release history",
		From: Provenance.Releases,
		Feeds: "the release register on /versions/",
	},
].map(({ Fact, From, Feeds }) => ({
	Cells: [{ Text: Fact }, { Text: From }, { Text: Feeds }],
}));

// THE FIGURE REGISTER - every record the page prints, with the four fields a
// reader needs in order to refuse to trust it blindly: what kind of figure it
// is, what unit it counts, what it was measured over, and how it was produced.
const RegisterRows = Figures.map(({ Id, Kind, Value, Unit, Scope, Method }) => ({
	Cells: [
		{ Text: Id },
		{ Text: Kind },
		{ Text: Value, Align: "right" as const },
		{ Text: Unit },
		{ Text: Scope },
		{ Text: Method },
	],
}));
---

<Base
	Title="BENCHMARKS // APHRODITE"
	Description={`Aphrodite benchmarks: up to ${Benchmark.Ceiling} best case on the standard corpus (${Benchmark.Overall} overall, ${Benchmark.CorpusIn} to ${Benchmark.CorpusOut}), ${Benchmark.Latency} end-to-end, ${Benchmark.Classify} classification, and the ${Study.Sessions}-session real-world study.`}
>
	<PageShell Rhythm="wide" Crumbs>
		<PageHeader
			Tape="BENCHMARKS // MEASURED FIGURES"
			Title="Benchmarks"
			Lead={[
				`A tool call's output becomes part of the model's context, and a long result is paid for on every turn that carries it. These are the measurements of what Aphrodite leaves of it.`,
				`They come from the project's own benchmarks and from a study of the author's real Hermes sessions.`,
				`Benchmark ratios are measured; session savings are estimated, and the uncertainty band is stated with the estimate.`,
				`Every plate carries the corpus it was measured on and the SRC line that contains it, and the harness at the foot of the page re-derives the measured figures from a checkout.`,
				`Every figure is extracted from a pinned revision of the repository - ${SourceRevision.Branch} at ${SourceRevision.Short} for this build - so what a reader checks is the number the tree carried, not a number someone typed here.`,
			]}
		/>

		<!-- THE MAP: what the page asks, in order, and which figure answers each.
		     The four-item list is the page's original orientation, kept verbatim;
		     what is new is the sentence saying which chapter carries which. -->
		<section class="relative w-full" data-reveal>
			<div class="max-w-3xl">
				<p class="type-body text-bone-newsprint">
					Read the four together and the shape of the product is in them:
				</p>
				<ul class="prose-flow mt-4 max-w-3xl type-body text-bone-newsprint">
					<li class="border-l-4 border-raw-blood pl-4">
						a ceiling that belongs to one long document
					</li>
					<li class="border-l-4 border-raw-blood pl-4">a band for the round-trip</li>
					<li class="border-l-4 border-raw-blood pl-4">
						a floor for the step that runs on every call
					</li>
					<li class="border-l-4 border-raw-blood pl-4">
						and a median for the ordinary case.
					</li>
				</ul>
				<p class="mt-4 max-w-3xl type-body text-bone-newsprint">
					The ceiling and the median belong to the next section - how much output a marker
					replaces. The round-trip band and the classification floor belong to the one
					after it - what that replacement costs. The per-class mechanism follows, then
					the recorded sessions and the field audit, the harness, and the limits, in that
					order.
				</p>
				<p class="mt-3 max-w-3xl type-body text-zinc-dust">
					The ceiling is the number quoted in the repository's first line; the median is
					the ordinary case - the one to plan a context budget against, as far as a median
					over {Classes.length} selected samples can tell you.
				</p>
			</div>
			<ZineSource
				Lines={[
					`SRC: ${Cite(Benchmark.From)} (the ceiling, the corpus, the latency band, the classification floor)`,
					`SRC: ${Cite(Study.From)} (the ${Study.Sessions}-session study)`,
				]}
			/>
		</section>

		<!-- ============ 01 // BENCHMARKS // THE HEADLINE ============ -->
		<section class="blueprint-section relative w-full" data-reveal>
			<p class="section-index">01 // BENCHMARKS // THE HEADLINE, FOUR FIGURES</p>
			<h2 id="headline" class="mt-3 max-w-4xl type-section text-bone-white">
				How much output is replaced?
			</h2>
			<p class="mt-6 max-w-3xl type-body text-bone-newsprint">
				What follows is the best case and the corpus it belongs to, with the per-class
				detail in the mechanism chapter. Every figure in this section is measured -
				arithmetic on a fixed corpus - and the method that computes it is stated before the
				first one so the unit is never in doubt.
			</p>

			<!-- THE CEILING: the page's one expressive assembly, and its brand moment.
			     The inverted sand pod - a bone sheet pasted on the dark table with the
			     grammar's hard offset plane. Its caption and body carry the qualifier
			     that keeps it honest. The grunge ink is oxblood here rather than the
			     default bone: the drawing that reads as a light bloom on a dark plate
			     reads as a stain on a printed sheet, which is what this one is. -->
			<article
				class="grunge grunge--oxblood tier-inverted zine-box-crimson relative mt-16 flex -rotate-[1.8deg] flex-col border-4 border-blood-crimson p-8 max-sm:rotate-0 sm:p-12"
				data-grunge
			>
				<ZineTape Variant="corner" Label={Ceiling.Tape} Color={Ceiling.TapeColor} />
				<div class="mt-2 type-meta font-black">{Ceiling.Caption}</div>
				<div class="metric mt-3 !text-carbon-void drop-shadow-[3px_3px_0px_#520612]">
					{CeilingFact.Value}
					<span class="metric__unit !text-carbon-void">{CeilingFact.Unit}</span>
				</div>
				<div class="mt-3 type-body">{CeilingFact.Scope}</div>
				<div class="mt-4 border-t border-carbon-void pt-3 prose-flow">
					{Ceiling.Body.map((Sentence) => (
						<p class="type-body">{Sentence}</p>
					))}
				</div>
				<div class="mt-auto pt-6 type-meta text-carbon-void">{Ceiling.Src}</div>
			</article>

			<!-- THE WHOLE CORPUS, as records: the totals the ceiling is a best case of.
			     Three shell cards rather than three ruled columns, so each total is a
			     module with its own edge rather than a value floating on the ground. -->
			<div class="mt-16">
				<div class="section-kicker">THE WHOLE CORPUS, COUNTED AT ONCE</div>
				<div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-3">
					{[
						{ Id: "benchmark.corpus.in", Label: "CORPUS IN" },
						{ Id: "benchmark.corpus.out", Label: "CORPUS OUT" },
						{ Id: "benchmark.overall", Label: "OVERALL RATIO" },
					].map(({ Id, Label }) => {
						const Fact = Figure(Id);

						return (
							<article class="grunge shell-card flex flex-col p-6" data-grunge>
								<div class="type-meta font-bold text-zinc-dust">{Label}</div>
								<div class="mt-3 font-headline text-2xl font-black tracking-tight text-bone-white">
									{Fact.Value}
								</div>
								<div class="mt-2 type-body text-zinc-dust">
									<span class="type-meta">{Fact.Unit}</span> &bull; {Fact.Scope}
								</div>
							</article>
						);
					})}
				</div>
			</div>

			<!-- THE METHOD: what the number is before it is a number. A well, because a
			     definition is a channel cut into the page rather than a module laid on
			     top of it. -->
			<div id="method" class="mt-16">
				<div class="grunge well p-6 sm:p-8" data-grunge>
					<div class="section-kicker">METHOD // ONE PAYLOAD, COUNTED TWICE</div>
					<h3 class="mt-3 max-w-3xl type-sub text-bone-white">How a ratio is computed</h3>
					<div class="prose-flow mt-6 max-w-3xl">
						<p class="type-body text-bone-newsprint">
							A ratio is one payload counted twice: the tokens the tool produced, the
							tokens the model actually reads, and the first divided by the second.
						</p>
						<p class="type-body text-bone-newsprint">
							Nothing else enters the number - no weighting, no projection, no
							averaging across calls.
						</p>
						<p class="type-body text-bone-newsprint">
							The denominator is not the raw output minus a preview.
						</p>
						<p class="type-body text-bone-newsprint">
							It is the whole replacement the model receives: the marker, its type,
							its size, and the short preview that lets the model decide whether the
							bytes are worth retrieving.
						</p>
					</div>
					<div class="mt-8">
						<ZineLedger
