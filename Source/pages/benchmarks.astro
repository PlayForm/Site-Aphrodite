---
import Base from "@Layout/Base.astro";

import Related from "@Component/Related.astro";
import PageShell from "@Component/PageShell.astro";
import PageHeader from "@Component/PageHeader.astro";
import ZineTape from "@Component/ZineTape.astro";
import ZineBox from "@Component/ZineBox.astro";
import ZineSource from "@Component/ZineSource.astro";

// THE MEASUREMENT REGISTER - one row per figure, three row groups. The
// headline plates, the per-type ratios and the 200-session study are the same
// claim (what the numbers are), so they live in one table instead of four
// plates: a figure a reader cannot compare to its neighbours is a poster, not
// a data sheet. Every figure and every note is byte-exact from the sources the
// SRC block cites; a Group row opens a band of rows.
interface Row {
	/** A row group's label; a group row carries no figure. */
	Group?: string;
	/** A group row's second line - the study's period and scope. */
	Scope?: string;
	Measure?: string;
	Figure?: string;
	Means?: string;
}
const Rows: Row[] = [
	{ Group: "THE HEADLINE" },
	{
		Measure: "MAX COMPRESSION",
		Figure: "610×",
		Means:
			"Best case on large low-entropy prose. 132× overall on the same corpus, 106 KB → 800 B. The best case is not part of the per-type chart below - that chart peaks at 416×.",
	},
	{
		Measure: "END-TO-END",
		Figure: "8-40 ms",
		Means: "Including the HTTP round-trip; the headline figure is ~10 ms.",
	},
	{
		Measure: "CLASSIFICATION",
		Figure: "40-123 ns",
		Means: "The compress path itself stays under 1 ms.",
	},
	{
		Measure: "MEDIAN",
		Figure: "23×",
		Means: "Fewer tokens on tool output - the median the README reports for its per-type table.",
	},
	{ Group: "RATIO BY OUTPUT CLASS (README STANDARD CORPUS, LOG SCALE):" },
	{ Measure: "BROWSER SNAPSHOT", Figure: "416×" },
	{ Measure: "BUILD OUTPUT", Figure: "140×" },
	{ Measure: "JSON", Figure: "40×" },
	{ Measure: "GIT DIFF", Figure: "23×" },
	{ Measure: "TERMINAL", Figure: "20×" },
	{ Group: "REAL-WORLD STUDY // MEASURED, SEP 2026", Scope: "200 HERMES SESSIONS • 6,843 API CALLS • SEP 18-20" },
	{
		Measure: "TOKENS SAVED",
		Figure: "156,342,817",
		Means: "26.9% of the expanded context budget deflected",
	},
	{
		Measure: "WITH MARKERS / EXPANDED",
		Figure: "424,959,588 / 581,302,405",
		Means:
			"tokens as stored vs the same payload with every marker expanded (stock Hermes)",
	},
	{
		Measure: "SESSIONS SAVED",
		Figure: "183 / 200",
		Means: "median session ratio 22.9%; avg 22,921 saved per call",
	},
	{
		Measure: "SESSION-SHAPE BAND",
		Figure: "20-25% tool-heavy · 76-82% pure-tool",
		Means: "the same engine, four payoffs - savings track tool-output volume",
	},
	{
		Measure: "RETRIEVAL TAX",
		Figure: "2,275 calls / 2,011,583 tokens",
		Means: "the re-entry toll, roughly 1.3% of the tokens saved",
	},
	{ Measure: "CHAT-ONLY SESSIONS", Figure: "~0%" },
	{ Measure: "LIGHT DEVELOPER SESSIONS", Figure: "~5%" },
	{ Measure: "TOOL-HEAVY SESSIONS", Figure: "20-25%" },
	{
		Measure: "SIMULATED PURE-TOOL LOOP",
		Figure: "76-82%",
		Means: "a simulated diff+ls+build+search workload - a stress test, not real usage",
	},
];
---

<Base
	Title="BENCHMARKS // APHRODITE"
	Description="Aphrodite benchmarks: up to 610x compression on the standard corpus (132x overall, 106 KB to 800 B), 8-40 ms end-to-end, 40-123 ns classification, and the 200-session real-world study."
>
	<PageShell Rhythm="wide">
		<PageHeader
			Tape="BENCHMARKS // MEASURED FIGURES"
			Title="Benchmarks"
			Lead={[
				`These figures come from the project's own benchmarks and from a study of the author's real Hermes sessions.`,
				`Benchmark ratios are measured; session savings are estimated, and the uncertainty band is shown below.`,
			]}
		/>

		<!-- SLOT 3: one claim's evidence - the register -->
		<section class="relative w-full">
			<ZineTape Variant="section" Label="MEASURED // RATIOS + THE STUDY" />
			<ZineBox Size="lg" Rotate="-rotate-[1deg]">
				<div class="overflow-x-auto">
					<table class="w-full border-collapse font-mono text-base">
						<tbody>
							{
								Rows.map(({ Group, Scope, Measure, Figure, Means }, I) =>
									Group ? (
										<tr>
											<td
												colspan="3"
												class={`pb-1 text-base font-black uppercase tracking-widest text-stamped-canary ${
													I === 0 ? "" : "pt-10"
												}`}
											>
												{Group}
												{Scope && (
													<div class="mt-1 text-base font-bold uppercase tracking-wider text-zinc-dust">
														{Scope}
													</div>
												)}
											</td>
										</tr>
									) : (
										<tr class={I < Rows.length - 1 ? "border-b border-oxblood-dark" : ""}>
											<td class="py-3 pr-4 align-top text-base font-black text-zinc-dust">
												{Measure}
											</td>
											<td class="py-3 pr-6 align-top whitespace-nowrap text-base font-black text-weathered-teal">
												{Figure}
											</td>
											<td class="py-3 align-top text-bone-newsprint">{Means}</td>
										</tr>
									),
								)
							}
						</tbody>
					</table>
				</div>
				<p class="mt-12 border-t border-oxblood-dark pt-8 text-base leading-relaxed text-zinc-dust">
					The study is the author's own work - multi-agent atomization fan-outs, merge/PR work,
					plugin integration - reconstructed payload-by-payload from the session transcripts.
				</p>
				<p class="mt-3 text-base leading-relaxed text-zinc-dust">
					<span class="font-black uppercase tracking-widest text-stamped-canary">CAVEAT &bull; </span>
					THE EXACT PERCENTAGE IS A BAND: ~24-33% ACROSS A 3.0-4.5 CHARS/TOKEN SENSITIVITY RANGE,
					CENTERED ~27%.
				</p>
			</ZineBox>
			<ZineSource
				Lines={[
					"SRC: README.md:12, 446",
					"SRC: README.md:460, 12",
					"SRC: README.md:461, 133; docs/README.md:7",
					"SRC: README.md:459",
					"SRC: README.md:451-457",
					"SRC: README.md:467-511.",
				]}
			/>
		</section>

		<!-- SLOT 4: the onward link -->
		<Related
			Links={[
				{ Href: "/case-study/", Label: "CASE STUDY" },
				{ Href: "/versions/", Label: "VERSIONS" },
				{ Href: "/setup/", Label: "SETUP" },
			]}
		/>
	</PageShell>
</Base>
