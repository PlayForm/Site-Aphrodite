---
import Base from "@Layout/Base.astro";
import DocsSidebar from "../../Component/DocsSidebar.astro";
import Related from "../../Component/Related.astro";
import ZineDiagramNav from "../../Component/ZineDiagramNav.astro";
import { Link as RepoLink, OurRepo, Routes } from "../../Library/Links.ts";

import CcrPipeline from "../../Content/Mermaid/ccr-pipeline.svg?raw";
import ConfigResolution from "../../Content/Mermaid/config-resolution.svg?raw";
import DualListener from "../../Content/Mermaid/dual-listener.svg?raw";
import MarkerFormat from "../../Content/Mermaid/marker-format.svg?raw";
import SessionLifecycle from "../../Content/Mermaid/session-lifecycle.svg?raw";

import { getCollection, render } from "astro:content";

// One page per generated docs entry; the root entry (id "index") builds /docs/.
export async function getStaticPaths() {
	const Docs = await getCollection("Docs");

	return Docs.map((Doc) => ({
		params: { slug: Doc.id === "index" ? undefined : Doc.id },
		props: { Doc },
	}));
}

const { Doc } = Astro.props;

const { Content, headings } = await render(Doc);

// The in-page outline: the page's OWN headings, never a hand-maintained list.
// Astro assigns each rendered heading an id (github-slugger) and reports the
// same slug here, so every entry resolves to a real anchor on this page. The
// body h1 is dropped: the page header already carries the title.
const Toc = headings
	.filter(({ depth }) => depth === 2 || depth === 3)
	.map(({ depth, slug, text }) => ({ Depth: depth, Id: slug, Label: text }));

// A page with no h2/h3 has no outline to speak of, so the rail and the narrow
// disclosure stay out of the way; a page with even one gets its entry, because
// the list is the page's own headings and never a judgement about them.
const HasToc = Toc.length > 0;

// The WIP docs: pages that document partly unimplemented or roadmap-only
// functionality (Centers: v1 shipped, v2-v4 are design sketches). They carry
// the WIP badge in the sidebar, the section cards, and the page header.
const WipDocs = new Set(["centers"]);

const Pages = await getCollection("Docs");

// A folder inside a section (docs/ccr/backends/*) is a real level of the
// hierarchy, so the sidebar renders it as its own cluster instead of four flat
// siblings. An entry opens a group when it sits inside the folder
// (ccr/backends/sqlite) or when it IS the folder's index page (ccr/backends) -
// the index page is the one whose title names the group.
const IsFolderIndex = (Id: string) =>
	Pages.some((Page) => Page.id.startsWith(`${Id}/`));

const GroupKeyOf = (Id: string) => {
	const Segments = Id.split("/");

	switch (true) {
		case Segments.length >= 3:
			return Segments.slice(1, -1).join("/");
		case Segments.length === 2 && IsFolderIndex(Id):
			return Segments[1];
		default:
			return undefined;
	}
};

const GroupLabels = new Map(
	Pages.filter((Page) => IsFolderIndex(Page.id)).map((Page) => [
		Page.id.split("/").slice(1).join("/"),
		Page.data.title,
	]),
);

// ── THE EDITORIAL READING ORDER ───────────────────────────────────────────
// The collection's id order is deterministic, not a learning path: it is
// alphabetical inside a section and it says nothing about which section a
// reader should meet first. This table is the missing editorial layer - the
// stages of the documentation, in the order the product is learned. It orders
// only; every destination still comes from the collection, so a new page joins
// the sequence without an edit here and nothing can be added or lost by it.
//
// A section the table does not name keeps alphabetical position after the
// named ones. Troubleshooting is not a section of its own (install/troubleshooting
// sits inside Install), which is why the stage list names nine stages for
// thirteen sections.
const ReadingStages: readonly { Stage: string; Sections: readonly string[] }[] = [
	{ Stage: "Start here", Sections: ["Overview"] },
	{ Stage: "Installation", Sections: ["Install"] },
	{ Stage: "Core concepts", Sections: ["CCR", "Classification"] },
	{ Stage: "Hermes integration", Sections: ["Plugin", "Guides", "Tool Relay"] },
	{ Stage: "Proxy integration", Sections: ["Proxy"] },
	{ Stage: "Configuration", Sections: ["Config"] },
	{ Stage: "API reference", Sections: ["API", "Metrics"] },
	{ Stage: "Architecture", Sections: ["Architecture"] },
	{ Stage: "Examples", Sections: ["Examples"] },
];

const ReadingOrder = ReadingStages.flatMap(({ Sections: Names }) => Names);

const OrderOf = (Section: string) => {
	const Position = ReadingOrder.indexOf(Section);

	return Position === -1 ? ReadingOrder.length : Position;
};

// A section's own page opens it: the docs root opens Overview, and a section
// index page (architecture/index.md, which the collection serves as the id
// "architecture") opens its section. Id order alone would put "centers" ahead
// of the docs root. This is DocsSidebar's RankOf verbatim, so the rail and the
// reading order never disagree about which page opens a section.
const RankOf = (Name: string, Id: string) =>
	Id === "index" || Id.toLowerCase() === Name.toLowerCase() ? 0 : 1;

const Sections = [
	...Pages.sort((A, B) => A.id.localeCompare(B.id))
		.reduce(
			(Groups, Page) => {
				const Key = GroupKeyOf(Page.id);

				Groups.set(Page.data.section, [
					...(Groups.get(Page.data.section) ?? []),
					{
						Id: Page.id,
						Title: Page.data.title,
						Wip: WipDocs.has(Page.id),
						Group: Key === undefined ? undefined : (GroupLabels.get(Key) ?? Key),
					},
				]);

				return Groups;
			},
			new Map<
				string,
				{ Id: string; Title: string; Wip: boolean; Group?: string }[]
			>(),
		)
		.entries(),
]
	// The editorial order, not Overview-then-alphabetical: the rail, the
	// prev/next sequence and the next steps all read this one array, so a
	// reader can never be sent backwards through the stage list.
	.sort(([A], [B]) => OrderOf(A) - OrderOf(B) || A.localeCompare(B))
	.map(([Name, Entries]) => ({
		// The group's own page opens it, then id order - the docs tree's numeric
		// prefixes (architecture/01-startup) ARE its reading order. Same rank
		// rule as DocsSidebar, so prev/next and the rail are one sequence and a
		// reader never steps backwards through the rail.
		Entries: [...Entries].sort(
			(A, B) => RankOf(Name, A.Id) - RankOf(Name, B.Id) || A.Id.localeCompare(B.Id),
		),
		Name,
	}));

// Reading order for the prev/next navigation: the flattened section tree.
const Sequence = Sections.flatMap(({ Entries }) => Entries);

const Position = Sequence.findIndex((Entry) => Entry.Id === Doc.id);

const Previous = Position > 0 ? Sequence[Position - 1] : undefined;
const Next = Position > -1 && Position < Sequence.length - 1 ? Sequence[Position + 1] : undefined;

const Href = (Id: string) => (Id === "index" ? "/docs/" : `/docs/${Id}/`);

// The pre-rendered Mermaid SVGs, embedded per the placement map. The markdown
// sources keep their ```mermaid blocks (they render as plain stream panes);
// the rendered diagram rides above the prose in a [data-diagram] figure.
const Diagrams: Record<string, { Id: string; Label: string; Svg: string }> = {
	"architecture/01-startup": { Id: "ccr-pipeline", Label: "M1 // CCR PIPELINE", Svg: CcrPipeline },
	"ccr/lifecycle": { Id: "ccr-pipeline", Label: "M1 // CCR PIPELINE", Svg: CcrPipeline },
	"ccr/marker-format": { Id: "marker-format", Label: "M6 // MARKER FORMAT", Svg: MarkerFormat },
	"architecture/07-config-resolution": {
		Id: "config-resolution",
		Label: "M7 // CONFIG RESOLUTION",
		Svg: ConfigResolution,
	},
	"architecture/05-ccr-lifecycle": {
		Id: "session-lifecycle",
		Label: "M8 // SESSION LIFECYCLE",
		Svg: SessionLifecycle,
	},
	"proxy/architecture": { Id: "dual-listener", Label: "M5 // DUAL LISTENER", Svg: DualListener },
};

const Diagram = Diagrams[Doc.id];

// A section index page is a README-derived entry whose id matches its section
// folder ("architecture", "guides", ...); the root entry is id "index".
const IsSectionIndex =
	Doc.id !== "index" && Doc.id.toLowerCase() === Doc.data.section.toLowerCase();

const IsIndex = Doc.id === "index" || IsSectionIndex;

const IndexEntries = IsSectionIndex
	? [
			{
				Name: Doc.data.section,
				// The card grid always consumes { Name, Entries } groups; on the
				// section-index routes the group is this section's own page list.
				Entries: (Sections.find(
					({ Name }) => Name.toLowerCase() === Doc.data.section.toLowerCase(),
				)?.Entries ?? []).filter((Entry) => Entry.Id !== Doc.id),
			},
		]
	: Sections.filter(({ Name }) => Name !== "Overview");

// ── AUTHORED SUMMARIES ────────────────────────────────────────────────────
// One line per page, written for the reader: what the page is for, in the
// voice the page itself uses. This is the text behind the index cards, the
// page's meta description and the next-step reasons.
//
// It is authored HERE, not in the generated frontmatter, because the docs
// pages are OUTPUT: `Scripts/Docs/Generate.ts` rewrites each page's
// frontmatter (title, section, source) on every `pnpm run Docs`, so a
// `summary:` written into Source/Content/Docs/*.md is reverted by the next
// generation - silently, with no diff and no error. Moving these into the
// frontmatter is a two-file change outside this route (the collection schema
// in Source/content.config.ts plus the generator that writes the field); until
// that lands, this table is the durable home and `Purpose()` below is the
// fallback for a page with no entry.
const Summaries: Record<string, string> = {
	"api/ccr-endpoints":
		"The loopback-only CCR endpoints that let external tools and scripts create, list and resolve stored entries.",
	"api/health": "GET /health - the public liveness check for load balancers and monitoring systems.",
	"api/metrics-endpoint":
		"GET /metrics - the proxy's counters, gauges and latency histogram, as Prometheus metrics.",
	"api/retrieve":
		"POST /retrieve resolves a CCR hash back to its original content, with optional line filtering.",
	"architecture/01-startup":
		"The two halves of the Aphrodite startup path, traced end to end.",
	"architecture/02-chat-compression":
		"The token and cache proxies' central flow, from the upstream response to the compressed reply.",
	"architecture/03-retrieve":
		"The two retrieval paths that turn a CCR marker back into its original content.",
	"architecture/04-hook-ffi":
		"The Hermes plugin path - a hook fires, the Python ctypes shim resolves the dylib, and the call crosses the FFI boundary.",
	"architecture/05-ccr-lifecycle":
		"The state machine of one CCR entry, from creation through storage, preview and retrieval.",
	"architecture/06-sse-streaming":
		"Why server-sent-event (text/event-stream) responses bypass compression, and what the proxy does instead.",
	"architecture/07-config-resolution":
		"The two independent resolution stacks - the proxy's and the dylib's - and how each reads env > TOML > default.",
	"architecture/08-dylib-loading":
		"The Python shim loads the Rust dylib exactly once per process, and this is where that load happens.",
	"architecture/09-release-ci":
		"The two GitHub Actions workflows that fire on an Aphrodite/v tag push, and what each one publishes.",
	"architecture/10-component":
		"The top-level components and the two boundaries that matter between them.",
	"architecture/11-data-model":
		"The principal data structures behind the compression engine, and what each one holds.",
	architecture: "Flow traces of every runtime path in Aphrodite, one page per path.",
	"ccr/backends/in-memory":
		"The in-memory backend - a process-local, sharded concurrent store for cache-mode deployments.",
	"ccr/backends":
		"The CCR (Compress-Cache-Retrieve) store's two full backends, and which deployment mode selects each.",
	"ccr/backends/inline":
		"Tiny entries bypass the CCR backend round-trip entirely; this is the inline path they take.",
	"ccr/backends/sqlite":
		"The SQLite backend - the production CCR store, persistent across worker restarts.",
	"ccr/lifecycle":
		"CCR (Compress-Cache-Retrieve), the lossless end-to-end compression path, from compression to retrieval.",
	"ccr/marker-format":
		"The compact marker strings that stand in for compressed content in an agent's context, and how to read each field.",
	centers:
		"A roadmap page: only v1 is implemented; v2 to v4 are design sketches for where the centers go.",
	"classification/content-types":
		"The content types the classifier labels every payload with before it enters the compression pipeline.",
	classification:
		"How the compression pipeline labels content before storage, and what each label decides.",
	"config/aphrodite-toml":
		"The single TOML file that configures Aphrodite's proxy listeners and compression engine.",
	"config/env-vars":
		"The APHRODITE_ environment variables (plus a few non-prefixed ones) that override the TOML.",
	examples:
		"Real tool results captured from live sessions against the Aphrodite 1.4.6 binary.",
	"examples/llm-view":
		"The LLM's view of the captured examples: what the model receives once compression has run.",
	"guides/hermes-integration":
		"Aphrodite connects to Hermes Agent as a native plugin, not as a proxy you point a client at.",
	"guides/hermes-tool-output-schemas":
		"Every Hermes tool returns output with its own shape - diffs, JSON envelopes and the rest - and this is how each one is classified.",
	guides:
		"Walkthrough-style pages that connect the parts of Aphrodite the way you actually use them.",
	index: "Aphrodite compresses context before it hits the LLM.",
	install: "Four correct answers to \"how do I install this\", one per platform.",
	"install/macos-linux":
		"The macOS and Linux install path - and everything that also works on Windows under Git Bash or WSL.",
	"install/troubleshooting":
		"What to check when Hermes loads the plugin and the proxy binary does not come up.",
	"install/windows":
		"Native Windows through PowerShell - download.ps1 as the direct install path.",
	"metrics/prometheus":
		"Every proxy operation exposed as counters, gauges and histograms at GET /metrics.",
	"metrics/queries":
		"PromQL reference for monitoring and alerting on the Aphrodite proxy metrics.",
	"plugin/context-engine":
		"The context engine - the dylib session's middle-turn archiver.",
	"plugin/directives":
		"Directives - short behavioural instruction files, one .md each - and what each one changes.",
	"plugin/hooks": "The six hooks the plugin registers with Hermes, and what each one is for.",
	"proxy/architecture":
		"The local reverse proxy that sits between any OpenAI-compatible client and the upstream API.",
	"proxy/compression":
		"How the proxy decides whether to compress each piece of Chat Completions response content.",
	"proxy/handlers":
		"The HTTP handlers the proxy exposes for LLM requests, CCR entries and more.",
	"proxy/retry":
		"Transient upstream failures do not fail the request; this is how the retry path works.",
	"tool-relay/callbacks": "The two distinct callback surfaces around the tool relay.",
	"tool-relay/tools":
		"The 13 tools Aphrodite exposes to the Hermes agent for compression, retrieval and stats.",
};

// The fallback, unchanged in contract: the first prose line of the page body,
// with the markdown syntax stripped. It is a fallback and not the source of
// truth, so it only has to be safe - and it is now fence-aware (a ``` block's
// first line is not prose) and link-aware (a `[label](href)` keeps its label
// and drops the destination, which used to be concatenated into the text).
const Purpose = (Body?: string) => {
	let Fenced = false;

	for (const Line of (Body ?? "").split("\n")) {
		const Trimmed = Line.trim();

		if (Trimmed.startsWith("```")) {
			Fenced = !Fenced;

			continue;
		}

		if (
			Fenced ||
			!Trimmed ||
			Trimmed.startsWith("#") ||
			Trimmed.startsWith("|") ||
			Trimmed.startsWith("<") ||
			Trimmed.startsWith(">") ||
			Trimmed.startsWith("![") ||
			Trimmed.startsWith("---")
		) {
			continue;
		}

		const Text = Trimmed
			.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
			.replace(/[*`_[\]]/g, "")
			.replace(/\s+/g, " ")
			.trim();
		const Cut = Text.indexOf(". ");

		return (Cut > 0 ? Text.slice(0, Cut + 1) : Text).slice(0, 220);
	}

	return "";
};

// One description per page: authored first, `Purpose()` where none was written.
const Purposes = new Map(
	Pages.map((Page) => [Page.id, Summaries[Page.id] ?? Purpose(Page.body)]),
);

// This page's own one-line purpose - the unique per-page meta description.
// The section template stays as the fallback for entries without prose.
const SelfPurpose = Purposes.get(Doc.id) ?? "";

// ── DENSITY ───────────────────────────────────────────────────────────────
// A narrative page earns the generous chapter break: the reader is being
// carried through an argument and a 7rem gap is the signal that the subject
// changed. A reference page is consulted, not read - its rhythm is heading,
// explanation, command or table, qualification - so the same 7rem turns it
// into a stack of landing-page sections. The mode is a property of the
// SECTION, because that is what the documentation's own taxonomy already says
// about the page; the stylesheet reads it as `[data-density]` on the article.
const ReferenceSections = new Set([
	"API",
	"Config",
	"Metrics",
	"Proxy",
	"CCR",
	"Classification",
	"Tool Relay",
	"Plugin",
]);

const Density = ReferenceSections.has(Doc.data.section) ? "reference" : "narrative";

// ── NEXT STEPS ────────────────────────────────────────────────────────────
// The foot of a page used to be prev/next alone: two destination names and no
// reason to follow either. These are the continuations a reader actually
// needs, each with the reason to take it - and all of them are read from the
// collection, so the editorial order is the only thing written by hand here.
const EntryOf = (Name: string) => {
	const Section = Sections.find(({ Name: Section }) => Section === Name);

	if (!Section) {
		return undefined;
	}

	return (
		Section.Entries.find((Entry) => Entry.Id.toLowerCase() === Name.toLowerCase()) ??
		Section.Entries[0]
	);
};

const NextStage = () => {
	const Position = ReadingStages.findIndex(({ Sections: Names }) =>
		Names.includes(Doc.data.section),
	);

	if (Position === -1) {
		return undefined;
	}

	for (const Stage of ReadingStages.slice(Position + 1)) {
		for (const Name of Stage.Sections) {
			const Entry = EntryOf(Name);

			if (Entry) {
				return { Entry, Stage: Stage.Stage };
			}
		}
	}

	return undefined;
};

const NextSteps = (() => {
	const Steps: { Href: string; Label: string; Reason?: string }[] = [];
	const SectionIndex = EntryOf(Doc.data.section);

	// The rest of this section: the section's own page names the cluster, so a
	// reader who finished one page can see what the other pages in it are.
	if (SectionIndex && SectionIndex.Id !== Doc.id) {
		Steps.push({
			Href: Href(SectionIndex.Id),
			Label: SectionIndex.Title,
			Reason: `The rest of ${Doc.data.section}, in reading order - one step of many in that section.`,
		});
	}

	const Following = NextStage();

	if (Following) {
		Steps.push({
			Href: Href(Following.Entry.Id),
			Label: Following.Entry.Title,
			Reason: `The reading order continues with ${Following.Stage}.`,
		});
	}

	// The index, for every page that is not the index: the one destination that
	// shows the whole tree rather than the next branch of it.
	if (Doc.id !== "index") {
		Steps.push({
			Href: "/docs/",
			Label: "Aphrodite Documentation",
			Reason: "Every section of the documentation, in the order a reader should meet them.",
		});
	}

	return Steps;
})();
---

<Base
	Title={`${Doc.data.title} - Aphrodite`}
	Description={
		SelfPurpose || `Aphrodite documentation - ${Doc.data.section}.`
	}
>
	<main class="relative z-10 mx-auto w-full max-w-[1440px] px-5 py-16 sm:px-8 lg:py-24">
		<!-- Mobile: the docs index opens as a full-screen drawer -->
		<button
			id="docs-nav-toggle"
			class="mb-8 flex w-full items-center justify-between border-4 border-blood-crimson bg-carbon-void px-4 py-2.5 font-mono text-base font-black uppercase tracking-widest text-bone-newsprint shadow-[4px_4px_0px_#000] xl:hidden"
			aria-expanded="false"
			aria-controls="docs-drawer"
		>
			DOCUMENTATION INDEX
			<span aria-hidden="true">+</span>
		</button>

		<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 font-mono text-base">
			<a
				class="text-stamped-canary underline decoration-2 underline-offset-4 hover:text-bone-white"
				href={Routes.Docs}
			>
				DOCS
			</a>
			<span class="text-zinc-dust" aria-hidden="true">/</span>
			<span class="uppercase tracking-widest text-zinc-dust">{Doc.data.section}</span>
			{
				!IsIndex && (
					<>
						<span class="text-zinc-dust" aria-hidden="true">
							/
						</span>
						<span class="uppercase tracking-widest text-bone-white">{Doc.data.title}</span>
					</>
				)
			}
		</nav>

		<!-- Two tracks from xl (the docs index and the reading column), three
		     only from 2xl. The reading column is the point of the page, and at
		     1280px a 17rem index plus a 15rem outline plus two 3rem gaps left it
		     roughly 608px - a narrow strip between two framed panels. The
		     outline therefore waits until all three tracks genuinely fit (96rem
		     and up) and stays a disclosure below that; the index waits until xl,
		     so a 1024px reader gets the full measure and the drawer. -->
		<div
			class={`mt-10 flex flex-col gap-16 xl:grid xl:grid-cols-[17rem_minmax(0,1fr)] xl:gap-x-16 ${
				HasToc ? "2xl:grid-cols-[17rem_minmax(0,1fr)_15rem] 2xl:gap-x-12" : ""
			}`}
		>
			<!-- Desktop: sticky sidebar. The index only - the page's outline
			     lives in the right rail (2xl) and the disclosure (below 2xl), so
			     no viewport ever shows the same list twice. -->
			<aside class="hidden xl:block">
				<div class="sticky top-24">
					<DocsSidebar
						Sections={Sections}
						CurrentId={Doc.id}
						Order={ReadingOrder}
						Label="Documentation sections"
					/>
				</div>
			</aside>

			<div class="min-w-0">
				<!-- Page header: the tape-stamp section tag above the crimson rule.
			     pt-12 pushes the whole block clear of the breadcrumb row above -
			     the section stamp's -top-7 rise previously reached the
			     breadcrumb text at the mt-10 gap. -->
				<header class="relative pt-12">
					<span
						class="absolute left-0 top-0 z-20 -rotate-1 border border-black bg-stamped-canary px-3 py-0.5 text-base font-black uppercase tracking-widest text-soot-black shadow-[2px_2px_0px_#000]"
					>
						{Doc.data.section}
					</span>
					{
						WipDocs.has(Doc.id) && (
							<span
								class="absolute right-0 top-0 z-20 rotate-1 border border-black bg-raw-blood px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
								title="Roadmap: partly unimplemented"
							>
								WIP
							</span>
						)
					}
					<h1
						class="border-b-4 border-blood-crimson pb-6 font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[3px_3px_0px_#520612] sm:text-4xl"
					>
						{Doc.data.title}
					</h1>
				</header>

				{
					Diagram && (
						<figure
							class="relative z-10 mt-16 border border-oxblood-dark bg-soot-black p-4"
							data-diagram={Diagram.Id}
							data-reveal
						>
							<div class="overflow-x-auto [&_svg]:h-auto [&_svg]:max-w-full" set:html={Diagram.Svg} />
							<figcaption class="mt-3 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
								{Diagram.Label}
							</figcaption>
						</figure>
					)
				}

				<!-- Index pages: the zine index cards with one-line purposes -->
				{
					IsIndex && (
						<section aria-label="Section index" class="relative mt-16" data-reveal>
							<h2 class="font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
								{IsSectionIndex ? "IN THIS SECTION" : "THE SECTIONS"}
							</h2>
							<div class="mt-8 grid gap-10 sm:grid-cols-2 sm:gap-x-12">
								{IndexEntries.map(({ Name, Entries }) => (
									<div class="border-l-2 border-oxblood-dark pl-5">
										<h3 class="font-mono text-base font-bold tracking-normal text-bone-white">
											{Name}
										</h3>
										<ul class="mt-3 flex flex-col gap-4">
											{Entries.filter((Entry) => Entry.Id !== Doc.id).map((Entry) => (
												<li class="flex flex-col gap-1">
													<a
														href={Href(Entry.Id)}
														aria-current={Entry.Id === Doc.id ? "page" : undefined}
														class={`font-mono text-base font-bold tracking-wide ${
															Entry.Id === Doc.id
																? "text-stamped-canary underline decoration-2 underline-offset-4"
																: "text-bone-white hover:text-stamped-canary"
														}`}
													>
														{Entry.Title}
														{Entry.Wip && (
															<span
																class="ml-2 inline-block border border-black bg-stamped-canary px-1.5 align-middle font-mono text-[13px] font-black uppercase leading-tight tracking-widest text-soot-black"
																title="Roadmap: partly unimplemented"
															>
																WIP
															</span>
														)}
													</a>
													{Purposes.get(Entry.Id) && (
														<p class="font-body text-base leading-relaxed text-zinc-dust">
															{Purposes.get(Entry.Id)}
														</p>
													)}
												</li>
											))}
										</ul>
									</div>
								))}
							</div>
						</section>
					)
				}

				<!-- Narrow viewports: the page's outline as a disclosure. Same
				     generated list as the right rail - the page derives it once
				     and presents it twice, and only one is ever visible. -->
				{
					HasToc && (
						<details class="group mt-16 border border-oxblood-dark bg-carbon-void 2xl:hidden">
							<summary
								aria-describedby="docs-outline-note"
								class="flex cursor-pointer list-none items-center justify-between px-5 py-3 font-mono text-base font-black uppercase tracking-widest text-stamped-canary [&::-webkit-details-marker]:hidden"
							>
								IN THIS DOCUMENT
								<span aria-hidden="true" class="transition-transform group-open:rotate-45">
									+
								</span>
							</summary>
							<p
								id="docs-outline-note"
								class="type-caption border-t border-oxblood-dark px-5 pb-1 pt-3 text-zinc-dust"
							>
								The section being read is marked in crimson; the list is the
								document's own headings.
							</p>
							<ul class="flex flex-col gap-1 px-5 py-4">
								{Toc.map(({ Depth, Id, Label }) => (
									<li class={Depth === 3 ? "pl-4" : undefined}>
										<a
											href={`#${Id}`}
											data-outline-link={Id}
											class="block px-2 py-0.5 font-mono text-base leading-relaxed text-zinc-dust transition-colors hover:text-bone-white aria-[current=location]:bg-raw-blood aria-[current=location]:text-bone-white"
										>
											{Label}
										</a>
									</li>
								))}
							</ul>
						</details>
					)
				}

				<!-- The reading column. One entrance for the whole column: the
				     generated markdown cannot carry attributes of its own, so the
				     column is the content root the shared runtime animates.
				     72ch is the measure: a reader's line stops where the eye can
				     return from, and the column never stretches to fill a track
				     just because the track is wide. -->
				<article
					class="docs-prose mt-16 min-w-0 max-w-[72ch]"
					data-density={Density}
					data-reveal
				>
					<Content />
				</article>

				<!-- NEXT STEPS: two or three contextual continuations, each with
				     the reason to take it. Renders nothing when the collection
				     offers none. -->
				<div class="mt-24">
					<Related Links={NextSteps} />
				</div>

				<!-- Prev / next: the zine cards at the bottom of the reading column -->
				{
					(Previous || Next) && (
						<nav
							aria-label="Docs pagination"
							class="mt-32 grid gap-16 border-t-4 border-dashed border-oxblood-dark pt-16 sm:grid-cols-2 sm:gap-8"
						>
							{Previous ? (
								<a
									href={Href(Previous.Id)}
									rel="prev"
									class="group relative border-4 border-blood-crimson bg-carbon-void p-6 zine-box-subtle transition-transform hover:-translate-y-1"
								>
									<span class="absolute -top-3.5 left-4 z-20 -rotate-1 border border-black bg-raw-blood px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]">
										PREV
									</span>
									<span class="mt-2 block font-mono text-base font-bold text-bone-white group-hover:text-stamped-canary">
										{Previous.Title}
									</span>
									<span class="mt-1 block font-mono text-base uppercase tracking-widest text-zinc-dust">
										{Href(Previous.Id)}
									</span>
								</a>
							) : (
								<span aria-hidden="true" />
							)}
							{Next ? (
								<a
									href={Href(Next.Id)}
									rel="next"
									class="group relative border-4 border-blood-crimson bg-carbon-void p-6 text-right zine-box-subtle transition-transform hover:-translate-y-1"
								>
									<span class="absolute -top-3.5 right-4 z-20 rotate-1 border border-black bg-stamped-canary px-3 py-0.5 text-base font-black uppercase tracking-widest text-soot-black shadow-[2px_2px_0px_#000]">
										NEXT
									</span>
									<span class="mt-2 block font-mono text-base font-bold text-bone-white group-hover:text-stamped-canary">
										{Next.Title}
									</span>
									<span class="mt-1 block font-mono text-base uppercase tracking-widest text-zinc-dust">
										{Href(Next.Id)}
									</span>
								</a>
							) : (
								<span aria-hidden="true" />
							)}
						</nav>
					)
				}

				<!-- Provenance, demoted to a "suggest an edit" block at the foot of
				     the page. The words are unchanged and the source is still one
				     click away: the page IS a module file, generated on every
				     build, so a reader can check the claim and the next editor
				     knows that a change belongs in the repository, not here. What
				     changed is the volume - an instruction about the site's own
				     construction sat above the article, where it competed with the
				     page's own lead. -->
				{
					Doc.data.source && (
						<aside
							aria-label="Suggest an edit"
							class="mt-24 border-t border-oxblood-dark pt-6"
						>
							<p class="type-meta uppercase tracking-widest text-zinc-dust">
								Suggest an edit
							</p>
							<p class="type-caption mt-2 max-w-[62ch] text-zinc-dust">
								<span class="uppercase tracking-widest">Generated from</span>{" "}
								<a
									class="text-stamped-canary underline decoration-2 underline-offset-4 hover:text-bone-white"
									href={RepoLink(OurRepo, Doc.data.source)}
								>
									{Doc.data.source}
								</a>{" "}
								<span class="uppercase tracking-widest">
									in the Aphrodite repository - edit it there, not the generated copy
								</span>
							</p>
						</aside>
					)
				}
			</div>

			<!-- Wide viewports: the in-page outline as a sticky right rail. The
			     entries come from the page's own headings, so the rail can never
			     drift from the anchors the renderer emitted. -->
			{
				HasToc && (
					<aside class="hidden 2xl:block">
						<div class="sticky top-24">
							<nav
								aria-label="In this document"
								aria-describedby="docs-rail-note"
								class="border-l border-oxblood-dark pl-4"
							>
								<p class="font-mono text-base font-black uppercase tracking-widest text-stamped-canary">
									IN THIS DOCUMENT
								</p>
								<p
									id="docs-rail-note"
									class="type-caption mt-2 border-b border-oxblood-dark pb-3 text-zinc-dust"
								>
									The section being read is marked in crimson; the rail follows the
									document's own headings.
								</p>
								<ul class="mt-3 flex max-h-[calc(100vh-16rem)] flex-col gap-1 overflow-y-auto">
									{Toc.map(({ Depth, Id, Label }) => (
										<li class={Depth === 3 ? "pl-3" : undefined}>
											<a
												href={`#${Id}`}
												data-outline-link={Id}
												class="block px-2 py-0.5 font-mono text-base leading-relaxed text-zinc-dust transition-colors hover:text-bone-white aria-[current=location]:bg-raw-blood aria-[current=location]:text-bone-white"
											>
												{Label}
											</a>
										</li>
									))}
								</ul>
							</nav>
						</div>
					</aside>
				)
			}
		</div>
	</main>

	<!-- Mobile drawer: the sidebar in a fixed overlay above everything -->
	<div
		id="docs-drawer"
		class="fixed inset-0 z-50 hidden xl:hidden"
		role="dialog"
		aria-modal="true"
		aria-label="Documentation index"
	>
		<div class="absolute inset-0 bg-soot-black/90" data-drawer-close></div>
		<div
			class="absolute inset-y-0 left-0 w-80 max-w-[85vw] overflow-y-auto border-r-4 border-blood-crimson bg-carbon-void p-6"
		>
			<button
				data-drawer-close
				class="mb-8 border-2 border-black bg-raw-blood px-3 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white shadow-[3px_3px_0px_#000]"
			>
				CLOSE
			</button>
			<DocsSidebar
				Sections={Sections}
				CurrentId={Doc.id}
				Order={ReadingOrder}
				Label="Documentation sections (mobile)"
			/>
		</div>
	</div>
	<ZineDiagramNav />
</Base>

<style>
	/* The markdown presentation layer, scoped to the reading column. The
	   rendered <Content /> tree is generated, so the element selectors are
	   global under the hashed .docs-prose wrapper.

	   TWO DENSITIES, ONE STYLESHEET. The rules below are the NARRATIVE
	   rhythm: the generous chapter break a reader being carried through an
	   argument needs. `[data-density="reference"]` tightens the same roles
	   into heading -> explanation -> command/table -> qualification, because a
	   reference page is consulted rather than read and the chapter break turns
	   it into a stack of landing-page sections. */
	.docs-prose :global(h1:first-child) {
		display: none; /* the page title already lives in the header */
	}

	/* Anchor landings: the sticky site header would otherwise cover the heading
	   a TOC link just jumped to. */
	.docs-prose :global(:is(h2, h3, h4, h5, h6)) {
		scroll-margin-top: 7rem;
	}

	.docs-prose :global(h2) {
		margin-top: var(--space-chapter);
		margin-bottom: 2rem;
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--blood-crimson);
		font-family: "Space Grotesk", sans-serif;
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--bone-white);
	}

	.docs-prose :global(h3) {
		margin-top: var(--space-group);
		margin-bottom: 1.5rem;
		font-family: "Space Grotesk", sans-serif;
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--bone-white);
	}

	.docs-prose :global(h4),
	.docs-prose :global(h5),
	.docs-prose :global(h6) {
		margin-top: 3rem;
		margin-bottom: 1rem;
		font-family: "Space Grotesk", sans-serif;
		font-size: 1rem;
		font-weight: 700;
		color: var(--bone-white);
	}

	.docs-prose :global(p) {
		margin: 1.5rem 0;
		font-family: "DM Sans", sans-serif;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--bone-newsprint);
	}

	.docs-prose :global(a) {
		color: var(--bone-white);
		text-decoration: underline;
		text-decoration-color: var(--stamped-canary);
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.docs-prose :global(a:hover) {
		background-color: var(--raw-blood);
		color: var(--bone-white);
	}

	/* The code-mention links: the chip wrapped in a source anchor - the canary
	   underline on hover, the raw-blood focus ring. */
	.docs-prose :global(a.code-link) {
		text-decoration: none;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.docs-prose :global(a.code-link:hover) {
		background-color: var(--raw-blood);
	}

	.docs-prose :global(a.code-link:hover code) {
		color: var(--stamped-canary);
		text-decoration: underline;
		text-decoration-color: var(--stamped-canary);
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.docs-prose :global(a.code-link:focus-visible) {
		outline: 2px solid var(--raw-blood);
		outline-offset: 2px;
	}

	.docs-prose :global(strong) {
		color: var(--bone-white);
	}

	/* Inline code: the asphalt chip. Scoped away from `pre` on purpose - a
	   fence's <code> is the whole block and inherits the plate's colour; only
	   the INLINE chip is teal. Marker chips (<<<CCR:hash|type|size>>>) wrap
	   mid-token inside the chip instead of overflowing the column. */
	.docs-prose :global(:not(pre) > code) {
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--oxblood-dark);
		background-color: var(--asphalt-panel);
		font-family: "JetBrains Mono", monospace;
		font-size: 1rem;
		overflow-wrap: anywhere;
		color: var(--weathered-teal);
	}

	/* Code fences: the plate is defined ONCE - `body pre.astro-code` in
	   Source/Stylesheet/Global.css (frame, padding, rhythm, overflow, scroll
	   cue) over the palette in Source/Library/ShikiTheme.ts. A second frame
	   declared here is drift, and the old `pre code { color: zinc-dust }`
	   greyed out the tokenless `text`/`plaintext` fences, which carry no
	   spans of their own to colour. */

	/* ── TABLES BY CONTENT TYPE ────────────────────────────────────────────
	   A table is three different objects on this site and `table-layout: fixed`
	   treated all three as one:

	   - a SHORT COMPARISON, where the columns should size to their content;
	   - a REFERENCE MATRIX (a config key, a path, a command fragment), where
	     the cell's whole job is that the token survives as one string;
	   - a KEY -> VALUE EXPLANATION, which is a definition list wearing a
	     table's clothes.

	   So: `auto` layout lets a short table fit its content, `overflow-wrap:
	   normal` keeps an identifier's token boundaries intact, a genuinely wide
	   matrix scrolls inside the wrapper this page's runtime builds around it
	   (BindTables), and a two-column table is set as the definition list it
	   actually is.

	   `fixed` + `anywhere` was the opposite of all three: it forced every
	   column to an equal share of the width and then broke `APHRODITE_HOME`
	   and `crates/aphrodite/src/...` wherever the letter count ran out. */
	.docs-prose :global(table) {
		margin: 2.5rem 0;
		width: 100%;
		border: 1px solid var(--oxblood-dark);
		border-collapse: collapse;
		display: table;
		table-layout: auto;
	}

	.docs-prose :global(th) {
		padding: 0.6rem 1rem;
		border-bottom: 2px solid var(--blood-crimson);
		background-color: var(--carbon-void);
		font-family: "JetBrains Mono", monospace;
		font-size: 16px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-align: left;
		overflow-wrap: normal;
		color: var(--stamped-canary);
	}

	.docs-prose :global(td) {
		padding: 0.6rem 1rem;
		border-top: 1px solid var(--oxblood-dark);
		font-family: "DM Sans", sans-serif;
		font-size: 1rem;
		overflow-wrap: normal;
		color: var(--bone-newsprint);
	}

	/* A long identifier in a narrow column: with no runtime there is no scroll
	   region, so the token is allowed to break rather than spill across the
	   page (the 375px overflow this site already paid for). With the runtime
	   the table keeps its boundaries and scrolls instead - see
	   `.docs-table--scroll`. */
	html:not(.js) .docs-prose :global(td),
	html:not(.js) .docs-prose :global(th) {
		overflow-wrap: anywhere;
	}

	/* The scroll region BindTables builds: a table wider than the reading
	   column scrolls inside its own box, labelled by the heading above it and
	   focusable only while it actually overflows (an always-present region
	   would add a tab stop to every table on the page). */
	.docs-prose :global(.docs-table) {
		margin: 2.5rem 0;
		max-width: 100%;
	}

	.docs-prose :global(.docs-table > table) {
		margin: 0;
	}

	.docs-prose :global(.docs-table--scroll) {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--blood-crimson) var(--asphalt-panel-dark);
	}

	.docs-prose :global(.docs-table--scroll:focus-visible) {
		outline: 2px solid var(--raw-blood);
		outline-offset: 2px;
	}

	/* KEY -> VALUE: a two-column table is a definition list. The term keeps the
	   technical voice and its token boundaries; the definition keeps the
	   reading voice; one hairline per pair instead of the zebra, because these
	   rows are not a comparison and nothing here benefits from counting them. */
	.docs-prose :global(table:has(td:nth-child(2)):not(:has(td:nth-child(3)))) {
		border: 0;
	}

	.docs-prose
		:global(table:has(td:nth-child(2)):not(:has(td:nth-child(3))) td:first-child) {
		width: 24ch;
		border-top: 0;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.9375rem;
		vertical-align: top;
		color: var(--bone-white);
	}

	.docs-prose
		:global(table:has(td:nth-child(2)):not(:has(td:nth-child(3))) tr:not(:first-child) > *) {
		border-top: 1px solid var(--oxblood-dark);
	}

	.docs-prose :global(tr:nth-child(even) td) {
		background-color: color-mix(in srgb, var(--asphalt-panel) 55%, transparent);
	}

	.docs-prose :global(table:has(td:nth-child(2)):not(:has(td:nth-child(3))) tr:nth-child(even) td) {
		background-color: transparent;
	}

	.docs-prose :global(blockquote) {
		margin: 2.5rem 0;
		padding: 1rem 1.5rem;
		border-left: 4px solid var(--stamped-canary);
		background-color: var(--asphalt-panel);
		color: var(--zinc-dust);
	}

	.docs-prose :global(blockquote p) {
		margin: 0.5rem 0;
	}

	.docs-prose :global(ul),
	.docs-prose :global(ol) {
		margin: 1.5rem 0;
		padding-left: 1.5rem;
		font-family: "DM Sans", sans-serif;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--bone-newsprint);
	}

	.docs-prose :global(ul) {
		list-style: square;
	}

	.docs-prose :global(ol) {
		list-style: decimal;
	}

	.docs-prose :global(li)::marker {
		color: var(--blood-crimson);
	}

	.docs-prose :global(li > ul),
	.docs-prose :global(li > ol) {
		margin: 0.5rem 0;
	}

	.docs-prose :global(hr) {
		margin: var(--space-chapter) 0;
		border: none;
		border-top: 2px dashed var(--oxblood-dark);
	}

	.docs-prose :global(img) {
		border: 4px solid var(--blood-crimson);
	}

	.docs-prose :global(section.footnotes) {
		margin-top: 4rem;
		padding-top: 1rem;
		border-top: 2px dashed var(--oxblood-dark);
		font-size: 1rem;
		color: var(--zinc-dust);
	}

	.docs-prose :global(.footnotes-backref) {
		text-decoration: none;
	}

	.docs-prose :global(kbd) {
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--zinc-dust);
		border-bottom-width: 3px;
		font-family: "JetBrains Mono", monospace;
		font-size: 1rem;
		color: var(--bone-white);
	}

	/* ── REFERENCE DENSITY ─────────────────────────────────────────────────
	   The same roles, tightened: a heading sits one group away from the block
	   it introduces instead of one chapter, and the paragraphs inside a
	   section close up so a lookup reads as one entry rather than a landing
	   page. Nothing is removed - every sentence, table row and fence is
	   still here; only the distance between them changes. */
	.docs-prose[data-density="reference"] :global(h2) {
		margin-top: var(--space-group);
		margin-bottom: 1rem;
		padding-bottom: 0.5rem;
	}

	.docs-prose[data-density="reference"] :global(h3) {
		margin-top: 1.75rem;
		margin-bottom: 0.75rem;
	}

	.docs-prose[data-density="reference"] :global(h4),
	.docs-prose[data-density="reference"] :global(h5),
	.docs-prose[data-density="reference"] :global(h6) {
		margin-top: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.docs-prose[data-density="reference"] :global(p) {
		margin: 1rem 0;
	}

	.docs-prose[data-density="reference"] :global(ul),
	.docs-prose[data-density="reference"] :global(ol) {
		margin: 1rem 0;
	}

	.docs-prose[data-density="reference"] :global(table),
	.docs-prose[data-density="reference"] :global(.docs-table) {
		margin: 1.5rem 0;
	}

	.docs-prose[data-density="reference"] :global(blockquote) {
		margin: 1.5rem 0;
	}

	.docs-prose[data-density="reference"] :global(hr) {
		margin: var(--space-group) 0;
	}

	/* The wrapper owns the table's distance from the prose, in BOTH densities:
	   the inner table's own margin must not add to it. This rule sits last on
	   purpose - the reference block above outranks `.docs-table > table` on
	   specificity, and a scroll region is a block formatting context, so its
	   margins do not collapse with the table's and the gap would double. */
	.docs-prose :global(.docs-table > table) {
		margin: 0;
	}
</style>

<script>
	function BindDocsDrawer() {
		const Toggle = document.getElementById("docs-nav-toggle");
		const Drawer = document.getElementById("docs-drawer");

		if (!Toggle || !Drawer || Toggle.dataset.drawerBound) {
			return;
		}

	// Focus management: opening moves focus into the drawer (the CLOSE button),
	// closing hands it back to the toggle that opened it.
	Toggle.dataset.drawerBound = "1";

	const Closer = Drawer.querySelector<HTMLButtonElement>("button[data-drawer-close]");

	const Set = (Open: boolean) => {
		Drawer.classList.toggle("hidden", !Open);
		Toggle.setAttribute("aria-expanded", String(Open));
		document.documentElement.classList.toggle("overflow-hidden", Open);

		if (Open) {
			Closer?.focus();
		} else {
			// preventScroll: a TOC link inside the drawer is about to jump to an
			// anchor further down the page - handing focus back must not drag the
			// viewport up to the toggle.
			Toggle.focus({ preventScroll: true });
		}
	};

		Toggle.addEventListener("click", () => Set(Drawer.classList.contains("hidden")));

		for (const Closer of Drawer.querySelectorAll("[data-drawer-close]")) {
			Closer.addEventListener("click", () => Set(false));
		}

		// A fragment link inside the drawer (a section card pointing at an
		// anchor) jumps the page and the overlay gets out of the way.
		for (const Anchor of Drawer.querySelectorAll('a[href^="#"]')) {
			Anchor.addEventListener("click", () => Set(false));
		}

		document.addEventListener("keydown", (Event) => {
			if (Event.key === "Escape" && !Drawer.classList.contains("hidden")) {
				Set(false);
			}
		});
	}

	// The outline's current entry, from an IntersectionObserver rather than a
	// scroll listener: the observer is the browser's own scroll bookkeeping, so
	// the page pays nothing for being marked. Both presentations (right rail,
	// narrow disclosure) carry data-outline-link and are marked together - the
	// hidden one simply goes unseen.
	let Outline: IntersectionObserver | null = null;

	function BindOutline() {
		const Links = Array.from(
			document.querySelectorAll<HTMLAnchorElement>("a[data-outline-link]"),
		);

		if (Links.length === 0 || Links[0]?.dataset["outlineBound"] === "1") {
			return;
		}

		const ById = new Map<string, HTMLAnchorElement[]>();

		for (const Link of Links) {
			const Id = Link.dataset["outlineLink"] ?? "";

			ById.set(Id, [...(ById.get(Id) ?? []), Link]);
		}

		// A toc entry whose heading the renderer never emitted is not a target;
		// dropping it here keeps the marker honest instead of throwing.
		const Targets = [...ById.keys()]
			.map((Id) => ({ Id, Element: document.getElementById(Id) }))
			.filter(
				(Target): Target is { Id: string; Element: HTMLElement } =>
					Target.Element !== null,
			);

		if (Targets.length === 0) {
			return;
		}

		const First = Targets[0]!;

		Links[0]!.dataset["outlineBound"] = "1";

		// A page swapped in by the client router is observed afresh; the
		// discarded page's observer would otherwise keep watching detached
		// headings for the life of the tab.
		Outline?.disconnect();

		let Current = "";

		const Mark = (Id: string) => {
			if (Id === Current) {
				return;
			}

			Current = Id;

			for (const [Key, Group] of ById) {
				for (const Link of Group) {
					switch (Key === Id) {
						case true:
							Link.setAttribute("aria-current", "location");

							break;
						default:
							Link.removeAttribute("aria-current");
					}
				}
			}
		};

		// The first entry names where the reader landed, including a page opened
		// straight onto an anchor; the observer corrects it on its first
		// callback, which the browser delivers on the next frame.
		Mark(First.Id);

		// No IntersectionObserver (an engine that predates it): the outline
		// still names the opening section instead of naming nothing at all.
		// Marking is state, not motion, so it works under reduced motion too.
		if (typeof IntersectionObserver === "undefined") {
			return;
		}

		// A band, not a scroll position: a heading names its section while it
		// sits below the sticky header and above the bottom 55% of the
		// viewport. The observer's callback reads no layout - it only reads
		// which headings the browser reported as in the band.
		const Band = new Set<Element>();

		Outline = new IntersectionObserver(
			(Entries) => {
				for (const Entry of Entries) {
					switch (Entry.isIntersecting) {
						case true:
							Band.add(Entry.target);

							break;
						default:
							Band.delete(Entry.target);
					}
				}

				// The topmost heading in the band is the section being read.
				// While a long body scrolls between two headings the band is
				// empty, so the mark stays on the section the reader is still
				// inside instead of jumping ahead to the next one.
				for (const { Id, Element } of Targets) {
					if (Band.has(Element)) {
						Mark(Id);

						return;
					}
				}
			},
			// -96px clears the sticky site header; -55% keeps the lower half of
			// the viewport from claiming a heading the reader has not reached.
			{ rootMargin: "-96px 0px -55% 0px", threshold: 0 },
		);

		for (const { Element } of Targets) {
			Outline.observe(Element);
		}
	}

	// The wide reference matrices: a table wider than the reading column gets a
	// scroll region of its own, labelled by the heading it belongs to. The
	// wrapper is built here rather than in the stylesheet because a scroll
	// container cannot be expressed in CSS - and it is a scroll region only
	// when the table actually overflows, so a table that fits stays a plain
	// table with no extra tab stop and no extra landmark.
	//
	// Two passes on purpose. The first wraps, the second MEASURES every wrapper
	// it can see - including one an earlier call built. The webfont lands after
	// the first measurement and its metrics decide whether a table crosses the
	// column, so a one-shot wrap would freeze the pre-font answer and leave a
	// wide table silently clipped.
	function BindTables() {
		const Tables = Array.from(
			document.querySelectorAll<HTMLTableElement>(".docs-prose table"),
		);

		for (const Table of Tables) {
			if (Table.dataset["tableBound"] === "1") {
				continue;
			}

			Table.dataset["tableBound"] = "1";

			const Wrapper = document.createElement("div");

			Wrapper.className = "docs-table";
			Table.replaceWith(Wrapper);
			Wrapper.append(Table);
		}

		const Wrappers = Array.from(
			document.querySelectorAll<HTMLElement>(".docs-prose .docs-table"),
		);

		if (Wrappers.length === 0) {
			return;
		}

		const Headings = Array.from(
			document.querySelectorAll<HTMLElement>(".docs-prose h2, .docs-prose h3"),
		);

		for (const Wrapper of Wrappers) {
			// The wrapper is the column's width and the table's own min-content
			// decides whether it fits.
			const Overflows = Wrapper.scrollWidth > Wrapper.clientWidth + 1;

			switch (Overflows) {
				case true: {
					// The label names the table's subject, taken from the nearest
					// heading above it in document order - never from the table's
					// own content.
					let Subject = "";

					for (const Heading of Headings) {
						const Follows =
							Heading.compareDocumentPosition(Wrapper) &
							Node.DOCUMENT_POSITION_FOLLOWING;

						if (Follows) {
							Subject = Heading.textContent?.trim() ?? Subject;
						}
					}

					Wrapper.classList.add("docs-table--scroll");
					Wrapper.tabIndex = 0;
					Wrapper.setAttribute("role", "region");
					Wrapper.setAttribute("aria-label", Subject ? `Table: ${Subject}` : "Table");

					break;
				}
				default:
					Wrapper.classList.remove("docs-table--scroll");
					Wrapper.removeAttribute("tabindex");
					Wrapper.removeAttribute("role");
					Wrapper.removeAttribute("aria-label");
			}
		}
	}

	// Each binder is isolated: one that throws must never take the rest of this
	// page's runtime with it. A bare call here once aborted the whole script and
	// silently killed the drawer and the outline together.
	const Binders: ReadonlyArray<() => void> = [BindDocsDrawer, BindOutline, BindTables];

	const BindRuntime = (): void => {
		for (const Bind of Binders) {
			try {
				Bind();
			} catch (Error) {
				console.warn("aphrodite: a docs binder failed", Error);
			}
		}
	};

	BindRuntime();
	document.addEventListener("astro:page-load", BindRuntime);

	// The webfont decides whether a table crosses the column, and it lands after
	// the first measurement: re-measure once it has. Isolated like every other
	// binder, and short-circuited where `document.fonts` does not exist.
	document.fonts?.ready
		.then(() => {
			try {
				BindTables();
			} catch (Error) {
				console.warn("aphrodite: the table re-measure failed", Error);
			}
		})
		.catch(() => undefined);
</script>
