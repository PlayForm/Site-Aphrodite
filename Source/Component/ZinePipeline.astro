---
/**
 * ZinePipeline - the stream/preview pair as a live, four-step pipeline. The
 * grammar's fourth law says the pair is the whole argument of the product,
 * and before this component two pages narrated it in hand-rolled markup with
 * a page-local simulation each. The engine now lives in `Script/Pipeline.ts`
 * (one classifier, one set of preview shapes, one digest); this component is
 * its only renderer.
 *
 * Mode="full" is the pipeline's home (/workbench/): the four-step rail, the
 * sample switchboard, the paired panes with their four h3s (INPUT,
 * CLASSIFIED, PREVIEW + MARKER, DECISION), the illustrative marker address and
 * a STATELESS per-run readout. The readout reports only what this one run
 * measured - no session totals, no timing - because the simulator is an
 * instrument, and an instrument that accumulates cannot be read.
 *
 * Mode="decide" is the decide branch (/case-study/): the marker the agent
 * already holds, beside the two-branch control - PREVIEW ANSWERS IT (nothing
 * is retrieved) or NEEDS THE BYTES (the marker resolves). The evidence is the
 * page's own exhibit; the control only makes the decision visible.
 *
 * The synthetic samples below are the SANITIZATION law's boundary: generated
 * for the demo, never real session content, no personal info, no home paths.
 */
import ZineTape from "@Component/ZineTape.astro";

interface Props {
	/** "full" = the live four-step pipeline; "decide" = the two-branch control. */
	Mode?: "full" | "decide";
}

const { Mode = "full" } = Astro.props;

// One synthetic sample per high-signal classifier type, byte-exact. Rendered
// into a JSON island the client engine reads (frontmatter constants are not
// in scope inside an Astro <script> module).
const Samples = [
	{
		Id: "build",
		Label: "BUILD LOG",
		Text: [
			"   Compiling aphrodite v0.4.2",
			"warning: unused variable: `hint`",
			" --> crates/aphrodite/src/preview.rs:212:9",
			"error[E0432]: unresolved import `crate::stage3`",
			" --> crates/aphrodite/src/main.rs:14:5",
			"error: could not compile `aphrodite` due to 1 previous error",
			"warning: 2 warnings emitted",
			"build failed: exit code 101",
		].join("\n"),
	},
	{
		Id: "test",
		Label: "TEST RUN",
		Text: [
			"running 222 tests",
			"test classify::tests::detects_build ... ok",
			"test preview::tests::build_grep ... ok",
			"test marker::tests::parses_hash ... ignored",
			"test store::tests::blake3_roundtrip ... FAILED",
			"failures:",
			"    store::tests::blake3_roundtrip",
			"test result: FAILED. 220 passed; 1 failed; 1 ignored; finished in 0.31s",
		].join("\n"),
	},
	{
		Id: "terminal",
		Label: "TERMINAL",
		Text: [
			"$ cargo fmt --check",
			"Diff in crates/aphrodite/src/main.rs at line 14:",
			"$ ls crates",
			"aphrodite  aphrodite-hermes",
			"$ echo done",
			"done",
			"exit code: 0",
		].join("\n"),
	},
	{
		Id: "code",
		Label: "RUST FILE",
		Text: [
			"use std::collections::HashMap;",
			"",
			"struct Preview {",
			"    kind: String,",
			"    body: String,",
			"}",
			"",
			"enum Source {",
			"    Tool,",
			"    Terminal,",
			"}",
			"",
			"fn classify(blob: &str) -> Source {",
			'    if blob.contains("exit code") { Source::Terminal } else { Source::Tool }',
			"}",
			"",
			"fn main() {",
			"    let cache: HashMap<String, Preview> = HashMap::new();",
			'    println!("{:?}", cache.len());',
			"}",
		].join("\n"),
	},
	{
		Id: "grep",
		Label: "GREP / RG",
		Text: [
			"src/preview.rs:12:fn build_preview(blob: &str) -> String {",
			"src/preview.rs:44:    build_preview(&truncated)",
			"src/classify.rs:7:// returns the detected content type before build_preview runs",
			"src/classify.rs:81:    build_preview(blob)",
			"src/store.rs:19:// preview stored next to the blake3 digest",
		].join("\n"),
	},
	{
		Id: "git",
		Label: "GIT STATUS",
		Text: [
			"M src/preview.rs",
			"M src/classify.rs",
			"A src/store.rs",
			"D src/legacy.rs",
			"?? docs/notes.md",
			"?? examples/demo.rs",
			"?? target/",
		].join("\n"),
	},
	{
		Id: "diff",
		Label: "DIFF",
		Text: [
			"diff --git a/src/main.rs b/src/main.rs",
			"--- a/src/main.rs",
			"+++ b/src/main.rs",
			"@@ -14,7 +14,9 @@",
			"-    let blob = read();",
			"+    let blob = read_trimmed();",
			"+    let kind = classify(&blob);",
			"diff --git a/Cargo.toml b/Cargo.toml",
			"+++ b/Cargo.toml",
			'+version = "0.4.3"',
		].join("\n"),
	},
	{
		Id: "json",
		Label: "JSON BLOB",
		Text: JSON.stringify(
			{
				cached: true,
				error: null,
				hits: 4,
				query: "build_preview",
				files: ["src/preview.rs", "src/classify.rs"],
				timing: { classify_ns: 88, compress_ns: 410 },
			},
			null,
			2,
		),
	},
	{
		Id: "error",
		Label: "ERROR",
		Text: ["Traceback (most recent call last):", "  KeyError: 'preview'", ""].join("\n"),
	},
] satisfies { Id: string; Label: string; Text: string }[];

// The four steps, with the figure each one is measured by (README.md:133-138).
// The CLASSIFY figure is the ENGINE's historical latency, printed as the README
// carries it - this page measures no timing at all, so the figure is labelled
// as the engine's rather than left to read as this run's.
const Steps = [
	{ N: "01", Name: "CLASSIFY", Figure: "engine 40-123 ns", Tone: "teal" },
	{ N: "02", Name: "PREVIEW", Figure: "~15 tok", Tone: "canary" },
	{ N: "03", Name: "STORE", Figure: "BLAKE3", Tone: "raw" },
	{ N: "04", Name: "DECIDE", Figure: "RETRIEVE?", Tone: "bone" },
] as const;

// The decide branch's exhibit: the marker and preview line the agent already
// holds (byte-exact - the same pair the contract section prints).
const Exhibit = {
	Preview: "[build:1E 1W 142L | error[E0432]: unresolved import ...]",
	Marker: "<<<CCR:0e3a5c9f2b8d4e6a1c3f5b7d9e0a2c4b6d8f0a1e|build|1420>>>",
	Bytes: "1,420 BYTES OF ORIGINAL OUTPUT · UNCHANGED",
} as const;
---

{Mode === "full" ? (
	<section data-pipeline="full" class="relative w-full" aria-label="The pipeline, live">
		<ZineTape Label="THE PIPELINE // LIVE" Color="raw" Side="left" />
		<h2 class="zp-title">Four steps, one decision</h2>

		<!-- THE RAIL: the four steps the page actually runs. -->
		<ol class="zp-rail" aria-label="The four steps, in order">
			{Steps.map(({ N, Name, Figure, Tone }) => (
				<li data-rail-step={Name} class={`zp-step zp-step-${Tone}`}>
					<span class="zp-step-n">{N}</span>
					<span class="zp-step-name">{Name}</span>
					<span class="zp-step-figure">{Figure}</span>
				</li>
			))}
		</ol>

		<!-- THE SWITCHBOARD: load a sample, or paste your own. -->
		<div class="zp-switch" aria-label="Sample outputs">
			<span class="zp-kicker">LOAD SAMPLE:</span>
			{Samples.map((Sample, Index) => (
				<button
					type="button"
					class="zp-pill"
					data-sample={Sample.Id}
					data-active={Index === 0 ? "" : undefined}
					aria-pressed={Index === 0}
				>
					{Sample.Label}
				</button>
			))}
			<button type="button" class="zp-pill zp-exec" data-action="exec" aria-pressed="false">
				RUN PIPELINE
			</button>
		</div>

		<!-- THE PAIR: two pods. Each pod is a HEADER RIBBON over an inset well
			     - the console grammar - so the pair reads as two instruments on one
			     bench rather than two boxes that happen to sit together. The ribbon
			     carries what produced the bytes and how many there are; the well
			     holds them. -->
		<div class="grid gap-10 lg:grid-cols-2">
			<!-- POD ONE: INPUT + CLASSIFIED. The ribbon is the command side of
				     the console: the pod's name on the left, the byte count of what
				     has arrived on the right. -->
			<div class="zp-pane">
				<div class="zp-pane-head">
					<h3 class="zp-h3">INPUT</h3>
					<span class="telemetry-tag" data-stat="raw-bytes">
						0 B
					</span>
				</div>
				<div class="relative flex-1">
					<label class="sr-only" for="zp-input">
						Tool output to classify
					</label>
					<textarea
						id="zp-input"
						data-input
						spellcheck="false"
						class="zp-terminal h-72 w-full resize-y bg-transparent p-5 text-bone-newsprint"
						placeholder="paste any output here - or load a sample"
					></textarea>
					<!-- The opacity-fade suppression overlay: the tail of the
						     raw feed dims toward the bottom of the well. -->
					<div
						aria-hidden="true"
						class="pointer-events-none absolute inset-x-0 bottom-0 h-16"
						style="background: linear-gradient(to bottom, transparent, var(--carbon-void, #111014));"
					></div>
				</div>
				<div class="zp-pane-foot">
					<h3 class="zp-h3">CLASSIFIED</h3>
					<p class="zp-classified">
						<span class="zp-type" data-type>
							not run yet
						</span>
						<span class="zp-dot">·</span>
						<span class="zp-tier" data-tier>
							×1
						</span>
						<span class="zp-dot">·</span>
						<!-- The effective token limit replaced the nanosecond
							     readout: a threshold is a fact of the run, a
							     latency here was generated. -->
						<span class="zp-note" data-stat="threshold">
							limit -
						</span>
					</p>
				</div>
			</div>

			<!-- POD TWO: PREVIEW + MARKER + DECISION. The ribbon names the pod and
				     says what it is: the line the LLM reads. -->
			<div class="zp-pane">
				<div class="zp-pane-head">
					<h3 class="zp-h3 zp-h3-teal">PREVIEW + MARKER</h3>
					<span class="telemetry-tag telemetry-tag--teal">the line the LLM reads</span>
				</div>
				<div class="zp-preview-body">
					<!-- The preview line, inset bone-white result. -->
					<div class="zp-result">
						<p class="zp-kicker zp-kicker-ink">PREVIEW LINE</p>
						<p class="zp-line mt-4 break-all" data-preview>
							[press RUN PIPELINE]
						</p>
					</div>

					<!-- The store address: an illustrative marker, then the
						     marker itself. The engine's address is a BLAKE3
						     digest; this page computes a deterministic stand-in,
						     so the label says what was actually computed. -->
					<div>
						<p class="zp-kicker zp-kicker-teal">
							ILLUSTRATIVE MARKER // NOT ENGINE-RESOLVABLE
						</p>
						<p class="zp-address mt-2" data-address>
							illustrative marker - · 0 B · not run yet
						</p>
						<button
							type="button"
							class="zp-chip ccr-marker mt-4 w-full border-2 border-weathered-teal bg-soot-black p-2 text-left"
							data-copy=""
							data-marker
						>
							&lt;&lt;&lt;CCR:...&gt;&gt;&gt;
						</button>
						<p class="zp-note-block mt-4">
							The engine's address is a BLAKE3 digest of the original bytes. This
							browser example computes a deterministic stand-in instead, so its marker
							is illustrative: no engine can resolve it, and nothing here is stored
							server-side.
						</p>
					</div>

					<!-- The decision the agent makes, not the engine. The readout
						     names a MECHANICAL outcome; whether the preview answers
						     the agent's question is the agent's judgement, and this
						     page was never given a task to judge against. -->
					<div class="zp-decision">
						<h3 class="zp-h3">DECISION</h3>
						<p class="zp-note-block mt-4" data-decision>
							no run yet - a run names the mechanical outcome: pass-through, or
							preview + marker
						</p>
						<p class="zp-note-block mt-4">
							The agent decides whether to retrieve. The engine has never been given a
							task, so it cannot know whether a preview answers one: it reports what
							the pipeline did with the bytes, and the retrieval that would follow
							belongs to whoever is driving the agent - the engine never retrieves on
							its own.
						</p>
					</div>

					<!-- The per-turn injection assembler (docs/plugin/hooks.md:114-136):
						     the pre_llm_call order under the 4,000-char budget - NOT an
						     auto-compaction pass (the engine is opt-in, non-destructive). -->
					<div class="zp-inject">
						<p class="zp-kicker zp-kicker-newsprint">
							INJECTION ASSEMBLER (PRE_LLM_CALL)
						</p>
						<p class="zp-note-block mt-4">
							<span class="text-stamped-canary">[directives:]</span> →
							<span class="text-stamped-canary">[nudge:]</span> →
							<span class="text-weathered-teal">[recall]</span>- assembled per turn,
							under the 4,000-char budget
						</p>
					</div>
				</div>
			</div>
		</div>

		<!-- THE READOUT: what THIS ONE RUN did, recomputed from the current
			     input and the current thresholds. Nothing accumulates - typing a
			     character, loading a sample and dragging a slider all report the
			     same single run, so a figure here can always be traced back to
			     the bytes and the limit printed beside it. A session simulator
			     (turns, cumulative savings) would be a separate mode with
			     explicit actions, never a side effect of typing. -->
		<div class="mt-20" role="group" aria-label="This run, in figures">
			<p class="zp-kicker">THIS RUN, IN FIGURES</p>
			<p class="zp-note-block mt-4 max-w-3xl">
				Every figure is measured from the bytes of the input and the limits in force: input
				bytes, the type the classifier chose, the token limit that type resolved to, the
				replacement the agent would receive (preview plus marker), whether a marker was
				emitted, and the byte reduction those two numbers produce. There is no running
				total, because a total would count keystrokes rather than the pipeline's work.
			</p>
			<div class="mt-8 grid gap-6 md:grid-cols-3">
				{[
					{ Key: "type", Label: "DETECTED TYPE" },
					{ Key: "raw-bytes", Label: "INPUT BYTES" },
					{ Key: "threshold", Label: "EFFECTIVE THRESHOLD" },
					{ Key: "replacement", Label: "REPLACEMENT SIZE" },
					{ Key: "marker", Label: "MARKER" },
					{ Key: "reduction", Label: "BYTE REDUCTION FOR THIS EXAMPLE" },
				].map((Stat) => (
					<div class="zp-pane p-6">
						<p class="zp-kicker">{Stat.Label}</p>
						<p class="zp-stat" data-fact={Stat.Key}>
							not run yet
						</p>
						{Stat.Key === "reduction" && (
							<div class="zp-stat-track mt-6">
								<div
									class="zp-stat-fill"
									data-fact-bar="reduction"
									style="width:0%"
								/>
							</div>
						)}
					</div>
				))}
			</div>
		</div>

		<!-- The samples as data: frontmatter constants are not in scope inside
			     an Astro <script> module, so the engine reads this island. It lives
			     INSIDE the pipeline root - the binding looks it up from there. -->
		<script type="application/json" data-samples-json set:html={JSON.stringify(Samples)} />
	</section>
) : (
	<section data-pipeline="decide" class="relative w-full" aria-label="The decide branch">
		<div class="grid gap-10 lg:grid-cols-2">
			<!-- What the agent already holds. -->
			<div class="zp-pane">
				<div class="zp-pane-head">
					<h3 class="zp-h3">WHAT THE AGENT HOLDS</h3>
					<span class="telemetry-tag telemetry-tag--canary">
						ONE PREVIEW + ONE MARKER
					</span>
				</div>
				<div class="p-5">
					<div class="zp-result">
						<p class="zp-line break-all">{Exhibit.Preview}</p>
						{/* `.zp-result` is a bone-white plate, and teal on bone-white is
							    3.06:1 - the marker was the least readable line on the one
							    surface that is printed rather than projected. A marker on a
							    light ground takes the ink of a printed receipt. */}
						<p class="ccr-marker mt-4 text-soot-black">{Exhibit.Marker}</p>
					</div>
					<p class="zp-note-block mt-4">
						Three fields and a preview line. Retrieval is a choice, not a step.
					</p>
				</div>
			</div>

			<!-- The two branches the choice opens. -->
			<div class="flex flex-col gap-6">
				<div class="flex flex-wrap gap-4">
					<button
						type="button"
						class="zp-pill"
						data-branch="preview-answers"
						data-active
						aria-pressed="true"
					>
						PREVIEW ANSWERS IT
					</button>
					<button
						type="button"
						class="zp-pill"
						data-branch="needs-bytes"
						aria-pressed="false"
					>
						NEEDS THE BYTES
					</button>
				</div>
				<div class="zp-pane" data-branch-panel="preview-answers">
					<div class="zp-pane-head">
						<h3 class="zp-h3">NOTHING IS RETRIEVED</h3>
					</div>
					<div class="p-5">
						<p class="zp-note-block">
							The marker stayed a receipt. The agent reasoned from the type, the size
							and the one error the preview carried - and the store was never touched.
						</p>
					</div>
				</div>
				<div class="zp-pane" data-branch-panel="needs-bytes" hidden>
					<div class="zp-pane-head">
						<h3 class="zp-h3 zp-h3-teal">THE MARKER RESOLVES</h3>
					</div>
					<div class="p-5">
						<p class="zp-note-block">{Exhibit.Bytes}</p>
						<p class="zp-note-block mt-4">
							Recursive resolution - nested markers are handled, so a retrieved blob
							that itself carries a marker resolves in the same call.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
)}

<script>
	import { BindPipeline } from "@Script/Pipeline";

	BindPipeline();
	document.addEventListener("astro:page-load", () => BindPipeline());
</script>

<style>
	/* The pipeline's own chrome. Self-contained: it must render identically on
	   /workbench/ and /case-study/, so it carries no page-local class. Radius
	   stays 0, shadows are hard offsets, rotation only from sm up. */
	.zp-title {
		margin-top: 1.5rem;
		font-family: var(--font-headline, inherit);
		font-size: 1.5rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		color: var(--bone-white, #ece9e0);
	}
	@media (min-width: 640px) {
		.zp-title {
			font-size: 2.25rem;
		}
	}

	/* THE RAIL */
	.zp-rail {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin-top: 2rem;
	}
	@media (min-width: 900px) {
		.zp-rail {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.zp-step {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		border: 2px solid var(--oxblood-dark, #520612);
		background: var(--soot-black, #09090b);
		padding: 0.75rem 1rem;
		opacity: 0.55;
		transition: opacity 0.2s ease;
	}
	.zp-step[data-on] {
		opacity: 1;
		border-color: var(--blood-crimson, #7a0a1e);
		box-shadow: 3px 3px 0 #000;
	}
	.zp-step-n {
		font-family: var(--font-mono, monospace);
		font-size: 13px;
		letter-spacing: 0.1em;
		color: var(--zinc-dust, #82808a);
	}
	.zp-step-name {
		font-family: var(--font-mono, monospace);
		font-size: 16px;
		font-weight: 900;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--bone-white, #ece9e0);
	}
	.zp-step-figure {
		font-family: var(--font-mono, monospace);
		font-size: 13px;
		letter-spacing: 0.08em;
		color: var(--zinc-dust, #82808a);
	}
	.zp-step-canary .zp-step-figure {
		color: var(--stamped-canary, #e5a93b);
	}
	.zp-step-teal .zp-step-figure {
		color: var(--weathered-teal, #2a938d);
	}
	/* `raw` and `bone` carry the same identity the index stage cards give stage
	   03 and stage 04, so the rail reads as the same four stages as the home
	   page. Raw blood measures 2.12:1 on carbon-void, so the figure takes the
	   same 55% lift the stage cards use for their ink: same colour, legible
	   text. */
	.zp-step-raw .zp-step-figure {
		color: color-mix(in srgb, var(--raw-blood, #931128) 55%, var(--bone-newsprint, #dedbd2));
	}
	.zp-step-bone .zp-step-figure {
		color: var(--bone-newsprint, #dedbd2);
	}

	/* THE SWITCHBOARD */
	.zp-switch {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
		margin-top: 3rem;
	}
	.zp-pill {
		border: 2px solid var(--blood-crimson, #7a0a1e);
		background: var(--carbon-void, #111014);
		padding: 0.5rem 0.9rem;
		font-family: var(--font-mono, monospace);
		font-size: 16px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--bone-newsprint, #dedbd2);
		box-shadow: 3px 3px 0 #000;
	}
	.zp-pill:hover,
	.zp-pill[data-active] {
		background: var(--raw-blood, #931128);
		color: var(--bone-white, #ece9e0);
	}
	.zp-exec {
		border-color: #000;
		background: var(--stamped-canary, #e5a93b);
		color: var(--soot-black, #09090b);
	}
	.zp-exec.zp-exec-spin {
		animation: zp-spin-once 0.42s ease;
	}
	@keyframes zp-spin-once {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	/* THE PAIR, AS TWO PODS. A pod is a crimson frame carrying the hard offset
	   shadow the plate grammar has always used, a header ribbon banded across
	   its top, and a body that is simply the pod's own fill. One depth per pod:
	   the difference between the two halves is what they hold, never how far
	   they sit from the page. */
	.zp-pane {
		display: flex;
