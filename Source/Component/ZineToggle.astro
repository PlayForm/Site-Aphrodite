---
/**
 * ZineToggle - the comparison toggle: a before/after switch over two panes
 * (typically a raw block vs the compressed result, but any two states).
 * Buttons sit in a raw-blood chrome; exactly one pane is visible. Without
 * JS the first pane shows.
 */
interface Props {
	/** Label of the first state (default "BEFORE"). */
	Left?: string;

	/** Label of the second state (default "AFTER"). */
	Right?: string;

	/** Left pane content (rich). */
	LeftPane: string;

	/** Right pane content (rich). */
	RightPane: string;

	/** Pane labels above the content. */
	LeftLabel?: string;
	RightLabel?: string;
}

const { Left = "BEFORE", Right = "AFTER", LeftPane, RightPane, LeftLabel, RightLabel } = Astro.props;
---

<div class="zine-box-subtle border-[3px] border-oxblood-dark bg-carbon-void p-4 sm:p-5" data-zine-toggle>
	<div
		class="mb-3 flex border-2 border-black bg-soot-black shadow-[3px_3px_0px_#000]"
		role="group"
		aria-label="Toggle the before and after panes"
	>
		<button
			class="grow bg-raw-blood px-3 py-1.5 font-mono text-base font-black uppercase tracking-widest text-bone-white"
			data-toggle-side="left"
			type="button"
			aria-pressed="true"
		>
			{Left}
		</button>
		<button
			class="grow px-3 py-1.5 font-mono text-base font-black uppercase tracking-widest text-zinc-dust hover:text-bone-white"
			data-toggle-side="right"
			type="button"
			aria-pressed="false"
		>
			{Right}
		</button>
	</div>
	<div data-toggle-pane="left">
		{LeftLabel && <div class="mb-1 font-mono text-base font-black uppercase tracking-widest text-stamped-canary">{LeftLabel}</div>}
		<div class="border border-oxblood-dark bg-soot-black p-3 font-mono text-base leading-relaxed text-zinc-dust" set:html={LeftPane} />
	</div>
	<div data-toggle-pane="right" hidden>
		{RightLabel && <div class="mb-1 font-mono text-base font-black uppercase tracking-widest text-weathered-teal">{RightLabel}</div>}
		<div class="border border-oxblood-dark bg-soot-black p-3 font-mono text-base font-bold leading-relaxed text-bone-white" set:html={RightPane} />
	</div>
</div>

<script>
	function BindToggles() {
		for (const Root of document.querySelectorAll("[data-zine-toggle]")) {
			if (Root.dataset.toggleBound) {
				continue;
			}

			Root.dataset.toggleBound = "1";

			const Buttons = Root.querySelectorAll<HTMLButtonElement>("[data-toggle-side]");
			const Panes: Record<string, HTMLElement | null> = {
				left: Root.querySelector<HTMLElement>("[data-toggle-pane='left']"),
				right: Root.querySelector<HTMLElement>("[data-toggle-pane='right']"),
			};

			function Select(Side: "left" | "right") {
				for (const Button of Buttons) {
					const Active = Button.dataset["toggleSide"] === Side;
					Button.classList.toggle("bg-raw-blood", Active);
					Button.classList.toggle("text-bone-white", Active);
					Button.classList.toggle("text-zinc-dust", !Active);
					Button.setAttribute("aria-pressed", String(Active));
				}
				Panes.left?.toggleAttribute("hidden", Side !== "left");
				Panes.right?.toggleAttribute("hidden", Side !== "right");
			}

			for (const Button of Buttons) {
				Button.addEventListener("click", () => Select(Button.dataset["toggleSide"] === "right" ? "right" : "left"));
			}
		}
	}

	BindToggles();
	document.addEventListener("astro:page-load", BindToggles);
</script>
