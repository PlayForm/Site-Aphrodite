---
/**
 * ZineToggle - the comparison switch over two panes (typically a raw block vs
 * the compressed result, but any two states).
 *
 * READABLE WITHOUT JAVASCRIPT. Both panes are server-rendered in document
 * order, each under its own label, so a reader with no script sees the whole
 * comparison rather than half of it - which is what "the first pane shows"
 * used to mean. The script hides the inactive pane and reveals the switch
 * bar, and only then sets `data-toggle-ready`; the stylesheet collapses the
 * pair on that signal alone (Motion.css, "Readable without JavaScript"), so
 * initialisation adds a presentation and never adds content.
 *
 * TWO PODS AND A SWITCH (the dual-pod grammar). Each pane is a POD - a
 * labelled ribbon over an inset well - and the switch above them is the
 * console's own header: the two states as tabs, one of them carrying the
 * active fill. The bar keeps its `zine-toggle-bar` class because the
 * stylesheet keys the pre-bind collapse on it, and the panes keep their
 * `data-toggle-pane` sides because the script does.
 *
 * THE PANE ROOT CARRIES NO DISPLAY UTILITY. `[hidden]` from preflight is
 * `display: none` at the same specificity as `.flex`, and the utility layer
 * comes later, so a `flex` on the element the script hides would keep the
 * "hidden" pane on screen. The pod stacks in normal block flow instead, and
 * the well still fills its frame.
 *
 * The switch bar is hidden until it can work: a two-button control that does
 * nothing is a promise the page cannot keep. Its listeners belong to an
 * AbortController that is aborted on astro:before-swap.
 *
 * THE TAB BAR GRAMMAR, and where else it is spent. A switch is a framed TRACK
 * with flush SEGMENTS: the frame is one border, the segments divide it with
 * hairlines, and the selected segment is the only one that carries a FILL. The
 * fill is the selected thing's IDENTITY, not decoration - so `Tone` exists.
 * `/setup/`'s playbook spends the same grammar twice in one control bar (the
 * platform selector, then the four route pills) and cannot import this
 * component, because its switch is a pair of radios driven by `:has()` and has
 * to work with JavaScript off. Two implementations, one grammar: a page that
 * needs a third switch copies the geometry from this bar rather than inventing
 * a fourth chip shape.
 */
interface Props {
	/** Label of the first state (default "BEFORE"). */
	Left?: string;

	/** Label of the second state (default "AFTER"). */
	Right?: string;

	/** Left pane content (rich). */
	LeftPane: string;

	/** Right pane content (rich). */
	RightPane: string;

	/** Pane labels above the content. */
	LeftLabel?: string;

	/** Pane labels above the content. */
	RightLabel?: string;

	/**
	 * The selected segment's fill - colour as identity. `raw` is the default
	 * because it is what every existing call site renders: a comparison whose
	 * two sides are not identities of their own. A toggle that selects a thing
	 * the page already colours (a stage, a route, an evidence class) passes that
	 * thing's accent instead, so four switches on one page do not all claim the
	 * same crimson.
	 */
	Tone?: "raw" | "canary" | "teal" | "bone";

	/** Extra classes on the frame - layout belongs to the caller. */
	Class?: string;
}

const {
	Left = "BEFORE",
	Right = "AFTER",
	LeftPane,
	RightPane,
	LeftLabel,
	RightLabel,
	Tone = "raw",
	Class = "",
} = Astro.props;

/** The selected segment's fill AND its ink, in one string: the two travel
 *  together, because a fill without its readable foreground is half a choice.
 *  `raw` reproduces the call sites' own `bg-raw-blood` + `text-bone-white`
 *  byte for byte; the other three take soot ink, the same pairing the solid
 *  `.telemetry-tag` modifiers use. */
const ToneClass = {
	raw: "bg-raw-blood text-bone-white",
	canary: "bg-stamped-canary text-soot-black",
	teal: "bg-weathered-teal text-soot-black",
	bone: "bg-bone-newsprint text-soot-black",
}[Tone];

/** The ribbon geometry, one string for the whole set. */
const Ribbon =
	"flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-oxblood-dark bg-asphalt-panel px-3 py-1.5 font-mono text-base font-black uppercase tracking-widest";
---

<div
	class:list={[
		"grunge zine-box-subtle border-[3px] border-oxblood-dark bg-carbon-void p-4 sm:p-5",
		Class,
	]}
	data-grunge
	data-zine-toggle
	data-toggle-active={ToneClass}
>
	<div
		class="zine-toggle-bar mb-3 flex border-2 border-black bg-asphalt-panel shadow-[3px_3px_0px_#000]"
		role="group"
		aria-label="Toggle the before and after panes"
	>
		<button
			class:list={[
				"grow px-3 py-1.5 font-mono text-base font-black uppercase tracking-widest",
				ToneClass,
			]}
			data-toggle-side="left"
			type="button"
			aria-pressed="true"
		>
			{Left}
		</button>
		<button
			class="grow px-3 py-1.5 font-mono text-base font-black uppercase tracking-widest text-zinc-dust hover:text-bone-white"
			data-toggle-side="right"
			type="button"
			aria-pressed="false"
		>
			{Right}
		</button>
	</div>

	<!-- Left pod: the canary label is the identity of the "before" side, and
	     the state name rides the ribbon as the tag so the pod says both what
	     the pane holds and which half of the comparison it is. -->
	<div class="zine-toggle-pane border-2 border-oxblood-dark bg-asphalt-panel" data-toggle-pane="left">
		<div class={`${Ribbon} text-stamped-canary`}>
			<span class="min-w-0 break-words">{LeftLabel ?? Left}</span>
			{LeftLabel !== undefined && (
				<span class="telemetry-tag telemetry-tag--canary ml-auto shrink-0">{Left}</span>
			)}
		</div>
		<div class="p-2">
			<div
				class="border border-oxblood-dark bg-soot-black p-3 font-mono text-base leading-relaxed text-zinc-dust"
				set:html={LeftPane}
			/>
		</div>
	</div>

	<!-- Right pod: teal, bold bone ink - the "after" side is the answer, so it
	     is the one the eye lands on when the two are read in order. -->
	<div
		class="zine-toggle-pane mt-4 border-2 border-oxblood-dark bg-asphalt-panel"
		data-toggle-pane="right"
	>
		<div class={`${Ribbon} text-weathered-teal`}>
			<span class="min-w-0 break-words">{RightLabel ?? Right}</span>
			{RightLabel !== undefined && (
				<span class="telemetry-tag telemetry-tag--teal ml-auto shrink-0">{Right}</span>
			)}
		</div>
		<div class="p-2">
			<div
				class="border border-oxblood-dark bg-soot-black p-3 font-mono text-base font-bold leading-relaxed text-bone-white"
				set:html={RightPane}
			/>
		</div>
	</div>
</div>

<script>
	/** One controller per bound module; a second bind is refused while it is live. */
	const Bound = new WeakMap<HTMLElement, AbortController>();

	function BindToggle(Root: HTMLElement): void {
		const Live = Bound.get(Root);

		if (Live !== undefined && !Live.signal.aborted) {
			return;
		}

		const Controller = new AbortController();
		const { signal } = Controller;

		Bound.set(Root, Controller);

		const Buttons = [...Root.querySelectorAll<HTMLButtonElement>("[data-toggle-side]")];
		const Panes: Record<string, HTMLElement | null> = {
			left: Root.querySelector<HTMLElement>("[data-toggle-pane='left']"),
			right: Root.querySelector<HTMLElement>("[data-toggle-pane='right']"),
		};

		/** The selected segment's fill, read off the frame so the tone is decided
		 *  once, in the frontmatter: the script applies classes, it never chooses
		 *  a colour. The fallback is the `raw` pair the component shipped before
		 *  `Tone` existed, so an older serialised frame still toggles correctly. */
		const Fill = (Root.dataset["toggleActive"] ?? "bg-raw-blood text-bone-white")
			.split(/\s+/)
			.filter(Boolean);

		/** The idle segment's voice: the two classes the unselected tab carries,
		 *  and both have to come off when the tab is selected - `text-zinc-dust`
		 *  because the fill brings its own ink, and the hover colour because a
		 *  bone-white hover over a canary or bone fill is unreadable. */
		const Idle = ["text-zinc-dust", "hover:text-bone-white"];

		function Select(Side: "left" | "right"): void {
			for (const Button of Buttons) {
				const Active = Button.dataset["toggleSide"] === Side;

				for (const Name of Fill) {
					Button.classList.toggle(Name, Active);
				}

				for (const Name of Idle) {
					Button.classList.toggle(Name, !Active);
				}

				Button.setAttribute("aria-pressed", String(Active));
			}

			Panes.left?.toggleAttribute("hidden", Side !== "left");
			Panes.right?.toggleAttribute("hidden", Side !== "right");
		}

		for (const Button of Buttons) {
			Button.addEventListener(
				"click",
				() => Select(Button.dataset["toggleSide"] === "right" ? "right" : "left"),
				{ signal },
			);
		}

		// The first frame is the server-rendered default selection, applied
		// before the stylesheet is told the module is bound - so the collapse
		// never happens a frame before the pane that replaces it.
		Select("left");
		Root.dataset.toggleReady = "1";
	}

	const BindAll = (): void => {
		for (const Root of document.querySelectorAll<HTMLElement>("[data-zine-toggle]")) {
			BindToggle(Root);
		}
	};

	/** Before a swap: every listener this module owns goes with its controller. */
	const StopAll = (): void => {
		for (const Root of document.querySelectorAll<HTMLElement>("[data-zine-toggle]")) {
			Bound.get(Root)?.abort();
			Bound.delete(Root);
		}
	};

	BindAll();
	document.addEventListener("astro:page-load", BindAll);
	document.addEventListener("astro:before-swap", StopAll);
</script>
