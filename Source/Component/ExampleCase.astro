---
/**
 * ExampleCase - ONE worked scenario, in the one shape every scenario takes.
 *
 * The page's seven mechanics scenarios all said the same thing in seven
 * different layouts: a hand-rolled tape, a hand-rolled crimson plate, a
 * two-column grid, a hand-written stream pane, an optional table, and a
 * hand-written SRC line. This component owns that frame and the shape inside
 * it, so a scenario is a data entry, not markup:
 *
 *   CLAIM    - the h2 and its sentences, one block each (PROSE BREAKDOWN)
 *   COMMAND  - the one command or call that starts the scenario (CodeFence)
 *   OUTPUT   - the real output, in the ZineStream pane with its tones
 *   MARKER   - the preview line and the marker it produced (ZinePreview)
 *   PANELS   - the scenario's own evidence, from a closed set of five shapes
 *   SRC      - the citation line, one form (D9's larger rhythm)
 *
 * The stream/preview pair is grammar law 4 - the soot-black pane showing the
 * raw flow beside the asphalt pane showing the compressed line - so every
 * scenario now demonstrates the product's whole argument instead of one page
 * doing it.
 *
 * TWO PRESENTATIONS, ONE RECORD.
 *
 * The sequence above is ONE mechanism - original output in, preview plus marker
 * out - and it was being rendered for four. An example whose data says it
 * produced no marker still printed a `THE MARKER` label over a `PREVIEW + HASH`
 * pane, and an example that never went through the classifier at all still read
 * as if it had. `Library` switches this component to the outcome-aware
 * presentation: a compact resting state (title, one-sentence takeaway, an
 * excerpt, what the agent saw, the outcome's name, an `Inspect example`
 * control) and one `<details>` holding the full output, the retrieval round
 * trip, the threshold decision, the configuration and the citation. `Outcome`
 * decides which visual the mechanism gets - compressed, passthrough, injected
 * or callback - because four different mechanisms that look identical are four
 * mechanisms the reader cannot tell apart.
 *
 * Without `Library` this component renders exactly the sequence it always has,
 * so a page that has not adopted the outcome model (or a scenario that really
 * is one stream in, one preview out) is unaffected.
 */
import ZineBox from "./ZineBox.astro";
import ZineTape from "./ZineTape.astro";
import ZineStream from "./ZineStream.astro";
import ZinePreview from "./ZinePreview.astro";
import ZineSource from "./ZineSource.astro";
import ZineKicker from "./ZineKicker.astro";
import CodeFence from "./CodeFence.astro";
import ExamplePanels from "./ExamplePanels.astro";
import type { ExampleOutcome, ExampleProvenance, ExampleRecord } from "@Library/Records";

// The record shape - the claim/command/output/marker/panels/src frame and the
// three panel shapes - lives in Source/Library/Records.ts, not here: the
// page's Cases array and this component are typed by the same declaration, so
// a scenario cannot carry a field the renderer drops. A page adds a field by
// adding it to the record, and the renderer fails to compile until it renders.

/** The props ARE the record: a scenario is a data entry, not markup. */
type Props = ExampleRecord & {
	/**
	 * The motion contract's opt-ins (Documentation/Motion.md), default off so
	 * this component's rendering is unchanged for a page that has not asked:
	 * `Reveal` gives the whole scenario one scroll entrance, `Stream` prints
	 * its OUTPUT pane line by line on that entrance's beat. The OUTPUT pane is
	 * the one genuine command output on the page, which is why the stagger
	 * belongs there and never on the claim's prose.
	 */
	Reveal?: boolean;
	Stream?: boolean;

	/**
	 * The outcome-aware presentation: compact resting state, one `Inspect
	 * example` fold holding the evidence. Off by default - see the header.
	 */
	Library?: boolean;

	/**
	 * The numbers the threshold decision was made against, printed inside the
	 * fold. Passed in rather than imported so the page stays the one place
	 * that knows which bank of defaults it is showing.
	 */
	Defaults?: Record<string, number | string>;
};

const {
	Id,
	N,
	Label,
	Title,
	Tone = "crimson",
	Rotate = "",
	Claim,
	Command,
	Output,
	Preview,
	Marker,
	Outcome = "compressed",
	Provenance = "Illustrative",
	Stages = [],
	Retrieval,
	Note,
	Panels = [],
	Diagram,
	Src,
	Reveal = false,
	Stream = false,
	Library = false,
	Defaults = {},
} = Astro.props;

const TapeColor = { crimson: "raw", canary: "canary", teal: "teal" } as const;

/**
 * When the marker lands: the frame the last printed output line finishes.
 * Documentation/Motion.md's `[data-stream]` beat - 140ms lead, 70ms per line,
 * 160ms per line - read over this scenario's own line count, so the preview
 * never arrives before the output it summarises has stopped arriving.
 */
const StreamBeat = 140 + Math.max(0, Output.length - 1) * 70 + 160;

/**
 * THE FOUR OUTCOMES, each with the words its own visual carries. This is
 * presentation, not data: the mechanism gloss explains the MECHANISM, the
 * example's own fields carry the specifics, and neither restates the other.
 */
const OutcomeCopy: Record<
	ExampleOutcome,
	{ Label: string; Original: string; Result: string; Decision: string }
> = {
	compressed: {
		Label: "COMPRESSED",
		Original: "THE ORIGINAL OUTPUT",
		Result: "WHAT THE AGENT SEES // PREVIEW + MARKER",
		Decision:
			"Over the surface's threshold: the bytes are hashed (BLAKE3), stored, and the transcript keeps a preview line plus a marker that addresses the original. Retrieval returns the exact original bytes, so the round trip closes with nothing lost.",
	},
	passthrough: {
		Label: "PASSED THROUGH",
		Original: "THE INPUT",
		Result: "WHAT THE AGENT SEES // UNCHANGED",
		Decision:
			"Under the surface's threshold, or stopped by a skip gate: the output reaches the transcript byte-identical and nothing is stored. Compression is a byte count against a threshold, never a judgment call - which is why the preview below was computed and then never emitted.",
	},
	injected: {
		Label: "INJECTED",
		Original: "THE ASSEMBLY ORDER",
		Result: "WHAT THE AGENT SEES // THE BLOCK HEADER",
		Decision:
			"Not a tool result at all: short behavioural files are assembled in a fixed order and injected into the prompt every turn, ahead of nudges and the recall catalog. Sections drop bottom-up when the flow budget is tight; directives and nudges never drop.",
	},
	callback: {
		Label: "CALLBACK",
		Original: "THE EXCHANGE",
		Result: "WHAT THE AGENT SEES // THE QUEUED REPLY",
		Decision:
			"A fire-and-forget relay call: the request answers immediately with a queued reply, and the real result arrives later, POSTed to the callback URL. Two deliveries, one call - which is why the exchange below is three stages and not one stream.",
	},
};

/** The provenance chip. The colour REINFORCES the words; it never carries them,
 * which is why every variant also spells its provenance out in the chip. */
const ProvenanceTone: Record<ExampleProvenance, string> = {
	Illustrative: "telemetry-tag",
	"Catalog-exact": "telemetry-tag telemetry-tag--teal",
	Captured: "telemetry-tag telemetry-tag--canary",
	"Engine-verified": "telemetry-tag telemetry-tag--bone",
};

/** The resting state's excerpt: enough to see the shape, not the whole stream. */
const ExcerptLines = Output.slice(0, 4);
const ExcerptMore = Math.max(0, Output.length - ExcerptLines.length);

/** A sequential mechanism renders its own order; the others render the pair. */
const Sequential = Outcome === "injected" || Outcome === "callback";

/** The outcome's own label chip, so the mechanism is named in text. Colour is
 * identity here: canary is compression, teal is a passthrough, bone is an
 * injection, crimson is a callback - the same mapping the preview panes use. */
const OutcomeChip = {
	compressed: "telemetry-tag telemetry-tag--canary",
	passthrough: "telemetry-tag telemetry-tag--teal",
	injected: "telemetry-tag telemetry-tag--bone",
	callback: "telemetry-tag telemetry-tag--crimson",
}[Outcome];
---

<section id={Id} class="relative w-full scroll-mt-24" data-reveal={Reveal ? "" : undefined}>
	<ZineBox Tone={Tone} Rotate={Rotate}>
		<ZineTape Label={`${N} // ${Label}`} Color={TapeColor[Tone]} Side="left" />
		{
			Library ? (
				<div class="mt-6 flex flex-col">
					<!-- ============ THE RESTING STATE ============ -->
					<div class="flex flex-wrap items-center gap-2">
						<span class:list={[ProvenanceTone[Provenance]]}>{Provenance}</span>
						<span class:list={[OutcomeChip]}>{OutcomeCopy[Outcome].Label}</span>
					</div>

					<h3 class="type-sub mt-5 uppercase text-bone-white">{Title}</h3>

					{/* One sentence: the takeaway, not the whole claim. */}
					<p class="type-body mt-3 max-w-3xl text-bone-newsprint" set:html={Claim[0]} />

					{Sequential ? (
						<div class="mt-8 flex flex-col gap-8">
							<div class="flex flex-col gap-4">
								<ZineKicker As="p" Tone="dust">
									{OutcomeCopy[Outcome].Original}
								</ZineKicker>
								{Stages.map((Stage, Index) => (
									<div class="well p-4">
										<div class="flex flex-wrap items-baseline gap-3">
											<span class="telemetry-tag telemetry-tag--crimson tabular-nums">
												{String(Index + 1).padStart(2, "0")}
											</span>
											{/* `min-w-0 break-words`: a stage label can name a URL, and one
											    unbreakable token sets the flex item's min-content width - so
											    the item refused to shrink and the section's `overflow-x: clip`
											    cut the label off mid-word at 390px. `min-w-0` lets the item
											    take the row's width and `break-words` breaks the token only
											    because it cannot fit; the label's own words never split. */}
											<span class="min-w-0 break-words font-mono text-base font-black uppercase tracking-widest text-stamped-canary">
												{Stage.Label}
											</span>
										</div>
										<div class="mt-3">
											<ZineStream Lines={Stage.Lines} />
										</div>
									</div>
								))}
							</div>
							<div>
								<ZineKicker As="p" Tone="dust">
									{OutcomeCopy[Outcome].Result}
								</ZineKicker>
								<div class="mt-3 max-w-3xl">
									<ZinePreview
										Label={Outcome === "callback" ? "PREVIEW + MARKER" : "THE PREVIEW LINE"}
										Result={Preview}
										Hash={Outcome === "callback" ? Marker : undefined}
										Enter={StreamBeat}
									/>
								</div>
							</div>
						</div>
					) : (
						<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
							<div>
								<ZineKicker As="p" Tone="dust">
									{OutcomeCopy[Outcome].Original}
								</ZineKicker>
								<div class="mt-3">
									<ZineStream Lines={ExcerptLines} Stream={Stream} />
								</div>
								{ExcerptMore > 0 && (
									<p class="mt-3 font-mono text-base leading-relaxed text-zinc-dust">
										{ExcerptMore} more {ExcerptMore === 1 ? "line" : "lines"} - inspect the example for
										the full stream.
									</p>
								)}
							</div>
							<div>
								<ZineKicker As="p" Tone="dust">
									{OutcomeCopy[Outcome].Result}
								</ZineKicker>
								{Outcome === "compressed" ? (
									<div class="mt-3">
										<ZinePreview
											Label="PREVIEW + MARKER"
											Result={Preview}
											Hash={Marker}
											Enter={StreamBeat}
										/>
									</div>
								) : (
									<div class="mt-3 well p-4">
										<ul class="flex flex-col gap-2 font-mono text-base leading-relaxed">
											<li>
												<span class="text-zinc-dust">bytes</span>{" "}
												<span class="text-bone-white">identical to the input above</span>
											</li>
											<li>
												<span class="text-zinc-dust">marker</span>{" "}
												<span class="text-bone-white">none - the output stays raw, no marker stored</span>
											</li>
											<li>
												<span class="text-zinc-dust">store</span>{" "}
												<span class="text-bone-white">no entry</span>
											</li>
										</ul>
										<div class="mt-4 border-t border-oxblood-dark pt-4">
											<p class="font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
												THE PREVIEW THE CLASSIFIER WOULD HAVE WRITTEN - NEVER EMITTED
											</p>
											<div class="mt-2 well p-2 font-mono text-base text-bone-newsprint">
												{Preview}
											</div>
										</div>
									</div>
								)}
							</div>
						</div>
					)}

					<!-- ============ THE INSPECT FOLD ============ -->
					<details class="group mt-10 well">
						<summary
							class="flex cursor-pointer list-none flex-wrap items-center gap-3 border-b border-transparent tier-shell px-4 py-3 font-mono text-base text-bone-newsprint transition-colors group-open:border-[var(--tier-well-edge)] hover:text-bone-white"
						>
							<span class="telemetry-tag telemetry-tag--crimson">INSPECT EXAMPLE</span>
							<span class="grow font-normal text-zinc-dust">
								full output · retrieval call and answer · threshold decision · configuration ·
								sources
							</span>
							<span class="text-stamped-canary group-open:hidden" aria-hidden="true">OPEN +</span>
							<span class="hidden text-zinc-dust group-open:inline" aria-hidden="true">CLOSE −</span>
						</summary>

						<div class="flex flex-col gap-12 p-4 sm:p-6">
							<!-- THE CLAIM, IN FULL -->
							<div>
								<ZineKicker As="p" Tone="dust">THE CLAIM // IN FULL</ZineKicker>
								<div class="prose-flow mt-4 max-w-3xl">
									{Claim.map((Sentence) => (
										<p class="type-body text-bone-newsprint" set:html={Sentence} />
									))}
								</div>
							</div>

							<!-- THE COMMAND -->
							<div>
								<ZineKicker As="p" Tone="dust">THE COMMAND</ZineKicker>
								<div class="mt-3 border-2 border-oxblood-dark bg-soot-black">
									<CodeFence Code={Command.Code} Lang={Command.Lang} Copy />
								</div>
							</div>

							<!-- THE FULL OUTPUT -->
							<div>
								<ZineKicker As="p" Tone="dust">THE FULL OUTPUT // EVERY LINE</ZineKicker>
								<div class="mt-3">
									<ZineStream Lines={Output} />
								</div>
							</div>

							<!-- THE RETRIEVAL ROUND TRIP -->
							{
								Retrieval && (
									<div>
										<ZineKicker As="p" Tone="dust">
											THE RETRIEVAL // THE CALL AND THE ANSWER
										</ZineKicker>
										<div class="mt-3 border-2 border-oxblood-dark bg-soot-black">
											<CodeFence Code={Retrieval.Call} Lang="text" Copy />
										</div>
										<ul
											class="mt-3 well flex flex-col gap-2 p-4 font-mono text-base leading-relaxed"
										>
											<li>
												<span class="text-zinc-dust">found</span>{" "}
												<span class="text-bone-white">{Retrieval.Found ? "true" : "false"}</span>
											</li>
											<li>
												<span class="text-zinc-dust">source</span>{" "}
												<span class="text-bone-white">{Retrieval.Source}</span>
											</li>
											<li>
												<span class="text-zinc-dust">hash</span>{" "}
												<span class="break-all text-weathered-teal">{Retrieval.Hash}</span>
											</li>
											<li>
												<span class="text-zinc-dust">content</span>{" "}
												<span class="text-bone-white">{Retrieval.Content}</span>
											</li>
										</ul>
									</div>
								)
							}

							<!-- THE THRESHOLD DECISION + THE CONFIGURATION IT READ -->
							<div>
								<ZineKicker As="p" Tone="dust">THE THRESHOLD DECISION</ZineKicker>
								<p class="type-body mt-3 max-w-3xl text-bone-newsprint">
									{OutcomeCopy[Outcome].Decision}
								</p>
								{
									Object.keys(Defaults).length > 0 && (
										<div class="mt-6 well p-4">
											<p class="section-index">THE CONFIGURATION IN PLAY</p>
											<p class="type-body mt-2 max-w-3xl text-bone-newsprint">
												These are the numbers every decision on this page is made against, read
												from the example bank rather than typed into the markup.
											</p>
											<ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2 font-mono text-base leading-relaxed">
												{Object.entries(Defaults).map(([Key, Value]) => (
													<li>
														<span class="text-zinc-dust">{Key}</span>{" "}
														<span class="text-weathered-teal">= {String(Value)}</span>
													</li>
												))}
											</ul>
										</div>
									)
								}
							</div>

							<!-- THE SCENARIO'S OWN EVIDENCE -->
							{/* The five evidence shapes, rendered by the one component that
							    owns them - the same renderer the legacy presentation at the
							    foot of the plate uses, so a shape cannot reach one and miss
							    the other. */}
							<ExamplePanels Panels={Panels} />

							<!-- THE DIAGRAM -->
							{
								Diagram && (
									<figure class="well p-4">
										<div class="overflow-x-auto" set:html={Diagram.Html} />
										<figcaption class="mt-6 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
											{Diagram.Caption}
										</figcaption>
									</figure>
								)
							}

							<!-- THE CLOSING -->
							{
								Note?.length ? (
									<div class="prose-flow max-w-3xl">
										{Note.map((Sentence) => (
											<p class="type-body text-bone-newsprint" set:html={Sentence} />
										))}
									</div>
								) : null
							}

							<!-- THE CITATION -->
							<ZineSource Lines={[Src]} />
						</div>
					</details>
				</div>
			) : (
				<div class="mt-6 grid grid-cols-1 gap-12 lg:grid-cols-2">
					<!-- THE CLAIM -->
					<div>
						<h2 class="font-headline text-2xl font-black uppercase tracking-tight text-bone-white sm:text-4xl">
							{Title}
						</h2>
						{/* ONE mechanism for one relationship: `.prose-flow` owns the
						    distance between the claim's own sentences, so the run carries
						    no container gap and no child carries an `mt-*` - splitting a
						    passage into more paragraphs then adds height once, not twice.
						    The heading is not prose, so its distance to the run is
						    `--space-tight`, the published "heading -> its own context"
						    role, rather than a fifth number. */}
						<div class="prose-flow mt-[var(--space-tight)]">
							{Claim.map((Sentence) => (
								<p class="font-body text-base leading-relaxed text-bone-newsprint" set:html={Sentence} />
							))}
						</div>
					</div>

					<!-- THE MECHANICS: command, output, marker -->
					<div class="flex flex-col gap-8">
						<div>
							<ZineKicker As="h3" Tone="dust">THE COMMAND</ZineKicker>
							<div class="mt-3 border-2 border-oxblood-dark bg-soot-black">
								<CodeFence Code={Command.Code} Lang={Command.Lang} Copy />
							</div>
						</div>
						<div>
							<ZineKicker As="h3" Tone="dust">THE OUTPUT</ZineKicker>
							<div class="mt-3">
								<ZineStream Lines={Output} Stream={Stream} />
							</div>
						</div>
						<div>
							<ZineKicker As="h3" Tone="dust">THE MARKER</ZineKicker>
							<div class="mt-3">
								<ZinePreview
									Label="PREVIEW + HASH"
									Result={Preview}
									Hash={Marker}
									Enter={StreamBeat}
								/>
							</div>
						</div>
					</div>
				</div>
			)
		}

		{
			!Library && (
				<>
					<!-- THE SCENARIO'S OWN EVIDENCE -->
					<ExamplePanels Panels={Panels} Class="mt-24" />

					<!-- THE DIAGRAM -->
					{Diagram && (
						<figure class="mt-24 border border-oxblood-dark bg-asphalt-panel p-4">
							<div class="overflow-x-auto" set:html={Diagram.Html} />
							<figcaption class="mt-6 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
								{Diagram.Caption}
							</figcaption>
						</figure>
					)}

					<!-- THE CLOSING -->
					{Note?.length ? (
						<div class="prose-flow mt-24 max-w-3xl">
							{Note.map((Sentence) => (
								<p class="font-body text-base leading-relaxed text-bone-newsprint" set:html={Sentence} />
							))}
						</div>
					) : null}

					<!-- THE CITATION -->
					<ZineSource Lines={[Src]} />
				</>
			)
		}
	</ZineBox>
</section>
