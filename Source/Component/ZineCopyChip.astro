---
/**
 * ZineCopyChip - the small inline copy chip: a visible label plus the clipboard
 * glyph, riding the site's one clipboard runtime (`[data-copy]`, bound in
 * `Layout/Base.astro`). Same mechanism as `CopyButton`, a quieter shape - it
 * sits inside a row of metadata rather than standing alone as a CTA.
 *
 * A LABEL NAMES THE ACTION, NEVER THE LANGUAGE OR THE FORMAT. `COPY PATH`,
 * `COPY` and `MARKER` all tell the reader what they are about to get; `BASH`
 * would tell them what a block is written in, which is metadata and belongs on
 * the fence's own tag. This chip is also NOT used for a code block's payload:
 * a fence's copy control is the plate's chip (`Source/Script/CodePlate.ts`),
 * which already exists on every fence, so a chip here would be a second
 * control for the same bytes.
 *
 * `Aria` exists for the chips whose visible label is a short verb over an
 * invisible payload - `COPY` beside a shell line names nothing on its own.
 */
interface Props {
	/** The chip text; clicking copies this exact string (defaults to Label). */
	Label: string;

	/** The payload handed to the clipboard; unset copies the Label. */
	Copy?: string;

	/**
	 * The accessible name. A chip that copies a command needs to say WHICH
	 * command: the default reads `Copy <Label> to the clipboard`, which is
	 * useless when the visible label is the word `COPY` and the payload is a
	 * shell line nobody can see from the control.
	 */
	Aria?: string;

	/** Chip color: teal (default), canary, raw, bone. */
	Color?: "teal" | "canary" | "raw" | "bone";
}

const { Label, Copy, Aria, Color = "teal" } = Astro.props;

const Palette = {
	teal: "text-weathered-teal hover:bg-weathered-teal",
	canary: "text-stamped-canary hover:bg-stamped-canary",
	raw: "text-raw-blood hover:bg-raw-blood",
	bone: "text-bone-newsprint hover:bg-bone-newsprint",
}[Color];

const HoverText = {
	teal: "hover:text-bone-white",
	canary: "hover:text-soot-black",
	raw: "hover:text-bone-white",
	bone: "hover:text-soot-black",
}[Color];
---

<button
	class={`group inline-flex items-center gap-1.5 border border-oxblood-dark bg-soot-black px-2 py-1 font-mono text-meta font-bold transition-colors ${Palette} ${HoverText}`}
	data-copy={Copy ?? Label}
	type="button"
	aria-label={Aria ?? `Copy ${Label} to the clipboard`}
>
	<span class="opacity-60 group-hover:opacity-100">{Label}</span>
	<span aria-hidden="true" class="text-base opacity-40 group-hover:opacity-90">
		⧉
	</span>
</button>
