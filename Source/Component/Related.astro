---
import type { InternalLink } from "@Library/Links";

/**
 * NEXT STEPS - the continuation module at the foot of a page.
 *
 * It used to be RELATED: a flat row of destination names, framed like
 * everything else on the page, which a reader could only use if they already
 * knew why they would want any of them. A next step carries its REASON: one
 * line saying what the reader gets by continuing, written by the page's
 * author. A link without a reason still renders - the sixteen pages that pass
 * a plain `InternalLink[]` keep working unchanged - but a page that wants the
 * module to mean something gives each step its `Reason`.
 *
 * The frame is deliberately quiet (a single hairline rule, no plate, no
 * shadow, no tape): this is the last thing on a page, and the reader has
 * already been carried by whatever expressive assembly the page spent.
 *
 * ── THE NEXT-STEPS MATRIX (Stitch grammar) ───────────────────────────────
 *
 * The module is a MATRIX, not a list: every step is a row of two columns - the
 * ordinal in mono, the destination and its reason in the reading column - with
 * a hairline between rows and one full-width rule above the whole module. The
 * shape says what the module is for. A vertical list of underlined names reads
 * as more navigation; a numbered ledger with a reason beside each number reads
 * as a continuation OF THE ARGUMENT the page just made, which is what "next
 * step" means.
 *
 * The head row states the module's own size (`3 DESTINATIONS`) so the reader
 * knows how much is left before starting, the same way the section index states
 * its section count on a phone.
 *
 * Everything the module ever carried still renders: the heading, every
 * destination label verbatim, every reason sentence verbatim, and the filter
 * that drops a link with no destination. Nothing was demoted to a caption and
 * nothing was dropped to make the block smaller - the reasons are the point,
 * and they now sit in a column instead of under a link.
 *
 * The ordinal is `aria-hidden`: it is the row's place in the sequence, and a
 * screen reader announcing "zero one Benchmarks" would read the ruler instead
 * of the destination.
 */
interface Props {
	/** The natural neighbours of the page - truthful links only, never forced. */
	Links?: (InternalLink & { Reason?: string })[];

	/** The module's heading. Overridable so a surface can name its own verb. */
	Title?: string;
}

const { Links = [], Title = "NEXT STEPS" } = Astro.props;

// A page without neighbors renders NO module: an empty NEXT STEPS plate is a
// promise the page cannot keep. Links missing a destination are dropped for
// the same reason - the box only ever ships targets that resolve.
const Entries = Links.filter(({ Href, Label }) => Boolean(Href) && Boolean(Label));
---

{Entries.length > 0 && (
	<nav aria-label="Next steps" class="related">
		<div class="related__head">
			<p class="related__label">{Title}</p>
			<p class="related__label">
				{Entries.length} {Entries.length === 1 ? "DESTINATION" : "DESTINATIONS"}
			</p>
		</div>
		<ul class="related__list">
			{Entries.map((Link, Position) => (
				<li class="related__row">
					<span class="related__ordinal" aria-hidden="true">
						{String(Position + 1).padStart(2, "0")}
					</span>
					<div class="related__body">
						<a class="related__link" href={Link.Href}>
							{Link.Label}
						</a>
						{Link.Reason && <p class="related__reason">{Link.Reason}</p>}
					</div>
				</li>
			))}
		</ul>
	</nav>
)}
