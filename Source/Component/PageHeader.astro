---
/**
 * PageHeader - D2 of the restructure plan. The header block repeated verbatim
 * in ten files: the same `<h1>` class string at all ten, the same wrapper, and
 * a section tape above it that differed only in margin (`mb-12` vs `mb-5`)
 * while the lead's top margin wandered between `mt-4`, `mt-6` and `mt-12`.
 * This component owns the label, the one claim and the lead's rhythm.
 *
 * The lead is one sentence per array entry (PROSE BREAKDOWN item 1): the first
 * entry opens at `mt-6`, every sibling at `mt-3`. That retires the nested
 * `<span class="mt-1 block">` idiom the pages used for a second sentence - the
 * split is structural, the words stay byte-identical.
 *
 * The tape renders through `ZineTape`'s `section` variant, so the `mb-12`/`mb-5`
 * split disappears: one margin, one shape, one component.
 *
 * ── THE INDEX COORDINATE (Stitch grammar) ────────────────────────────────
 *
 * Above the tape the header carries ONE `.telemetry-tag` reading
 * `INDEX 05 / 14`: where this page sits in the site's own index, and how many
 * entries that index has. It is the drawing's sheet number - the thing that
 * tells a reader this page is one of a set, and which one.
 *
 * THE NUMBER IS DERIVED, NEVER TYPED. `AllLinks` (Library/Links) is the single
 * registry every route resolves through, so the coordinate is the entry's
 * position in it, zero-padded, and the total is that registry's own length - so
 * the two halves can never disagree with the navigation, and a page that
 * reorders the registry reorders its coordinate with it. A page that wants a
 * coordinate of its own passes `Index`, and that value wins.
 *
 * A route the registry does not carry - the retired pages CRATES, FLAVORS and
 * HOOKS still render this header - resolves to NO coordinate and the tag is
 * omitted. Inventing a position for a page the index does not know would be a
 * number that means nothing, and the header is complete without it.
 *
 * The tag stays in the QUIET telemetry voice whatever the tape's tone is: the
 * tape carries the section's identity colour, and a second chip in the same
 * colour would take emphasis from it rather than add information.
 */
import ZineTape from "./ZineTape.astro";

import { AllLinks, IsActive } from "@Library/Links";

interface Props {
	/** The tape label, e.g. "BENCHMARKS // MEASURED FIGURES". */
	Tape: string;

	/** The page's one claim, rendered as the `<h1>`. Plain text. */
	Title: string;

	/**
	 * The lead, one sentence per array entry - each becomes its own `<p>`.
	 * An entry may carry inline markup (`<code>`, `<em>`), because the pages'
	 * leads name identifiers in the mono voice; it is rendered as HTML, so a
	 * page passes markup, never user input.
	 */
	Lead: string[];

	/** Tape tone; raw is the section default. */
	Tone?: "raw" | "canary" | "teal";

	/**
	 * The page's coordinate in the site's index, overriding the derived one.
	 * Pass the number only (`"05"`); the tag adds the label and the total.
	 */
	Index?: string;
}

const { Tape, Title, Lead, Tone = "raw", Index } = Astro.props;

/**
 * The registry entry this route belongs to, resolved with the SAME matcher the
 * breadcrumb trail uses (`IsActive`, which compares on the route prefix) rather
 * than with an exact-href lookup: the header and the trail then cannot disagree
 * about which page this is, and a trailing-slash difference between the dev
 * server and the built route cannot silently remove the coordinate.
 */
const Entry = AllLinks.find((Link) => IsActive(Astro.url.pathname, Link));

/** `AllLinks` IS the index, so a position in it is the coordinate. */
const Derived =
	Entry === undefined ? undefined : String(AllLinks.indexOf(Entry) + 1).padStart(2, "0");

const Coordinate = Index ?? Derived;

/** The index's size, in the same two-digit voice as the coordinate. */
const Total = String(AllLinks.length).padStart(2, "0");
---

<header class="relative flex w-full flex-col items-start">
	{
		Coordinate !== undefined && (
			<p
				class="telemetry-tag mb-4"
				title={`Entry ${Coordinate} of ${Total} in the site index`}
			>
				INDEX {Coordinate} / {Total}
			</p>
		)
	}
	<ZineTape Variant="section" Label={Tape} Color={Tone} />
	<h1
		class="font-headline text-3xl font-black uppercase tracking-tight text-bone-white drop-shadow-[4px_4px_0px_#520612] sm:text-6xl"
	>
		{Title}
	</h1>
	{
		Lead.map((Sentence, Position) => (
			<p
				class:list={[
					Position === 0 ? "mt-6" : "mt-3",
					"max-w-3xl font-body text-base leading-relaxed text-bone-newsprint",
				]}
				set:html={Sentence}
			/>
		))
	}
</header>
