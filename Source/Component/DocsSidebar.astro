---
interface Entry {
	Id: string;

	Title: string;
}

interface Props {
	Sections: { Name: string; Entries: Entry[] }[];

	/** Collection id of the page currently being read. */
	CurrentId: string;
}

const { Sections, CurrentId } = Astro.props;

const Href = (Id: string) => (Id === "index" ? "/docs/" : `/docs/${Id}/`);
---

<nav aria-label="Documentation sections">
	<div
		class="relative z-10 max-h-[calc(100vh-9rem)] overflow-y-auto border-4 border-blood-crimson bg-carbon-void p-5 zine-box-subtle"
	>
		<span
			class="absolute -top-3.5 left-4 z-20 -rotate-1 border border-black bg-raw-blood px-3 py-0.5 text-[10px] font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
		>
			DOC INDEX
		</span>

		<div class="mt-2 flex flex-col gap-8">
			{
				Sections.map(({ Name, Entries }) => (
					<div class="flex flex-col gap-2">
						<p class="flex items-center gap-2 font-mono text-[10px] font-black uppercase tracking-widest text-zinc-dust">
							<span class="inline-block h-3 w-1 bg-blood-crimson" aria-hidden="true" />
							{Name}
						</p>
						<ul class="flex flex-col gap-1 border-l border-oxblood-dark pl-3">
							{Entries.map((Entry) => {
								const Current = Entry.Id === CurrentId;

								return (
									<li>
										<a
											href={Href(Entry.Id)}
											aria-current={Current ? "page" : undefined}
											class={`block px-2 py-0.5 font-mono text-xs leading-relaxed transition-colors ${
												Current
													? "bg-raw-blood text-bone-white"
													: "text-zinc-dust hover:text-bone-white"
											}`}
										>
											{Entry.Title}
										</a>
									</li>
								);
							})}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</nav>
