---
interface Entry {
	Id: string;

	Title: string;

	/** Roadmap / partly unimplemented docs carry the WIP mark. */
	Wip?: boolean;
}

interface Props {
	Sections: { Name: string; Entries: Entry[] }[];

	/** Collection id of the page currently being read. */
	CurrentId: string;
}

const { Sections, CurrentId } = Astro.props;

const Href = (Id: string) => (Id === "index" ? "/docs/" : `/docs/${Id}/`);
---

<nav aria-label="Documentation sections">
	<div class="relative">
	<!-- The tape stamp lives OUTSIDE the scroll container: overflow-y-auto
	     clips absolutely-positioned children that cross its top edge, and
	     z-index cannot undo a clip. The scroll applies to the entry box only. -->
	<span
		class="absolute -top-3.5 left-4 z-20 -rotate-1 border border-black bg-raw-blood px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
	>
		DOC INDEX
	</span>
	<div
		class="relative z-10 max-h-[calc(100vh-9rem)] overflow-y-auto border-4 border-blood-crimson bg-carbon-void p-5 zine-box-subtle"
	>
		<div class="flex flex-col gap-8">
			{
				Sections.map(({ Name, Entries }) => (
					<div class="flex flex-col gap-2">
						<p class="flex items-center gap-2 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
							<span class="inline-block h-3 w-1 bg-blood-crimson" aria-hidden="true" />
							{Name}
						</p>
						<ul class="flex flex-col gap-1 border-l border-oxblood-dark pl-3">
							{Entries.map((Entry) => {
								const Current = Entry.Id === CurrentId;

								return (
									<li>
										<a
											href={Href(Entry.Id)}
											aria-current={Current ? "page" : undefined}
											class={`block px-2 py-0.5 font-mono text-base leading-relaxed transition-colors ${
												Current
													? "bg-raw-blood text-bone-white"
													: "text-zinc-dust hover:text-bone-white"
											}`}
										>
											{Entry.Title}
											{
												Entry.Wip && (
													<span
														class="ml-2 inline-block border border-black bg-stamped-canary px-1.5 align-middle font-mono text-[13px] font-black uppercase leading-tight tracking-widest text-soot-black"
														title="Roadmap: partly unimplemented"
													>
														WIP
													</span>
												)
											}
										</a>
									</li>
								);
							})}
						</ul>
					</div>
				))
			}
		</div>
		</div>
	</div>
</nav>
