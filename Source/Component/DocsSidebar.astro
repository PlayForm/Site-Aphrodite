---
import { getCollection } from "astro:content";

// ── THE DOCS TREE ─────────────────────────────────────────────────────────
// The rail is not handed a list of links: it reads the docs collection's own
// ids and frontmatter, so what the reader sees below /docs/ is the tree the
// collection actually serves. `DocsTree` and `DocsTrail` are exported because
// Breadcrumbs.astro renders the same trail - one derivation, two surfaces, so
// a crumb can never name a page the rail does not show in that position.

interface DocsPage {
	Id: string;
	Title: string;
	Href: string;
	Children: DocsPage[];
}

interface DocsSection {
	Name: string;
	Pages: DocsPage[];
	Count: number;
}

interface Heading {
	Depth: number;
	Id: string;
	Label: string;
}

interface Crumb {
	Label: string;
	Href?: string;
}

/** The docs hierarchy: sections, their pages, and the one nested level.
    Self-contained on purpose: Astro hoists an exported component-script
    function to module scope, so anything it closes over must live inside it. */
export async function DocsTree(): Promise<DocsSection[]> {
	const HrefOf = (Id: string) => (Id === "index" ? "/docs/" : `/docs/${Id}/`);

	const Entries = (await getCollection("Docs"))
		.map(({ id, data }) => ({ Id: id, Title: data.title, Section: data.section }))
		.sort((A, B) => A.Id.localeCompare(B.Id));

	const ById = new Map(Entries.map((Entry) => [Entry.Id, Entry]));

	// The one genuine level of nesting: a folder that is also its own page. The
	// platform pages under install/ are siblings of the Install index, not its
	// children, so they stay at depth 0 - only ccr/backends/* nests, because
	// "CCR Backends" is a page that owns the three backends beneath it.
	const ParentOf = (Entry: { Id: string; Section: string }) => {
		const Segments = Entry.Id.split("/");

		if (Segments.length < 3) {
			return undefined;
		}

		const Parent = ById.get(Segments.slice(0, -1).join("/"));

		return Parent !== undefined && Parent.Section === Entry.Section
			? Parent.Id
			: undefined;
	};

	const Pages = new Map(
		Entries.map((Entry) => [
			Entry.Id,
			{
				Id: Entry.Id,
				Title: Entry.Title,
				Href: HrefOf(Entry.Id),
				Children: [] as DocsPage[],
			},
		]),
	);

	const Roots: DocsPage[] = [];

	for (const Entry of Entries) {
		const Page = Pages.get(Entry.Id)!;
		const Parent = ParentOf(Entry);

		switch (Parent) {
			case undefined:
				Roots.push(Page);
				break;
			default:
				Pages.get(Parent)!.Children.push(Page);
		}
	}

	// Sections keep the id order inside them - the docs tree's numeric prefixes
	// (architecture/01-startup, .../02-chat-compression) ARE its reading order.
	// Overview opens the rail; the rest read A-Z.
	const Sections = new Map<string, DocsPage[]>();

	for (const Page of Roots) {
		const Name = ById.get(Page.Id)!.Section;

		Sections.set(Name, [...(Sections.get(Name) ?? []), Page]);
	}

	// The group's own page opens it - the docs root for Overview, the section
	// index (install) for Install - and the rest keep id order, which is the
	// docs tree's reading order.
	const RankOf = (Name: string, Page: DocsPage) =>
		Page.Id === "index" || Page.Id.toLowerCase() === Name.toLowerCase() ? 0 : 1;

	return [...Sections.entries()]
		.sort(([A], [B]) =>
			A === "Overview" ? -1 : B === "Overview" ? 1 : A.localeCompare(B),
		)
		.map(([Name, Pages]) => ({
			Name,
			Pages: [...Pages].sort(
				(A, B) => RankOf(Name, A) - RankOf(Name, B) || A.Id.localeCompare(B.Id),
			),
			Count: Pages.reduce((Total, Page) => Total + 1 + Page.Children.length, 0),
		}));
}

/** The breadcrumb trail for one collection id, read from the same tree.
    The last crumb is the page itself and carries no href. */
export async function DocsTrail(Id: string): Promise<Crumb[]> {
	const HrefOf = (Target: string) =>
		Target === "index" ? "/docs/" : `/docs/${Target}/`;

	const Sections = await DocsTree();

	if (Id === "index") {
		// The docs root IS /docs/: a trail would only repeat its own name.
		return [];
	}

	const SectionIndexOf = (Name: string) =>
		Sections.some(
			({ Pages }) =>
				Pages.some((Page) => Page.Id === Name.toLowerCase()) ||
				Pages.some((Page) =>
					Page.Children.some((Child) => Child.Id === Name.toLowerCase()),
				),
		);

	for (const { Name, Pages } of Sections) {
		// The section's own index page IS its section crumb: repeating the name
		// as a link to the page you are on is a self-link, so it is dropped.
		const IsSectionIndexPage = Name.toLowerCase() === Id;

		const Trail: Crumb[] = [
			{ Label: "DOCS", Href: "/docs/" },
			...(IsSectionIndexPage
				? []
				: [
						{
							Label: Name,
							// A section names a destination only when it has its own
							// index page (install -> docs/install); otherwise it is a
							// label.
							Href: SectionIndexOf(Name)
								? HrefOf(Name.toLowerCase())
								: undefined,
						},
					]),
		];

		for (const Page of Pages) {
			if (Page.Id === Id) {
				return [...Trail, { Label: Page.Title }];
			}

			for (const Child of Page.Children) {
				if (Child.Id === Id) {
					return [
						...Trail,
						{ Label: Page.Title, Href: Page.Href },
						{ Label: Child.Title },
					];
				}
			}
		}
	}

	return [];
}

interface Props {
	/** The Wip overlay. The single WIP registry lives on the docs route (see
	    Documentation/Skill/wip-marking) and this component never re-decides what
	    is WIP - it only renders the flags it is handed. */
	Sections?: { Entries: { Id: string; Wip?: boolean }[] }[];

	/** Collection id of the page currently being read. Derived from the URL
	    when the route does not pass it. */
	CurrentId?: string;

	/** The current page's own headings: the in-page outline, not a registry. */
	Headings?: Heading[];

	/** Landmark name. The desktop rail and the mobile drawer render this
	    component twice, so the two must not share one label. */
	Label?: string;
}

const { Sections: Registry, CurrentId, Headings = [], Label = "Documentation sections" } =
	Astro.props;

// "/docs/ccr/backends/sqlite/" -> "ccr/backends/sqlite"; "/docs/" -> "index".
const IdFromUrl = () => {
	const Path = Astro.url.pathname.replace(/^\/docs\/?/, "").replace(/\/+$/, "");

	return Path === "" ? "index" : Path;
};

const Current = CurrentId ?? IdFromUrl();

const Sections = await DocsTree();

const WipIds = new Set(
	(Registry ?? []).flatMap(({ Entries }) =>
		Entries.filter(({ Wip }) => Wip === true).map(({ Id }) => Id),
	),
);

const HoldsCurrent = ({ Pages }: DocsSection) =>
	Pages.some(
		(Page) =>
			Page.Id === Current || Page.Children.some(({ Id }) => Id === Current),
	);
---

<nav aria-label={Label}>
	<div class="relative">
	<!-- The tape stamp lives OUTSIDE the scroll container: overflow-y-auto
	     clips absolutely-positioned children that cross its top edge, and
	     z-index cannot undo a clip. The scroll applies to the entry box only. -->
	<span
		class="absolute -top-3.5 left-4 z-20 -rotate-1 border border-black bg-raw-blood px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]"
	>
		DOC INDEX
	</span>
	<div
		class="relative z-10 max-h-[calc(100vh-9rem)] overflow-y-auto border-4 border-blood-crimson bg-carbon-void p-5 zine-box-subtle"
	>
		{
			Headings.length > 1 && (
				<nav
					aria-label={`${Label} · on this page`}
					class="mb-8 border-b border-oxblood-dark pb-6"
				>
					<p class="font-mono text-base font-black uppercase tracking-widest text-stamped-canary">
						ON THIS PAGE
					</p>
					<ul class="mt-3 flex flex-col gap-1 border-l border-oxblood-dark pl-3">
						{Headings.map(({ Depth, Id, Label: Text }) => (
							<li class={Depth === 3 ? "pl-3" : undefined}>
								<a
									href={`#${Id}`}
									data-toc-link={Id}
									class="block px-2 py-0.5 font-mono text-base leading-relaxed text-zinc-dust transition-colors hover:text-bone-white aria-[current=location]:bg-raw-blood aria-[current=location]:text-bone-white"
								>
									{Text}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
		<div class="flex flex-col gap-2">
			{
				Sections.map((Section) => {
					const IsCurrent = HoldsCurrent(Section);

					return (
						<details
							class="group"
							open={IsCurrent}
							data-docs-section={Section.Name}
							data-current-section={IsCurrent ? "1" : undefined}
						>
							<summary class="flex cursor-pointer list-none items-center gap-2 font-mono text-base font-black uppercase tracking-widest transition-colors [&::-webkit-details-marker]:hidden">
								<span
									class={`inline-block h-3 w-1 shrink-0 ${
										IsCurrent ? "bg-stamped-canary" : "bg-blood-crimson"
									}`}
									aria-hidden="true"
								/>
								<span
									class={`min-w-0 flex-1 ${
										IsCurrent
											? "text-bone-white"
											: "text-zinc-dust group-hover:text-bone-white"
									}`}
								>
									{Section.Name}
								</span>
								<span
									class={`font-mono text-[13px] font-normal tracking-normal ${
										IsCurrent ? "text-stamped-canary" : "text-oxblood-dark"
									}`}
								>
									{Section.Count}
								</span>
								<span
									class={`inline-block font-mono text-[13px] transition-transform group-open:rotate-90 ${
										IsCurrent ? "text-stamped-canary" : "text-oxblood-dark"
									}`}
									aria-hidden="true"
								>
									▸
								</span>
							</summary>
							<ul class="mt-2 flex flex-col gap-1 border-l border-oxblood-dark pl-3">
								{Section.Pages.map((Page) => (
									<li>
										<a
											href={Page.Href}
											aria-current={Page.Id === Current ? "page" : undefined}
											class={`block py-0.5 pr-2 font-mono text-base leading-relaxed transition-colors ${
												Page.Id === Current
													? "bg-raw-blood pl-2 text-bone-white"
													: "pl-2 text-zinc-dust hover:text-bone-white"
											}`}
										>
											{Page.Id === Current && (
												<span
													class="mr-1.5 inline-block h-2 w-2 bg-stamped-canary align-middle"
													aria-hidden="true"
												/>
											)}
											{Page.Title}
											{WipIds.has(Page.Id) && (
												<span
													class="ml-2 inline-block border border-black bg-stamped-canary px-1.5 align-middle font-mono text-[13px] font-black uppercase leading-tight tracking-widest text-soot-black"
													title="Roadmap: partly unimplemented"
												>
													WIP
												</span>
											)}
										</a>
										{Page.Children.length > 0 && (
											<ul class="mt-1 flex flex-col gap-1 border-l border-oxblood-dark pl-3">
												{Page.Children.map((Child) => (
													<li>
														<a
															href={Child.Href}
															aria-current={
																Child.Id === Current ? "page" : undefined
															}
															class={`block py-0.5 pr-2 font-mono text-base leading-relaxed transition-colors ${
																Child.Id === Current
																	? "bg-raw-blood pl-2 text-bone-white"
																	: "pl-2 text-zinc-dust hover:text-bone-white"
															}`}
														>
															{Child.Id === Current && (
																<span
																	class="mr-1.5 inline-block h-2 w-2 bg-stamped-canary align-middle"
																	aria-hidden="true"
																/>
															)}
															{Child.Title}
															{WipIds.has(Child.Id) && (
																<span
																	class="ml-2 inline-block border border-black bg-stamped-canary px-1.5 align-middle font-mono text-[13px] font-black uppercase leading-tight tracking-widest text-soot-black"
																	title="Roadmap: partly unimplemented"
																>
																	WIP
																</span>
															)}
														</a>
													</li>
												))}
											</ul>
										)}
									</li>
								))}
							</ul>
						</details>
					);
				})
			}
		</div>
	</div>
	</div>
</nav>

<script>
	// The in-page outline's current-section marker: the last heading above the
	// reading line wins, so a long page always names where the reader is.
	function BindOnThisPage() {
		const Links = Array.from(
			document.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]"),
		);

		if (Links.length === 0 || Links[0]?.dataset["tocBound"] === "1") {
			return;
		}

		const ById = new Map<string, HTMLAnchorElement[]>();

		for (const Link of Links) {
			const Id = Link.dataset["tocLink"] ?? "";

			ById.set(Id, [...(ById.get(Id) ?? []), Link]);
		}

		const Targets = [...ById.keys()]
			.map((Id) => ({ Id, Element: document.getElementById(Id) }))
			.filter(
				(Target): Target is { Id: string; Element: HTMLElement } =>
					Target.Element !== null,
			);

		if (Targets.length === 0) {
			return;
		}

		const First = Targets[0]!;
		const Last = Targets[Targets.length - 1]!;

		Links[0]!.dataset["tocBound"] = "1";

		let Current = "";

		const Mark = (Id: string) => {
			if (Id === Current) {
				return;
			}

			Current = Id;

			for (const [Key, Group] of ById) {
				for (const Link of Group) {
					switch (Key === Id) {
						case true:
							Link.setAttribute("aria-current", "location");

							break;
						default:
							Link.removeAttribute("aria-current");
					}
				}
			}
		};

		const Measure = () => {
			// 160px: just clear of the sticky site header.
			let Active = First.Id;

			for (const { Id, Element } of Targets) {
				if (Element.getBoundingClientRect().top <= 160) {
					Active = Id;
				}
			}

			// The page's own tail: the last heading is what the reader is in.
			if (
				window.innerHeight + window.scrollY >=
				document.documentElement.scrollHeight - 4
			) {
				Active = Last.Id;
			}

			Mark(Active);
		};

		let Queued = false;

		const OnScroll = () => {
			switch (Queued) {
				case true:
					return;
				default:
					Queued = true;
					requestAnimationFrame(() => {
						Queued = false;
						Measure();
					});
			}
		};

		Measure();
		document.addEventListener("scroll", OnScroll, { passive: true });
		window.addEventListener("resize", OnScroll);
	}

	BindOnThisPage();
	document.addEventListener("astro:page-load", BindOnThisPage);
</script>
