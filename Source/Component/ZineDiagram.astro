---
import ZineDiagramNav from "./ZineDiagramNav.astro";

interface Props {
	/** The raw-imported Mermaid SVG (e.g. `import X from "...svg?raw"`). */
	Svg: string;

	/** The diagram id written to data-diagram; also the figcaption prefix. */
	Name: string;

	/** The figcaption text. */
	Caption: string;

	/** Node key -> internal route; clicking the node navigates there
	 *  (the registry link). Keys are the Mermaid node ids: "H1", "TURN", ... */
	Links?: Record<string, string>;
}

const { Svg, Name, Caption, Links } = Astro.props;

const LinkAttribute = Links ? JSON.stringify(Links) : undefined;
---

<figure
	class="relative w-full overflow-hidden border-4 border-blood-crimson tier-shell shadow-[6px_6px_0px_#7a0a1e]"
	data-diagram={Name}
	data-diagram-links={LinkAttribute}
>
	<!-- THE RIBBON: the diagram's own name, at the section-index voice. It names
	     the figure the way the fence ribbon names a file, so a reader meeting
	     three diagrams in a row can tell which one they are looking at before
	     reading the caption under it. -->
	<div class="flex items-center gap-3 border-b border-[var(--tier-shell-edge)] bg-carbon-void px-4 py-2">
		<span class="section-index">{Name}</span>
		<span class="h-0 grow border-t border-dashed border-oxblood-dark"></span>
	</div>
	<div class="overflow-x-auto p-4 [&_svg]:h-auto" set:html={Svg} />
	<figcaption
		class="border-t border-[var(--tier-shell-edge)] px-4 py-3 font-mono text-base font-black uppercase tracking-widest text-zinc-dust"
	>
		{Caption}
	</figcaption>
</figure>

<ZineDiagramNav />
