---
import ZineDiagramNav from "./ZineDiagramNav.astro";

interface Props {
	/** The raw-imported Mermaid SVG (e.g. `import X from "...svg?raw"`). */
	Svg: string;

	/** The diagram id written to data-diagram; also the figcaption prefix. */
	Name: string;

	/** The figcaption text. */
	Caption: string;

	/** Node key -> internal route; clicking the node navigates there
	 *  (the registry link). Keys are the Mermaid node ids: "H1", "TURN", ... */
	Links?: Record<string, string>;
}

const { Svg, Name, Caption, Links } = Astro.props;

const LinkAttribute = Links ? JSON.stringify(Links) : undefined;
---

<figure
	class="relative w-full border-4 border-blood-crimson bg-carbon-void p-4 shadow-[6px_6px_0px_#7a0a1e]"
	data-diagram={Name}
	data-diagram-links={LinkAttribute}
>
	<div class="overflow-x-auto [&_svg]:h-auto" set:html={Svg} />
	<figcaption class="mt-3 font-mono text-[10px] font-black uppercase tracking-widest text-zinc-dust">
		{Caption}
	</figcaption>
</figure>

<ZineDiagramNav />
