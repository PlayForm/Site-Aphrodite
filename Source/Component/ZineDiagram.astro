---
/**
 * ZineDiagram - one diagram, framed as a console pod: a header ribbon that
 * names it, a RECESSED CHANNEL holding the drawing, a footer ribbon carrying
 * the caption. The arrangement is the Stitch console grammar applied to a
 * figure - ribbon, channel, ribbon - and the surface is ours: the crimson
 * module boundary, the hard offset plane and the carbon-void ribbons are
 * untouched, and the channel is the published `.well` tier, whose edge is
 * LIGHTER than the plate's own so it reads as depth rather than as one more
 * panel.
 *
 * ZineDiagramNav is attached below: it builds the figure's numbered stage row
 * (one entry per node, in the SVG's own order) and owns the hover highlight,
 * so a diagram is navigable by name and not only by pointing at a box.
 */
import ZineDiagramNav from "./ZineDiagramNav.astro";

interface Props {
	/** The raw-imported Mermaid SVG (e.g. `import X from "...svg?raw"`). */
	Svg: string;

	/** The diagram id written to data-diagram; also the figcaption prefix. */
	Name: string;

	/** The figcaption text. */
	Caption: string;

	/** Node key -> internal route; clicking the node navigates there
	 *  (the registry link). Keys are the Mermaid node ids: "H1", "TURN", ... */
	Links?: Record<string, string>;
}

const { Svg, Name, Caption, Links } = Astro.props;

const LinkAttribute = Links ? JSON.stringify(Links) : undefined;
---

<figure
	class="relative w-full overflow-hidden border-4 border-blood-crimson tier-shell shadow-[6px_6px_0px_#7a0a1e]"
	data-diagram={Name}
	data-diagram-links={LinkAttribute}
>
	<!-- THE RIBBON: the diagram's own name, at the section-index voice. It names
	     the figure the way the fence ribbon names a file, so a reader meeting
	     three diagrams in a row can tell which one they are looking at before
	     reading the caption under it. -->
	<div class="flex items-center gap-3 border-b border-[var(--tier-shell-edge)] bg-carbon-void px-4 py-2">
		<span class="section-index">{Name}</span>
		<span class="h-0 grow border-t border-dashed border-oxblood-dark"></span>
	</div>
	<!-- THE CHANNEL: the drawing sits in the recessed tier, inset from the plate
	     on all four sides, so the ribbons above and below read as the pod's
	     edges and the diagram reads as the thing the pod holds. -->
	<div class="well m-4 overflow-x-auto p-3 [&_svg]:h-auto" set:html={Svg} />
	<!-- THE FOOTER RIBBON: the same band as the header, in the same fill, so the
	     frame closes the way it opened. -->
	<figcaption class="border-t border-[var(--tier-shell-edge)] bg-carbon-void px-4 py-2 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
		{Caption}
	</figcaption>
</figure>

<ZineDiagramNav />
