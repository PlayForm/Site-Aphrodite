---
interface Props {
	/** The caption left of the slider, e.g. "ENGINE THRESHOLD". */
	Label: string;

	/** The live readout suffix, e.g. "%" or " tokens". */
	Unit?: string;

	/** Range bounds + start. */
	Min?: number;
	Max?: number;
	Step?: number;
	Value?: number;
}

const { Label, Unit = "", Min = 0, Max = 100, Step = 1, Value = 50 } = Astro.props;
---

<label class="zine-box-subtle flex flex-col gap-1.5 border-[3px] border-oxblood-dark bg-carbon-void p-4" data-slider>
	<span class="flex items-baseline justify-between font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
		{Label}
		<span class="text-base text-stamped-canary" data-slider-value data-slider-unit={Unit}>{String(Value)}{Unit}</span>
	</span>
	<input
		class="h-2 w-full appearance-none bg-soot-black accent-raw-blood [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-2 [&::-moz-range-thumb]:border [&::-moz-range-thumb]:border-black [&::-moz-range-thumb]:bg-raw-blood [&::-webkit-slider-thumb]:h-5 [&::-webkit-slider-thumb]:w-3 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:border [&::-webkit-slider-thumb]:border-black [&::-webkit-slider-thumb]:bg-raw-blood [&::-webkit-slider-thumb]:shadow-[2px_2px_0px_#000]"
		type="range"
		min={Min}
		max={Max}
		step={Step}
		value={Value}
		data-slider-input
		aria-label={Label}
	/>
</label>

<script>
	function BindSliders() {
		for (const Root of document.querySelectorAll("[data-slider]")) {
			if (Root.dataset.sliderBound) {
				continue;
			}

			Root.dataset.sliderBound = "1";

			const Input = Root.querySelector<HTMLInputElement>("[data-slider-input]");
			const ValueNode = Root.querySelector<HTMLElement>("[data-slider-value]");

			Input?.addEventListener("input", () => {
				const Unit = ValueNode?.dataset["sliderUnit"] ?? "";
				if (ValueNode) ValueNode.textContent = `${Input.value}${Unit}`;
				Input.dispatchEvent(new CustomEvent("zine:slider", { bubbles: true }));
			});
		}
	}

	BindSliders();
	document.addEventListener("astro:page-load", BindSliders);
</script>
