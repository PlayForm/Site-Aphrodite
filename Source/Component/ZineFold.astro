---
/**
 * ZineFold - the expandable pane pair: a closed pane showing the headline
 * and a "OPEN +" tab; expanding reveals the body (and swaps the tab to
 * "CLOSE −"). Details/summary semantics, styled in the grammar (radius 0,
 * hard shadow, no smooth height animation).
 */
interface Props {
	/** The closed-state headline. */
	Label: string;

	/** Optional side tag, e.g. "DETAIL" or a step number. */
	Tag?: string;

	/** The body content (rich). */
	Body: string;
}

const { Label, Tag, Body } = Astro.props;
---

<details class="group border border-oxblood-dark bg-carbon-void shadow-[3px_3px_0px_#000]" data-zine-fold>
	<summary class="flex cursor-pointer list-none items-center gap-3 border-b border-transparent bg-soot-black px-3 py-2 font-mono text-xs font-bold text-bone-newsprint transition-colors group-open:border-oxblood-dark hover:text-bone-white">
		{Tag && <span class="border border-oxblood-dark bg-raw-blood px-1.5 py-0.5 text-[9px] font-black uppercase tracking-widest text-bone-white">{Tag}</span>}
		<span class="grow">{Label}</span>
		<span class="text-stamped-canary group-open:hidden" aria-hidden="true">OPEN +</span>
		<span class="hidden text-zinc-dust group-open:inline" aria-hidden="true">CLOSE −</span>
	</summary>
	<div class="p-3 font-body text-sm leading-relaxed text-bone-newsprint" set:html={Body} />
</details>
