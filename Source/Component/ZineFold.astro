---
/**
 * ZineFold - the quiet disclosure.
 *
 * EMPHASIS TIER: quiet. ONE top rule, no shadow, no inner card, no fill - a
 * fold is a list item the reader opens, not a plate competing with the argument
 * above it. Consecutive folds therefore read as one list: rule, title, body,
 * rule, title, body.
 *
 * Native `<details>` keeps the keyboard, the screen-reader semantics and the
 * no-JavaScript behaviour; only the presentation is ours. The state is a GLYPH
 * rather than a word, because "OPEN +" beside a title is a second label for a
 * control that already has one - the reader does not need to be told twice what
 * a disclosure does.
 *
 * `Tag` is quiet mono metadata, never a second bordered badge: a badge beside a
 * fold title reads as a competing label, which is the old problem (everything
 * shouts, so nothing does) in miniature.
 */
interface Props {
	/** The closed-state headline. */
	Label: string;

	/** Optional side tag, e.g. "DETAIL" or a step number. Quiet mono, no badge. */
	Tag?: string;

	/** The body content (rich). */
	Body: string;
}

const { Label, Tag, Body } = Astro.props;
---

<details class="group border-t border-oxblood-dark" data-zine-fold>
	<summary
		class="flex cursor-pointer list-none items-baseline gap-3 py-3 text-bone-newsprint transition-colors hover:text-bone-white"
	>
		{Tag && <span class="type-meta shrink-0 uppercase text-zinc-dust">{Tag}</span>}
		<span class="grow font-body text-base font-bold leading-snug">{Label}</span>
		<span class="shrink-0 font-mono text-base text-zinc-dust group-open:hidden" aria-hidden="true">+</span>
		<span class="hidden shrink-0 font-mono text-base text-zinc-dust group-open:inline" aria-hidden="true">−</span>
	</summary>
	<div class="pb-4 font-body text-base leading-relaxed text-bone-newsprint" set:html={Body} />
</details>
