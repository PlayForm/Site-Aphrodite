---
/**
 * ZineFold - the quiet disclosure, wearing the telemetry tag.
 *
 * EMPHASIS TIER: quiet. ONE top rule, no shadow, no inner card, no fill - a
 * fold is a list item the reader opens, not a plate competing with the argument
 * above it. Consecutive folds therefore read as one list: rule, title, body,
 * rule, title, body.
 *
 * Native `<details>` keeps the keyboard, the screen-reader semantics and the
 * no-JavaScript behaviour; only the presentation is ours. The state is a GLYPH
 * rather than a word, because "OPEN +" beside a title is a second label for a
 * control that already has one - the reader does not need to be told twice what
 * a disclosure does.
 *
 * `Tag` speaks the telemetry voice: the published `.telemetry-tag` chip
 * (Global.css) - 11.5px mono, 700, 0.08em tracking, uppercase, on the
 * sub-panel fill with the oxblood hairline. It stays the QUIET variant by
 * default, and that is the point: an unaccented chip beside a fold title reads
 * as metadata, while a solid accent chip reads as a competing label - which is
 * the old problem (everything shouts, so nothing does) in miniature. A tag that
 * genuinely marks an IDENTITY passes `TagTone`, and the chip's own modifier
 * carries the ink so contrast holds.
 *
 * The tag never breaks mid-token: the chip declares its own wrap rules, so a
 * tag like "8 STEPS" or "REPRO_PROOF #001" wraps at its spaces or not at all.
 */
interface Props {
	/** The closed-state headline. */
	Label: string;

	/** Optional side tag, e.g. "DETAIL" or a step number: the telemetry voice. */
	Tag?: string;

	/** The tag's accent, when the tag marks an identity rather than a note. */
	TagTone?: "crimson" | "canary" | "teal" | "bone";

	/** The body content (rich). */
	Body: string;
}

const { Label, Tag, TagTone, Body } = Astro.props;

/** The chip modifiers, in the order the grammar publishes them. */
const TagAccent = {
	crimson: "telemetry-tag--crimson",
	canary: "telemetry-tag--canary",
	teal: "telemetry-tag--teal",
	bone: "telemetry-tag--bone",
};
---

<details class="fold" data-zine-fold>
	<summary class="fold__summary">
		{Tag && (
			<span class:list={["telemetry-tag fold__tag", TagTone && TagAccent[TagTone]]}>
				{Tag}
			</span>
		)}
		<span class="fold__label">{Label}</span>
		<span
			class="fold__marker fold__marker--closed"
			aria-hidden="true"
		>
			+
		</span>
		<span
			class="fold__marker fold__marker--open"
			aria-hidden="true"
		>
			−
		</span>
	</summary>
	<div class="fold__body" set:html={Body} />
</details>
