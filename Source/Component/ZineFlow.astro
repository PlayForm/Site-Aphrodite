---
/**
 * ZineFlow - the interactive traversal stepper, UI-native (no static mermaid).
 * Each stage carries two synchronized views: AGENT-VIEW (what the agent sees)
 * and SYSTEM-PATH (what Aphrodite does), a per-stage detail line, and a SRC
 * anchor chip naming the file the stage is described in.
 *
 * TWO PODS PER STAGE (the dual-pod grammar). Each view is a POD - a labelled
 * ribbon over an inset well - so the pair reads as two consoles at the same
 * depth, and the difference between them is what they show, never how far they
 * sit from the page. The console's own header ribbon is the progress row: the
 * stage ticks on the left, the stage's short name and its position on the
 * right. The ribbon carries the NAME and the VERDICT here; nothing in this
 * component counts bytes.
 *
 * SYNTAX ROLES, the four names ZineStream owns, applied to the pane lines:
 *
 *   command  a line that starts `$ `             amber
 *   tree     a tree glyph or `Compiling `         sand
 *   tag      a CCR marker, or a line starting `» `  cyan
 *   warning  `warning:` / `error[`                crimson, carried by a rule
 *                                                 and a tint rather than by
 *                                                 crimson type
 *
 * VOLUME is the separate axis and only it may be reduced: a `· ` line fades
 * (40) and a `→ ` line dims (70), and neither loses its role. A dimmed warning
 * is still a warning.
 *
 * READABLE WITHOUT JAVASCRIPT, WHICH IS THE DEFAULT IT IS BUILT FROM.
 * Every stage is server-rendered with both panes, its own stage number, its
 * SRC chip and its detail line, in document order - so a reader with no
 * script, a reader printing the page, and browser-find all see the whole
 * walkthrough. The script collapses that into the one-stage-at-a-time
 * presentation and sets `data-flow-ready`, which is the ONLY signal the
 * stylesheet uses to switch layouts (Motion.css, "Readable without
 * JavaScript"). Initialisation therefore adds a presentation; it never adds
 * content.
 *
 * Manual stepping is primary: Previous / Next / Read all steps. Autoplay is
 * opt-in behind Replay, and it stops on any manual interaction, when the
 * module leaves the viewport, when the document is hidden, and before a route
 * swap. The endpoint is honest - Next is disabled on the last stage rather
 * than wrapping to the first under a button that still says NEXT; Replay is
 * the separate action that starts over.
 *
 * Every listener belongs to an AbortController owned by this module and is
 * aborted on astro:before-swap, so no timer and no listener outlives the page.
 */
interface Props {
	/** The traversal title, rendered on the header tape. */
	Title: string;

	/** The completion-stamp label shown after the last stage. */
	Complete?: string;

	/** The stages, in order. Each pane value is either one paragraph or a
	 *  list of mono lines - the conversation-view excerpt (Agent) or the
	 *  file-system/backend journey (System). A line containing a CCR
	 *  marker renders as the marker chip; a "· " line fades, a "→ "
	 *  line dims, a "» " line highlights teal. */
	Steps: {
		Title: string;
		/** AGENT-VIEW pane text: what the agent sees at this stage. */
		Agent: string | string[];
		/** SYSTEM-PATH pane text: what Aphrodite does at this stage. */
		System: string | string[];
		/** Optional per-stage detail line. */
		Detail?: string;
		/** Optional SRC anchor route or URL for this stage. */
		Anchor?: string;
		/** Label for the anchor chip (defaults to "SRC"). */
		AnchorLabel?: string;
	}[];
}

const { Title, Complete = "FLOW COMPLETE", Steps } = Astro.props;

const Total = Steps.length;

/** Two digits, so the count and the stage labels never shift width. */
const Pad = (Value: number) => String(Value).padStart(2, "0");

/** One pane value -> the mono lines it renders as. */
const PaneLines = (Text: string | string[]) => (Array.isArray(Text) ? Text : [Text]);

/** The VOLUME a line's prefix carries - the suppression law, and nothing else. */
type Volume = "plain" | "fade" | "dim";

/** The syntax role of a line - IDENTITY, not emphasis. The four names are
 *  ZineStream's; the derivation is ZineSplit's `RoleOf`, so one line of output
 *  is classified the same way wherever the site prints it. */
type Role = "command" | "tree" | "tag" | "warning";

const VolumeOf = (Line: string): Volume =>
	Line.startsWith("· ") ? "fade" : Line.startsWith("→ ") ? "dim" : "plain";

const VolumeClass: Record<Volume, string> = {
	plain: "",
	fade: "opacity-40",
	dim: "opacity-70",
};

const RoleInk: Record<Role, string> = {
	command: "text-stamped-canary font-bold",
	tree: "text-bone-newsprint",
	tag: "text-weathered-teal",
	warning: "text-bone-white",
};

/**
 * The role's row. Only the warning needs one: its identity is crimson, and
 * crimson is not legible as type on this fill, so the ROW carries the colour
 * and the ink stays bone.
 *
 * The tint is a `color-mix` against the well rather than `bg-raw-blood/15`:
 * `--raw-blood` is a `var()` holding a hex, so Tailwind cannot apply an opacity
 * modifier to it and silently emits no rule at all. The 2px rule is the part
 * that always paints, which is why the identity does not depend on the tint.
 */
const RoleRow: Record<Role, string> = {
	command: "",
	tree: "",
	tag: "",
	warning:
		"border-l-2 border-raw-blood bg-[color-mix(in_srgb,var(--raw-blood)_18%,var(--soot-black))] pl-2",
};

/**
 * A role is only ever taken by a line that proves it. `» ` is checked before
 * the warning test on purpose: a highlighted line that happens to quote an
 * error is still the highlighted line, and the prefix the caller wrote is the
 * contract, not the words inside it.
 */
const RoleOf = (Line: string): Role | undefined => {
	const Trimmed = Line.trimStart();

	if (Trimmed.includes("<<<CCR:") || Trimmed.startsWith("» ")) {
		return "tag";
	}

	if (Trimmed.startsWith("$ ")) {
		return "command";
	}

	if (
		/^(warning|error)[:[]/i.test(Trimmed) ||
		Trimmed.includes(": error[") ||
		Trimmed.includes(": warning:")
	) {
		return "warning";
	}

	if (/^[├└│─]/.test(Trimmed) || Trimmed.startsWith("Compiling ")) {
		return "tree";
	}

	return undefined;
};

/** A CCR marker wraps mid-token (`.ccr-marker`); visual only - the string the
 *  reader copies stays byte-exact. It also keeps its weight, because an address
 *  that can break anywhere should not also read as prose. */
const IsMarker = (Line: string) => Line.includes("<<<CCR:");

/** The role's row, or nothing when the line proves no role. */
const LineRow = (Line: string): string => {
	const LineRole = RoleOf(Line);

	return LineRole === undefined ? "" : RoleRow[LineRole];
};

/** The line's ink: volume first, then the role's colour, then the marker's
 *  wrap. A line with no role keeps the pane's own bone ink. */
const LineInk = (Line: string): string[] => {
	const LineRole = RoleOf(Line);

	return [
		VolumeClass[VolumeOf(Line)],
		LineRole === undefined ? "" : RoleInk[LineRole],
		IsMarker(Line) ? "ccr-marker" : "",
	];
};

/** The two panes, named once: the same pair renders inside every stage. */
const Panes = ["agent", "system"] as const;

/** The view name: the left slot of the pane ribbon. */
const PaneName = (Pane: (typeof Panes)[number]) =>
	Pane === "agent" ? "AGENT-VIEW" : "SYSTEM-PATH";

/** What the view carries: the ribbon's tag. Agent is the transcript the model
 *  reads (canary); System is the work that produced it (teal) - the same two
 *  tones Motion.css assigns the pane label. */
const PanePayload = (Pane: (typeof Panes)[number]) =>
	Pane === "agent" ? "CONVERSATION" : "BACKEND";

const PaneTag = (Pane: (typeof Panes)[number]) =>
	Pane === "agent" ? "telemetry-tag--canary" : "telemetry-tag--teal";

const PaneText = (Step: Props["Steps"][number], Pane: (typeof Panes)[number]) =>
	PaneLines(Pane === "agent" ? Step.Agent : Step.System);
---

<div
	class="grunge zine-box-crimson relative border-4 border-blood-crimson bg-carbon-void p-5 sm:p-8"
	data-grunge
	data-zine-flow
>
	<div class="absolute -top-3.5 left-6 -rotate-1 border border-black bg-raw-blood px-3 py-0.5 text-base font-black uppercase tracking-widest text-bone-white shadow-[2px_2px_0px_#000]">
		{Title}
	</div>

	<!-- THE HEADER RIBBON: the stage ticks, the stage's short name and its
	     position - the console's own progress line. One 44px hit area per stage
	     with a restrained bar inside it. Hidden until the script has bound: the
	     bars are a control, and a control that cannot work is a promise the page
	     cannot keep. Plain buttons (not a tablist): the panes are not tabpanels,
	     so a tabs ARIA pattern would be broken here - the labels carry the
	     semantics, and aria-current="step" marks the stage being read. -->
	<div
		class="mt-4 flex flex-wrap items-center gap-x-1 gap-y-2 border border-oxblood-dark bg-asphalt-panel px-2 py-1"
		data-flow-ticks
		role="group"
		aria-label={`Traversal stages, ${Total} in order`}
	>
		{Steps.map((Step, I) => (
			<button
				class="zine-flow-tick flex h-11 items-center px-0.5"
				data-flow-tick={I}
				type="button"
				aria-label={`Go to stage ${I + 1} of ${Total}: ${Step.Title}`}
			>
				<span
					class="zine-flow-tick-bar block h-2.5 w-8 border border-black bg-soot-black"
					aria-hidden="true"
				/>
			</button>
		))}
		<span class="ml-auto flex flex-wrap items-baseline gap-x-2 font-mono text-base font-bold">
			<span class="text-zinc-dust" data-flow-stage>
				{Steps[0]?.Title ?? ""}
			</span>
			<span class="telemetry-tag ml-auto shrink-0" data-flow-count>
				{Pad(1)} / {Pad(Total)}
			</span>
		</span>
	</div>

	<!-- The one live region on this module, and it says one sentence: which
	     stage is on screen. Announcing the whole root made every repaint a
	     screen-reader event; announcing the stage makes the change the
	     message. -->
	<p class="sr-only" data-flow-status role="status" aria-live="polite" aria-atomic="true">
		Step 1 of {Total}: {Steps[0]?.Title ?? ""}.
	</p>

	<!-- Every stage, in order, with both panes. This is what a reader without
	     JavaScript sees, what print sees, and what browser-find reaches. Each
	     pane is a POD - a labelled ribbon over an inset well - so the pair reads
	     as two consoles at the same depth, and the difference between them is
	     what they show, never how far they sit from the page. -->
	<div class="mt-4 flex flex-col gap-4">
		{Steps.map((Step, I) => (
			<div class="zine-flow-step" data-flow-step={I}>
				<div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
					<span class="zine-flow-step-index font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
						STEP {Pad(I + 1)} / {Pad(Total)}
					</span>
					<span
						class="font-mono text-base font-black uppercase tracking-widest text-bone-white"
						data-flow-title
					>
						{Step.Title}
					</span>
					{Step.Anchor && (
						<a
							class="border border-oxblood-dark bg-soot-black px-2 py-0.5 font-mono text-base font-bold text-weathered-teal hover:bg-weathered-teal hover:text-bone-white"
							href={Step.Anchor}
							rel={Step.Anchor.startsWith("http") ? "noreferrer" : undefined}
						>
							{Step.AnchorLabel ?? "SRC"} ↗
						</a>
					)}
				</div>

				<div class="grid min-h-[5.5rem] gap-4 lg:grid-cols-2">
					{Panes.map((Pane) => (
						<div
							class="zine-flow-pane flex flex-col border-2 border-oxblood-dark bg-asphalt-panel"
							data-flow-pane={Pane}
						>
							<div class="zine-flow-pane-label flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-oxblood-dark bg-asphalt-panel px-3 py-1.5 font-mono text-base font-black uppercase tracking-widest">
								<span class="min-w-0 break-words">{PaneName(Pane)}</span>
								<span class:list={["telemetry-tag ml-auto shrink-0", PaneTag(Pane)]}>
									{PanePayload(Pane)}
								</span>
							</div>
							<div class="flex grow p-2">
								<div class="grow border border-oxblood-dark bg-soot-black p-2 font-mono text-base font-bold leading-relaxed text-bone-white">
									{PaneText(Step, Pane).map((Line) => (
										<div class={LineRow(Line)}>
											<span class:list={LineInk(Line)}>{Line}</span>
										</div>
									))}
								</div>
							</div>
						</div>
					))}
				</div>

				{Step.Detail && (
					<p class="zine-flow-detail mt-1.5 font-body text-base leading-relaxed text-bone-newsprint opacity-70 transition-opacity hover:opacity-100">
						{Step.Detail}
					</p>
				)}
			</div>
		))}
	</div>

	<!-- Controls: manual first, autoplay behind Replay, and the stamp that
	     only appears on the last stage. -->
	<div class="mt-5 flex flex-wrap items-center gap-3" data-flow-controls>
		<button
			class="border border-black bg-raw-blood px-3 py-1.5 font-mono text-base font-black uppercase text-bone-white shadow-[2px_2px_0px_#000] transition-colors hover:bg-blood-crimson disabled:opacity-40"
			data-flow-prev
			type="button"
			disabled
		>
			◀ PREV
		</button>
		<button
			class="border border-black bg-raw-blood px-3 py-1.5 font-mono text-base font-black uppercase text-bone-white shadow-[2px_2px_0px_#000] transition-colors hover:bg-blood-crimson disabled:opacity-40"
			data-flow-next
			type="button"
		>
			NEXT ▶
		</button>
		<button
			class="border border-black bg-raw-blood px-3 py-1.5 font-mono text-base font-black uppercase text-bone-white shadow-[2px_2px_0px_#000] transition-colors hover:bg-blood-crimson"
			data-flow-play
			type="button"
			aria-pressed="false"
		>
			▶ REPLAY
		</button>
		<button
			class="border border-black bg-raw-blood px-3 py-1.5 font-mono text-base font-black uppercase text-bone-white shadow-[2px_2px_0px_#000] transition-colors hover:bg-blood-crimson"
			data-flow-all
			type="button"
			aria-pressed="false"
		>
			READ ALL STEPS
		</button>
		<span
			class="hidden -rotate-2 border-2 border-black bg-stamped-canary px-3 py-1 font-mono text-base font-black uppercase tracking-widest text-soot-black shadow-[3px_3px_0px_#000]"
			data-flow-stamp
		>
			{Complete}
		</span>
	</div>
</div>

<script>
	/** The autoplay beat. Manual stepping never waits on it. */
	const Cadence = 2600;

	/** Two digits, so the count never shifts width as it climbs. */
	const Pad = (Value: number): string => String(Value).padStart(2, "0");

	/**
	 * One controller per bound module. A second bind of the same module is
	 * refused while its controller is live, so astro:page-load firing twice
	 * cannot double-bind; astro:before-swap aborts every controller, which is
	 * what takes the listeners, the observer and the interval with it.
	 */
	const Bound = new WeakMap<HTMLElement, AbortController>();

	function BindFlow(Root: HTMLElement): void {
		const Live = Bound.get(Root);

		if (Live !== undefined && !Live.signal.aborted) {
			return;
		}

		const Controller = new AbortController();
		const { signal } = Controller;

		Bound.set(Root, Controller);

		const Blocks = [...Root.querySelectorAll<HTMLElement>("[data-flow-step]")];
		const Total = Blocks.length;

		// A module with no stages has nothing to present: the markup is
		// already the whole story, and binding it would only hide it.
		if (Total === 0) {
			return;
		}

		const Ticks = [...Root.querySelectorAll<HTMLElement>("[data-flow-tick]")];
		const Stage = Root.querySelector<HTMLElement>("[data-flow-stage]");
		const Count = Root.querySelector<HTMLElement>("[data-flow-count]");
		const Status = Root.querySelector<HTMLElement>("[data-flow-status]");
		const Prev = Root.querySelector<HTMLButtonElement>("[data-flow-prev]");
		const Next = Root.querySelector<HTMLButtonElement>("[data-flow-next]");
		const Play = Root.querySelector<HTMLButtonElement>("[data-flow-play]");
		const All = Root.querySelector<HTMLButtonElement>("[data-flow-all]");
		const Stamp = Root.querySelector<HTMLElement>("[data-flow-stamp]");

		// The stage titles come from the DOM the page already renders, so the
		// script can never announce a name the markup does not carry.
		const Titles = Blocks.map(
			(Block) =>
				Block.querySelector<HTMLElement>("[data-flow-title]")?.textContent?.trim() ?? "",
		);

		let Index = 0;
		let Timer = 0;
		let Reading = false;

		const Stop = (): void => {
			if (Timer !== 0) {
				window.clearInterval(Timer);
				Timer = 0;
			}

			if (Play) {
				Play.textContent = "▶ REPLAY";
				Play.setAttribute("aria-pressed", "false");
			}
		};

		const Render = (): void => {
			Blocks.forEach((Block, At) => {
				Block.hidden = !Reading && At !== Index;
			});

			Ticks.forEach((Tick, At) => {
				if (!Reading && At === Index) {
					Tick.setAttribute("aria-current", "step");
				} else {
					Tick.removeAttribute("aria-current");
				}

				if (At <= Index) {
					Tick.setAttribute("data-flow-done", "1");
				} else {
					Tick.removeAttribute("data-flow-done");
				}
			});

			if (Stage) {
				Stage.textContent = Titles[Index] ?? "";
			}

			if (Count) {
				Count.textContent = `${Pad(Index + 1)} / ${Pad(Total)}`;
			}

			if (Status) {
				Status.textContent = `Step ${Index + 1} of ${Total}: ${Titles[Index] ?? ""}.`;
			}

			if (Prev) {
				Prev.disabled = Reading || Index === 0;
			}

			if (Next) {
				Next.disabled = Reading || Index === Total - 1;
			}

			if (Play) {
				Play.disabled = Reading;
			}

			if (All) {
				All.setAttribute("aria-pressed", String(Reading));
				All.textContent = Reading ? "STEP THROUGH" : "READ ALL STEPS";
			}

			if (Stamp) {
				Stamp.classList.toggle("hidden", Reading || Index < Total - 1);
			}

			Root.toggleAttribute("data-flow-all", Reading);

			// Last, because this is the signal the stylesheet reads to switch
			// from the readable list to the presentation: it must be set with
			// the first frame already rendered, never before it.
			Root.dataset.flowReady = "1";
		};

		const GoTo = (At: number): void => {
			Index = Math.max(0, Math.min(Total - 1, At));
			Render();
		};

		/** The endpoint is a wall, not a wrap: NEXT on the last stage does nothing. */
		const Step = (Delta: number): void => {
			if (Index === Total - 1 && Delta > 0) {
				Stop();

				return;
			}

			GoTo(Index + Delta);
		};

		const Replay = (): void => {
			Stop();
			GoTo(0);

			if (Play) {
				Play.textContent = "❚❚ PAUSE";
				Play.setAttribute("aria-pressed", "true");
			}

			Timer = window.setInterval(() => {
				if (Index >= Total - 1) {
					Stop();

					return;
				}

				GoTo(Index + 1);
			}, Cadence);
		};

		// Every manual action stops autoplay first: the reader has taken the
		// wheel, and a timer that keeps advancing under their hands is the
		// defect this module used to have.
		Prev?.addEventListener(
			"click",
			() => {
				Stop();
				Step(-1);
			},
			{ signal },
		);

		Next?.addEventListener(
			"click",
			() => {
				Stop();
				Step(1);
			},
			{ signal },
		);

		Play?.addEventListener(
			"click",
			() => {
				if (Timer !== 0) {
					Stop();

					return;
				}

				Replay();
			},
			{ signal },
		);

		All?.addEventListener(
			"click",
			() => {
				Stop();
				Reading = !Reading;
				Render();
			},
			{ signal },
		);

		Ticks.forEach((Tick, At) => {
			Tick.addEventListener(
				"click",
				() => {
					Stop();
					Reading = false;
					GoTo(At);
				},
				{ signal },
			);
		});

		Root.addEventListener(
			"keydown",
			(Event) => {
				if (Event.key !== "ArrowRight" && Event.key !== "ArrowLeft") {
					return;
				}

				Stop();
				Reading = false;
				Step(Event.key === "ArrowRight" ? 1 : -1);
				Event.preventDefault();
			},
			{ signal },
		);

		// A walkthrough that plays to an empty room is a timer nobody watches:
		// leaving the viewport and hiding the document both stop it. Neither
		// changes the stage the reader left on screen.
		if ("IntersectionObserver" in window) {
			const Observer = new IntersectionObserver(
				(Entries) => {
					for (const Entry of Entries) {
						if (!Entry.isIntersecting) {
							Stop();
						}
					}
				},
				{ threshold: 0 },
			);

			Observer.observe(Root);
			signal.addEventListener("abort", () => Observer.disconnect(), { once: true });
		}

		document.addEventListener(
			"visibilitychange",
			() => {
				if (document.hidden) {
					Stop();
				}
			},
			{ signal },
		);

		// The swap's half of the contract: aborting the controller removes
		// every listener above, but an interval is not a listener - it has to
		// be cleared by name, or it keeps ticking against a detached module.
		signal.addEventListener("abort", Stop, { once: true });

		Render();
	}

	const BindAll = (): void => {
		for (const Root of document.querySelectorAll<HTMLElement>("[data-zine-flow]")) {
			BindFlow(Root);
		}
	};

	/** Before a swap: every timer, listener and observer this module owns goes. */
	const StopAll = (): void => {
		for (const Root of document.querySelectorAll<HTMLElement>("[data-zine-flow]")) {
			Bound.get(Root)?.abort();
			Bound.delete(Root);
		}
	};

	BindAll();
	document.addEventListener("astro:page-load", BindAll);
	document.addEventListener("astro:before-swap", StopAll);
</script>
