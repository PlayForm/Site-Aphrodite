---
import "@Stylesheet/Component/Data.scss";

/**
 * ZineStatBar - A GIANT FIGURE, ITS UNIT IN THE LABEL VOICE, AND THE TRACK
 * THAT MEASURES IT.
 *
 * The readout is read in one order, and only that order:
 *
 *   the LABEL     a mono micro-label directly over the figure, tight (the gap
 *                 is --space-tight), so the number answers the label instead of
 *                 floating somewhere beside it.
 *   the FIGURE    `.metric` (Global.css): JetBrains Mono, tabular digits,
 *                 clamp(2.5rem, 6vw, 4.5rem). The numeral is the largest thing
 *                 in the block at every width; `Scale="compact"` is the same
 *                 figure in a dense stack.
 *   the UNIT      `.metric__unit`, a CHILD of `.metric`: the unit keeps the
 *                 telemetry voice (11.5px mono, uppercase, zinc-dust) while the
 *                 numeral stays oversized, and being a child it can never wrap
 *                 away from the figure it belongs to.
 *   the TRACK     under both, full width, because a bar whose length encodes a
 *                 percentage must not be sized by the figure above it.
 *
 * TWO VARIANTS, ONE READOUT. `Variant="bar"` (the default) is the order above.
 * `Variant="pod"` is the Hero Metrics Pod: the same label, figure and unit
 * inside the accent's own PLATE, the qualifier under it, and NO track - a pod
 * carries a figure that is not a share of anything ("610x", "~10MS"), so a bar
 * beneath it would encode nothing. The plate resolves the accent's fill and its
 * ink TOGETHER (the `Pod` table below), because a fill without a legible ink is
 * a colour block rather than an identity.
 *
 * `Ratio` arrives as ONE string ("416x", "0%", "13 / 13"), so the unit is split
 * off HERE rather than demanded from every call site. The split is deliberately
 * conservative: only a trailing non-numeric token of at most three characters
 * counts as a unit, and the figure in front of it must stay short. A comparison
 * ("13 / 13") or a range therefore stays whole instead of being cut through the
 * middle of a fact. `Unit` overrides the split for a caller that knows better,
 * and `Qualifier` keeps the word that makes a number honest visible under it.
 */
interface Props {
	Label: string;

	/** The ratio text on the right, e.g. "416×". */
	Ratio: string;

	/** Width of the primary fill, 0-100. BAR ONLY: a pod has no track, because
	 *  the figures it carries are not shares of anything. */
	Percent?: number;

	/** Fill color: teal (default), raw, canary. In the pod variant the same
	 *  accent names the PLATE, so the fill and the ink stay one decision. */
	Color?: "teal" | "raw" | "canary";

	/** "scroll" = the MONUMENT treatment: width 0 until the bar enters the
	 *  viewport, then snaps to Percent in hard steps (`.statbar__fill`).
	 *  Default "static" renders the width immediately (the existing form). */
	Fill?: "static" | "scroll";

	/**
	 * The ratio's scale. `metric` is the giant mono figure a section is built
	 * around; `compact` is the same figure in a dense stack, where several
	 * readouts share one column and two 4.5rem numbers would halve each other.
	 * The page that owns the stack is the only thing that knows which it is.
	 */
	Scale?: "metric" | "compact";

	/** The unit printed after the figure in the telemetry voice ("×", "%", "ms").
	 *  Omit it and the trailing token of `Ratio` is used. */
	Unit?: string;

	/** A qualifier line under the figure - the word that keeps a number honest
	 *  ("ESTIMATED", "PER OUTPUT", "MEASURED"). It renders in the label voice,
	 *  which is legible where the giant figure would swallow a sentence. */
	Qualifier?: string;

	/**
	 * "bar" (default) is the readout with its percentage track. "pod" is the
	 * same readout as a filled card with no track: a label, a figure with its
	 * unit, and the qualifier that keeps the number honest.
	 */
	Variant?: "bar" | "pod";

	/**
	 * Emit `data-count` on the figure so the motion runtime climbs it
	 * (Motion.ts reads `[data-count]`). Only for a figure that is a whole
	 * number: the runtime leaves a value it cannot parse ("~10") alone, so
	 * asking for a climb there would be a promise the page does not keep.
	 */
	Count?: boolean;
}

const {
	Label,
	Ratio,
	Percent,
	Color = "teal",
	Fill = "static",
	Scale = "metric",
	Unit,
	Qualifier,
	Variant = "bar",
	Count = false,
} = Astro.props;

// The TONE is one class on the block, and the sheet states BOTH inks a tone
// needs - the fill and the figure - because the two are not always the same
// ink. `--raw-blood` is a FILL token (Global.css: "stamps, primary buttons,
// badges"); as text on soot-black it measures 2.23:1 and fails the 4.5:1 floor,
// so a "raw" bar printed its figure in a red no reader could read. The bar
// itself keeps the raw fill, which is where the variant's identity lives, and
// the value takes the heading voice. Keeping the pair in the sheet is what stops
// a caller pairing a raw fill with a raw figure.
//
// The palette used to be resolved HERE as two maps and rendered as a class on
// the fill element, and before that inside the <script> - which is a separate
// module: a plain <script> never receives a component's frontmatter variables,
// so `Color` was undefined there, `classList.add(undefined)` threw a
// ReferenceError on the first observed bar, and the colour was never applied -
// while the width, set one line earlier, still was. The symptom was a bar of
// the right length in the wrong (default) colour with nothing in the console
// that pointed at this file. The tone is server-rendered here and the script
// only ever sets the width.
const Tone = `statbar--${Color}`;

/** The figure's scale: the giant metric, or the compact one for a dense stack. */
const MetricScale = Scale === "compact" ? "metric metric--compact" : "metric";

// THE POD PLATE. In the pod variant the accent is a surface, so the fill and the
// ink are one decision taken here rather than at the call site: each accent's
// own plate, with an ink that measures on it.
//
//   raw      raw blood, bone-white ink - the stamp surface
//   teal     carbon void, weathered-teal ink - teal is LIFTED to pass 4.5:1 on
//            the dark fills, and it does not pass on the paper ones
//   canary   stamped canary, soot-black ink - the solid canary chip
//
// The unit takes the figure's ink as well: `.metric__unit` defaults to zinc-dust,
// which is unreadable on a raw-blood plate.
const Pod = {
	raw: {
		Ground: "bg-raw-blood",
		Figure: "!text-bone-white",
		Label: "text-bone-white",
		Qualifier: "text-bone-newsprint",
	},
	teal: {
		Ground: "bg-carbon-void",
		Figure: "!text-weathered-teal",
		Label: "text-bone-white",
		Qualifier: "text-zinc-dust",
	},
	canary: {
		Ground: "bg-stamped-canary",
		Figure: "!text-soot-black",
		Label: "text-soot-black",
		Qualifier: "text-soot-black",
	},
}[Color];

// The split: `^(.*[0-9])\s*([^\s0-9]{1,3})$` reads "everything up to the last
// digit, then a short non-numeric tail". "416×" -> "416" + "×"; "0%" -> "0" +
// "%"; "13 / 13" ends on a digit, so it matches nothing and stays whole.
const TrailingUnit = /^(.*[0-9])\s*([^\s0-9]{1,3})$/;
const Trimmed = Ratio.trim();
const Split = Trimmed.match(TrailingUnit);
const Splittable = Split !== null && Split[1]!.length <= 12;
const Figure = Unit === undefined && Splittable ? Split![1]! : Trimmed;
const UnitText = Unit ?? (Splittable ? Split![2]! : "");

// Clamped once, server-side: a caller that passes 140 or -5 gets a bar that
// cannot overflow its track, and the script never has to guess what it meant.
// A pod has no track at all, so its Percent is never read and defaults to 0.
const Width = Math.max(0, Math.min(100, Percent ?? 0));
---

{
	Variant === "pod" ? (
		<div class={`statbar ${Tone} statbar__pod ${Pod.Ground}`}>
			{/* THE TIGHT LABEL, in the plate's ink: it names the domain the figure
			    belongs to, so a reader can tell one pod from another before
			    reading a digit. */}
			<p class={`type-meta !font-black uppercase tracking-widest ${Pod.Label}`}>{Label}</p>

			{/* THE FIGURE AND ITS UNIT, on one baseline: `.metric` is a block, so
			    the numeral and the unit's span stay inline without a flex wrapper. */}
			<p class={`${MetricScale} ${Pod.Figure}`}>
				{Count ? <span data-count={Figure}>{Figure}</span> : Figure}
				{UnitText === "" ? null : (
					<span class={`metric__unit ${Pod.Figure}`}>{UnitText}</span>
				)}
			</p>

			{/* THE QUALIFIER stays a sentence, so it keeps the reading size and
			    the sentence case: a pod's qualifier is the thing that stops its
			    figure from being averaged with the pod beside it. */}
			{Qualifier === undefined ? null : (
				<p class={`text-base leading-relaxed ${Pod.Qualifier}`}>{Qualifier}</p>
			)}
		</div>
	) : (
		<div class={`statbar ${Tone}`}>
			{/* THE TIGHT LABEL: mono, uppercase, black, one line above its own figure.
			    It is a label, not a sentence - the sentence that explains the figure
			    belongs to the page, which is the only thing that knows the context. */}
			<p class="statbar__label">{Label}</p>

			{/* THE FIGURE AND ITS UNIT. `.metric` is a block, so the figure's text and
			    the unit's span stay inline on one baseline - the same shape StudyLedger
			    uses. No flex here: Global.css loads after the utility layer, so its
			    `display: block` would win over a `flex` utility anyway. */}
			<div class="statbar__figure">
				<p class={`statbar__value ${MetricScale}`}>
					{Count ? <span data-count={Figure}>{Figure}</span> : Figure}
					{UnitText === "" ? null : <span class="metric__unit">{UnitText}</span>}
				</p>
			</div>

			{Qualifier === undefined ? null : <p class="statbar__qualifier">{Qualifier}</p>}

			<div class="statbar__track well">
				{Fill === "scroll" ? (
					<div
						class="statbar__fill zine-stat-fill"
						style={`width: ${Width}%;`}
						data-stat-fill={Width}
						aria-hidden="true"
					/>
				) : (
					<div class="statbar__fill" style={`width: ${Width}%;`} />
				)}
			</div>
		</div>
	)
}

<script>
	// The scroll-fill. The client sets ONE thing here - the width - because the
	// palette and the final width are already in the markup. Everything the
	// reader needs without JavaScript is server-rendered: the ratio text beside
	// the bar, and the bar itself at its final width (the pre-hide in the style
	// block is scoped to `html.js`, which only a scripting reader has).
	function BindStatFills() {
		for (const Bar of document.querySelectorAll<HTMLElement>("[data-stat-fill]")) {
			if (Bar.dataset.statFillBound) {
				continue;
			}

			Bar.dataset.statFillBound = "1";

			const Fill = () => {
				// The attribute goes first: the pre-hide rule matches on its
				// absence, so clearing it and setting the width must not be
				// separated by a paint.
				Bar.dataset.statFillOn = "1";
				Bar.style.width = `${Bar.dataset["statFill"] ?? "0"}%`;
			};

			// No observer, no pre-hide to release: a reader whose browser lacks
			// IntersectionObserver gets the final width at once rather than a
			// bar frozen at zero.
			if (!("IntersectionObserver" in window)) {
				Fill();
				continue;
			}

			const Observer = new IntersectionObserver(
				(Entries) => {
					for (const Entry of Entries) {
						if (Entry.isIntersecting) {
							Fill();
							Observer.disconnect();
						}
					}
				},
				{ threshold: 0.4 },
			);

			Observer.observe(Bar);
		}
	}

	BindStatFills();
	document.addEventListener("astro:page-load", BindStatFills);
</script>

<!-- No <style> block here on purpose: the fill's pre-hide is part of the readout's
     own state contract and lives in `Stylesheet/Component/Data.scss` beside the
     geometry it hides, while the hard-step snap stays in Global.css behind the
     `.zine-stat-fill` motion hook the fill element still carries. A component
     that carries a style block is the extraction reversing itself. -->
