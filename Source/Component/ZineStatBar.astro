---
interface Props {
	Label: string;

	/** The ratio text on the right, e.g. "416×". */
	Ratio: string;

	/** Width of the primary fill, 0-100. */
	Percent: number;

	/** Fill color: teal (default), raw, canary. */
	Color?: "teal" | "raw" | "canary";

	/** "scroll" = the MONUMENT treatment: width 0 until the bar enters the
	 *  viewport, then snaps to Percent in hard steps (.zine-stat-fill).
	 *  Default "static" renders the width immediately (the existing form). */
	Fill?: "static" | "scroll";
}

const { Label, Ratio, Percent, Color = "teal", Fill = "static" } = Astro.props;

const Palette = {
	teal: "bg-weathered-teal",
	raw: "bg-raw-blood",
	canary: "bg-stamped-canary",
}[Color];

const Text = {
	teal: "text-weathered-teal",
	raw: "text-raw-blood",
	canary: "text-stamped-canary",
}[Color];
---

<div>
	<div class="mb-1 flex justify-between text-xs font-bold">
		<span class="text-bone-newsprint">{Label}</span>
		<span class={Text}>{Ratio}</span>
	</div>
	<div class="flex h-4 w-full overflow-hidden border border-oxblood-dark bg-soot-black">
		{
			Fill === "scroll" ? (
				<div
					class="zine-stat-fill h-full"
					style="width: 0%;"
					data-stat-fill={Percent}
					aria-hidden="true"
				/>
			) : (
				<div class={`h-full ${Palette}`} style={`width: ${Percent}%;`} />
			)
		}
	</div>
</div>

<script>
	function BindStatFills() {
		for (const Bar of document.querySelectorAll<HTMLElement>("[data-stat-fill]")) {
			if (Bar.dataset.statFillBound) {
				continue;
			}

			Bar.dataset.statFillBound = "1";

			// The MONUMENT scroll-fill: the color plane and the target width are
			// applied only when the bar first enters the viewport (hard offsets:
			// width goes 0% -> target in steps, never eased).
			const Fill = () => {
				Bar.style.width = `${Bar.dataset["statFill"] ?? "0"}%`;
				Bar.classList.add({ teal: "bg-weathered-teal", raw: "bg-raw-blood", canary: "bg-stamped-canary" }[Color]);
			};

			const Observer = new IntersectionObserver(
				(Entries) => {
					for (const Entry of Entries) {
						if (Entry.isIntersecting) {
							Fill();
							Observer.disconnect();
						}
					}
				},
				{ threshold: 0.4 }
			);

			Observer.observe(Bar);
		}
	}

	BindStatFills();
	document.addEventListener("astro:page-load", BindStatFills);
</script>
