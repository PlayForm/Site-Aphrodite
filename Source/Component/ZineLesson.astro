---
interface Props {
	/** The lesson headline, stamped. */
	Label: string;

	/** The lesson text - a single line, or a tight group. */
	Text?: string;

	/** One entry per line: use when the lesson enumerates options a reader picks between. */
	Lines?: string[];

	/** Stamp color of the headline: canary (default), raw, teal. */
	Color?: "canary" | "raw" | "teal";
}

const { Label, Text, Lines, Color = "canary" } = Astro.props;

const Palette = {
	canary: "bg-stamped-canary text-soot-black",
	raw: "bg-raw-blood text-bone-white",
	// Teal takes DARK ink (ZineStamp documents the measurement: bone-white on
	// weathered-teal is 3.06:1 at 16px, soot-black on the same fill is 5.36:1).
	// The fill is the identity and stays; only the ink moves.
	teal: "bg-weathered-teal text-soot-black",
}[Color];
---

<aside class="flex flex-col gap-3 border-l-4 border-blood-crimson bg-asphalt-panel p-4 sm:flex-row sm:items-start sm:gap-5">
	<span class={`shrink-0 -rotate-1 self-start border-2 border-black px-3 py-1 font-mono text-base font-black uppercase tracking-widest shadow-[3px_3px_0px_#000] sm:-rotate-2 ${Palette}`}>
		{Label}
	</span>
	{
		Lines && Lines.length > 0 ? (
			<ul class="flex flex-col gap-2 font-body text-base leading-relaxed text-bone-newsprint">
				{Lines.map((Line) => (
					<li class="border-l-2 border-oxblood-dark pl-3">{Line}</li>
				))}
			</ul>
		) : (
			<p class="font-body text-base leading-relaxed text-bone-newsprint">{Text}</p>
		)
	}
</aside>
