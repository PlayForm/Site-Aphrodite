---
/**
 * ZineBox - the module plate, and the one place a block decides how loudly it
 * is framed.
 *
 * EMPHASIS TIER: this component spans all three tiers, and the tier is CHOSEN
 * rather than accumulated.
 *
 *   quiet     A hairline rule - 1px outline-oxblood with a 2px crimson left
 *             edge, no fill, no shadow, no tilt. The tier for a block the
 *             reader has to study: methodology, caveats, a definition list, a
 *             long quotation. Renders `.plate--quiet` (one published class in
 *             `Plate.scss`, sharing its budget with `.emphasis-quiet`),
 *             because quiet spends a complete budget and nothing here competes
 *             with it - `Surface`, `Accent`, `Tilt`, `Tone` and `Hover` are
 *             inert under quiet by design, not by omission.
 *   standard  The 4px crimson module boundary plus the hard offset shadow,
 *             flat. The default, and the plate for an example, a figure or a
 *             table. Renders `.plate--standard` for the boundary, a
 *             `.plate--surface-*` fill and a `.zine-box-*` plane for the
 *             shadow - three separate axes, so `Surface` and `Accent` each move
 *             their own value without the tier's declarations winning a
 *             specificity tie against them. The values live in
 *             `Stylesheet/Component/Plate.scss`.
 *   featured  standard plus a tilt: the ONE expressive assembly a section is
 *             allowed. Mirrors `.emphasis-expressive`'s frame. One per section -
 *             a second one takes emphasis away from the first, and from
 *             everything the reader actually has to study.
 *
 * Grammar law 1 is the border (4px crimson = the module boundary) and law 2 is
 * the shadow (zero-blur, pasted down, radius 0); law 3 is "mobile flattens",
 * which is why every tilt is composed with `max-sm:rotate-0`.
 *
 * THE LEAN STAYS A UTILITY, and the reason is the prop's own type: `Rotate`
 * takes a free-form angle (`-rotate-[0.6deg]`, `rotate-[0.4deg]`) chosen per
 * call site, so no class in the sheet can carry it. The component composes it,
 * and `max-sm:rotate-0` follows it so the mobile flatten keeps winning the way
 * it always did. `Tilt`'s named values resolve to the same utilities.
 *
 * The legacy props keep their meaning. `Tone` still selects only the shadow
 * plane, and it still outranks `Accent`'s shadow, so a call site that passes
 * `Tone="subtle"` keeps its crimson boundary and its subtle plane.
 *
 * Hover motion is OPT-IN (`Hover`). A plate that carries copy is not a control,
 * and a plate that leans away when a pointer crosses it tells the reader it can
 * be clicked. Only a plate that IS the affordance asks for `Hover`.
 */
import ZineTape from "./ZineTape.astro";

interface Props {
	/** Shadow tone: the zine-box class from Global.css. Legacy alias - it owns
	 * the shadow plane and nothing else, and it wins over `Accent`'s shadow. */
	Tone?: "crimson" | "subtle" | "canary" | "teal";

	/** The plate's padding: md = 1.5rem, 2rem from `sm` (`.plate--size-md`);
	 * lg = 2rem, 3rem from `sm` (`.plate--size-lg`). */
	Size?: "md" | "lg";

	/** Rotation from `sm` up; mobile is always flat. Pass the unprefixed class.
	 * The most specific rotation control - it outranks `Tilt`. */
	Rotate?: string;

	/** The corner tape rendered by ZineTape, if any. */
	Tape?: string;

	/** The corner tape's color. */
	TapeColor?: "raw" | "canary" | "teal" | "bone";

	/** The corner tape's side. */
	TapeSide?: "left" | "right";

	/** Extra classes for the plate itself. */
	Class?: string;

	/** An anchor id for the plate. `ZineSplit` needs one so `#hero-run` (and any
	 *  deep link) has something to land on - the id was previously computed but
	 *  only emitted as `data-run`, so every in-page anchor to a split did nothing. */
	Id?: string;

	/**
	 * Sweep the plate's edge once, on the beat of the entrance root that owns
	 * it (`[data-wipe]` in Documentation/Motion.md). The plate becomes the
	 * container-query context, so the bar crosses this plate and not the
	 * viewport. Opt-in: a plate that carries copy and follows nothing does not
	 * need a second mark drawing attention to it.
	 */
	Wipe?: boolean;

	/**
	 * The fill under the frame.
	 *
	 * ELEVATION TIERS (the blueprint grammar, Global.css): `canvas` is the page
	 * ground, `shell` a workbench module lifted off it with a 1px zinc edge,
	 * `well` a channel recessed into a shell. Each tier is a FILL only - the
	 * frame stays whatever `Emphasis` and `Accent` already decided - so a tiered
	 * plate keeps its boundary and its shadow plane.
	 *
	 * The three legacy values are unchanged, byte for byte, so no existing call
	 * site moves: `plain` = the module surface (carbon-void, the default);
	 * `inset` = the page ground, so the plate reads as a hole in it; `paper` =
	 * one sheet above the module surface (asphalt-panel).
	 */
	Surface?: "plain" | "inset" | "paper" | "canvas" | "shell" | "well";

	/** The emphasis tier - see the doc comment. One `featured` per section. */
	Emphasis?: "quiet" | "standard" | "featured";

	/** The boundary colour, and the shadow plane that mirrors it. `none` is the
	 * quietest framed plate: an oxblood-dark boundary on a subtle plane. */
	Accent?: "none" | "crimson" | "canary" | "teal";

	/** The lean. `featured` leans left on its own; pass `none` to hold a
	 * featured plate flat, or a side to lean a standard one. */
	Tilt?: "none" | "left" | "right";

	/** Hover motion: the plate straightens under the pointer. **On by default
	 * for a leaning plate** - a plate that leans and does not straighten reads
	 * as broken, not as calm. Pass `false` for a plate that must stay static
	 * (a dense reading column, or a tilted plate inside another tilted frame). */
	Hover?: boolean;

	/** Ink splats behind the plate. This is ELIGIBILITY, not a promise: the
	 *  painter draws a density score from the shared noise field and biases it by
	 *  the surface behind the plate, so an eligible plate can come out clean and
	 *  a filled one never carries more than a couple of faint groups. Default
	 *  follows the frame: a plate WITH a coloured border keeps that border as its
	 *  edge, a borderless one is eligible to take the ink as its edge.
	 *  `true`/`false` overrides either way. */
	Grunge?: boolean;

	/** Force the splat corner for a plate whose copy fills its body. */
	GrungeCorner?: "tl" | "tr" | "bl" | "br";
}

const {
	Tone,
	Size = "md",
	Rotate,
	Tape,
	TapeColor = "raw",
	TapeSide = "left",
	Class = "",
	Id,
	Wipe = false,
	Surface = "plain",
	Emphasis = "standard",
	// The frame follows the tier: `featured` keeps its crimson border (and stays
	// clean), `standard` and `quiet` are borderless, and `standard` is ELIGIBLE
	// for the ink as its edge. That is the mix the language wants - some plates
	// ruled, some printed. Eligibility is not a promise: Script/Grunge decides
	// the density from the noise field and the surface, so a filled plate usually
	// comes out clean instead of every borderless plate carrying the same ink.
	Accent = Emphasis === "featured" ? "crimson" : "none",
	Tilt,
	Hover = true,
	Grunge = Accent === "none" && Emphasis !== "quiet",
	GrungeCorner,
} = Astro.props;

/** Whether this plate paints no ground of its own: `quiet` paints nothing, and
 *  a page that overrides with `bg-transparent` has taken the fill away. ONE
 *  fact with two readers - the ink painter below, and the fill class, which has
 *  to DECLARE the absence rather than hope a utility outranks the sheet. */
const Fillless =
	Emphasis === "quiet" || /(^|\s)bg-transparent(\s|$)/.test(Class);

/** The surface the ink is painted on, as this component composes it.
 *
 *  The painter MEASURES the computed background first and only falls back to
 *  this declaration, for the one case a measurement cannot see: a fill painted
 *  by a pseudo-element. So it has to agree with the fill actually composed, and
 *  it is derived from `Fillless` for exactly that reason - one fact, so the
 *  class list and the painter cannot disagree. Every other value here carries a
 *  real `background-color`. */
const GrungeSurface: "transparent" | "filled" = Fillless ? "transparent" : "filled";

const Pad = {
	md: "plate--size-md",
	lg: "plate--size-lg",
}[Size];

/** The fill under the frame. The three legacy values map to the plate's own
 *  surface modifiers; the three tier values map to the blueprint grammar's fill
 *  classes, which set a background and nothing else, so the frame composed
 *  above stays intact.
 *
 *  All six are plain class selectors in `Plate.scss`, so a utility no longer
 *  beats a plate's ground - which is the point, since a fill that silently
 *  loses leaves a bordered box with nothing behind it. A call site that MEANS
 *  to remove the fill says `bg-transparent`, and `Fillless` turns that into the
 *  declared opt-out `plate--surface-none` instead of relying on the utility
 *  winning a specificity argument. The tier fills are already fill classes and
 *  nothing more: `Surface="shell"` is the surface the page asked for. */
const Fill = Fillless
	? "plate--surface-none"
	: {
			plain: "plate--surface-plain",
			inset: "plate--surface-inset",
			paper: "plate--surface-paper",
			canvas: "tier-canvas",
			shell: "tier-shell",
			well: "tier-well",
		}[Surface];

const Boundary = {
	none: "plate--accent-none",
	crimson: "plate--accent-crimson",
	canary: "plate--accent-canary",
	teal: "plate--accent-teal",
}[Accent];

/** `Tone` is the shadow-only legacy alias, so it outranks `Accent` here: that is
 * what a call site passing `Tone` means by the prop. `Accent` supplies both the
 * boundary colour above and the plane that mirrors it. */
const Plane =
	Tone !== undefined
		? {
				crimson: "zine-box-crimson",
				subtle: "zine-box-subtle",
				canary: "zine-box-canary",
				teal: "zine-box-teal",
			}[Tone]
		: {
				none: "zine-box-subtle",
				crimson: "zine-box-crimson",
				canary: "zine-box-canary",
				teal: "zine-box-teal",
			}[Accent];

/** The lean, in precedence order: the legacy `Rotate` string (honoured
 * verbatim), then `Tilt`, then `featured`'s own default. */
const LeanByTilt = {
	none: "",
	left: "-rotate-[1.2deg]",
	right: "rotate-[0.8deg]",
};

const DefaultLean = Emphasis === "featured" ? "-rotate-[1.2deg]" : "";

const Lean =
	Rotate !== undefined && Rotate !== ""
		? Rotate
		: Tilt === undefined
			? DefaultLean
			: LeanByTilt[Tilt];

/** The tilt is composed as `rotate` + a mobile flatten, never as a `sm:` prefix:
 * Tailwind's scanner only sees literal class text, so a composed `sm:-rotate-x`
 * would never be generated and the plate would render flat. */
const Transform = Lean === "" ? "max-sm:rotate-0" : `${Lean} max-sm:rotate-0`;

/** Quiet is one published class carrying a complete budget; standard and
 * featured name the plate's own tier, then the three axes that move under it -
 * the boundary, the fill and the plane - followed by the lean and its
 * straighten. The modifiers come after the tier in `Plate.scss`, so each one
 * wins its own property by source order instead of losing a specificity tie. */
const Frame =
	Emphasis === "quiet"
		? ["plate--quiet"]
		: [
				`plate--${Emphasis}`,
				Boundary,
				Fill,
				Plane,
				Transform,
				Lean !== "" && Hover && "plate--straighten",
			];
---

<div
	class:list={[
		"plate",
		...Frame,
		Pad,
		Wipe && "motion-wipe-host",
		Grunge && "grunge",
		Grunge && Surface === "paper" && "grunge--faint",
		Class,
	]}
	data-emphasis={Emphasis}
	id={Id}
	data-surface={Surface}
	data-grunge={Grunge ? "" : undefined}
	data-grunge-surface={Grunge ? GrungeSurface : undefined}
	data-grunge-corner={Grunge ? GrungeCorner : undefined}
	data-grunge-mode={Grunge ? (Accent === "none" ? "edge" : "scatter") : undefined}
>
	{Wipe && <span class="motion-wipe" data-wipe aria-hidden="true" />}
	{Tape !== undefined && (
		<ZineTape Variant="corner" Label={Tape} Color={TapeColor} Side={TapeSide} />
	)}
	<slot />
</div>
