---
/**
 * ZineTape - the module's label, and the site's annotation hierarchy.
 *
 * EMPHASIS TIER: this component spans the tiers, and the shape IS the tier.
 * `kicker` and `hash` are quiet; `corner` and `tab` are standard; `section`,
 * `hero` and `strip` are expressive - the tier a section spends once.
 *
 * THE BUDGET. A tape is the site's expressive accent, so a section is allowed
 * ONE of `section`, `hero` or `strip` - never two in the same chapter. A second
 * one does not add emphasis; it takes emphasis from the first, and from the
 * reading the section was written for. Everything that is a LABEL rather than
 * an accent is quiet, and DEMOTION is the fix rather than deletion: the words
 * stay, only the volume changes.
 *
 * THE HIERARCHY, loudest last. Pick the smallest shape that carries the job;
 * a page that tapes everything has no tape.
 *
 *   kicker   A SECTION IDENTIFIER: small mono text, no box, no shadow, no
 *            rotation. This is what most section labels actually need - the
 *            reader has to find the section, not admire the label.
 *   hash     The mechanical voice: the published `.telemetry-tag--teal` chip
 *            (Global.css) under the hard 3px offset plane, for a hash, a
 *            version or a count.
 *   corner   IMPORTANT ANNOTATION: a narrow strip on a module's top edge. The
 *            default shape, and the workhorse.
 *   tab      The index tab that hangs above a plate.
 *   strip    The full-bleed file strip across a hero's top edge.
 *   section  The in-flow section stamp, with the full `mb-12` rhythm.
 *   hero     The BRAND STICKER: the large stamp in the hero row.
 *
 * DEMOTION PATH. A chapter that needs an identifier and not an accent uses
 * `Variant="kicker"`, `Variant="hash"`, or writes the `.section-index` tag
 * (`01 // POSITIONING`, Global.css) directly: 11px mono, no chip, no tilt.
 * Every path keeps every word of the label.
 *
 * RESERVE THE FULL TAPE for a few moments. `section`, `hero` and `strip` are
 * the expressive tier - one per section at most, and the page's own brand
 * moment gets the `hero`. Everything else is `kicker`, `corner` or `hash`.
 *
 * The variant set is closed on purpose. A tape is a grammar element, so it has
 * a finite number of shapes and a page picks one; six free-form knobs would let
 * the grammar drift back.
 *
 * Grammar law 3 (mobile flattens) is enforced HERE rather than at the call
 * site: every shape that leans appends `max-sm:rotate-0`, so a page cannot
 * reintroduce a lean on a 390px screen by passing the unprefixed class.
 *
 * `corner` keeps the geometry the site ships today (`-top-7`, `-rotate-1`) so
 * the pages that already import this component render unchanged; a caller that
 * wants the hand-rolled sites' `-top-5` passes `Offset`.
 *
 * The palette defaults are the grammar's: raw-blood is the section label,
 * stamped-canary the highlight, weathered-teal the mechanical voice, and the
 * tilt is 1-2 degrees.
 */
interface Props {
	/** The tape's text. */
	Label: string;

	/** The shape: corner (default) | section | hero | hash | tab | strip | kicker. */
	Variant?: "corner" | "section" | "hero" | "hash" | "tab" | "strip" | "kicker";

	/** Stamp color: raw-blood (default), stamped-canary, weathered-teal, bone-newsprint. */
	Color?: "raw" | "canary" | "teal" | "bone";

	/** Side of the module the tape sits on. Corner variant only. */
	Side?: "left" | "right" | "center";

	/** Corner offset only; -top-7 is the corner default this component ships. */
	Offset?: "-top-3.5" | "-top-4" | "-top-5" | "-top-7";

	/** The tilt. Each variant has its own default, so pass one only to override it. */
	Rotate?: "-rotate-1" | "rotate-1" | "-rotate-2";

	/** Extra classes for the tape itself. */
	Class?: string;
}

const {
	Label,
	Variant = "corner",
	Color = "raw",
	Side = "left",
	Offset = "-top-7",
	Rotate,
	Class = "",
} = Astro.props;

/** A tape's colour is a FILL with text on it. */
const Fill = {
	raw: "plate__tape--fill-raw",
	canary: "plate__tape--fill-canary",
	// Teal takes DARK ink, on the same measurement ZineStamp records: bone-white
	// on weathered-teal is 3.06:1 at 16px (below the 4.5:1 floor), soot-black on
	// the same fill is 5.36:1. The fill carries the identity; only the ink moves.
	teal: "plate__tape--fill-teal",
	bone: "plate__tape--fill-bone",
}[Color];

/** `kicker` has no box to fill, so it takes the same colour as TEXT. `raw` is a
 * chrome colour and never a text colour (the AA-LIFT law), so the section-label
 * voice is dust - which is also what a label should read as. */
const Ink = {
	raw: "plate__tape--ink-raw",
	canary: "plate__tape--ink-canary",
	teal: "plate__tape--ink-teal",
	bone: "plate__tape--ink-bone",
}[Color];

const Position = {
	left: "left-6",
	right: "right-6",
	center: "left-1/2 -translate-x-1/2",
}[Side];

/** The tilt each shape carries when the caller does not override it. `kicker`
 * sits still: a section identifier that leans is decoration pretending to be a
 * label. */
const DefaultTilt = {
	corner: "-rotate-1",
	section: "-rotate-1",
	hero: "-rotate-2",
	hash: "rotate-1",
	tab: "-rotate-1",
	strip: "-rotate-1",
	kicker: "",
}[Variant];

const Tilt = Rotate ?? DefaultTilt;

/** Grammar law 3: the lean exists from `sm` up and nowhere below it. Composed
 * here so no call site has to remember, and so the mobile flatten cannot be
 * lost by a page that passes the unprefixed class. */
const Lean = Tilt === "" ? "" : `${Tilt} max-sm:rotate-0`;

/** The SHAPE and the PALETTE live in `Plate.scss` as `plate__tape--*`. What is
 *  composed here is PLACEMENT - the side, the offset and the lean - because
 *  those values are props the call site chooses and a class in the sheet cannot
 *  carry an angle or an offset that exists only at that call site.
 *
 *  The mobile flatten rides with the lean for the same reason: Tailwind emits
 *  `max-sm:rotate-0` after the unprefixed rotation, so it wins against whatever
 *  angle a caller passed - a class in the sheet would have to fight that
 *  utility for the same property and would lose the flatten on a phone.
 *
 *  `hash` keeps the published `.telemetry-tag` chip (11.5px mono, 0.08em
 *  tracking, teal OUTLINE on no fill - the modifier's own contrast decision) and
 *  adds only the hard plane, so it still reads as a tape rather than as a badge
 *  from another design. `strip` keeps `.tape-strip`, which is
 *  `Component/Texture`'s: that block owns the tape's translucent fill and its
 *  torn short edges, and this one owns where the strip sits and its two
 *  hairlines. */
const Shape = {
	corner: `plate__tape--corner ${Offset} ${Position} ${Lean} ${Fill}`,
	section: `plate__tape--section ${Lean} ${Fill}`,
	hero: `plate__tape--hero ${Lean} ${Fill}`,
	hash: `plate__tape--hash telemetry-tag telemetry-tag--teal ${Lean}`,
	tab: `plate__tape--tab ${Lean} ${Fill}`,
	strip: `plate__tape--strip tape-strip ${Lean}`,
	kicker: `plate__tape--kicker ${Ink} ${Lean}`,
}[Variant];

/** The hash chip and the kicker are the inline shapes: they sit inside a flow
 * or a flex row rather than owning a block of their own. */
const Element = Variant === "hash" || Variant === "kicker" ? "span" : "div";
---

<Element class:list={["plate__tape", Shape, Class]}>{Label}</Element>
