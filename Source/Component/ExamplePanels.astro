---
/**
 * ExamplePanels - the five evidence shapes an `ExampleCase` panel can take,
 * rendered once for both of that component's presentations.
 *
 * The shapes are a closed set (`ExamplePanel` in Source/Library/Records.ts):
 * `rows`, `cards`, `lanes`, `table`, `sequence`. `ExampleCase` shows them
 * inside its `Inspect example` fold in the library presentation and at the
 * foot of the plate in the legacy one - two DOM positions, one renderer, so a
 * shape cannot be added to one presentation and silently missed in the other.
 *
 * EACH SHAPE IS THE ELEMENT ITS DATA IS, not a div that resembles one:
 *
 *   rows     -> `<dl>`, one shared track for the terms, so the readings form a
 *               column a reader can scan. The old shape was a wrapping
 *               `justify-between` flex row, which started every reading
 *               wherever its own term happened to end.
 *   cards    -> plates, title over body.
 *   lanes    -> panes side by side.
 *   table    -> `<table>` with a `<caption>` and `<th scope>`, so the columns
 *               are columns to a screen reader as well as to the eye.
 *   sequence -> `<ol>`, so the order survives with the styling off. The ordinal
 *               the reader sees is the step's own `N`, printed in a span that
 *               is hidden from assistive tech - the list already carries it.
 */
import ZineKicker from "./ZineKicker.astro";
import type { ExamplePanel } from "@Library/Records";

interface Props {
	/** The scenario's own evidence, in reading order. */
	Panels?: ExamplePanel[];
	/** The wrapper's classes - the caller owns the distance to what precedes it. */
	Class?: string;
}

const { Panels = [], Class = "" } = Astro.props;
---

{Panels.map((Panel) => (
	<div class:list={[Class]}>
		<ZineKicker Tone="dust">{Panel.Label}</ZineKicker>
		{Panel.Kind === "rows" && (
			<dl class="mt-8 flex flex-col gap-3">
				{Panel.Rows?.map(({ Left, Right, Tag, TagTone = "canary" }) => (
					<div class="grid grid-cols-1 gap-x-8 gap-y-1 border border-oxblood-dark bg-asphalt-panel px-4 py-3 sm:grid-cols-[minmax(0,16rem)_minmax(0,1fr)]">
						<dt class="font-mono text-base font-black uppercase tracking-widest text-bone-white">
							{Left}
						</dt>
						<dd class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-base text-zinc-dust">
							<span>{Right}</span>
							{Tag && (
								<span
									class:list={[
										"border px-2 py-0.5 font-mono text-base font-black",
										{
											canary: "border-stamped-canary text-stamped-canary",
											teal: "border-weathered-teal text-weathered-teal",
											newsprint: "border-bone-newsprint text-bone-newsprint",
										}[TagTone],
									]}
								>
									{Tag}
								</span>
							)}
						</dd>
					</div>
				))}
			</dl>
		)}
		{Panel.Kind === "cards" && (
			<div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
				{Panel.Cards?.map(({ Title, Body, Note }) => (
					<div class="zine-box-subtle border-[3px] border-oxblood-dark bg-soot-black p-5">
						<div class="font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
							{Title}
						</div>
						<div class="mt-4 font-mono text-base text-bone-white">{Body}</div>
						{Note && (
							<div class="mt-4 border-t border-oxblood-dark pt-4 font-mono text-base leading-relaxed text-zinc-dust">
								{Note}
							</div>
						)}
					</div>
				))}
			</div>
		)}
		{Panel.Kind === "lanes" && (
			<div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2">
				{Panel.Lanes?.map(({ Title, Lines, Marker }) => (
					<div class="border border-oxblood-dark bg-soot-black p-5 font-mono text-base">
						<div class="font-black uppercase tracking-widest text-bone-white">
							{Title}
						</div>
						{Lines.map((Line) => (
							<div class="mt-2 text-zinc-dust">{Line}</div>
						))}
						{Marker && (
							<div class="ccr-marker mt-4 text-weathered-teal" set:html={Marker} />
						)}
					</div>
				))}
			</div>
		)}
		{Panel.Kind === "table" && (
			<div class="mt-8 overflow-x-auto">
				<table class="w-full min-w-[36rem] border-collapse text-left">
					<caption class="type-sub mb-[var(--space-tight)] text-left text-bone-white">
						{Panel.Caption}
					</caption>
					<thead>
						<tr>
							{Panel.Columns.map((Column) => (
								<th
									scope="col"
									class="border border-oxblood-dark px-3 py-2 font-mono text-base font-black uppercase tracking-widest text-zinc-dust"
								>
									{Column}
								</th>
							))}
						</tr>
					</thead>
					<tbody>
						{Panel.Rows?.map((Row) => (
							<tr>
								{Row.map((Cell, Index) =>
									Index === 0 ? (
										<th
											scope="row"
											class="border border-oxblood-dark px-3 py-3 align-top font-mono text-base font-black uppercase tracking-widest text-bone-white"
										>
											{Cell}
										</th>
									) : (
										<td class="border border-oxblood-dark px-3 py-3 align-top font-mono text-base leading-relaxed text-zinc-dust">
											{Cell}
										</td>
									),
								)}
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)}
		{Panel.Kind === "sequence" && (
			<ol role="list" class="mt-8 flex list-none flex-col gap-3">
				{Panel.Steps?.map(({ N, Title, Rule }) => (
					<li class="border border-oxblood-dark bg-asphalt-panel px-4 py-3">
						<div class="flex flex-wrap items-baseline gap-3">
							<span
								aria-hidden="true"
								class="border border-oxblood-dark bg-raw-blood px-1.5 py-0.5 font-mono text-base font-black text-bone-white"
							>
								{N}
							</span>
							<span class="font-mono text-base font-black uppercase tracking-widest text-stamped-canary">
								{Title}
							</span>
						</div>
						<p class="mt-2 font-mono text-base leading-relaxed text-zinc-dust">
							{Rule}
						</p>
					</li>
				))}
			</ol>
		)}
	</div>
))}
