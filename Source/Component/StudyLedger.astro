---
/**
 * StudyLedger - the canonical real-world study block. One structured form for
 * every occurrence of the Sep 2026 measured study: a header row (the period and
 * the scope), ONE primary result, a quiet details table, the method note as its
 * own bordered block, the caveat, and the SRC citation.
 *
 * WHY ONE PRIMARY RESULT AND NOT A LEDGER OF EQUALS
 *
 * The first version gave every row the same shape - a fixed label, a heavy
 * value, a right-aligned note - so a reader met nine numbers with equal weight
 * and had to work out which one was the result. A row of three roles also makes
 * every multi-value row fight for width. The answer is not fewer figures: it is
 * one result stated at reading size, and everything a reader checks it against
 * in a table underneath, each row carrying its own unit, its own kind and its
 * own scope.
 *
 * OBSERVED ONLY. The study's fourth session shape is a SIMULATED pure-tool
 * workload, and it never happened. It is deliberately absent here: a simulated
 * workload in the same table as recorded sessions reads as a fourth observation.
 * The page that wants it prints it in its own block, tagged simulated.
 *
 * The facts are the generated primaries, reached through `Figure(Id)` - every
 * number stays byte-exact, never reworded or rounded, and a page joins it by a
 * stable ID rather than by a position in a list. The SRC citation is written as
 * a plain prose token ("README.md:694-740") and the CodeMentions pass wraps it
 * at build time into the real tree/Current link with the #L fragment, so no
 * anchor is hand-built here.
 */
import { Cite, Figure, Study } from "@Library/Numbers";

interface Props {
	/** "full" = the /benchmarks primary (larger numerals); "compact" = the
	 *  index telemetry footnote and the case-study variants. */
	Scale?: "compact" | "full";
}

const { Scale = "compact" } = Astro.props;

/** The one result the block leads with. */
const Reduction = Figure("study.reduction.center");
const Band = Figure("study.reduction.band");
const Sessions = Figure("study.sessions");
const SavedTokens = Figure("study.tokens.saved");

const LeadSize = Scale === "full" ? "metric" : "metric metric--compact";

/**
 * The details table: what the result is computed from, one question per row.
 * `Id` is the join - the label is this component's voice, the value, unit,
 * kind and scope are the record's, and `Figure` throws when an ID is unknown.
 */
const Measures: { Id: string; Label: string }[] = [
	{ Id: "study.tokens.recorded", Label: "Recorded context" },
	{ Id: "study.tokens.expanded", Label: "Expanded reconstruction" },
	{ Id: "study.tokens.saved", Label: "Estimated tokens saved" },
	{ Id: "study.reduction.percent", Label: "Estimated context reduction (point estimate)" },
	{ Id: "study.reduction.band", Label: "Sensitivity band" },
	{ Id: "study.api-calls", Label: "Calls analysed" },
	{ Id: "study.sessions.saved", Label: "Sessions with nonzero estimated reduction" },
	{ Id: "study.sessions.unsaved", Label: "Sessions with no estimated reduction" },
	{ Id: "study.median-ratio", Label: "Median session ratio" },
	{ Id: "study.average-per-call", Label: "Average saved per call" },
	{ Id: "study.retrieval.tokens", Label: "Tokens returned by retrieval (the re-entry toll)" },
	{ Id: "study.retrieval.calls", Label: "Retrieval calls" },
	{ Id: "study.retrieval.share", Label: "Retrieval as a share of the saving" },
	{ Id: "study.retrieval.factor", Label: "Full output paid again instead would have cost" },
];

const Rows = Measures.map(({ Id, Label }) => ({ Label, Fact: Figure(Id) }));

/** The kind tag. A reader must be able to tell a reconstruction from a count, so
 * the kind is a CHIP in the telemetry voice and its colour is identity:
 * measured is the teal outline, estimated the solid canary, simulated the solid
 * crimson, derived the quiet default. The solid variants carry their own ink,
 * which is also why `simulated` is no longer `text-raw-blood` - crimson as a
 * text colour measures 2.23:1 on these fills. */
const KindTag = {
	measured: { Tag: "MEASURED", Class: "telemetry-tag telemetry-tag--teal" },
	estimated: { Tag: "ESTIMATED", Class: "telemetry-tag telemetry-tag--canary" },
	simulated: { Tag: "SIMULATED", Class: "telemetry-tag telemetry-tag--crimson" },
	derived: { Tag: "DERIVED", Class: "telemetry-tag" },
} as const;
---

<div class="blueprint-section">
	<!-- HEADER row: the period + the scope. Two telemetry tags - the
	     measurement, then the corpus it was taken over. Metadata, not a
	     sentence, which is why they are chips and not prose. -->
	<div class="flex flex-wrap items-center justify-between gap-2">
		<span class="telemetry-tag telemetry-tag--teal">
			MEASURED, {Study.Measured.toUpperCase()}
		</span>
		<span class="telemetry-tag">
			{Study.Sessions} HERMES SESSIONS &bull; {Study.ApiCalls} API CALLS &bull;{" "}
			{Study.Period.toUpperCase()}
		</span>
	</div>

	<!-- THE PRIMARY RESULT: one figure, at the metric scale, with its unit as a
	     child so the two never separate on a narrow viewport. -->
	<div class="mt-8 border-l-2 border-blood-crimson pl-5">
		<div class="section-index">ESTIMATED CONTEXT REDUCTION</div>
		<div class={`mt-2 !text-stamped-canary ${LeadSize}`}>
			{Reduction.Value}
			<span class="metric__unit">{Reduction.Unit}</span>
		</div>
		<p class="mt-3 max-w-2xl type-body text-bone-newsprint">
			Across {Sessions.Value} recorded sessions, with a sensitivity band of {Band.Value}. The
			band is the result: {SavedTokens.Value} tokens is the same reconstruction counted at the
			centre of that range.
		</p>
		<p class="mt-2 max-w-2xl type-body text-zinc-dust">
			<span class="type-meta">{Reduction.Kind.toUpperCase()}</span> &bull; {Reduction.Scope}
		</p>
	</div>

	<!-- THE DETAILS: one question per row, every row carrying its own unit and
	     scope. A TELEMETRY MATRIX rather than a ruled table: the well recesses
	     the readings into the page, the rows are separated by hairlines instead
	     of a box per cell, and every figure is tabular so the digits line up
	     down the column. -->
	<div class="mt-10 overflow-x-auto well">
		<table class="w-full border-collapse font-mono text-base">
			<thead>
				<tr class="border-b border-[var(--tier-well-edge)]">
					<th class="px-3 py-2 text-left type-meta !font-black text-zinc-dust">
						MEASURE
					</th>
					<th class="px-3 py-2 text-right type-meta !font-black text-zinc-dust">VALUE</th>
					<th class="px-3 py-2 text-left type-meta !font-black text-zinc-dust">UNIT</th>
					<th class="px-3 py-2 text-left type-meta !font-black text-zinc-dust">KIND</th>
					<th class="px-3 py-2 text-left type-meta !font-black text-zinc-dust">SCOPE</th>
				</tr>
			</thead>
			<tbody>
				{Rows.map(({ Label, Fact }) => (
					<tr class="border-b border-oxblood-dark/60 last:border-b-0 hover:bg-raw-blood/10">
						<td class="px-3 py-2 text-left text-bone-newsprint">{Label}</td>
						<td class="px-3 py-2 text-right font-black tabular-nums text-bone-white">
							{Fact.Value}
						</td>
						<td class="px-3 py-2 text-left text-zinc-dust">{Fact.Unit}</td>
						<td class="px-3 py-2 text-left">
							<span class={KindTag[Fact.Kind].Class}>{KindTag[Fact.Kind].Tag}</span>
						</td>
						<td class="px-3 py-2 text-left type-body text-zinc-dust">{Fact.Scope}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>

	<!-- HOW IT WAS MEASURED: the method as a block, not a footnote. The study is
	     a reconstruction by the author, and a reconstruction establishes nothing
	     about task success or about anyone else's sessions. -->
	<div class="mt-8 border-l-4 border-stamped-canary tier-shell p-4">
		<div class="type-meta font-black text-stamped-canary">HOW THIS WAS MEASURED</div>
		<p class="mt-3 max-w-3xl type-body text-bone-newsprint">
			The study is the author's own work - multi-agent atomization fan-outs, merge/PR work,
			plugin integration - reconstructed payload-by-payload from the session transcripts.
		</p>
		<p class="mt-3 max-w-3xl type-body text-bone-newsprint">
			It is an author-run reconstruction, not a randomised comparison: it establishes neither
			better task success nor universal cost savings. What it measures is how much context the
			markers replaced in these sessions, and what that reconstruction cost in tokens.
		</p>
		<p class="mt-3 max-w-3xl type-body text-zinc-dust">
			Every figure above carries its own method and the pinned revision it was extracted from
			- the register on the benchmarks page lists all of them with their IDs.
		</p>
	</div>

	<!-- CAVEAT: its own bordered note, visually distinct -->
	<div class="mt-4 border-l-4 border-stamped-canary tier-shell p-4 font-mono text-base leading-relaxed text-bone-newsprint">
		<span class="font-black uppercase tracking-widest text-stamped-canary">CAVEAT &bull; </span>
		THE EXACT PERCENTAGE IS A BAND: {Study.Band} ACROSS A {Study.CharsPerTok} CHARS/TOKEN
		SENSITIVITY RANGE, CENTERED {Study.BandCenter}.
	</div>

	<!-- SRC: the plain citation token the CodeMentions pass links at build time -->
	<div class="mt-3 type-meta text-zinc-dust">SRC: {Cite(Study.From)}.</div>
</div>
