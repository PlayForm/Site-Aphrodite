---
/**
 * ZineLedger - the generic DATA MATRIX: a recessed well of readings, one row per
 * record, an optional caption row of column labels.
 *
 * The matrix is the telemetry voice applied to a table. Three things make it
 * one, and none of them is decoration:
 *
 *   the WELL      the readings sit in a channel cut into the page (`.well`),
 *                 so the block reads as captured data rather than as a panel
 *                 of prose that happens to be tabular.
 *   the HAIRLINES rows are separated by one hairline each and the header row by
 *                 one stronger rule - no box per cell, no vertical rules. A
 *                 grid of boxes is a form; a stack of readings is a matrix.
 *   the DIGITS    every cell is tabular-numeric, so a column of figures aligns
 *                 on the decimal whether or not the caller padded it.
 *
 * `Delta` is IDENTITY, not emphasis: `up` is the canary and `down` the teal, on
 * the arrow as well as on the value. A matrix that greyed its deltas would be
 * quieter and would stop saying which direction a reading moved.
 */
interface Props {
	/** Table rows; Delta highlights a cell in the canary/teal accent. */
	Rows: {
		Cells: {
			Text: string;
			/** "up" renders canary, "down" renders teal; unset renders plain. */
			Delta?: "up" | "down";
			/** Align this cell right (numeric columns). */
			Align?: "right";
		}[];
	}[];

	/** Optional header row; rendered as the ruled column captions. */
	Headers?: string[];
}

const { Rows, Headers } = Astro.props;

const Delta = {
	up: "text-stamped-canary",
	down: "text-weathered-teal",
};
---

<!-- The table cannot shrink below its content's min-content width, so on a
	narrow viewport it widened the PAGE (/versions/ by 226px) instead of
	scrolling. The box is the scroll container: the border stays put, the
	rows move. Same pattern as every hand-written table on the site. -->
<div class="zine-box-subtle well overflow-x-auto">
	<table class="w-full border-collapse font-mono text-base">
		{
			Headers && (
				<thead>
					<tr class="border-b border-[var(--tier-well-edge)]">
						{Headers.map((Header) => (
							<th class="px-3 py-2 text-left type-meta !font-black uppercase tracking-widest text-zinc-dust">
								{Header}
							</th>
						))}
					</tr>
				</thead>
			)
		}
		<tbody>
			{
				Rows.map((Row) => (
					<tr class="border-b border-oxblood-dark/60 last:border-b-0 hover:bg-raw-blood/10">
						{Row.Cells.map((Cell) => (
							<td
								class={`px-3 py-2 tabular-nums ${Cell.Delta ? Delta[Cell.Delta] : "text-bone-newsprint"} ${Cell.Align === "right" ? "text-right" : "text-left"}`}
							>
								{Cell.Delta && <span class="mr-1 font-black">{Cell.Delta === "up" ? "▲" : "▼"}</span>}
								{Cell.Text}
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
