---
import { AllLinks, IsActive } from "@Library/Links";

// The registry-driven breadcrumb trail: OVERVIEW -> the page. Rendered only
// on deep pages (the root matches only itself, so "/" gets nothing).
const Active = AllLinks.find((Link) => IsActive(Astro.url.pathname, Link));
---

{
	Active && Active.Href !== "/" && (
		<nav
			aria-label="Breadcrumb"
			class="flex items-center gap-2 font-mono text-base uppercase tracking-widest text-zinc-dust"
		>
			<a class="transition-colors hover:text-bone-white" href="/">
				OVERVIEW
			</a>
			<span class="text-oxblood-dark" aria-hidden="true">
				//
			</span>
			<span class="text-bone-newsprint" aria-current="page">
				{Active.Label}
			</span>
		</nav>
	)
}
