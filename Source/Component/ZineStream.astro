---
interface Props {
	/** Terminal lines; Tone maps to the suppression opacities or a highlight. */
	Lines: { Text: string; Tone?: "plain" | "dim" | "fade" | "mute" | "result" | "canary" | "teal" }[];
	/**
	 * Print the lines one after another instead of showing them at once.
	 *
	 * This is the motion contract's `[data-stream]` (Documentation/Motion.md):
	 * the stagger IS the streaming log - the product's argument rendered as
	 * motion - so it belongs on a pane of real command output and nowhere else.
	 * The pane's own entrance root (a `[data-reveal]` section) owns the beat:
	 * the lines print when the panel arrives, not while it is still off-screen.
	 */
	Stream?: boolean;
}

const { Lines, Stream = false } = Astro.props;

const Tone = {
	plain: "",
	dim: "opacity-70",
	fade: "opacity-40",
	mute: "opacity-25",
	result: "text-bone-white",
	canary: "text-stamped-canary",
	teal: "text-weathered-teal",
};
---

<div
	class="ccr-marker border border-oxblood-dark bg-soot-black p-3.5 font-mono text-base leading-relaxed text-zinc-dust"
	data-stream={Stream ? "" : undefined}
>
	{
		/*
		 * The tone lives on an INNER span, never on the line itself. The stream
		 * animation runs on the line and fills `opacity: 1` for good, which would
		 * flatten the suppression law (dim 70 / fade 40 / mute 25) the moment the
		 * log finished printing - the pane would lose the one thing it is there to
		 * show. One wrapper div per line, one span inside it: the line animates,
		 * the span keeps its tone, and the two opacities multiply.
		 */
		Lines.map(({ Text, Tone: LineTone = "plain" }) => (
			<div>
				<span class={Tone[LineTone]} set:html={Text} />
			</div>
		))
	}
</div>
