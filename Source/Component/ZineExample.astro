---
/**
 * ZineExample - the PRE-ASSEMBLED form of one worked example: the raw input
 * pane, the "absorbed" rule, and the preview the model kept, in one plate.
 *
 * This is the compact form. `ExampleCase` owns the full one - the outcome
 * model, the compact resting state and the `Inspect example` fold - and a page
 * that renders a library of examples uses that. This component stays for the
 * one-line case: a page that wants a single plate showing what went in and
 * what came out.
 *
 * It shares the outcome vocabulary anyway, because the two forms must not
 * disagree about what an example is: `Outcome` decides whether a marker can be
 * rendered at all (a passed-through output has none to show), and
 * `Provenance` prints where the words came from. Both are optional, so a
 * caller that has neither gets exactly the plate this component always drew.
 */
import ZinePreview from "./ZinePreview.astro";
import ZineStream from "./ZineStream.astro";
import ZineTape from "./ZineTape.astro";
import type { ExampleOutcome, ExampleProvenance } from "@Library/Records";

interface Props {
	/** The example title, rendered on the tape across the top. */
	Title: string;

	/** The raw input lines shown in the terminal panel (the ZineStream tones). */
	Lines: { Text: string; Tone?: "plain" | "dim" | "fade" | "mute" | "result" | "canary" | "teal" }[];

	/** The absorptive preview shown to the LLM. */
	Preview: string;

	/**
	 * The optional CCR hash line (teal). Rendered only when the outcome is one
	 * that stores a marker - an entry that passed through has nothing to show
	 * here, and a pane implying otherwise is the defect this guards.
	 */
	Hash?: string;

	/** Optional retrieval note under the pair, e.g. the tool + args that got it back. */
	Retrieval?: string;

	/** Rotation applied from the sm breakpoint up; mobile is always flat. */
	Rotate?: string;

	/** How the bytes reached the transcript; unset renders the plate unchanged. */
	Outcome?: ExampleOutcome;

	/** Where the words come from, printed as text beside the title. */
	Provenance?: ExampleProvenance;
}

const { Title, Lines, Preview, Hash, Retrieval, Rotate = "", Outcome, Provenance } = Astro.props;

/** The four mechanism names, in this form's short voice. */
const OutcomeLabel = {
	compressed: "COMPRESSED",
	passthrough: "PASSED THROUGH",
	injected: "INJECTED",
	callback: "CALLBACK",
};

/** The one outcome whose bytes end up behind a marker. */
const StoresMarker = Outcome === undefined || Outcome === "compressed" || Outcome === "callback";

/** The preview pane's own name, per mechanism: it is not always "what the LLM sees". */
const PreviewLabel = {
	compressed: "PREVIEW // WHAT THE LLM SEES",
	passthrough: "THE PREVIEW COMPUTED, NEVER EMITTED",
	injected: "THE BLOCK HEADER",
	callback: "THE QUEUED REPLY",
};
---

<div class={`relative ${Rotate} transition-transform duration-300 hover:rotate-0 sm:-rotate-[0.8deg]`}>
	<ZineTape Label={Title} Color="raw" Side="center" />
	<div class="zine-box-subtle border-[3px] border-oxblood-dark bg-carbon-void p-4 pt-7 sm:p-6 sm:pt-8">
		{
			(Outcome !== undefined || Provenance !== undefined) && (
				<div class="mb-4 flex flex-wrap items-center gap-2">
					{Provenance && (
						<span class="border border-zinc-dust px-2 py-0.5 font-mono text-base font-black uppercase tracking-widest text-zinc-dust">
							{Provenance}
						</span>
					)}
					{Outcome && (
						<span class="border border-weathered-teal px-2 py-0.5 font-mono text-base font-black uppercase tracking-widest text-weathered-teal">
							{OutcomeLabel[Outcome]}
						</span>
					)}
				</div>
			)
		}
		<ZineStream Lines={Lines} />
		<div class="my-4 flex items-center gap-3" aria-hidden="true">
			<span class="h-0 grow border-t border-dashed border-oxblood-dark"></span>
			<span class="font-mono text-base font-black uppercase tracking-widest text-zinc-dust">absorbed</span>
			<span class="h-0 grow border-t border-dashed border-oxblood-dark"></span>
		</div>
		<ZinePreview
			Label={Outcome === undefined ? "PREVIEW // WHAT THE LLM SEES" : PreviewLabel[Outcome]}
			Result={Preview}
			Hash={StoresMarker ? Hash : undefined}
			Color="canary"
		/>
		{Retrieval && (
			<div class="mt-3 border border-oxblood-dark bg-asphalt-panel-dark px-3 py-2 font-mono text-base leading-relaxed text-weathered-teal">
				<span class="mr-1 font-black text-stamped-canary">RETRIEVAL</span>
				{Retrieval}
			</div>
		)}
	</div>
</div>
