---
/**
 * ZineButton - the site's one action control, and its action hierarchy.
 *
 * EMPHASIS TIER: `Role` decides the budget, and the budget is the point.
 *
 *   primary    Filled raw-blood, bone-white text, black hairline, hard 3px
 *              offset shadow, press collapses both. THE action of a section.
 *              A section usually has ONE filled primary action - a second one
 *              competes with the first, and takes emphasis from both.
 *   ghost      A thin oxblood-dark hairline on no fill: the Stitch ghost. An
 *              action that must be visible without being THE action - a sibling
 *              destination, a "compare the other number". `secondary` is the
 *              same treatment under the name the tree already ships, and both
 *              resolve to one block in `Plate.scss` so neither can drift.
 *   text       An underlined link - no border, no shadow, no fill. Navigation
 *              that belongs inside the argument: "read the source", "see the
 *              measured page".
 *   utility    The small neutral control: mono, one step down, dust until it is
 *              pointed at. Reserved for SHORT labels (COPY, RUN, OPEN), where
 *              uppercase is a mark rather than a shout.
 *
 * THE LASER EDGE is the hover grammar of every role that HAS an edge: the
 * border turns stamped-canary under the pointer and under keyboard focus. It is
 * a 1px colour change on a border that already exists, so it costs no layout and
 * adds no shadow - the hard offset plane stays the resting/pressed signal, and
 * the laser is only the "this is live" edge. `text` has no border, so it takes
 * the canary underline it always had.
 *
 * The global `:focus-visible` ring (2px raw-blood, 2px offset, Global.css) still
 * applies on top: the laser border is an addition for the pointer and for a
 * filled control whose own fill would swallow a crimson ring, never a
 * replacement for the ring.
 *
 * LABEL CASING: sentence case is the default, because a button label is a
 * sentence the reader says to themselves. Uppercase belongs to the `utility`
 * voice only, and a `utility` label must stay short enough to read at a glance.
 *
 * The click is NOT handled here. `Source/Layout/Base.astro` owns the only copy
 * runtime in the site: it binds every `[data-copy]` element, writes the payload
 * to the clipboard and shows the toast, and re-binds on `astro:page-load` under
 * a bound guard. This component therefore ships markup and a `data-copy` value,
 * nothing else.
 */
interface Props {
	/** The visible label and the accessible name. Sentence case. */
	Label: string;

	/** When set, clicking copies this text and shows the toast stamp. */
	Copy?: string;

	/** When set the control is an `<a>`; otherwise it is a `<button>`. */
	Href?: string;

	/** The action budget - see the doc comment. Defaults to the filled CTA. */
	Role?: "primary" | "secondary" | "ghost" | "text" | "utility";

	/** Extra classes for the control itself. */
	Class?: string;
}

const { Label, Copy, Href, Role = "primary", Class = "" } = Astro.props;

/** The action hierarchy lives in `Plate.scss`: `.button` carries the box model
 *  and the transition every role shares, and a role modifier carries only what
 *  makes it different. The laser edge, the hairline treatment and the press are
 *  declared there with the role they belong to, so nothing here composes a
 *  string that a second component could drift away from. */
const Shape = {
	primary: "button--primary",
	ghost: "button--ghost",
	secondary: "button--secondary",
	text: "button--text",
	utility: "button--utility",
}[Role];

const Classes = ["button", Shape, Class];
---

{Href ? (
	<a class:list={Classes} href={Href}>
		{Label}
	</a>
) : (
	<button class:list={Classes} data-copy={Copy} type="button">
		{Label}
	</button>
)}
