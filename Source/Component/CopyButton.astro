---
/**
 * CopyButton - the one clipboard control (plan D11).
 *
 * The site had two COPY CTAs with the same class and DIFFERENT payloads: the
 * install sequence was written out on `/` and again, one line longer, on
 * `/plugin/`. Two payloads for one sequence is exactly the drift
 * `install-surfaces` §1 exists to prevent, so the payload is a prop here and
 * the page passes the one canonical string.
 *
 * The click is NOT handled here. `Source/Layout/Base.astro` owns the only copy
 * runtime in the site: it binds every `[data-copy]` element, writes
 * `data-copy` to the clipboard and shows the "COPIED TO SPOOL" toast, and it
 * re-binds on `astro:page-load` under a bound guard so the view-transitions
 * router cannot orphan the handler. This component therefore ships markup and
 * a `data-copy` value, nothing else - a second script here would double the
 * toast, and a second toast is a second truth.
 *
 * `ZineCopyChip` is the small inline chip shape and rides the same runtime; it
 * is a different size, not a different mechanism. Use this one wherever the
 * copy is an ACTION in a panel or beside a code fence.
 *
 * NOT FOR A FENCE'S OWN PAYLOAD. A code block's copy control is the plate's
 * chip (`Source/Script/CodePlate.ts`), which already exists on every fence and
 * copies the one payload the block declares. `Component/CodeFence.astro` used
 * to render this button too, and the result was two controls for one payload
 * with the second one labelled `BASH` - the fence's language, because the
 * label defaulted to `Lang.toUpperCase()`. That is the rule this component
 * carries everywhere now: A LABEL NAMES THE ACTION, NEVER THE LANGUAGE OR THE
 * FORMAT. `COPY TOML` and `COPY ALL 7` name what the reader gets; `BASH` names
 * what the block is written in and belongs on the fence's metadata tag, where
 * nothing is clickable.
 *
 * The plate enforces it from its side: a control a PAGE placed in a
 * single-fence host is MOVED into the ribbon, never duplicated, so a stray
 * button beside a fence becomes that fence's one control rather than a second
 * one. This component therefore does not need a guard of its own - it needs to
 * stay out of the ribbon, which is what the `Size` note says.
 *
 * THE CONFIRMATION IS THE CONTROL. Stitch's CLI snippet confirms the copy where
 * the reader clicked, and this component carries that: on a successful write
 * the verb becomes `COPIED` for as long as the site's toast is on screen, then
 * returns. It is a second CONFIRMATION of the one clipboard write - never a
 * second control and never a second write. The state is set from
 * `Layout/Base.astro`'s OWN success signal (the toast it reveals only after
 * `navigator.clipboard.writeText` resolved), so a refused write marks nothing
 * and no control ever claims a copy that did not happen.
 *
 * The state itself is written by `Layout/Base.astro`'s reflector, beside the
 * toast it follows - not here. A component's `<script>` is bundled only on the
 * routes that render the component, so a reflector living in this file reached
 * the six routes that render a control and left every fence on crates,
 * benchmarks, plugin and the docs pages confirming nothing. The confirmation
 * is markup here; the mechanism is Base's, once, on every page.
 *
 *   <CopyButton Payload={InstallSequence} />
 *   <CopyButton Label="COPY TOML" Payload={Toml} Tone="teal" Size="sm" />
 */
interface Props {
	/** The visible label and the accessible name; defaults to `COPY`. */
	Label?: string;

	/**
	 * The exact string handed to the clipboard - a command block, a TOML
	 * snippet, an install sequence. Required: a copy button with nothing to
	 * copy is a dead control, so there is no default and no empty-string case.
	 */
	Payload: string;

	/** The fill. `crimson` is the CTA voice; `teal` and `canary` are the marks. */
	Tone?: "crimson" | "teal" | "canary";

	/**
	 * `md` in a panel, `sm` in a dense row of one. NOT for a code fence's
	 * header: the fence header is the ribbon's, its control is built by
	 * `Source/Script/CodePlate.ts`, and a button placed there would be a
	 * second control for one payload - the exact defect this component's own
	 * header records.
	 */
	Size?: "md" | "sm";

	/** Extra classes for the one caller that needs to sit in a flex row. */
	Class?: string;
}

const { Label = "COPY", Payload, Tone = "crimson", Size = "md", Class = "" } = Astro.props;

// The measured CTA shape (index:441-451 / plugin:218-226): a black hairline,
// a hard 3px offset shadow, and a press that collapses both - law 2, nothing
// floats. raw-blood is a FILL with bone-white text (the AA-LIFT raw-blood law:
// raw-blood is chrome, never a text colour); the light fills take soot-black.
//
// The label takes the TELEMETRY VOICE (`text-meta` - the same 11.5px tracked
// mono as every other label on the site) rather than body size. A control's
// label is a label: at body size it read as a sentence that happened to be
// sitting in a box, which is also what made a copy chip and a language tag
// compete for the same corner. Padding and the offset shadow are unchanged, so
// the target is exactly as large as it was.
const Base =
	"inline-flex items-center gap-2 border border-black font-mono font-black uppercase tracking-widest transition-colors active:translate-x-0.5 active:translate-y-0.5 active:shadow-none";

const Fill = {
	crimson: "bg-raw-blood text-bone-white hover:bg-blood-crimson",
	teal: "bg-weathered-teal text-soot-black hover:bg-weathered-teal",
	canary: "bg-stamped-canary text-soot-black hover:bg-stamped-canary",
}[Tone];

const Metrics = {
	md: "px-4 py-2 text-meta shadow-[3px_3px_0px_#000]",
	sm: "px-2 py-1 text-meta shadow-[2px_2px_0px_#000]",
}[Size];
---

<button
	class:list={[Base, Fill, Metrics, "group", Class]}
	data-copy={Payload}
	type="button"
	aria-label={Label === "COPY" ? "Copy to the clipboard" : `Copy ${Label} to the clipboard`}
>
	<span aria-hidden="true">⧉</span>
	<span class="group-data-[copy-state=copied]:hidden">{Label}</span>
	<span class="hidden group-data-[copy-state=copied]:inline" aria-live="polite">COPIED</span>
</button>
