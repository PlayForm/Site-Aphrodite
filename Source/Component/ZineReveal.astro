---
/**
 * ZineReveal - the redacted-cover layer. DECORATIVE ONLY.
 *
 * EMPHASIS TIER: expressive, and spent sparingly - one per section at most.
 * The hover/tap reveal is a printed-redaction joke: a muted cover line lifts to
 * expose the raw content underneath, the same hard-offset grammar, no easing.
 * Mobile has no hover, so tap flips the class there.
 *
 * THE POD GRAMMAR (dual-pod direction): the cover is the RIBBON - the cover
 * line on the left, the tag on the right - and the revealed content sits in an
 * inset WELL beneath it. That is the same shape a stream takes, which is the
 * point: a suppression mark and a preview are the same object seen at two
 * moments, so they are drawn with the same three parts. The ribbon carries the
 * TAG here and no byte count, because nothing in this component measures a
 * stream.
 *
 * DECORATIVE ONLY, and this is the rule that keeps it honest: the overlay is
 * ABSOLUTELY POSITIONED and its height is decided by the COVER, not by the raw
 * content. Put a paragraph in `Raw` and it is clipped, or overlaps the block
 * below it; a reader who never hovers - touch without a tap, a keyboard without
 * focus, a screen reader following the flow - gets the cover instead of the
 * content. Use it for a flourish whose meaning is already carried by the
 * argument beside it: a cover line over a number the page has just stated.
 *
 * `Flow` is the mode for substantive text: the cover becomes a quiet label and
 * `Raw` renders in normal document order below it, at its own full height, with
 * no overlay and no script. Same component, same grammar, no absolute
 * positioning - so the height is decided by the CONTENT.
 */
interface Props {
	/** The cover line shown while suppressed (mono, muted). */
	Cover: string;

	/** Optional small label on the cover, e.g. "SUPPRESSED". */
	Tag?: string;

	/** The raw content revealed underneath (rich). */
	Raw: string;

	/** Render in normal document order instead of as a hover overlay. Required
	 * for any substantive text. */
	Flow?: boolean;
}

const { Cover, Tag = "SUPPRESSED", Raw, Flow = false } = Astro.props;

/** The ribbon geometry, one string for the whole set. */
const Ribbon =
	"flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-oxblood-dark bg-asphalt-panel px-3 py-1.5";
---

{Flow ? (
	<div class="border border-oxblood-dark bg-soot-black" data-zine-reveal-flow>
		<div class={Ribbon}>
			<span class="min-w-0 break-words font-mono text-base text-zinc-dust">{Cover}</span>
			<span class="telemetry-tag ml-auto shrink-0">{Tag}</span>
		</div>
		<div class="p-3 font-mono text-base font-bold text-bone-white" set:html={Raw} />
	</div>
) : (
	<div
		class="group relative cursor-crosshair border border-oxblood-dark bg-soot-black"
		data-zine-reveal
		tabindex="0"
		aria-label={`${Tag}: hover or focus to reveal the raw content`}
	>
		<!-- The cover IS the ribbon. It fades rather than leaves, so the pod keeps
		     its height while the raw content is on top of it - the height is the
		     cover's, which is the whole reason this mode is decorative. -->
		<div
			class={`${Ribbon} transition-opacity duration-150 group-hover:opacity-10 group-focus:opacity-10 group-[.revealed]:opacity-10`}
		>
			<span class="min-w-0 truncate font-mono text-base text-zinc-dust">{Cover}</span>
			<span class="telemetry-tag ml-auto shrink-0">{Tag}</span>
		</div>
		<div class="pointer-events-none absolute inset-0 flex items-center p-3 font-mono text-base font-bold text-bone-white opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus:opacity-100 group-[.revealed]:opacity-100">
			<div class="w-full" set:html={Raw} />
		</div>
		<div class="pointer-events-none absolute bottom-1.5 right-2 type-meta text-zinc-dust opacity-0 transition-opacity group-hover:opacity-70 group-focus:opacity-70 group-[.revealed]:opacity-70">
			REVEALED
		</div>
	</div>
)}

<script>
	// Mobile flattens: no hover exists there, so tap flips the reveal. Only the
	// overlay form binds - `Flow` renders in document order and needs nothing.
	function BindReveals() {
		for (const Root of document.querySelectorAll("[data-zine-reveal]")) {
			if (Root.dataset.revealBound) {
				continue;
			}

			Root.dataset.revealBound = "1";

			Root.addEventListener("click", () => {
				Root.classList.toggle("revealed");
			});
		}
	}

	BindReveals();
	document.addEventListener("astro:page-load", BindReveals);
</script>
